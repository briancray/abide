{
    "$schema": "https://biomejs.dev/schemas/2.5.4/schema.json",
    "vcs": {
        "enabled": false,
        "clientKind": "git",
        "useIgnoreFile": true
    },
    "files": {
        "includes": [
            "packages/docs/src/**/*.ts",
            "packages/docs/e2e/**/*.ts",
            "packages/docs/scripts/**/*.ts",
            "packages/docs/*.ts",
            "packages/abide/src/**/*.ts",
            "packages/bench/**/*.ts",
            "packages/starter/src/**/*.ts",
            "packages/starter/e2e/**/*.ts",
            "packages/starter/scripts/**/*.ts",
            "packages/starter/*.ts",
            "!**/node_modules",
            "!**/dist",
            "!**/.abide",
            "!**/*.abide",
            "!**/__fixtures__"
        ]
    },
    "formatter": {
        "enabled": true,
        "indentStyle": "space",
        "indentWidth": 4,
        "lineWidth": 100
    },
    "linter": {
        "enabled": true,
        "rules": {
            "preset": "recommended"
        }
    },
    "assist": {
        "enabled": true,
        "actions": {
            "source": {
                "organizeImports": "on"
            }
        }
    },
    "javascript": {
        "formatter": {
            "quoteStyle": "single",
            "semicolons": "asNeeded"
        }
    },
    "overrides": [
        {
            "includes": ["packages/abide/src/shared/**", "!packages/abide/src/shared/**/*.test.ts"],
            "linter": {
                "rules": {
                    "style": {
                        "noRestrictedImports": {
                            "level": "error",
                            "options": {
                                "patterns": [
                                    {
                                        "group": ["**/server/**", "**/ui/**"],
                                        "message": "ADR 0026/0027: shared/ is the bottom layer and must not import from server/ or ui/. Move the dependency down, or read it off the reactive scope."
                                    }
                                ]
                            }
                        }
                    }
                }
            }
        },
        {
            "includes": ["packages/abide/src/ui/**", "!packages/abide/src/ui/**/*.test.ts"],
            "linter": {
                "rules": {
                    "style": {
                        "noRestrictedImports": {
                            "level": "error",
                            "options": {
                                "patterns": [
                                    {
                                        "group": ["**/server/**"],
                                        "message": "ADR 0027 D10: the layer order is shared <- ui <- server. ui/ must not import from server/ — including `import type`, which still makes ui/ uncompilable without server/. Move the shared contract down to shared/ (see shared/internal/hydrationSeed.ts, rpcSurface.ts, matchRoute.ts)."
                                    }
                                ]
                            }
                        }
                    }
                }
            }
        }
    ]
}
