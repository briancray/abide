{
    "compilerOptions": {
        "lib": ["ESNext", "DOM", "DOM.Iterable"],
        "target": "ESNext",
        "module": "Preserve",
        "moduleResolution": "bundler",
        "moduleDetection": "force",
        "allowImportingTsExtensions": true,
        // `.abide` files resolve to the `.d.abide.ts` the compiler generates, so a template
        // expression is checked by the real checker rather than by a second one.
        "allowArbitraryExtensions": true,
        // Where that generated tree actually IS. `allowArbitraryExtensions` looks for the declaration
        // in the SAME directory as the source and cannot be redirected — `rootDirs` answers it by
        // making these two one virtual directory for relative resolution, which is what keeps three
        // generated files per page out of the tree the author reads. It merges BOTH ways, so a
        // compiled module's own `../models.ts` still resolves back out into the source.
        //
        // A pair per PACKAGE that holds `.abide` files, because the mirror hangs off the package root
        // — a compiled `<script module>` imports `abide` by its public specifier, and a bare specifier
        // resolves by walking up for a `node_modules` rather than through anything here. An app
        // outside a workspace writes the one pair, `[".", "./.abide/types"]`.
        "rootDirs": [
            "packages/example",
            "packages/example/.abide/types",
            "packages/perf",
            "packages/perf/.abide/types"
        ],
        "verbatimModuleSyntax": true,
        "noEmit": true,
        "strict": true,
        "skipLibCheck": true,
        "noUncheckedIndexedAccess": true,
        "exactOptionalPropertyTypes": true,
        "types": ["bun"],
        // The directories the source is split into. Everything crosses these seams by alias, so a
        // file's imports say which SUBSTRATE it depends on rather than how many `../` it sits from.
        //
        // `$shared` is the only one that carries real traffic, and that is the architecture showing
        // through: `$ui` and `$server` may import shared, never each other, and nothing may import a
        // renderer except through its public entry point. The test kit has no alias for the same
        // reason — it is reached as `abide/tests`, and an alias would be a way around that.
        "paths": {
            "$shared/*": ["./packages/abide/src/shared/*"],
            "$ui/*": ["./packages/abide/src/ui/*"],
            "$server/*": ["./packages/abide/src/server/*"],
            "$compiler/*": ["./packages/abide/compiler/*"],
            "$shared": ["./packages/abide/src/shared/index.ts"],
            "$ui": ["./packages/abide/src/ui/index.ts"],
            "$server": ["./packages/abide/src/server/index.ts"],
            "$compiler": ["./packages/abide/compiler/index.ts"]
        }
        // The public specifiers — `abide`, `abide/ui`, `abide/server`, `abide/tests`,
        // `abide/compiler` — are deliberately NOT aliased here: the example resolves them through
        // the workspace link and abide's own `exports` map, so a broken public entry point fails in
        // the example's typecheck rather than being papered over.
    },
    "include": [
        "packages/abide/src/**/*.ts",
        "packages/abide/tests/**/*.ts",
        "packages/abide/compiler/**/*.ts",
        "packages/abide/cli/**/*.ts",
        "packages/example/**/*.ts",
        // What every `.abide` compiled to. The MODULE is where a template's expressions actually are,
        // so a config that only resolved the declarations would check the types a page exports and
        // nothing inside it.
        "packages/example/.abide/types/**/*.ts",
        // The perf app and its mirror. Absent until a `details?: boolean` prop that should have been
        // `State<boolean>` shipped through `abide check packages/perf` reporting clean — the checker
        // emits the named package's mirror and then runs `tsc` over whatever THIS file covers, so a
        // package missing here is checked to zero files and passes.
        "packages/perf/**/*.ts",
        "packages/perf/.abide/types/**/*.ts"
    ],
    // The type fixtures under `types/invalid` are SUPPOSED to fail. They are checked deliberately by
    // `packages/example/test/types.test.ts`, through their own config, and a repo whose own typecheck
    // is red says nothing at all — so they are not part of it.
    //
    // A pattern rather than the one path, because the fixtures are now in two trees: the `.abide`
    // sources and what they compiled to under `.abide/types/`. Two spellings of one rule is the one
    // that gets updated alone, and this failure mode is a repo whose typecheck is permanently red.
    "exclude": ["**/types/invalid"]
}
