{
    "name": "abide",
    "version": "0.0.0",
    "type": "module",
    "private": true,
    "workspaces": [
        "packages/*"
    ],
    "scripts": {
        "test": "bun test",
        "abide": "bun packages/abide/compiler/check.ts packages/example",
        "typecheck": "bun packages/abide/compiler/check.ts packages/example --check",
        "shapes": "bun packages/abide/compiler/shapes.ts packages/example --out .abide/shapes.json --pretty",
        "web": "bun run --filter example web",
        "example": "bun run --filter example ssr",
        "check": "biome check .",
        "check:fix": "biome check --write .",
        "lint": "biome lint .",
        "format": "biome format --write ."
    },
    "devDependencies": {
        "@biomejs/biome": "^2.5.7",
        "@types/bun": "latest",
        "typescript": "^7.0.2"
    }
}
