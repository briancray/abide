{
    "name": "abide",
    "version": "0.0.0",
    "type": "module",
    "private": true,
    "workspaces": [
        "packages/*"
    ],
    "scripts": {
        "test": "bun test",
        "e2e": "playwright test",
        "profile": "ABIDE_PROFILE=1 playwright test --project=example profile.e2e.ts --reporter=list",
        "cli": "bun packages/abide/cli/index.ts",
        "abide": "bun packages/abide/compiler/check.ts packages/example",
        "typecheck": "bun packages/abide/cli/index.ts check packages/example packages/perf",
        "shapes": "bun packages/abide/compiler/shapes.ts packages/example --out .abide/shapes.json --pretty",
        "dev": "bun run --filter example dev",
        "build": "bun run --filter example build",
        "example": "bun run build && bun run --filter example start",
        "check": "biome check .",
        "check:fix": "biome check --write .",
        "lint": "biome lint .",
        "format": "biome format --write ."
    },
    "devDependencies": {
        "@biomejs/biome": "^2.5.7",
        "@playwright/test": "^1.62.1",
        "@types/bun": "latest",
        "typescript": "^7.0.2"
    }
}
