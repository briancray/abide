{
    "name": "abide-workspace",
    "private": true,
    "type": "module",
    "workspaces": [
        "packages/*"
    ],
    "scripts": {
        "typecheck": "bun check -p packages/abide && bun check -p packages/harness && bun check -p packages/dogfood && bun check -p packages/bridge",
        "test": "bun run build && bun test packages/abide packages/harness/tests packages/dogfood/tests --parallel --timings=test-timings.json",
        "test:timings": "bun run build && bun test packages/abide packages/harness/tests packages/dogfood/tests --parallel --timings=test-timings.json --update-timings",
        "test:serial": "bun run build && bun test packages/abide packages/harness/tests packages/dogfood/tests",
        "test:changed": "bun test --changed",
        "build": "bun run --filter dogfood build",
        "dev": "bun run --filter dogfood dev",
        "lint": "biome lint",
        "format": "biome check --write --linter-enabled=false",
        "fix": "biome check --write",
        "knip": "bunx knip --workspace packages/abide",
        "e2e": "playwright test",
        "e2e:changed": "playwright test --only-changed",
        "e2e:failed": "playwright test --last-failed",
        "verify": "bun run lint && bun run typecheck && bun run test",
        "bench": "bun packages/harness/scripts/bench.ts",
        "test:gates": "bun run build && HARNESS_VERIFY_GATES=1 bun test packages/abide packages/harness/tests packages/dogfood/tests",
        "bench:reactive": "bun packages/harness/scripts/benchReactive.ts",
        "bench:compiler": "bun packages/harness/scripts/benchCompiler.ts",
        "bench:component": "bun packages/harness/scripts/benchComponent.ts",
        "bench:grid": "bun packages/harness/scripts/benchGrid.ts",
        "bench:render": "bun packages/harness/scripts/benchRender.ts",
        "bench:shared": "bun packages/harness/scripts/benchShared.ts",
        "bench:share": "bun packages/harness/scripts/nameTheShare.ts",
        "clauses:uncited": "bun packages/harness/scripts/uncitedClauses.ts",
        "bench:reorder": "bun packages/harness/scripts/reorderShare.ts",
        "prepare": "git config core.hooksPath .githooks || true",
        "changeset": "changeset",
        "version-packages": "bun run scripts/autofillChangesets.ts && changeset version",
        "release": "changeset publish"
    },
    "devDependencies": {
        "@biomejs/biome": "^2.5.15",
        "@changesets/cli": "^3.0.3",
        "@playwright/test": "^1.64.0",
        "@types/bun": "^1.4.2",
        "typescript": "^7.0.2"
    }
}
