{
    "name": "perf",
    "version": "0.0.0",
    "type": "module",
    "private": true,
    "imports": {
        "#server/*": ["./src/server/*", "./.abide/types/src/server/*"],
        "#ui/*": ["./src/ui/*", "./.abide/types/src/ui/*"],
        "#shared/*": ["./src/shared/*", "./.abide/types/src/shared/*"],
        "#tests/*": ["./src/tests/*", "./.abide/types/src/tests/*"]
