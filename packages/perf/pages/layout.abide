<script module>
// Through `url()` rather than written into the href, and mounting is what showed why: served under a
// sub-path, a literal `/dashboard` leaves the app entirely — app space never carries the base and
// browser space always does, so the crossing has to be made somewhere. `url` is that crossing, and it
// is the same target `navigate` would build, so a link and a navigation cannot disagree.
import { url } from 'abide'

const NAV = [
    { href: '/', label: 'simple' },
    { href: '/dashboard', label: 'dashboard' },
    { href: '/complex', label: 'complex' },
    { href: '/media', label: 'media' },
    { href: '/data', label: 'data' },
]
</script>

<header>
    {#for link of NAV by link.href}<a href={url(link.href)}>{link.label}</a> {/for}
</header>
<main>
    <slot/>
</main>
