<script>
import { state } from 'abide'
import { buildRows, type Row } from '#shared/rows.ts'

const SIZE = 1000

let rows = state<Row[]>(buildRows(1, SIZE))
let selected = state(-1)
let next = SIZE + 1

function create(): void {
    rows = buildRows(next, SIZE)
    next += SIZE
}

function append(): void {
    rows = rows.concat(buildRows(next, SIZE))
    next += SIZE
}

function update(): void {
    const held = rows.slice()
    for (let i = 0; i < held.length; i += 10) {
        const row = held[i] as Row
        held[i] = { id: row.id, label: `${row.label} !!!` }
    }
    rows = held
}

function swap(): void {
    const held = rows.slice()
    if (held.length < 999) return
    const a = held[1] as Row
    const b = held[998] as Row
    held[1] = b
    held[998] = a
    rows = held
}

function clear(): void {
    rows = []
}

function remove(id: number): void {
    rows = rows.filter((row) => row.id !== id)
}
</script>

<h1>complex</h1>
<p>A keyed table of {SIZE} rows, server-rendered and adopted.</p>

<div class="controls">
    <button id="create" onclick={() => create()}>create</button>
    <button id="append" onclick={() => append()}>append</button>
    <button id="update" onclick={() => update()}>update</button>
    <button id="swap" onclick={() => swap()}>swap</button>
    <button id="clear" onclick={() => clear()}>clear</button>
</div>

<table>
    <tbody id="rows">
        {#for row of rows by row.id}
            <tr class={row.id === selected ? 'danger' : ''}>
                <td class="col-id">{row.id}</td>
                <td><a onclick={() => selected = row.id}>{row.label}</a></td>
                <td><a onclick={() => remove(row.id)}>x</a></td>
                <td></td>
            </tr>
        {/for}
    </tbody>
</table>
