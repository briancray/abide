{
    "name": "@abide/kit",
    "version": "0.0.0",
    "type": "module",
    "description": "Headless components and helpers for abide apps — dialogs, toasts, popovers, lists, tables, charts, formatting, markdown, the assistant's chat, and the server rungs, fetches and jobs every app rewrites",
    "license": "MIT",
    "author": "Brian Cray",
    "homepage": "https://github.com/briancray/abide#readme",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/briancray/abide.git",
        "directory": "packages/kit"
    },
    "bugs": {
        "url": "https://github.com/briancray/abide/issues"
    },
    "keywords": [
        "abide",
        "bun",
        "headless",
        "components",
        "ui"
    ],
    "engines": {
        "bun": ">=1.4.4"
    },
    "publishConfig": {
        "access": "public",
        "provenance": true
    },
    "files": [
        "KIT.md",
        "src",
        "docs"
    ],
    "exports": {
        "./dialog": "./src/dialog/index.ts",
        "./Dialog.abide": "./src/dialog/Dialog.abide",
        "./Prompts.abide": "./src/dialog/Prompts.abide",
        "./toasts": "./src/toasts/index.ts",
        "./Toasts.abide": "./src/toasts/Toasts.abide",
        "./popover": "./src/popover/index.ts",
        "./Tooltip.abide": "./src/popover/Tooltip.abide",
        "./Menu.abide": "./src/popover/Menu.abide",
        "./listbox": "./src/listbox/index.ts",
        "./Combobox.abide": "./src/listbox/Combobox.abide",
        "./Tabs.abide": "./src/tabs/Tabs.abide",
        "./table": "./src/table/index.ts",
        "./SortableTable.abide": "./src/table/SortableTable.abide",
        "./format": "./src/format/index.ts",
        "./markdown": "./src/markdown/index.ts",
        "./Markdown.abide": "./src/markdown/Markdown.abide",
        "./chart": "./src/chart/index.ts",
        "./LineChart.abide": "./src/chart/LineChart.abide",
        "./Sparkline.abide": "./src/chart/Sparkline.abide",
        "./keys": "./src/keys/index.ts",
        "./elements": "./src/elements/index.ts",
        "./assistant": "./src/assistant/index.ts",
        "./Chat.abide": "./src/assistant/Chat.abide",
        "./Pairing.abide": "./src/assistant/Pairing.abide",
        "./guard": "./src/guard/index.ts",
        "./fetch": "./src/fetch/index.ts",
        "./job": "./src/job/index.ts",
        "./package.json": "./package.json"
    },
    "scripts": {
        "typecheck": "bun check"
    },
    "peerDependencies": {
        "@abide/abide": ">=0.141.0"
    },
    "devDependencies": {
        "@abide/abide": "workspace:*",
        "@abide/harness": "workspace:*"
    }
}
