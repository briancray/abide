<script>
// One or more series over a shared x, drawn in SVG at the size the chart is laid out at: the
// drawing is measured rather than stretched, so its labels are never distorted, and a pointer over
// it moves a crosshair to the nearest x and reads every series out there.
import type { Attributes } from '#shared/Attributes.ts'
import {
    nearest,
    path,
    scale,
    type Series,
    ticks,
} from '#shared/chart/index.ts'
import { number } from '#shared/format/index.ts'
import { size as observeSize } from '#shared/observe/size.ts'
import { props } from '#shared/props.ts'
import { reactive } from '#shared/reactive/index.ts'

const {
    series,
    label,
    x,
    xFormat = (value: number) => number(value),
    yFormat = (value: number) => number(value),
    xTicks = 5,
    yTicks = 4,
    zero = false,
    width = 600,
    height = 240,
    onpick,
    disabled,
    ...rest
} = props<
    {
        /** The lines, each a label and one value per x position. Line `i` is drawn as `data-series="i"`. */
        series: readonly Series[]
        /** What the chart shows, as its accessible name: `'Won revenue by month'`. */
        label: string
        /** The x of each position, ascending: a time in epoch milliseconds, say. Indices by default. */
        x?: readonly number[]
        /** Writes an x for its tick and the readout: `format.date`, say. `format.number` by default. */
        xFormat?: (x: number) => string
        /** Writes a y for its tick and the readout: `format.money`, say. `format.number` by default. */
        yFormat?: (y: number) => string
        /** The most x positions labeled under the plot. 5 by default. */
        xTicks?: number
        /** About how many intervals the y gridlines divide the range into. 4 by default. */
        yTicks?: number
        /** Whether the y range takes in zero, with a line drawn there as `data-part="zero"`. `false` by default. */
        zero?: boolean
        /** The width drawn at before the chart is measured, and where nothing sizes it. 600 by default. */
        width?: number
        /** The height drawn at before the chart is measured, and where nothing sizes it. 240 by default. */
        height?: number
        /** Called with the x position nearest a click on the plot, where `disabled` does not hold for it (52.38). */
        onpick?: (index: number) => void
        /** Whether an x position takes no pick, written as `data-disabled` on its bars and the readout (52.39). */
        disabled?: (index: number) => boolean
    } & Omit<Attributes<'svg'>, 'x' | 'width' | 'height'>
>()

// Room over the top gridline for its label, and under the plot for the x labels.
const TOP = 16
const BOTTOM = 24

const size = reactive({ width, height })
let hovered = reactive(-1)

const plot = reactive(() => {
    const length = series.reduce(
        (longest, line) => Math.max(longest, line.values.length),
        0,
    )
    const positions: number[] = []
    for (let index = 0; index < length; index += 1)
        positions.push(x?.[index] ?? index)
    let low = zero ? 0 : Number.POSITIVE_INFINITY
    let high = zero ? 0 : Number.NEGATIVE_INFINITY
    for (const line of series)
        for (const value of line.values)
            if (
                value !== null &&
                value !== undefined &&
                Number.isFinite(value)
            ) {
                if (value < low) low = value
                if (value > high) high = value
            }
    if (low > high) {
        low = 0
        high = 1
    }
    const gridValues = ticks(low, high, yTicks)
    const bottom = size.height - BOTTOM
    const toX = scale(
        [positions[0] ?? 0, positions.at(-1) ?? 0],
        [0, size.width],
    )
    const toY = scale(
        [gridValues[0] ?? low, gridValues.at(-1) ?? high],
        [bottom, TOP],
    )
    const xs: number[] = []
    for (const position of positions) xs.push(toX(position))
    const lines: {
        label: string
        path: string
        ys: (number | undefined)[]
        bar: boolean
    }[] = []
    // 52.37 — EACH BAR SERIES TAKES A SHARE OF ITS X'S SLOT, side by side, rising from zero where the
    // range takes it in and from the plot's floor otherwise.
    let barSeries = 0
    for (const line of series) if (line.kind === 'bar') barSeries += 1
    const slot = size.width / Math.max(1, length)
    const barWidth = barSeries === 0 ? 0 : (slot * 0.8) / barSeries
    const base = toY(Math.min(Math.max(0, low), high))
    const bars: {
        series: number
        index: number
        x: number
        y: number
        height: number
    }[] = []
    let barAt = 0
    for (let at = 0; at < series.length; at += 1) {
        const line = series[at] as Series
        const ys: (number | undefined)[] = []
        for (const value of line.values)
            ys.push(
                value === null || value === undefined ? undefined : toY(value),
            )
        const bar = line.kind === 'bar'
        lines.push({
            label: line.label,
            path: bar ? '' : path(xs, ys),
            ys,
            bar,
        })
        if (!bar) continue
        for (let index = 0; index < ys.length; index += 1) {
            const y = ys[index]
            if (y === undefined || !Number.isFinite(y)) continue
            bars.push({
                series: at,
                index,
                x: (xs[index] ?? 0) - (slot * 0.8) / 2 + barAt * barWidth,
                y: Math.min(y, base),
                height: Math.abs(base - y),
            })
        }
        barAt += 1
    }
    const grid: { y: number; label: string }[] = []
    for (const value of gridValues)
        grid.push({ y: toY(value), label: yFormat(value) })
    const labeled: { x: number; label: string; anchor: string }[] = []
    const shown = Math.min(length, Math.max(1, xTicks))
    for (let step = 0; step < shown; step += 1) {
        const index =
            shown === 1 ? 0 : Math.round((step * (length - 1)) / (shown - 1))
        labeled.push({
            x: xs[index] ?? 0,
            label: xFormat(positions[index] ?? index),
            anchor:
                shown === 1
                    ? 'middle'
                    : step === 0
                      ? 'start'
                      : step === shown - 1
                        ? 'end'
                        : 'middle',
        })
    }
    return {
        positions,
        xs,
        lines,
        bars,
        barWidth,
        grid,
        labeled,
        bottom,
        zeroY: zero ? toY(0) : undefined,
    }
})

// What the crosshair reads out, and which side of it the readout sits on so it stays in the plot.
const readout = reactive(() => {
    const index = hovered
    const drawn = plot
    if (index < 0 || index >= drawn.xs.length) return undefined
    const at = drawn.xs[index] ?? 0
    const right = at < size.width / 2
    const values: { label: string; value: string; y: number | undefined }[] = []
    for (let line = 0; line < drawn.lines.length; line += 1) {
        const value = series[line]?.values[index]
        values.push({
            label: drawn.lines[line]?.label ?? '',
            value: value === null || value === undefined ? '—' : yFormat(value),
            y: drawn.lines[line]?.ys[index],
        })
    }
    return {
        at,
        disabled: disabled?.(index) === true,
        textX: right ? at + 8 : at - 8,
        align: right ? 'start' : 'end',
        x: xFormat(drawn.positions[index] ?? index),
        values,
    }
})

function track(event: PointerEvent) {
    const box = (event.currentTarget as Element).getBoundingClientRect()
    if (box.width === 0) return
    const pointer = ((event.clientX - box.left) * size.width) / box.width
    hovered = nearest(plot.xs, pointer)
}

// 52.38 — a click picks the x the crosshair is on, read again from the click's own position.
function pick(event: MouseEvent) {
    if (onpick === undefined) return
    const box = (event.currentTarget as Element).getBoundingClientRect()
    if (box.width === 0) return
    const index = nearest(
        plot.xs,
        ((event.clientX - box.left) * size.width) / box.width,
    )
    if (index < 0 || disabled?.(index) === true) return
    onpick(index)
}
</script>

<svg
    {...rest}
    width={size.width}
    height={size.height}
    viewBox="0 0 {size.width} {size.height}"
    role="img"
    aria-label={label}
    data-hovering={readout ? '' : undefined}
    bind:element={observeSize(size)}
    onpointermove={track}
    onpointerleave={() => (hovered = -1)}
    onclick={pick}
>
    {#for line of plot.grid}
        <line data-part="grid" x1="0" x2={size.width} y1={line.y} y2={line.y} stroke="currentColor" stroke-opacity="0.2" />
        <text data-part="tick" data-axis="y" x="0" y={line.y - 4} fill="currentColor">{line.label}</text>
    {/for}
    {#if plot.zeroY !== undefined}
        <line data-part="zero" x1="0" x2={size.width} y1={plot.zeroY} y2={plot.zeroY} stroke="currentColor" />
    {/if}
    {#for tick of plot.labeled}
        <text
            data-part="tick"
            data-axis="x"
            x={tick.x}
            y={plot.bottom + 6}
            text-anchor={tick.anchor}
            dominant-baseline="hanging"
            fill="currentColor"
        >{tick.label}</text>
    {/for}
    {#for bar of plot.bars}
        <rect
            data-part="bar"
            data-series={bar.series}
            data-disabled={disabled?.(bar.index) ? '' : undefined}
            x={bar.x}
            y={bar.y}
            width={plot.barWidth}
            height={bar.height}
            fill="currentColor"
         />
    {/for}
    {#for line, index of plot.lines}
        {#if !line.bar}
            <path
                data-part="line"
                data-series={index}
                d={line.path}
                fill="none"
                stroke="currentColor"
                stroke-linejoin="round"
                stroke-linecap="round"
             />
        {/if}
    {/for}
    {#if readout}
        <line data-part="crosshair" x1={readout.at} x2={readout.at} y1={TOP} y2={plot.bottom} stroke="currentColor" />
        {#for point, index of readout.values}
            {#if point.y !== undefined}
                <circle data-part="point" data-series={index} cx={readout.at} cy={point.y} r="3" fill="currentColor" />
            {/if}
        {/for}
        <text data-part="readout" data-align={readout.align} data-disabled={readout.disabled ? '' : undefined} x={readout.textX} y={TOP} text-anchor={readout.align} dominant-baseline="hanging" fill="currentColor">
            <tspan data-part="readout-x" x={readout.textX}>{readout.x}</tspan>
            {#for point, index of readout.values}
                <tspan data-part="readout-value" data-series={index} x={readout.textX} dy="1.25em">{point.label}: {point.value}</tspan>
            {/for}
        </text>
    {/if}
</svg>
