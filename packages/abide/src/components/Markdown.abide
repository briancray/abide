<script>
// Markdown rendered as safe markup, a section at a time: a section a stream has moved past keeps
// its nodes, so a chunk re-renders only the section still growing (52.18).
import type { Attributes } from '#shared/Attributes.ts'
import {
    blockOf,
    type LinkTarget,
    referencesOf,
    renderSection,
    SCHEMES,
    sectionEnd,
    type Settings,
} from '#shared/markdown/sections.ts'
import { props } from '#shared/props.ts'
import { raw } from '#shared/Raw.ts'
import { reactive } from '#shared/reactive/index.ts'

const { source, schemes, headingLevel, href, blocks, ...rest } = props<
    {
        /** The markdown to render, as it stands: a stream hands it the text so far. */
        source: string
        /**
         * The schemes a link's address may have, lowercase and without the colon. A link to any
         * other renders as its text. `['http', 'https', 'mailto']` by default.
         */
        schemes?: readonly string[]
        /** The level a `#` heading renders at, the deeper ones below it, down to 6. 1 by default. */
        headingLevel?: number
        /**
         * Where each link `schemes` lets through goes: an address, or the address with the
         * `target` and `rel` it opens with (52.40); a link it answers `undefined` for renders as its
         * text. Pass one function for the component's life: a new one renders every section again.
         */
        href?: (address: string) => string | LinkTarget | undefined
        /**
         * 52.43 — the components rendering fenced blocks, by the first word of the fence's info:
         * each is handed the block's `source` and the rest of its `info`. A block still being
         * written shows as code until its fence closes.
         */
        blocks?: Readonly<
            Record<string, (props: { source: string; info: string }) => unknown>
        >
    } & Attributes<'div'>
>()

type Block = {
    Block: (props: { source: string; info: string }) => unknown
    source: string
    info: string
}
type Section = { source: string; html: string; block: Block | undefined }

// The sections no later text can change, the source and settings they were rendered from, and the
// section still growing as the last text left it.
let closed: Section[] = []
let closedSource = ''
let closedSettings: Settings | undefined
let open: Section | undefined

// The section `source` renders as — the growing one itself where it closed as the last text left it.
// 52.43 — a section is a block once its fence closes, the last one included: `blockOf` answers
// nothing for a fence still open, so a block still being written renders as code.
function sectionOf(source: string, settings: Settings): Section {
    // 52.18 — a section closing as it stood keeps the nodes it rendered while open.
    if (open?.source === source) return open
    const found =
        blocks === undefined ? undefined : blockOf(source, Object.keys(blocks))
    const Block = found === undefined ? undefined : blocks?.[found.name]
    if (Block === undefined || found === undefined)
        return {
            source,
            html: renderSection(source, settings),
            block: undefined,
        }
    // And a block the text ended on is the same block once text goes on past it, the blank line
    // after its fence joining the section.
    const held = open?.block
    if (
        held !== undefined &&
        held.Block === Block &&
        held.source === found.source &&
        held.info === found.info
    )
        return open as Section
    return {
        source,
        html: '',
        block: { Block, source: found.source, info: found.info },
    }
}

const sections = reactive(() => {
    const text = source ?? ''
    const settings: Settings = {
        schemes: schemes ?? SCHEMES,
        headingLevel: headingLevel ?? 1,
        href,
        references: referencesOf(text),
        blocks: {},
    }
    if (
        closedSettings === undefined ||
        closedSettings.schemes.join() !== settings.schemes.join() ||
        closedSettings.headingLevel !== settings.headingLevel ||
        closedSettings.href !== settings.href ||
        // 52.41 — a definition landing later names links in sections already rendered.
        !sameReferences(closedSettings.references, settings.references) ||
        !text.startsWith(closedSource)
    ) {
        closed = []
        closedSource = ''
        open = undefined
    }
    closedSettings = settings
    let at = closedSource.length
    let end = sectionEnd(text, at)
    while (end < text.length) {
        closed.push(sectionOf(text.slice(at, end), settings))
        at = end
        end = sectionEnd(text, at)
    }
    closedSource = text.slice(0, at)
    const shown = closed.slice()
    if (at < text.length) {
        open = sectionOf(text.slice(at), settings)
        shown.push(open)
    }
    return shown
})

function sameReferences(
    held: ReadonlyMap<string, string>,
    now: ReadonlyMap<string, string>,
): boolean {
    if (held.size !== now.size) return false
    for (const [label, url] of now) if (held.get(label) !== url) return false
    return true
}
</script>

<div {...rest}>
    <!-- Keyed by the section itself: a closed section is the same object chunk after chunk. With
    no `blocks`, a section is its markup alone, with no branch's anchors around it. A block's
    component is bound by a `for` of one, the binding a `<Name/>` renders by. -->
    {#if blocks === undefined}
        {#for section of sections by section}{raw(section.html)}{/for}
    {:else}
        {#for section of sections by section}{#if section.block}{#for Block of [section.block.Block] by Block}<Block source={section.block.source} info={section.block.info} />{/for}{:else}{raw(section.html)}{/if}{/for}
    {/if}
</div>
