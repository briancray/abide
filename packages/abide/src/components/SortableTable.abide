<script generics="Row">
// 49.9, 51.45-51.60, 51.79-51.83 — `sortableTable`'s default markup: a header per column with a sort
// button, a row per row with a cell per column, a checkbox column while `selected` is given, and a
// detail row where `Detail` is. Everything it does is the parts'; an app wanting its own cells spreads them.
import type { Attributes } from '#shared/Attributes.ts'
import type { Column } from '#shared/Column.ts'
import { props } from '#shared/props.ts'
import { reactiveOver } from '#shared/reactiveOver.ts'
import type { Sort } from '#shared/Sort.ts'
import { sortableTable } from '#shared/sortableTable.ts'

const {
    rows,
    columns,
    key,
    sort,
    selected,
    Cell,
    Detail,
    rowAttributes,
    ...rest
} = props<
    {
        /** The rows, in the order they show while no column is sorted. */
        rows: readonly Row[]
        /** The columns, left to right: what each header says, sorts by and shows. */
        columns: readonly Column<Row>[]
        /** What tells one row from another, so a re-sort moves each row rather than rewriting it. */
        key(row: Row): string
        /** The column sorted by and its direction, or none; bind it to read and set the sort. */
        sort?: Sort | undefined
        /** The keys of the rows selected, where rows can be: a checkbox column leads the table while it is given. Bind it to read and set the selection (51.79). */
        selected?: readonly string[] | undefined
        /** Renders a cell's content in place of its text, handed the row, the column and the text. */
        Cell?(props: { row: Row; column: Column<Row>; text: string }): unknown
        /** Renders a row of its own under each row, spanning every column: what the row expands to. */
        Detail?(props: { row: Row }): unknown
        /** 51.60 — the attributes each row's `<tr>` carries, handed the row: a `class`, a `data-` state, an `onclick`. */
        rowAttributes?(row: Row): Attributes<'tr'>
    } & Attributes<'table'>
>()

const table = sortableTable({
    rows: () => rows,
    columns: () => columns,
    // An accessor, so a function prop that changes reaches the parts (49.13).
    get key() {
        return key
    },
    sort: reactiveOver(
        () => sort,
        (next) => {
            sort = next
        },
    ),
    selected: reactiveOver(
        () => selected,
        (next) => {
            selected = next
        },
    ),
})
</script>

<table {...rest} {...table.table}>
    <thead>
        <tr>
            {#if selected !== undefined}
                <th {...table.selectAll.select}><input {...table.selectAll.checkbox}></th>
            {/if}
            {#for column of columns by column.key}
                <th {...table.column(column).header}>
                    {#if column.sortable === false}
                        {column.label}
                    {:else}
                        <button {...table.column(column).sort}>{column.label}</button>
                    {/if}
                </th>
            {/for}
        </tr>
    </thead>
    <tbody>
        {#for row of table.rows by key(row)}
            <tr {...rowAttributes?.(row)} {...table.row(row).row}>
                {#if selected !== undefined}
                    <td {...table.row(row).select}><input {...table.row(row).checkbox}></td>
                {/if}
                {#for column of columns by column.key}
                    <td {...table.column(column).cell}>
                        {#if Cell}
                            <Cell row={row} column={column} text={table.text(row, column)} />
                        {:else}
                            {table.text(row, column)}
                        {/if}
                    </td>
                {/for}
            </tr>
            {#if Detail}
                <tr {...table.row(row).detail}>
                    <td colspan={columns.length + (selected === undefined ? 0 : 1)}><Detail row={row} /></td>
                </tr>
            {/if}
        {/for}
    </tbody>
</table>
