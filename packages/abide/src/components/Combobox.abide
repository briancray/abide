<script generics="Item">
// 49.9, 51.13-51.29, 51.61-51.64 — `combobox`'s default markup: the chips picked where `value` is an
// array, the input, and the popup holding the list and the children shown where nothing matches.
// Everything it does is the parts'; an app wanting its own option or chip markup spreads them itself.
import type { Attributes } from '#shared/Attributes.ts'
import { combobox } from '#shared/combobox.ts'
import { props } from '#shared/props.ts'
import type { Reactive } from '#shared/reactive/index.ts'
import { reactiveOver } from '#shared/reactiveOver.ts'

const {
    id,
    options = [],
    search,
    debounce,
    key,
    label,
    value,
    Option,
    Chip,
    placeholder,
    ...rest
} = props<
    {
        /** The input's id, for a `<label for>`; the popup's and each option's ids are derived from it. */
        id: string
        /** The items to pick from, narrowed to those whose label holds what was typed. */
        options?: readonly Item[]
        /** Finds the items for what was typed, in place of narrowing `options`: a handler call, or any async function. */
        search?(
            query: string,
        ):
            | readonly Item[]
            | PromiseLike<readonly Item[]>
            | Reactive<readonly Item[], unknown, unknown, unknown>
        /** Milliseconds typing has to pause before `search` runs again. */
        debounce?: number
        /** What tells one item from another; unique among the items. */
        key(item: Item): string
        /** An item's text: what an option shows by default, and what the input holds once it is picked. */
        label(item: Item): string
        /**
         * The item picked; bind it to read and set the pick. 51.61 — bound to an array, every item
         * picked: a pick adds an item or takes it out again, and the list stays open.
         */
        value?: Item | undefined | readonly Item[]
        /** Renders an option's content in place of its label, handed the item. */
        Option?(props: { item: Item }): unknown
        /** 51.62 — renders an item picked, where `value` is an array, handed the item and what takes it out. */
        Chip?(props: { item: Item; remove: () => void }): unknown
        /** The input's placeholder. */
        placeholder?: string
    } & Omit<Attributes<'div'>, 'id'>
>()

const box = combobox({
    id,
    options: () => options,
    search,
    debounce,
    key,
    label,
    value: reactiveOver(
        () => value,
        (next) => {
            value = next
        },
    ),
})
</script>

<div {...rest} {...box.root}>
    {#if box.picks()}
        <span data-part="chips">
            {#for item of box.picks() ?? [] by key(item)}
                {#if Chip}
                    <Chip item={item} remove={() => box.unpick(item)} />
                {:else}
                    <span data-part="chip">{label(item)}<button {...box.remove(item)} data-part="remove">×</button></span>
                {/if}
            {/for}
        </span>
    {/if}
    <input {...box.input} placeholder={placeholder} data-part="input">
    {#if box.open()}
        <div {...box.popup} data-part="popup">
            <ul {...box.listbox} data-part="listbox">
                {#for item of box.items() by key(item)}
                    <li {...box.option(item)} data-part="option">
                        {#if Option}
                            <Option item={item} />
                        {:else}
                            {label(item)}
                        {/if}
                    </li>
                {/for}
            </ul>
            {#if box.nothingFound()}
                <div {...box.empty} data-part="empty"><slot /></div>
            {/if}
        </div>
    {/if}
</div>
