<script generics="Item">
import type { Attributes } from '#shared/Attributes.ts'
import { listbox } from '#shared/listbox.ts'
import { props } from '#shared/props.ts'
import { busy, type Reactive, reactive } from '#shared/reactive/index.ts'

const {
    id,
    options = [],
    search,
    debounce,
    key,
    label,
    value,
    Option,
    Chip,
    placeholder,
    ...rest
} = props<
    {
        /** The input's id, for a `<label for>`; the popup's and each option's ids are derived from it. */
        id: string
        /** The items to pick from, narrowed to those whose label holds what was typed. */
        options?: readonly Item[]
        /** Finds the items for what was typed, in place of narrowing `options`: a handler call, or any async function. */
        search?(
            query: string,
        ):
            | readonly Item[]
            | PromiseLike<readonly Item[]>
            | Reactive<readonly Item[], unknown, unknown, unknown>
        /** Milliseconds typing has to pause before `search` runs again. */
        debounce?: number
        /** What tells one item from another; unique among the items. */
        key(item: Item): string
        /** An item's text: what an option shows by default, and what the input holds once it is picked. */
        label(item: Item): string
        /**
         * The item picked; bind it to read and set the pick. 51.61 — bound to an array, every item
         * picked: a pick adds an item or takes it out again, and the list stays open.
         */
        value?: Item | undefined | readonly Item[]
        /** Renders an option's content in place of its label, handed the item. */
        Option?(props: { item: Item }): unknown
        /** 51.62 — renders an item picked, where `value` is an array, handed the item and what takes it out. */
        Chip?(props: { item: Item; remove: () => void }): unknown
        /** The input's placeholder. */
        placeholder?: string
    } & Omit<Attributes<'div'>, 'id'>
>()

// What was typed since the last pick; the input shows the pick's label while nothing has been.
let typed = reactive<string | undefined>(undefined)
// 51.61 — the items picked, where `value` is an array; `undefined` where it holds one item.
const picks = reactive((): readonly Item[] | undefined =>
    Array.isArray(value) ? (value as readonly Item[]) : undefined,
)
const query = reactive(() => {
    const text = typed
    const many = picks
    const one = value
    if (text !== undefined) return text
    return many !== undefined || one === undefined ? '' : label(one as Item)
})
let open = reactive(false)

const NOTHING: readonly Item[] = []

// Nothing is searched while the list is shut, and a search in flight keeps the last results listed.
const found = reactive(
    () => {
        if (!open) return NOTHING
        const text = query
        if (search !== undefined) return search(text)
        const lowered = text.toLowerCase()
        const kept: Item[] = []
        for (const item of options)
            if (label(item).toLowerCase().includes(lowered)) kept.push(item)
        return kept
    },
    debounce === undefined ? {} : { debounce },
)

const list = listbox({
    id,
    options: () => found,
    key,
    onpick: pick,
    onescape: dismiss,
})

function write(text: string) {
    typed = text
    open = true
}

function pick(item: Item) {
    typed = undefined
    const many = picks
    if (many === undefined) {
        value = item
        open = false
        return
    }
    const picked = key(item)
    const kept = many.filter((each) => key(each) !== picked)
    value = kept.length === many.length ? [...many, item] : kept
}

function remove(item: Item) {
    const removed = key(item)
    value = (picks ?? []).filter((each) => key(each) !== removed)
}

function dismiss() {
    if (open) open = false
    else {
        typed = undefined
        // 51.61 — what is picked into an array is taken out one at a time, never by Escape.
        if (picks === undefined) value = undefined
    }
}

function keydown(event: KeyboardEvent) {
    // Home and End move the caret in the text, not the active option.
    if (event.key === 'Home' || event.key === 'End') return
    // 51.28 — an Escape with nothing to shut or clear is left to whatever holds the input: a
    // `<dialog>` cancels only on an Escape no one prevented.
    if (event.key === 'Escape' && !open && query === '') return
    // 51.62 — Backspace in an empty input takes out the last item picked.
    if (event.key === 'Backspace' && query === '' && picks !== undefined) {
        const last = picks.at(-1)
        if (last !== undefined) remove(last)
        return
    }
    if (!open && (event.key === 'ArrowDown' || event.key === 'ArrowUp')) {
        event.preventDefault()
        open = true
        return
    }
    list.keydown(event)
}

const pickedKeys = reactive(() => {
    const many = picks
    const one = value
    const keys = new Set<string>()
    if (many !== undefined) for (const each of many) keys.add(key(each))
    else if (one !== undefined) keys.add(key(one as Item))
    return keys
})
</script>

<div {...rest} data-open={open ? '' : undefined} data-busy={open && busy(found) ? '' : undefined}>
    {#if picks}
        <span data-part="chips">
            {#for item of picks by key(item)}
                {#if Chip}
                    <Chip item={item} remove={() => remove(item)} />
                {:else}
                    <span data-part="chip">{label(item)}<button type="button"
                            data-part="remove" aria-label="Remove {label(item)}"
                            onclick={() => remove(item)}>×</button></span>
                {/if}
            {/for}
        </span>
    {/if}
    <input
        id={id}
        type="text"
        role="combobox"
        autocomplete="off"
        aria-autocomplete="list"
        aria-expanded={open ? 'true' : 'false'}
        aria-controls={`${id}-listbox`}
        aria-activedescendant={open ? list.activeId() : undefined}
        placeholder={placeholder}
        data-part="input"
        bind:value={{ get: () => query, set: write }}
        onkeydown={keydown}
        onblur={() => {
            open = false
        }}
    >
    {#if open}
        <ul id={`${id}-listbox`} role="listbox" data-part="listbox"
            aria-multiselectable={picks ? 'true' : undefined} onmousedown={(event) => event.preventDefault()}>
            {#for item of found by key(item)}
                <li
                    id={list.idOf(key(item))}
                    role="option"
                    aria-selected={list.active() === key(item) ? 'true' : 'false'}
                    data-part="option"
                    data-active={list.active() === key(item) ? '' : undefined}
                    data-selected={pickedKeys.has(key(item)) ? '' : undefined}
                    onpointermove={() => list.activate(key(item))}
                    onclick={() => pick(item)}
                >
                    {#if Option}
                        <Option item={item} />
                    {:else}
                        {label(item)}
                    {/if}
                </li>
            {/for}
        </ul>
        {#if !busy(found) && found.length === 0}
            <div role="status" data-part="empty"><slot /></div>
        {/if}
    {/if}
</div>
