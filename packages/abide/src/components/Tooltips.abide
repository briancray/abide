<script>
// 50.55 — WHERE `tooltip.tip` SHOWS, AT ITS PLAINEST: rendered once, in the root layout, as the one
// popover every hint on the page opens in. An app wanting more spreads `tooltip.host`'s part onto an
// element of its own.
import type { Attributes } from '#shared/Attributes.ts'
import { props } from '#shared/props.ts'
import { host } from '#shared/tooltip/host.ts'

const { ...rest } = props<Omit<Attributes<'span'>, 'popover' | 'role'>>()

const shown = host()
</script>

<span {...rest} {...shown.hint}>{shown.text}</span>
