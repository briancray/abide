<script>
// 49.9, 51.72-51.78 — `commandPalette`'s default markup: a `Dialog` holding the search input, the list
// of commands, each with its key shown beside it, and the component's children where nothing matches.
// Everything it does is the parts'; an app wanting other markup spreads them itself.
import type { Attributes } from '#shared/Attributes.ts'
import { type Command, commandPalette } from '#shared/commandPalette.ts'
import { keyLabel } from '#shared/keyLabel.ts'
import { props } from '#shared/props.ts'
import { reactiveOver } from '#shared/reactiveOver.ts'

import Dialog from './Dialog.abide'

const {
    commands,
    open = false,
    hotkey,
    id = 'command-palette',
    label,
    placeholder,
    ...rest
} = props<
    {
        /** What the palette can do, in the order it lists them, each told apart by its `label`. */
        commands: readonly Command[]
        /** Whether the palette is showing. Bind it to open it from a button of the app's own. */
        open?: boolean
        /** The binding that opens and closes it, as `hotkeys` reads one. `'mod+k'` by default. */
        hotkey?: string
        /** The base the input's, the list's and each option's ids are derived from. `'command-palette'` by default. */
        id?: string
        /** The palette's accessible name. `'Commands'` by default. */
        label?: string
        /** The input's placeholder. */
        placeholder?: string
    } & Omit<Attributes<'dialog'>, 'open' | 'id'>
>()

const palette = commandPalette({
    commands: () => commands,
    open: reactiveOver(
        () => open,
        (next) => {
            open = next
        },
    ),
    hotkey,
    id,
    label,
})
</script>

<Dialog {...rest} {...palette.dialog} bind:open={open}>
    <input {...palette.input} placeholder={placeholder} data-part="input">
    <ul {...palette.listbox} data-part="listbox">
        {#for command of palette.results() by command.label}
            <li {...palette.option(command)} data-part="option">
                <span data-part="label">{command.label}</span>
                {#if command.key}
                    <kbd data-part="key">{keyLabel(command.key)}</kbd>
                {/if}
            </li>
        {/for}
    </ul>
    {#if palette.results().length === 0}
        <div {...palette.empty} data-part="empty"><slot /></div>
    {/if}
</Dialog>
