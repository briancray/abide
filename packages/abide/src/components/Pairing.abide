<script>
// The visitor's Claude Code paired with this page through `pairing` (44.69): connecting, the command
// and the click that pair a bridge, the install where no bridge app opened, and once paired, what the
// caller put inside it. 53.42 — the step is the root's `data-step`.
//
// STYLED BY WHAT IT WRITES (49.2, 49.4): `data-step` on the root, and the `data-pairing` parts `message`,
// `command`, `copy` (`data-copied`), `pair`, `retry` and `missing`.
import type { Attributes } from '#shared/Attributes.ts'
import { copy } from '#shared/copy.ts'
import { isServer } from '#shared/isServer.ts'
import { online } from '#shared/online.ts'
import { pairing } from '#shared/pairing.ts'
import { props } from '#shared/props.ts'
import { reactive, watch } from '#shared/reactive/index.ts'

type Step =
    | 'connecting'
    | 'slow'
    | 'offline'
    | 'unavailable'
    | 'click'
    | 'waiting'
    | 'install'
    | 'paired'

const {
    slowAfter = 8000,
    Message,
    ...rest
} = props<
    {
        /** 53.50 — milliseconds of connecting before the step is `slow`, offering to try again. Default `8000`. */
        slowAfter?: number
        /** 53.52 — renders a step's message in place of its own words, handed the step. */
        Message?(props: { step: Step }): unknown
    } & Attributes<'section'>
>()

const { status, step, copied, start, retry: askAgain, copyInstall } = pairing()

// 53.50 — connecting for longer than `slowAfter`.
let slow = reactive(false)
watch(() => {
    const connecting = status === undefined && !status.error()
    if (!connecting || isServer()) {
        slow = false
        return
    }
    const timer = setTimeout(() => {
        slow = true
    }, slowAfter)
    return () => clearTimeout(timer)
})

const shown = reactive((): Step => {
    const reachable = online
    const failed = status.error()
    const value = status
    const late = slow
    const asked = step
    // 53.51 — no network is said before anything else, since nothing below it can change until it returns.
    if (!reachable) return 'offline'
    if (failed) return 'unavailable'
    if (value === undefined) return late ? 'slow' : 'connecting'
    if (value.paired) return 'paired'
    return asked
})

const WORDS: Record<Step, string> = {
    connecting: 'Connecting…',
    slow: 'Still connecting to Claude Code.',
    offline: 'You are offline. Pairing resumes once you are back.',
    unavailable: 'Claude Code is unavailable here.',
    click: 'Pair your Claude Code with this page with a click, or run this in a terminal:',
    waiting:
        'Pair your Claude Code with this page with a click, or run this in a terminal:',
    install:
        'No bridge app opened. Install it once, in a terminal, then pair again:',
    paired: '',
}

function retry() {
    slow = false
    askAgain()
}

const command = () => status.peek()?.command ?? ''
</script>

<section {...rest} data-step={shown}>
    {#if shown !== 'paired'}
        <p data-pairing="message">{#if Message}<Message step={shown} />{:else}{WORDS[shown]}{/if}</p>
    {/if}
    {#if shown === 'slow'}
        <button type="button" data-pairing="retry" onclick={retry}>Try again</button>
    {:else if shown === 'paired'}
        {#if status?.missing.length}
            <p data-pairing="missing">Claude Code here cannot use
                {status.missing.join(', ')}.</p>
        {/if}
        <slot />
        <button type="button" data-pairing="pair" onclick={start}>Reconnect</button>
    {:else if shown === 'install'}
        <pre data-pairing="command">{status?.install}</pre>
        <button type="button" data-pairing="copy"
            data-copied={copied ? '' : undefined}
            onclick={copyInstall}>{copied ? 'Copied' : 'Copy'}</button>
        <button type="button" data-pairing="pair" onclick={start}>Pair again</button>
    {:else if shown === 'click' || shown === 'waiting'}
        <pre data-pairing="command">{status?.command}</pre>
        <button type="button" data-pairing="copy"
            {...copy({ value: command })}>Copy</button>
        <button type="button" data-pairing="pair" disabled={shown === 'waiting'}
            onclick={start}>
            {shown === 'waiting' ? 'Pairing…' : 'Pair with a click'}</button>
    {/if}
</section>
