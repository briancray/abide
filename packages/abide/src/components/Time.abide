<script>
// 52.73-52.78 — A TIME THAT STAYS CURRENT: how long ago or how soon it is, as `format.relative` writes
// it, in a `<time>` whose `datetime` a machine reads and whose `title` is the date in full. Every
// `Time` on the page is ticked by one clock, at the moment its label next reads differently.
import type { Attributes } from '#shared/Attributes.ts'
import { clock, follow } from '#shared/clock.ts'
import { date, relative } from '#shared/format/index.ts'
import { instant } from '#shared/format/instant.ts'
import { props } from '#shared/props.ts'
import { reactive, watch } from '#shared/reactive/index.ts'

const {
    value,
    style = 'long',
    locale,
    timeZone,
    ...rest
} = props<
    {
        /** The time: a `Date`, epoch milliseconds or an ISO string. */
        value: unknown
        /** `'long'` (`12 minutes ago`), `'short'` (`12 min. ago`) or `'narrow'` (`12m ago`). `'long'` by default. */
        style?: 'long' | 'short' | 'narrow'
        /** The BCP 47 locale it is written in. `'en-US'` by default. */
        locale?: string
        /** The zone its `title` writes the date in, as `format.date` takes one. */
        timeZone?: string
    } & Omit<Attributes<'time'>, 'datetime' | 'title'>
>()

const time = reactive(() => instant(value))

// 52.74 — followed for as long as it stands, so the one clock ticks when this label next changes.
watch(() => {
    const at = time
    return at === undefined ? undefined : follow(at)
})
</script>

<time
    {...rest}
    datetime={time === undefined ? undefined : new Date(time).toISOString()}
    title={time === undefined
        ? undefined
        : date(time, { style: 'dateTime', timeZone, locale })}
>{relative(time, { now: clock(), style, locale })}</time>
