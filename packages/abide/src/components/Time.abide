<script>
// 49.9, 52.73-52.78 — `time`'s default markup: a `<time>` holding the label. Everything it does is the
// parts'; an app wanting other markup spreads them itself.
import type { Attributes } from '#shared/Attributes.ts'
import { props } from '#shared/props.ts'
import { time } from '#shared/time.ts'

const {
    value,
    style = 'long',
    locale,
    timeZone,
    ...rest
} = props<
    {
        /** The time: a `Date`, epoch milliseconds or an ISO string. */
        value: unknown
        /** `'long'` (`12 minutes ago`), `'short'` (`12 min. ago`) or `'narrow'` (`12m ago`). `'long'` by default. */
        style?: 'long' | 'short' | 'narrow'
        /** The BCP 47 locale it is written in. `'en-US'` by default. */
        locale?: string
        /** The zone its `title` writes the date in, as `format.date` takes one. */
        timeZone?: string
    } & Omit<Attributes<'time'>, 'datetime' | 'title'>
>()

const parts = time({
    style: () => style,
    locale: () => locale,
    timeZone: () => timeZone,
})
</script>

<time {...rest} {...parts.time(value)}>{parts.text(value)}</time>
