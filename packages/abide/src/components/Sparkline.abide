<script>
// 49.9 — `sparkline`'s default markup: the line, or the bars, an area under the line where `area` is
// set and a dot at the last value where `dot` is. Everything it draws is the parts'; an app wanting
// other markup spreads them itself.
import type { Attributes } from '#shared/Attributes.ts'
import { sparkline } from '#shared/chart/sparkline.ts'
import { props } from '#shared/props.ts'

const {
    values,
    label,
    area = false,
    dot = false,
    zero = false,
    kind = 'line',
    ...rest
} = props<
    {
        /** The values in order, drawn left to right. `null` or `undefined` leaves a gap. */
        values: readonly (number | null | undefined)[]
        /** What the trend shows, as the image's accessible name: `'Won revenue, last 6 months'`. */
        label: string
        /** Whether to fill under the line, as `data-sparkline="area"`. `false` by default. */
        area?: boolean
        /** Whether to mark the last value, as `data-sparkline="dot"`. `false` by default. */
        dot?: boolean
        /** Whether the range takes in zero, so a run of zeroes lies along the bottom. `false` by default. */
        zero?: boolean
        /** 52.33 — `'bar'` draws each value as a bar up from zero, as `data-sparkline="bar"`, in place of the line: a count. `'line'` by default. */
        kind?: 'line' | 'bar'
    } & Omit<Attributes<'svg'>, 'values'>
>()

const trend = sparkline({
    values: () => values,
    label: () => label,
    zero: () => zero,
    kind: () => kind,
})
</script>

<svg {...rest} {...trend.svg}>
    {#if kind === 'bar'}
        <path {...trend.bars} />
    {:else if area}
        <path {...trend.area} />
    {/if}
    {#if kind === 'line'}
        <path {...trend.line} />
    {/if}
    {#if kind === 'line' && dot && trend.ended}
        <path {...trend.dot} />
    {/if}
</svg>
