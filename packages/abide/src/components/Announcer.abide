<script module>
// 50.50, 34.33 — THE CALL THAT GIVES THIS COMPONENT ITS MESSAGE, imported beside it from its own entry.
import { announce, type AnnounceOptions } from '#shared/announce.ts'

export { announce }
export type { AnnounceOptions }
</script>

<script>
import { announcers, said } from '#shared/announce.ts'
// 50.52, 50.53 — WHERE `announce` IS READ OUT: rendered once, in the root layout, as a polite and an
// assertive live region, both standing empty from the first paint — a region added together with its
// words is not read. Nothing it holds is meant to be seen: hide it with the app's own class.
import type { Attributes } from '#shared/Attributes.ts'
import { props } from '#shared/props.ts'

const { ...rest } = props<Attributes<'div'>>()

// 50.36 — this host, among the ones standing; the last holds the message.
const shows = announcers.stand()
</script>

<div {...rest}>
    <div role="status" aria-live="polite" data-part="polite">
        {#for message of shows() && said?.politeness === 'polite' ? [said] : [] by message.count}
            <span>{message.text}</span>
        {/for}
    </div>
    <div role="alert" aria-live="assertive" data-part="assertive">
        {#for message of shows() && said?.politeness === 'assertive' ? [said] : [] by message.count}
            <span>{message.text}</span>
        {/for}
    </div>
</div>
