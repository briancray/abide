<script module>
// 50.5, 34.33 — THE CALLS THAT QUEUE WHAT THIS COMPONENT SHOWS, imported beside it from its own entry.
import * as prompts from '#shared/prompts/index.ts'
import type { PromptOptions } from '#shared/prompts/queue.ts'

export { prompts }
export type { PromptOptions }
</script>

<script>
// 49.9, 50.6, 50.8-50.10, 50.34 — `prompts.host`'s default markup: a `<dialog>` holding the prompt's
// title, its body, a field where it asks for text, the error its `run` failed with, and its buttons.
// Everything it does is the parts'; an app wanting other markup spreads them itself.
import type { Attributes } from '#shared/Attributes.ts'
import { host } from '#shared/prompts/host.ts'
import { props } from '#shared/props.ts'

const { ...rest } =
    props<Omit<Attributes<'dialog'>, 'open' | 'onclose' | 'role'>>()

const asked = host()
</script>

<dialog {...rest} {...asked.dialog}>
    {#if asked.current}
        <form {...asked.form}>
            {#if asked.current?.title}
                <h2 {...asked.title}>{asked.current?.title}</h2>
            {/if}
            {#if asked.current?.body}
                <p {...asked.body}>{asked.current?.body}</p>
            {/if}
            {#if asked.typing}
                <label {...asked.field}>
                    {#if asked.current?.mustType !== undefined}
                        Type {asked.current?.mustType} to confirm
                    {/if}
                    <input {...asked.input}>
                </label>
            {/if}
            {#if asked.failed !== undefined}
                <p {...asked.error}>{asked.failed}</p>
            {/if}
            <div {...asked.actions}>
                <button {...asked.confirm}>{asked.current?.confirm}</button>
                {#if asked.current?.kind !== 'alert'}
                    <button {...asked.cancel}>{asked.current?.cancel}</button>
                {/if}
            </div>
        </form>
    {/if}
</dialog>
