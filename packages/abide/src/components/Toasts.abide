<script module>
// 50.12, 34.33 — THE CALLS THAT RAISE WHAT THIS COMPONENT SHOWS, imported beside it from its own entry.
import * as toasts from '#shared/toasts/index.ts'
import type { Toast } from '#shared/toasts/list.ts'
import type { NotifyOptions } from '#shared/toasts/notify.ts'

export { toasts }
export type { NotifyOptions, Toast }
</script>

<script>
// 49.9, 50.17, 50.18 — `toasts.host`'s default markup: the live region, and per notice its text, its
// action and a close button, or the `Toast` component's content in their place. Everything it does is
// the parts'; an app wanting other markup spreads them itself.
import type { Attributes } from '#shared/Attributes.ts'
import { props } from '#shared/props.ts'
import { dismiss } from '#shared/toasts/dismiss.ts'
import { host } from '#shared/toasts/host.ts'
// Named apart from the `Toast` prop: a type annotation naming a prop is read as the prop.
import type { Toast as Notice } from '#shared/toasts/list.ts'

const {
    label = 'Notices',
    Toast,
    ...rest
} = props<
    {
        /** The region's accessible name. Default `'Notices'`. */
        label?: string
        /**
         * 50.46 — renders a notice's content in place of its text, action and close button, handed
         * the notice, what dismisses it and what runs its action. An element in it whose
         * `bind:element` hands back `element.animate(…).finished` keeps the notice until it ends (32.38).
         */
        Toast?(props: {
            toast: Notice
            dismiss: () => void
            act: () => void
        }): unknown
    } & Omit<Attributes<'div'>, 'role'>
>()

const shown = host({ label: () => label })
</script>

<div {...rest} {...shown.region}>
    {#for toast of shown.notices by toast.id}
        <div {...shown.toast(toast).toast}>
            {#if Toast}
                <Toast toast={toast} dismiss={() => dismiss(toast.id)} act={shown.toast(toast).act} />
            {:else}
                <span {...shown.toast(toast).text}>{toast.text}</span>
                {#if toast.action}
                    <button {...shown.toast(toast).action}>{toast.action.label}</button>
                {/if}
                <button {...shown.toast(toast).close}>×</button>
            {/if}
        </div>
    {/for}
</div>
