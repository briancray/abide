<script module>
// 50.12, 34.33 — THE CALLS THAT RAISE WHAT THIS COMPONENT SHOWS, imported beside it from its own entry.
import * as toasts from '#shared/toasts/index.ts'
import type { Toast } from '#shared/toasts/list.ts'
import type { NotifyOptions } from '#shared/toasts/notify.ts'

export { toasts }
export type { NotifyOptions, Toast }
</script>

<script>
// 50.17, 50.18 — WHERE `toasts.notify` SHOWS: rendered once, in the root layout, as the live region
// every notice is read out from as it lands.
import type { Attributes } from '#shared/Attributes.ts'
import { props } from '#shared/props.ts'
import { close, dismiss } from '#shared/toasts/dismiss.ts'
// Named apart from the `Toast` prop: a type annotation naming a prop is read as the prop.
import { list, notices, type Toast as Notice } from '#shared/toasts/list.ts'

const {
    label = 'Notices',
    Toast,
    ...rest
} = props<
    {
        /** The region's accessible name. Default `'Notices'`. */
        label?: string
        /**
         * 50.46 — renders a notice's content in place of its text, action and close button, handed
         * the notice, what dismisses it and what runs its action. An element in it whose
         * `bind:element` hands back `element.animate(…).finished` keeps the notice until it ends (32.38).
         */
        Toast?(props: {
            toast: Notice
            dismiss: () => void
            act: () => void
        }): unknown
    } & Omit<Attributes<'div'>, 'role'>
>()

// 50.36 — this host, among the ones standing; the last renders the notices.
const shows = notices.stand()

function act(toast: Notice) {
    close(toast.id, 'action')
    toast.action?.run()
}
</script>

<div {...rest} role="status" aria-live="polite" aria-label={label}>
    {#for toast of shows() ? list : [] by toast.id}
        <div {...toast.attributes} data-part="toast" data-tone={toast.tone}>
            {#if Toast}
                <Toast toast={toast} dismiss={() => dismiss(toast.id)} act={() => act(toast)} />
            {:else}
                <span data-part="text">{toast.text}</span>
                {#if toast.action}
                    <button type="button" data-part="action" onclick={() => act(toast)}>{toast.action.label}</button>
                {/if}
                <button
                    type="button"
                    data-part="close"
                    aria-label="Dismiss"
                    onclick={() => dismiss(toast.id)}
                >×</button>
            {/if}
        </div>
    {/for}
</div>
