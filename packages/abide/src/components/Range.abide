<script>
// 51.92-51.98 — A RANGE BETWEEN TWO THUMBS, which the native `<input type="range">` cannot hold:
// WAI-ARIA's multi-thumb slider. Each thumb is a scrub along the track (`scrub`) that keeps to its own
// side of the other, so the arrows, Home and End are the crosshair's, and the pointer takes the thumb
// nearer it and drags it while held.
import type { Attributes } from '#shared/Attributes.ts'
import { number } from '#shared/format/index.ts'
import { props } from '#shared/props.ts'
import { randomToken } from '#shared/randomToken.ts'
import { reactive } from '#shared/reactive/index.ts'
import { scrub, type ScrubPosition } from '#shared/scrub.ts'

const {
    value,
    label,
    min = 0,
    max = 100,
    step = 1,
    labels = ['Minimum', 'Maximum'],
    format = (each: number) => number(each),
    name,
    ...rest
} = props<
    {
        /** The low and the high end of the range picked. Bind it to read and set the range. */
        value: readonly [number, number]
        /** What the range is of, as the group's accessible name: `'Deal amount'`. */
        label: string
        /** The least value. 0 by default. */
        min?: number
        /** The greatest value. 100 by default. */
        max?: number
        /** How far apart the values a thumb stops at are, from `min`. 1 by default. */
        step?: number
        /** Each thumb's accessible name, low then high. `['Minimum', 'Maximum']` by default. */
        labels?: readonly [string, string]
        /** Writes a value for the thumb's `aria-valuetext`: `format.money`, say. `format.number` by default. */
        format?: (value: number) => string
        /** Submits each end with a form as a field of this name, low then high (51.98). */
        name?: string
    } & Omit<Attributes<'div'>, 'role'>
>()

// The values a thumb stops at, by index from `min`.
const last = reactive(() => Math.max(0, Math.floor((max - min) / step)))
const indexOf = (each: number) =>
    Math.min(last, Math.max(0, Math.round((each - min) / step)))
const valueOf = (index: number) => min + index * step
// 51.97 — where a value stands along the track, as the share of its width a thumb's `left` is.
const percent = (each: number) =>
    `${max === min ? 0 : ((each - min) / (max - min)) * 100}%`

// 51.93 — a thumb stops at the other: the low one at most at the high, the high one at least at the low.
function thumb(which: 0 | 1): ScrubPosition {
    return {
        peek: () => indexOf(value[which]),
        set(index) {
            const [low, high] = value
            if (which === 0)
                value = [
                    valueOf(Math.min(Math.max(index, 0), indexOf(high))),
                    high,
                ]
            else
                value = [
                    low,
                    valueOf(Math.max(Math.min(index, last), indexOf(low))),
                ]
        },
    }
}
const thumbs = [thumb(0), thumb(1)] as const
const axis = {
    count: () => last + 1,
    nearest: (fraction: number) =>
        Math.round(Math.min(1, Math.max(0, fraction)) * last),
}
const scrubs = [scrub(thumbs[0], axis), scrub(thumbs[1], axis)] as const

// The thumb a held pointer drags, or -1 while none is held.
let dragging = reactive(-1)

// 51.95 — the pointer takes the thumb nearer it, the high one where the two stand together and it is
// above them, and holds it until it lets go.
function press(event: PointerEvent) {
    const index = scrubs[0].indexAt(event)
    if (index === undefined) return
    // The press's own focusing would take focus back off the thumb it focuses, and select text as it drags.
    event.preventDefault()
    const [low, high] = [indexOf(value[0]), indexOf(value[1])]
    const which =
        Math.abs(index - low) < Math.abs(index - high) ||
        (low === high && index < low)
            ? 0
            : 1
    dragging = which
    ;(event.currentTarget as Element).setPointerCapture?.(event.pointerId)
    scrubs[which].move(event)
    document.getElementById(thumbId(which))?.focus()
}

function drag(event: PointerEvent) {
    if (dragging === -1) return
    scrubs[dragging as 0 | 1].move(event)
}

// 51.94 — Up and Right step up, Down and Left step down, Page Up and Page Down a tenth of the way.
function key(which: 0 | 1, event: KeyboardEvent) {
    const at = thumbs[which].peek() ?? 0
    const big = Math.max(1, Math.round(last / 10))
    const by =
        event.key === 'ArrowUp'
            ? 1
            : event.key === 'ArrowDown'
              ? -1
              : event.key === 'PageUp'
                ? big
                : event.key === 'PageDown'
                  ? -big
                  : 0
    if (by === 0) return scrubs[which].key(event)
    event.preventDefault()
    thumbs[which].set(at + by)
}

// Hydration runs setup again (41.6), and every attribute naming one is bound to it, so the ids are
// rewritten together.
const base = `range-${randomToken(4, 'hex')}`
const thumbId = (which: number) => `${base}-${which}`
const BOTH = [0, 1] as const
</script>

<div {...rest} role="group" aria-label={label} data-dragging={dragging === -1 ? undefined : ''}>
    <div
        data-part="track"
        onpointerdown={press}
        onpointermove={drag}
        onpointerup={() => (dragging = -1)}
        onlostpointercapture={() => (dragging = -1)}
    >
        <div data-part="fill" style:left={percent(value[0])} style:right={percent(max - value[1] + min)} />
        {#for which of BOTH by which}
            <span
                id={thumbId(which)}
                role="slider"
                tabindex="0"
                data-part="thumb"
                data-thumb={which === 0 ? 'low' : 'high'}
                aria-label={labels[which]}
                aria-valuemin={which === 0 ? min : value[0]}
                aria-valuemax={which === 0 ? value[1] : max}
                aria-valuenow={value[which]}
                aria-valuetext={format(value[which])}
                aria-orientation="horizontal"
                style:left={percent(value[which])}
                onkeydown={(event) => key(which, event)}
             />
        {/for}
    </div>
    {#if name !== undefined}
        <input type="hidden" name={name} value={value[0]}>
        <input type="hidden" name={name} value={value[1]}>
    {/if}
</div>
