<script>
// 49.9, 51.92-51.98 — `range`'s default markup: a group holding a track, the span between the thumbs
// and the two thumbs, and a hidden field per end where `name` is given. Everything it does is the
// parts'; an app wanting other markup spreads them itself.
import type { Attributes } from '#shared/Attributes.ts'
import { props } from '#shared/props.ts'
import { range } from '#shared/range.ts'
import { reactiveOver } from '#shared/reactiveOver.ts'

const {
    value,
    label,
    min = 0,
    max = 100,
    step = 1,
    labels,
    format,
    name,
    ...rest
} = props<
    {
        /** The low and the high end of the range picked. Bind it to read and set the range. */
        value: readonly [number, number]
        /** What the range is of, as the group's accessible name: `'Deal amount'`. */
        label: string
        /** The least value. 0 by default. */
        min?: number
        /** The greatest value. 100 by default. */
        max?: number
        /** How far apart the values a thumb stops at are, from `min`. 1 by default. */
        step?: number
        /** Each thumb's accessible name, low then high. `['Minimum', 'Maximum']` by default. */
        labels?: readonly [string, string]
        /** Writes a value for the thumb's `aria-valuetext`: `format.money`, say. `format.number` by default. */
        format?: (value: number) => string
        /** Submits each end with a form as a field of this name, low then high (51.98). */
        name?: string
    } & Omit<Attributes<'div'>, 'role'>
>()

const parts = range({
    value: reactiveOver(
        () => value,
        (next) => {
            value = next
        },
    ),
    label: () => label,
    min: () => min,
    max: () => max,
    step: () => step,
    labels,
    format,
    name,
})
</script>

<div {...rest} {...parts.root}>
    <div data-part="track" {...parts.track}>
        <div data-part="fill" {...parts.fill} />
        <span data-part="thumb" {...parts.thumb(0)} />
        <span data-part="thumb" {...parts.thumb(1)} />
    </div>
    {#if name !== undefined}
        <input {...parts.input(0)}>
        <input {...parts.input(1)}>
    {/if}
</div>
