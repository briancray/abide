<script generics="Item">
import type { Attributes } from '#shared/Attributes.ts'
import { props } from '#shared/props.ts'
import { reactive } from '#shared/reactive/index.ts'

const { id, tabs, key, label, selected, Tab, ...rest } = props<
    {
        /** The root's id; each tab's id and the panel's are derived from it, so it is unique on the page. */
        id: string
        /** The tabs, in the order they render. */
        tabs: readonly Item[]
        /** What tells one tab from another: the value `selected` holds, and the base of the tab's id. */
        key(item: Item): string
        /** A tab's text, where `Tab` is not given; the tab's key where this is not given either. */
        label?(item: Item): string
        /** The selected tab's key, the first tab's until one is picked; bind it to read and set the pick. */
        selected?: string | undefined
        /** Renders a tab's content in place of its label, handed the tab's item: an icon beside a name. */
        Tab?(props: { item: Item }): unknown
    } & Omit<Attributes<'div'>, 'id'>
>()

// A key no tab has selects the first.
const current = reactive(() => {
    for (const item of tabs) if (key(item) === selected) return selected
    return tabs[0] === undefined ? undefined : key(tabs[0])
})

const tabId = (each: string) => `${id}-tab-${encodeURIComponent(each)}`

function select(each: string) {
    selected = each
    globalThis.document?.getElementById(tabId(each))?.focus()
}

function keydown(event: KeyboardEvent) {
    const last = tabs.length - 1
    let at = 0
    for (let index = 0; index <= last; index += 1)
        if (key(tabs[index] as Item) === current) at = index
    let next: number
    switch (event.key) {
        case 'ArrowRight':
            next = at === last ? 0 : at + 1
            break
        case 'ArrowLeft':
            next = at === 0 ? last : at - 1
            break
        case 'Home':
            next = 0
            break
        case 'End':
            next = last
            break
        default:
            return
    }
    const item = tabs[next]
    if (item === undefined) return
    event.preventDefault()
    select(key(item))
}
</script>

<div {...rest} id={id}>
    <div role="tablist" data-part="tablist" onkeydown={keydown}>
        {#for item of tabs by key(item)}
            <button
                type="button"
                role="tab"
                id={tabId(key(item))}
                aria-selected={current === key(item) ? 'true' : 'false'}
                aria-controls={`${id}-panel`}
                tabindex={current === key(item) ? 0 : -1}
                data-part="tab"
                data-selected={current === key(item) ? '' : undefined}
                onclick={() => select(key(item))}
            >
                {#if Tab}
                    <Tab item={item} />
                {:else}
                    {label === undefined ? key(item) : label(item)}
                {/if}
            </button>
        {/for}
    </div>
    <div
        role="tabpanel"
        id={`${id}-panel`}
        aria-labelledby={current === undefined ? undefined : tabId(current)}
        tabindex="0"
        data-part="panel"
    ><slot /></div>
</div>
