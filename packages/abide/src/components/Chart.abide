<script>
// 49.9 — `chart`'s default markup: the gridlines and their labels, the x labels, every series' mark in
// order, and the crosshair with its points and its readout while it stands. Everything it draws and
// does is the parts'; an app wanting other markup — a dot at every point, a label on every bar — spreads
// them itself. Its `Line`, `Column` and `Area` children are the series it hands the parts.
import type { Attributes } from '#shared/Attributes.ts'
import { chart } from '#shared/chart/chart.ts'
import type { ChartChild } from '#shared/chart/children.ts'
import { props } from '#shared/props.ts'
import { reactive } from '#shared/reactive/index.ts'

const {
    label,
    x,
    xFormat,
    yFormat,
    xTicks = 5,
    yTicks = 4,
    zero = false,
    stack = false,
    normalize = false,
    bounds,
    width = 600,
    height = 240,
    onpick,
    disabled,
    ...rest
} = props<
    {
        /** What the chart shows, as its accessible name: `'Won revenue by month'`. */
        label: string
        /** The x of each position, ascending: a time in epoch milliseconds, say. Indices by default. */
        x?: readonly number[]
        /** Writes an x for its tick and the readout: `format.date`, say. `format.number` by default. */
        xFormat?: (x: number) => string
        /** Writes a value for the y ticks and the readout: `format.money`, say. `format.number` by default. */
        yFormat?: (y: number) => string
        /** The most x positions labeled under the plot. 5 by default. */
        xTicks?: number
        /** About how many intervals the y gridlines divide the range into. 4 by default. */
        yTicks?: number
        /** Whether the y range takes in zero, with a line drawn there as `data-part="zero"`. `false` by default. */
        zero?: boolean
        /** Whether a child with no `stack` of its own piles into one stack with the others (52.55). `false` by default. */
        stack?: boolean
        /** Whether each stack is drawn as shares of its total at each x, its y ticks as percentages (52.57, 52.60). Stacks as `stack` does. `false` by default. */
        normalize?: boolean
        /** The range each axis spans, in place of the range of the values (52.62). */
        bounds?: {
            x?: readonly [number, number]
            y?: readonly [number, number]
        }
        /** The width drawn at before the chart is measured, and where nothing sizes it. 600 by default. */
        width?: number
        /** The height drawn at before the chart is measured, and where nothing sizes it. 240 by default. */
        height?: number
        /** Called with the x position nearest a click on the plot, where `disabled` does not hold for it (52.38). */
        onpick?: (index: number) => void
        /** Whether an x position takes no pick, written as `data-disabled` on its columns and the readout (52.39). */
        disabled?: (index: number) => boolean
    } & Omit<Attributes<'svg'>, 'x' | 'width' | 'height'>
>()

// The children's series, shared from here where the compiler sees the call and opens its scope (10.5).
const children = reactive.share('abide:chart', () =>
    reactive<readonly ChartChild[]>([]),
)

// The function props as accessors, so one that arrives or changes after mount reaches the chart (33.5).
const plot = chart({
    label: () => label,
    series: () => children.map((child) => child.series()),
    x: () => x,
    get xFormat() {
        return xFormat
    },
    get yFormat() {
        return yFormat
    },
    xTicks: () => xTicks,
    yTicks: () => yTicks,
    zero: () => zero,
    stack: () => stack,
    normalize: () => normalize,
    bounds: () => bounds,
    width,
    height,
    get onpick() {
        return onpick
    },
    get disabled() {
        return disabled
    },
})
</script>

<svg {...rest} {...plot.svg}>
    <slot />
    {#for tick of plot.yTicks}
        <line {...tick.grid} />
        <text {...tick.text}>{tick.label}</text>
    {/for}
    {#if plot.zero}
        <line {...plot.zero?.line} />
    {/if}
    {#for tick of plot.xTicks}
        <text {...tick.text}>{tick.label}</text>
    {/for}
    {#for mark of plot.marks by mark.series}
        {#if mark.kind === 'column'}
            <g {...mark.columns}>
                {#for bar of mark.bars by bar.index}
                    <rect {...bar.rect} />
                {/for}
            </g>
        {:else}
            <path {...mark.path} />
        {/if}
    {/for}
    {#if plot.readout}
        <line {...plot.crosshair?.line} />
        {#for point of plot.readout?.values ?? []}
            {#if point.circle}
                <circle {...point.circle} />
            {/if}
        {/for}
    {/if}
</svg>
{#if plot.readout}
    <!-- 50.47 — the readout, opened against the crosshair. -->
    <span {...plot.tip}>
        <span {...plot.readout?.heading}>{plot.readout?.label}</span>
        {#for point of plot.readout?.values ?? []}
            <span {...point.text}>{point.label}: {point.value}</span>
        {/for}
    </span>
{/if}
