<script>
// 49.9, 50.1-50.4 — `dialog`'s default markup: a `<dialog>` holding the component's children.
// Everything it does is the parts'; an app wanting other markup spreads them itself.
import type { Attributes } from '#shared/Attributes.ts'
import { dialog } from '#shared/dialog.ts'
import { props } from '#shared/props.ts'
import { reactiveOver } from '#shared/reactiveOver.ts'

const {
    open = false,
    modal = true,
    dismissible = true,
    onclose,
    ...rest
} = props<
    {
        /** Whether the dialog is showing, modal, over the page. Bind it — `bind:open={editing}` — and every way it closes writes `false` back. Mirrored as `data-open` on the `<dialog>`. */
        open?: boolean
        /** Whether it opens modal, over an inert page, or beside the page with `show`. Default `true`. */
        modal?: boolean
        /** Whether Escape and a click on the backdrop close it. `false` keeps it open until `open` turns false or a `<form method="dialog">` inside it submits. Default `true`. */
        dismissible?: boolean
        /** Called each time it closes, however it closed, with the `<dialog>`'s `returnValue`: the `value` of the button that submitted a `<form method="dialog">`, or `''`. */
        onclose?: (returnValue: string) => void
    } & Omit<Attributes<'dialog'>, 'open' | 'onclose'>
>()

const parts = dialog({
    open: reactiveOver(
        () => open,
        (next) => {
            open = next
        },
    ),
    modal: () => modal,
    dismissible: () => dismissible,
    onclose: (returnValue) => onclose?.(returnValue),
})
</script>

<dialog {...rest} {...parts.dialog}><slot /></dialog>
