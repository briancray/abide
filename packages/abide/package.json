{
    "name": "@abide/abide",
    "version": "0.102.0",
    "type": "module",
    "description": "Isomorphic type-safe framework for reactive async interfaces for humans and machines",
    "license": "MIT",
    "author": "Brian Cray",
    "homepage": "https://github.com/briancray/abide#readme",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/briancray/abide.git",
        "directory": "packages/abide"
    },
    "bugs": {
        "url": "https://github.com/briancray/abide/issues"
    },
    "keywords": [
        "bun",
        "framework",
        "isomorphic",
        "reactive",
        "ssr",
        "rpc",
        "mcp",
        "cli"
    ],
    "engines": {
        "bun": ">=1.4.3"
    },
    "publishConfig": {
        "access": "public",
        "provenance": true
    },
    "bin": {
        "abide": "./bin/abide.ts"
    },
    "exports": {
        ".": "./src/shared/index.ts",
        "./runtime": "./src/ui/index.ts",
        "./routing": "./src/ui/routing.ts",
        "./wire": "./src/ui/wire.ts",
        "./server": "./src/server/index.ts",
        "./test": "./src/server/preload.ts",
        "./compiler": "./src/compiler/index.ts",
        "./package.json": "./package.json"
    },
    "imports": {
        "#shared": "./src/shared/index.ts",
        "#shared/*": "./src/shared/*",
        "#ui": "./src/ui/index.ts",
        "#ui/*": "./src/ui/*",
        "#server": "./src/server/index.ts",
        "#server/*": "./src/server/*",
        "#compiler": "./src/compiler/index.ts",
        "#compiler/*": "./src/compiler/*"
    },
    "sideEffects": [
        "./src/server/**",
        "./src/shared/WORK.ts",
        "./src/shared/reactive/Reactive.ts"
    ],
    "dependencies": {
        "typescript": "^7.0.2"
    },
    "scripts": {
        "typecheck": "bun check",
        "prepack": "bun ../../scripts/packDocs.ts"
    },
    "files": [
        "src",
        "bin",
        "scaffold",
        "docs",
        "CHANGELOG.md"
    ]
}
