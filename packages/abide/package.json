{
    "name": "@abide/abide",
    "version": "0.142.0",
    "type": "module",
    "description": "Isomorphic type-safe framework for reactive async interfaces for humans and machines",
    "license": "MIT",
    "author": "Brian Cray",
    "homepage": "https://github.com/briancray/abide#readme",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/briancray/abide.git",
        "directory": "packages/abide"
    },
    "bugs": {
        "url": "https://github.com/briancray/abide/issues"
    },
    "keywords": [
        "bun",
        "framework",
        "isomorphic",
        "reactive",
        "ssr",
        "rpc",
        "mcp",
        "cli"
    ],
    "engines": {
        "bun": ">=1.4.4"
    },
    "publishConfig": {
        "access": "public",
        "provenance": true
    },
    "bin": {
        "abide": "./bin/abide.ts"
    },
    "exports": {
        ".": "./src/shared/index.ts",
        "./runtime": "./src/ui/index.ts",
        "./routing": "./src/ui/routing.ts",
        "./wire": "./src/ui/wire.ts",
        "./worker": "./src/shared/worker/index.ts",
        "./server": "./src/server/index.ts",
        "./server/runtime": "./src/server/runtime.ts",
        "./test": "./src/server/preload.ts",
        "./compiler": "./src/compiler/index.ts",
        "./Dialog.abide": "./src/components/Dialog.abide",
        "./Prompts.abide": "./src/components/Prompts.abide",
        "./Toasts.abide": "./src/components/Toasts.abide",
        "./Tooltips.abide": "./src/components/Tooltips.abide",
        "./Announcer.abide": "./src/components/Announcer.abide",
        "./Combobox.abide": "./src/components/Combobox.abide",
        "./SortableTable.abide": "./src/components/SortableTable.abide",
        "./Markdown.abide": "./src/components/Markdown.abide",
        "./Chart.abide": "./src/components/Chart.abide",
        "./Line.abide": "./src/components/Line.abide",
        "./Column.abide": "./src/components/Column.abide",
        "./Area.abide": "./src/components/Area.abide",
        "./Pie.abide": "./src/components/Pie.abide",
        "./Sparkline.abide": "./src/components/Sparkline.abide",
        "./Chat.abide": "./src/components/Chat.abide",
        "./Pairing.abide": "./src/components/Pairing.abide",
        "./package.json": "./package.json"
    },
    "imports": {
        "#shared": "./src/shared/index.ts",
        "#shared/*": "./src/shared/*",
        "#ui": "./src/ui/index.ts",
        "#ui/*": "./src/ui/*",
        "#server": "./src/server/index.ts",
        "#server/*": "./src/server/*",
        "#compiler": "./src/compiler/index.ts",
        "#compiler/*": "./src/compiler/*"
    },
    "sideEffects": [
        "./src/server/**",
        "./src/shared/WORK.ts",
        "./src/shared/reactive/Reactive.ts",
        "./src/ui/outboxQueue.ts",
        "./src/ui/socketWire.ts"
    ],
    "dependencies": {
        "@abide/bridge": "0.8.3",
        "typescript": "^7.0.2"
    },
    "devDependencies": {
        "@abide/harness": "workspace:*"
    },
    "scripts": {
        "typecheck": "bun check",
        "prepack": "bun ../../scripts/packDocs.ts"
    },
    "files": [
        "ABIDE.md",
        "src",
        "bin",
        "scaffold",
        "docs",
        "CHANGELOG.md"
    ]
}
