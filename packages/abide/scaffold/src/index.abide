<script>
import { reactive } from '@abide/abide'

import getGreeting from '#src/getGreeting.handler.ts'

let count = reactive(0)
const greeting = reactive(() => getGreeting({ name: 'world' }))
</script>

<head><title>Hello</title></head>

<main class="mx-auto flex max-w-md flex-col gap-4 p-8">
    <h1 class="text-2xl font-semibold">{greeting}</h1>
    <p>Clicked {count} times.</p>
    <button class="self-start rounded bg-black px-4 py-2 text-white" onclick={() => {
        count = count + 1
    }}>Click</button>
</main>
