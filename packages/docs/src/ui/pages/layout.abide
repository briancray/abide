<script module>
  import "../app.css"
  import { route } from "abide/shared/route"
  import { watch } from "abide/shared/watch"

  // The sample index mirrors the file-based route tree (src/ui/pages/**) — in abide the navigation
  // IS the routing, so the sidebar shows exactly the pages that exist. Grouped by capability.
  const sections = [
    { title: "Start", items: [
      { href: "/", label: "Home" },
    ] },
    { title: "Primitives", items: [
      { href: "/state", label: "state — owned" },
      { href: "/memo", label: "memo — loaded" },
      { href: "/channel", label: "channel — pushed" },
      { href: "/watch", label: "watch — effects" },
      { href: "/memo/verbs", label: "Surface verbs" },
      { href: "/memo/probes", label: "Reactive probes" },
      { href: "/memo/global", label: "Global probes" },
    ] },
    { title: "Transport", items: [
      { href: "/rpc", label: "rpc = memo + transport" },
      { href: "/rpc/reads", label: "Reads" },
      { href: "/rpc/mutations", label: "Mutations" },
      { href: "/rpc/responses", label: "Responses" },
      { href: "/rpc/streaming", label: "Streaming" },
      { href: "/rpc/uploads", label: "File uploads" },
      { href: "/rpc/probes", label: "RPC probes" },
      { href: "/sockets", label: "socket = channel + transport" },
      { href: "/sockets/probes", label: "Socket probes" },
    ] },
    { title: "Templating", items: [
      { href: "/templating/bindings", label: "Bindings & directives" },
      { href: "/templating/conditionals", label: "Conditionals" },
      { href: "/templating/lists", label: "Lists" },
      { href: "/templating/async", label: "Async blocks" },
      { href: "/templating/errors", label: "Error boundary" },
      { href: "/templating/components", label: "Components" },
      { href: "/templating/styling", label: "Scoped <style>" },
    ] },
    { title: "Pages", items: [
      { href: "/pages/routing", label: "Routing & navigation" },
      { href: "/pages/structure", label: "Page file structure" },
      { href: "/pages/layouts", label: "Layouts" },
      { href: "/pages/data", label: "Data & props" },
      { href: "/pages/ssr", label: "Streaming SSR" },
      { href: "/pages/hydration", label: "Hydration health" },
    ] },
    { title: "Platform", items: [
      { href: "/platform/config", label: "Config" },
      { href: "/platform/identity", label: "Identity" },
      { href: "/platform/scope", label: "Request scope" },
      { href: "/platform/observability", label: "Observability" },
      { href: "/platform/lifecycle", label: "Lifecycle hooks" },
      { href: "/platform/machines", label: "Machine surfaces" },
      { href: "/platform/cli", label: "CLI" },
      { href: "/platform/testing", label: "Testing" },
      { href: "/platform/deploy", label: "Build & deploy" },
      { href: "/platform/bench", label: "Render bench" },
      { href: "/platform/bench/client", label: "Mount bench (browser)" },
      { href: "/platform/bench/server", label: "Server dispatch bench" },
    ] },
  ]

  // Clickable breadcrumb trail from the current path — each segment links to its cumulative path,
  // reinforcing abide's file-based routing (a folder is a URL). Reactive via route().
  function crumbs(pathname) {
    const parts = pathname.split("/").filter(Boolean)
    const trail = [{ label: "pages", href: "/" }]
    let acc = ""
    for (const part of parts) {
      acc += "/" + part
      trail.push({ label: part, href: acc })
    }
    return trail
  }

  // CLIENT-ONLY (attached via bind:element, which never runs on the server): after the page content
  // mounts, list its `<section class="sample" id>` cards in the sidebar under the active page, and
  // scroll-spy the one in view. Pure progressive enhancement — the page works without it.
  //
  // The attachment fires ONCE, not per navigation: this is the root layout, and a cross-route soft-nav
  // that shares a layout prefix keeps the outer layouts alive and swaps only the diverging suffix. So
  // `.content-inner` is never re-created and `bind:element` never re-runs — the page content changes
  // underneath a node that stays put. (It previously assumed the opposite, which left the PREVIOUS page's
  // card list in the sidebar after every soft-nav.) The rebuild therefore hangs off `route()`.
  //
  // Timing is still racy in the other direction: when a rebuild starts, the destination's sample cards and
  // the sidebar's reactive `idx-active` class have not necessarily landed yet, so the build retries for a
  // bounded run of frames and the teardown clears eagerly — a page with no cards then simply has no index.
  function indexSamples(contentNode: Element) {
    if (typeof IntersectionObserver === "undefined") return
    let frame = 0
    let attempts = 0
    let spy: IntersectionObserver | undefined
    let sub: HTMLDivElement | undefined

    function teardown() {
      if (frame !== 0) {
        cancelAnimationFrame(frame)
        frame = 0
      }
      spy?.disconnect()
      spy = undefined
      sub?.remove()
      sub = undefined
      // Belt and braces: a racing rebuild may have left a block anchored under a now-stale link.
      for (const stale of document.querySelectorAll(".idx-samples")) stale.remove()
    }

    function build() {
      frame = 0
      const active = document.querySelector(".idx-link.idx-active")
      const samples = Array.from(contentNode.querySelectorAll("section.sample[id]"))
      if (active === null || samples.length === 0) {
        // Not settled yet: the content swap and the sidebar's reactive `idx-active` class land on their
        // own schedules. Retry for a bounded run of frames rather than leaving the page unindexed.
        if (attempts < 30) {
          attempts++
          frame = requestAnimationFrame(build)
        }
        return
      }

      sub = document.createElement("div")
      sub.className = "idx-samples"
      const linkFor = new Map()
      for (const s of samples) {
        const heading = s.querySelector("h2, h3")
        const link = document.createElement("a")
        link.href = "#" + s.id
        link.className = "idx-sample"
        link.textContent = (heading?.textContent ?? s.id).trim()
        sub.appendChild(link)
        linkFor.set(s.id, link)
      }
      active.after(sub)

      spy = new IntersectionObserver(
        (entries) => {
          for (const entry of entries) {
            if (!entry.isIntersecting) continue
            for (const l of sub!.children) l.classList.remove("idx-sample-active")
            linkFor.get(entry.target.id)?.classList.add("idx-sample-active")
          }
        },
        { rootMargin: "0px 0px -70% 0px", threshold: 0 },
      )
      for (const s of samples) spy.observe(s)
    }

    function rebuild() {
      teardown()
      attempts = 0
      frame = requestAnimationFrame(build)
    }

    rebuild()

    // The root layout SURVIVES a soft-nav — a cross-route nav sharing a layout prefix keeps the outer
    // layouts alive and swaps only the diverging suffix — so this attachment does NOT re-fire per
    // navigation: the page content changes underneath a node that stays put. Rebuilding therefore has to
    // hang off the thing that actually changed, which is the route.
    const stopWatching = watch(() => route().url.pathname, rebuild)

    return () => {
      stopWatching()
      teardown()
    }
  }
</script>

<div class="shell">
  <aside class="sidebar">
    <a href="/" class="brand">abide <small>isomorphic</small></a>
    <nav class="index">
      {#for section of sections by section.title}
        <div class="idx-group">
          <div class="idx-label">{section.title}</div>
          {#for item of section.items by item.href}
            <a href={item.href} class="idx-link" class:idx-active={route().url.pathname === item.href}>{item.label}</a>
          {/for}
        </div>
      {/for}
    </nav>
  </aside>

  <main class="content">
    <div class="content-inner" bind:element={indexSamples}>
      <nav class="crumb" aria-label="Breadcrumb">
        <span class="crumb-root">src/ui</span>{#for c of crumbs(route().url.pathname) by c.href}<span class="crumb-sep">/</span><a href={c.href}>{c.label}</a>{/for}
      </nav>
      <slot/>
    </div>
  </main>
</div>
