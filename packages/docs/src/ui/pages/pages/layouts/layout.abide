<script>
  import { state } from "abide/shared/state"

  // This section layout is KEPT ALIVE across navigation within pages/layouts/ (C6.2/C6.3): its <script>
  // runs ONCE, and this counter survives a param nav (→ an [item]) AND a cross-route nav (→ the hub or the
  // child) — the framework grafts only the diverging page into the <slot/> below, never rebuilding this
  // layout. Increment it, navigate around this section, and watch it hold.
  let count = state(0)
</script>

<section class="rounded border border-indigo-300 bg-indigo-50 p-4" data-testid="section-layout">
  <div class="row">
    <strong>section layout</strong>
    <span>persistent count: <b data-testid="layout-count">{count}</b></span>
    <button data-testid="layout-inc" onclick={() => count++}>+1</button>
  </div>
  <div class="mt-3 rounded border border-slate-200 bg-white p-3">
    <slot/>
  </div>
</section>
