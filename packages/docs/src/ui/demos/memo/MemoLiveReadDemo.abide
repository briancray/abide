<script>
  import { state } from "abide/shared/state"
  import { memo } from "abide/shared/memo"

  // live(args): the non-blocking snapshot — undefined while the first load is in flight, the value once
  // it resolves. Reading it subscribes the caller and kicks a coalesced load.
  let started = state(false)
  const greeting = memo(async ({ id }: { id: string }) => {
    await new Promise((resolve) => setTimeout(resolve, 300))
    return `hello ${id}`
  })
  const snapshot = memo(() => (started ? (greeting.live({ id: "a" }) ?? "undefined (pending)") : "idle"))
  function read() { started = true }
</script>

<ul class="grid">
  <li><code>live()</code>: <strong data-testid="memolive-value">{snapshot}</strong></li>
</ul>
<div class="row">
  <button data-testid="memolive-read" onclick={read}>Read</button>
</div>
