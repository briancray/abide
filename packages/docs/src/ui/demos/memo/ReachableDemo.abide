<script>
  import { state } from "abide/shared/state"
  import { memo } from "abide/shared/memo"
  import cacheReachable from "$server/rpc/cacheReachable"

  // reachable(host) actively probes a host: the app's own origin answers (true), a dead local port
  // is refused (false).
  let reachStarted = state(false)
  const reachSelf = memo(() => (reachStarted ? String(cacheReachable.live()?.self ?? "…") : "idle"))
  const reachDead = memo(() => (reachStarted ? String(cacheReachable.live()?.dead ?? "…") : "idle"))
  function startReach() { reachStarted = true }
</script>

<ul class="grid">
  <li>reachable(self): <strong data-testid="reach-self">{reachSelf}</strong></li>
  <li>reachable(dead): <strong data-testid="reach-dead">{reachDead}</strong></li>
</ul>
<div class="row">
  <button data-testid="reach-start" onclick={startReach}>Probe</button>
</div>
