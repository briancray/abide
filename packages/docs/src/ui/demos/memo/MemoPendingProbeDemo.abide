<script>
  import { state } from "abide/shared/state"
  import { memo } from "abide/shared/memo"

  // pending(args): true only while the FIRST load is in flight (no value yet). It flips back to false
  // once the slot holds a value or an error.
  let started = state(false)
  const slow = memo(async ({ id }: { id: string }) => {
    await new Promise((resolve) => setTimeout(resolve, 400))
    return `ready ${id}`
  })
  const value = memo(() => (started ? (slow.live({ id: "a" }) ?? "loading") : "idle"))
  const pendingFlag = memo(() => (started ? (slow.pending({ id: "a" }) ? "yes" : "no") : "—"))
  function read() { started = true }
</script>

<ul class="grid">
  <li>Value: <strong data-testid="memopending-value">{value}</strong></li>
  <li><code>pending()</code>: <strong data-testid="memopending-flag">{pendingFlag}</strong></li>
</ul>
<div class="row">
  <button data-testid="memopending-read" onclick={read}>Read</button>
</div>
