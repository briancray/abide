<script>
  import { state } from "abide/shared/state"
  import rpcGreet from "$server/rpc/rpcGreet"

  // `fn.raw(args, init?)` is the same read, returning the Response instead of the decoded value. This
  // runs in the BROWSER, where that means a bare fetch of the RPC's HTTP face: the untouched wire
  // Response, no client memo and no error-throw, so the caller reads `.status`, headers and body
  // itself. (Server-side the read is coalesced and authorized like any other, then encoded.) Works on
  // any RPC, read or mutation — a mutation's `.raw` sends the body + CSRF header; see the onError demo.
  let raw = state(null)

  async function rawFetch() {
    const response = await rpcGreet.raw({ name: "raw" })
    raw = { status: response.status, contentType: response.headers.get("content-type"), body: await response.text() }
  }
</script>

<button data-testid="raw-btn" onclick={rawFetch}>Raw fetch /rpc/rpcGreet</button>
{#if raw}
  <pre class="out" data-testid="raw-result">status: {raw.status}
content-type: {raw.contentType}
body: {raw.body}</pre>
{/if}
