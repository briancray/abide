<script>
  import { state } from "abide/shared/state"

  // `rpcPing` is declared as an ordinary GET — there is no HEAD helper. The router derives HEAD from
  // it, so this raw HEAD fetch reaches the same handler and reports the status line with no body.
  let headStatus = state(0)

  async function head() {
    const response = await fetch("/__abide/rpc/rpcPing", { method: "HEAD" })
    headStatus = response.status
  }
</script>

<button data-testid="head-btn" onclick={head}>HEAD /rpc/rpcPing</button>
<p>Status: <strong data-testid="head-status">{headStatus}</strong></p>
