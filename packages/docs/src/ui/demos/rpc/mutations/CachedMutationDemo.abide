<script>
  import { state } from "abide/ui/state"
  import rpcBumpCounter from "$server/rpc/rpcBumpCounter"

  // A mutation opted into caching (`cache: { ttl }`) gets the SAME reactive surface as a read. Calling
  // it retains the value: a second call HITS the cache (the run number stays), while `.refresh()` re-runs
  // the handler (the run number bumps). `.peek()` snapshots the retained value; `.refreshing()` reports
  // the revalidation. This is the read/mutation symmetry — the exact same probes a GET exposes.
  const args = { id: "demo" }
  let called = state(false)
  function call() { rpcBumpCounter(args); called = true }
  function refresh() { rpcBumpCounter.refresh(args) }
</script>

<button data-testid="cached-call-btn" onclick={call}>Call (cached)</button>
<button data-testid="cached-refresh-btn" onclick={refresh}>Refresh (re-run)</button>
{#if called}
  <pre class="out" data-testid="cached-out">runs: {rpcBumpCounter.peek(args)?.runs ?? "…"}
refreshing: {String(rpcBumpCounter.refreshing(args))}</pre>
{:else}
  <p data-testid="cached-out">not called yet</p>
{/if}
