<script>
  import { state } from "abide/shared/state"
  import rpcBoom from "$server/rpc/rpcBoom"

  // `error(status, message)` THROWS an HttpError in the handler; the router renders it at that status
  // and the browser proxy decodes the non-2xx back into the same HttpError — so the caller catches it
  // here and reads `status`/`message`, exactly as an in-process caller would.
  let plainError = state(null)

  async function callBoom() {
    try {
      await rpcBoom({ ok: false })
      plainError = { message: "(no error)" }
    } catch (caught) {
      plainError = { status: caught.status, message: caught.message }
    }
  }
</script>

<button data-testid="error-btn" onclick={callBoom}>Trigger 422</button>
{#if plainError}
  <p class="err" data-testid="error-result">{plainError.status} — {plainError.message}</p>
{/if}
