<script>
  import { state } from "abide/shared/state"

  // `redirect(url, status)` THROWS a Redirect in the handler; the router renders the 3xx + Location,
  // and the browser fetch follows it transparently — the resolved `Response` reports `redirected` and
  // the final `url`.
  //
  // Hand-built URL, so it names the RESERVED transport param itself: `__abide_args` carries the
  // canonical JSON args blob. The `__abide_` prefix is what keeps it from ever colliding with a
  // handler's own arg field.
  let redirectInfo = state(null)

  async function followRedirect() {
    const response = await fetch("/__abide/rpc/rpcGoHome?__abide_args=" + encodeURIComponent(JSON.stringify({ to: "/rpc/reads" })))
    redirectInfo = { redirected: response.redirected, url: new URL(response.url).pathname }
  }
</script>

<button data-testid="redirect-btn" onclick={followRedirect}>Follow redirect</button>
{#if redirectInfo}
  <p class="say" data-testid="redirect-result">redirected: {String(redirectInfo.redirected)} → {redirectInfo.url}</p>
{/if}
