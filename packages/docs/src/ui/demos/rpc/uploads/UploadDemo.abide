<script>
  import { state } from "abide/shared/state"
  import rpcUpload from "$server/rpc/rpcUpload"

  // The upload RPC's single argument is a real FormData: the picked File plus the caption text field.
  // A native <form> builds that FormData for free — `new FormData(form)` harvests every `name=`d field
  // (the text `caption` + the `avatar` File) with no manual `.set()` or node capture. The browser then
  // calls the SAME callable as the server; the client proxy sends the FormData as the raw multipart
  // body (adding the `x-abide` header the CSRF gate requires — which a bare form submit can't forge, so
  // we go through the callable, not the form's own `action`). A 422 (missing/short caption, or a
  // missing/oversize/wrong-type file) throws an HttpError we surface below.
  let result = state(null)
  let errorMsg = state("")

  async function upload(event) {
    event.preventDefault()
    errorMsg = ""
    result = null
    const form = new FormData(event.currentTarget)
    try {
      result = await rpcUpload(form)
    } catch (caught) {
      const err = caught as { data?: { fields?: Record<string, string> }; message?: string }
      const fields = err.data?.fields
      errorMsg = fields ? Object.values(fields).join("; ") : (err.message ?? "upload failed")
    }
  }
</script>

<form class="controls" onsubmit={upload}>
  <label>caption <input data-testid="upload-caption" name="caption" placeholder="required, non-empty" /></label>
  <input data-testid="upload-file" name="avatar" type="file" />
  <button data-testid="upload-submit" type="submit">Upload</button>
</form>

{#if result}
  <p data-testid="upload-result" class="out">uploaded <strong>{result.name}</strong> ({result.size} bytes, {result.type}) — caption: "{result.caption}"</p>
{/if}
{#if errorMsg}
  <p data-testid="upload-error" class="out err">rejected: {errorMsg}</p>
{/if}
