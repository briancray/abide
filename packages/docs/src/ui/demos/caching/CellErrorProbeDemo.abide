<script>
  import { state } from "abide/shared/state"
  import { cell } from "abide/shared/cell"

  // error(args): the retained error, or undefined. A rejected load lands on the slot; a subsequent
  // invalidate + successful read clears it. The `started` gate keeps SSR from kicking the failing load
  // (an ungated peek during render would reject before any click).
  let started = state(false)
  let failing = state(true)
  const flaky = cell(async ({ id }: { id: string }) => {
    if (failing) throw new Error(`cell boom for ${id}`)
    return `ok ${id}`
  })
  const errorText = state.computed(() => {
    if (!started) return "idle"
    const e = flaky.error({ id: "a" })
    return e instanceof Error ? e.message : "none"
  })
  const value = state.computed(() => (started ? (flaky.peek({ id: "a" }) ?? "—") : "idle"))
  function trigger() { started = true; flaky({ id: "a" }).catch(() => {}) }
  function fixAndRetry() { failing = false; flaky.invalidate({ id: "a" }); flaky({ id: "a" }).catch(() => {}) }
</script>

<ul class="grid">
  <li><code>error()</code>: <strong data-testid="cellerror-error">{errorText}</strong></li>
  <li>Value: <strong data-testid="cellerror-value">{value}</strong></li>
</ul>
<div class="row">
  <button data-testid="cellerror-trigger" onclick={trigger}>Trigger failure</button>
  <button data-testid="cellerror-fix" onclick={fixAndRetry}>Fix &amp; retry</button>
</div>
