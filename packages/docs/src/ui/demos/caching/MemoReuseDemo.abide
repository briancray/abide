<script>
  import { state } from "abide/shared/state"
  import { memo } from "abide/shared/memo"

  // memo() wraps ANY async function into a memoized slot: cache + in-flight coalescing + a reactive read
  // surface. RPCs and sockets are just memo + a transport; here the bare primitive runs entirely in the
  // browser. The handler counts its real runs — repeated reads REUSE the slot (count holds), invalidate
  // drops it so the next read re-runs.
  let started = state(false)
  let reads = state(0)
  let runs = state(0)
  const counter = memo(async ({ key }: { key: string }) => {
    runs++
    await new Promise((resolve) => setTimeout(resolve, 150))
    return { key, at: runs }
  })
  const value = memo(() => (started ? (counter.peek({ key: "alpha" })?.at ?? "loading") : "idle"))

  function start() { started = true }
  function readAgain() { reads++; counter({ key: "alpha" }) }
  function drop() { counter.invalidate({ key: "alpha" }) }
</script>

<ul class="grid">
  <li>Handler runs: <strong data-testid="memo-runs">{runs}</strong></li>
  <li>Value (run #): <strong data-testid="memo-value">{value}</strong></li>
  <li>Reads requested: <strong data-testid="memo-reads">{reads}</strong></li>
</ul>
<div class="row">
  <button data-testid="memo-start" onclick={start}>Load</button>
  <button data-testid="memo-read" onclick={readAgain}>Read again</button>
  <button data-testid="memo-invalidate" onclick={drop}>Invalidate</button>
</div>
