<script>
  import { state } from "abide/shared/state"
  import { memo } from "abide/shared/memo"

  // refreshing(args): true only while a re-fetch runs OVER a value that stays on screen — the SWR case.
  // So during a refresh: value = the stale one, refreshing = yes, pending = no.
  let started = state(false)
  let runs = state(0)
  const slot = memo(async ({ id }: { id: string }) => {
    runs++
    await new Promise((resolve) => setTimeout(resolve, 400))
    return runs
  })
  const value = memo(() => (started ? (slot.peek({ id: "a" }) ?? "loading") : "idle"))
  const refreshingFlag = memo(() => (slot.refreshing({ id: "a" }) ? "yes" : "no"))
  const pendingFlag = memo(() => (slot.pending({ id: "a" }) ? "yes" : "no"))
  function read() { started = true }
  function refresh() { slot.refresh({ id: "a" }) }
</script>

<ul class="grid">
  <li>Value (run #): <strong data-testid="memorefreshing-value">{value}</strong></li>
  <li><code>refreshing()</code>: <strong data-testid="memorefreshing-flag">{refreshingFlag}</strong></li>
  <li><code>pending()</code>: <strong data-testid="memorefreshing-pending">{pendingFlag}</strong></li>
</ul>
<div class="row">
  <button data-testid="memorefreshing-read" onclick={read}>Load</button>
  <button data-testid="memorefreshing-refresh" onclick={refresh}>Refresh</button>
</div>
