<script>
  import platformObserve from "$server/rpc/platformObserve"

  // trace() via RPC — the handler reads the request's W3C traceparent and returns it (plus the split-
  // out trace id). The `{#await}` blocks SSR so the value lands in the initial HTML. "Run again"
  // refreshes the cached read.
</script>

{#await platformObserve()}
  <p id="observe-block">reading…</p>
{:then o}
  <pre class="out" id="observe-block">traceparent = {o.traceparent ?? "(none)"}
traceId     = {o.traceId ?? "(none)"}</pre>
{/await}
<div class="row">
  <button data-testid="replay" onclick={() => platformObserve.refresh()}>Run again ▸</button>
</div>
