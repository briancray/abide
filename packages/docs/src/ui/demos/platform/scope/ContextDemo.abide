<script>
  import platformContext from "$server/rpc/platformContext"

  // No input — a per-RPC middleware stamps context(), the handler reads it back.
  //
  // The stamp is ALREADY filled in on first paint: this read runs during the page's server render, and an
  // rpc's middleware runs per READ from every door, so the in-process read runs it too. The button is a
  // second read (over HTTP this time), which runs it again.
</script>

<button id="read-context-btn" onclick={() => platformContext.refresh()}>Read context()</button>

{#await platformContext()}
  <p id="context-block">reading…</p>
{:then scope}
  <pre class="out" id="context-block">context.stampedBy = {scope?.stampedBy ?? "(none)"}
context.stampedAt = {scope?.stampedAt ?? "(none)"}</pre>
{/await}
