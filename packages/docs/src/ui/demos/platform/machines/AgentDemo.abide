<script>
  import { state } from "abide/shared/state"
  import agentDemo from "$server/rpc/agentDemo"

  // Gate the stream behind a click so SSR renders the button (the run streams client-side), then consume
  // it declaratively. `agentDemo` is a streaming GET of `agent()` frames mapped to `{ kind, text }`; the
  // browser RPC proxy decodes its `application/jsonl` response into an AsyncIterable, so `{#for await}`
  // drains it in the browser identically to SSR — no hand-rolled fetch/reader/decoder (see /rpc/streaming).
  let running = state(false)
</script>

<button data-testid="agent-btn" onclick={() => running = true}>Run agent</button>
{#if running}
  <ol class="agent-log" data-testid="agent-log">
    {#for await step of agentDemo()}
      <li data-kind={step.kind}><strong>{step.kind}</strong> {step.text}</li>
    {:catch}
      <li>agent run failed</li>
    {/for}
  </ol>
{/if}
