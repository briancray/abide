<script>
  import { url } from "abide/shared/url"

  // url(path, params?, query?) fills [name] segments AND appends a query string. With no dynamic
  // segments it collapses to url(path, query?). The built href flows straight into an <a href>.
  const slug = "alpha"
</script>

<dl class="route">
  <dt>url(path, params, query)</dt>
  <dd data-testid="url-params-query">{url("/pages/routing/[slug]", { slug }, { ref: "docs", page: 2 })}</dd>
  <dt>url(path, query)</dt>
  <dd data-testid="url-query-only">{url("/pages/routing", { tab: "links" })}</dd>
</dl>

<div class="row">
  <a data-testid="query-link" href={url("/pages/routing/[slug]", { slug }, { ref: "docs", page: 2 })}>open ?ref=docs&amp;page=2</a>
</div>
