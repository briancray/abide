<script>
  import { state } from "abide/shared/state"

  // bind:group radio group.
  let picked = state("green")
</script>

<label><input type="radio" name="hue" value="red" bind:group={picked} /> red</label>
<label><input type="radio" name="hue" value="green" bind:group={picked} /> green</label>
<label><input type="radio" name="hue" value="blue" bind:group={picked} /> blue</label>
<p>Picked: <span id="group-out">{picked}</span></p>
