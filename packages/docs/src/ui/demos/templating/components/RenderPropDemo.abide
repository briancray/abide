<script>
  // Components are first-class values: pass one as a prop and invoke it as a tag. Data flows via props —
  // `Framed` hands its own data to the passed-in `Render` component.
</script>

{#component Loud({ text })}
  <b data-testid="loud">{text.toUpperCase()}</b>
{/component}

{#component Framed({ Render })}
  <div data-testid="framed" class="framed"><Render text="rendered via prop"/></div>
{/component}

<Framed Render={Loud}/>
