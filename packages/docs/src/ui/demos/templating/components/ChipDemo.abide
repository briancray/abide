<script>
  // A component is a reusable builder invoked as a tag `<Chip .../>` — the same during SSR and after
  // hydration. Props arrive as one object; destructure them in the header.
</script>

{#component Chip({ text })}
  <span data-testid="chip" class="chip">{text}</span>
{/component}

<p class="chips"><Chip text="alpha"/><Chip text="beta"/><Chip text="gamma"/></p>
