<script>
  import { state } from "abide/shared/state"

  // A component is a TitleCase `{#component}` taking a single props object. `Card` receives a reactive
  // `title` prop and renders whatever sits between its tags via its single `<slot/>` (filled
  // automatically — no `children` param needed). Both the prop and the slot stay live after hydration.
  let title = state("Original title")
  let count = state(0)

  function rename() {
    title = "Renamed title"
  }
</script>

{#component Card(props)}
  <section data-testid="card" class="card">
    <h3 data-testid="card-title">{props.title}</h3>
    <div class="card-body"><slot/></div>
  </section>
{/component}

<div class="controls">
  <button data-testid="rename" onclick={rename}>Rename card</button>
  <button data-testid="inc" onclick={() => count++}>Increment count</button>
</div>

<Card title={title}>
  This body is the slot. It reads the live count: <strong data-testid="card-count">{count}</strong>.
</Card>
