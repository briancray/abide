<script>
  import { state } from "abide/shared/state"

  // Nothing here belongs to a tally. The component below owns its own state and its own styling, so
  // this script has no name for either — it just decides how many tallies there are.
  let labels = state(["reads", "writes"])

  function addTally() {
    labels = [...labels, "extra " + labels.length]
  }
</script>

{#component Tally({ label })}
  <script>
    // PER INVOCATION. Every `<Tally/>` on the page gets its own `count`, created when it mounts and
    // gone when it unmounts — the same contract the component's root `<script>` has, one level in.
    let count = state(0)
  </script>

  <style>
    /* Scoped to THIS component's subtree. The `.tally` further down the page is untouched — both
       selectors below reach only what this component renders.
       Literal green rather than `--color-live`: that variable is a badge TINT (2.6:1 on white), and
       this is body text you have to read. Same hue family, darkened to 5.5:1. */
    .tally { color: #047857; font-family: var(--font-mono); font-weight: 600; }
    .pair {
      display: inline-flex; align-items: center; gap: var(--space-2);
      padding: var(--space-1) var(--space-1) var(--space-1) var(--space-3);
      border: 1px solid var(--color-line); border-radius: var(--radius-pill);
    }
  </style>

  <span class="pair">
    <span data-testid="tally" class="tally">{label} · {count}</span>
    <button data-testid="tally-bump" onclick={() => count++}>+1</button>
  </span>
{/component}

<div class="controls">
  <button data-testid="add-tally" onclick={addTally}>Add tally</button>
</div>

<div class="row">
  {#for label of labels by label}
    <Tally label={label}/>
  {/for}
</div>

<p data-testid="tally-outside" class="tally">a <code>.tally</code> outside the component — the same class, none of its styling</p>
