<script>
  import controlGreet from "$server/rpc/controlGreet"

  // Server-resolved {#await} of a real RPC. The read blocks SSR, so the value is already in the
  // initial HTML. "Run again" re-fires the one-shot read directly: refreshing the RPC memo
  // invalidates its slot and the {#await} re-awaits it.
</script>

<p data-testid="rpc-await" class="out">
  {#await controlGreet({ who: "control flow" })}
    reading…
  {:then message}
    {message}
  {/await}
</p>
<div class="row">
  <button data-testid="replay" onclick={() => controlGreet.refresh({ who: "control flow" })}>Run again ▸</button>
</div>
