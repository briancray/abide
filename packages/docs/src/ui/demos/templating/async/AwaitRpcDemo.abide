<script>
  import controlGreet from "$server/rpc/controlGreet"

  // No branches: a bare {await …} interpolation. The read blocks SSR, so the value is already in
  // the initial HTML — nothing suspends, nothing flashes. "Run again" refreshes the RPC memo and
  // the interpolation re-awaits it in place: the run counter climbs, so the value genuinely moves.
  // That last part is the point — a refresh that lands the SAME value wakes nobody, so a handler
  // returning a fixed string would leave this button doing nothing visible at all.
</script>

<p data-testid="rpc-await" class="out">{await controlGreet({ who: "control flow" })}</p>
<div class="row">
  <button data-testid="replay" onclick={() => controlGreet.refresh({ who: "control flow" })}>Run again ▸</button>
</div>
