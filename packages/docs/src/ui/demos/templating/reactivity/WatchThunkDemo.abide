<script>
  import { state } from "abide/ui/state"
  import { watch } from "abide/ui/watch"

  // watch(thunk) — an auto-tracked effect. It reads `doubled` and mirrors a derived value into a
  // separate cell, so the thunk re-runs whenever its tracked reads change (seeded once on mount).
  let count = state(0)
  const doubled = state.computed(() => count * 2)
  let mirror = state(0)
  watch(() => { mirror = doubled + 1 })
</script>

<div class="row">
  <button data-testid="wt-inc" onclick={() => count++}>Increment</button>
</div>
<p>Count: <strong data-testid="wt-count">{count}</strong> · Doubled: <strong data-testid="wt-doubled">{doubled}</strong></p>
<p>Mirror (doubled + 1): <strong data-testid="mirror">{mirror}</strong> <span class="muted">(<code>watch(thunk)</code>, auto-tracked)</span></p>
