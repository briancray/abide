<script module>
  import { channel } from "abide/shared/channel"

  // A ROOMED channel — `Args` names the room, so each distinct args value gets its own hub, created
  // lazily. Owned by a browser module like the card above it: rooms are the primitive's own keying, so
  // there is still no transport here, nothing to connect to, and nothing on the server.
  const notes = channel<{ at: number; text: string }, { room: string }>({ tail: 3 })
</script>

<script>
  import { state } from "abide/shared/state"

  // Publish into the room you are NOT watching and nothing shows up.
  let room = state("red")
  let sent = state(0)

  function post(target: string) {
    sent = sent + 1
    notes.publish({ room: target }, { at: sent, text: `note → ${target}` })
  }

  function switchRoom() {
    room = room === "red" ? "blue" : "red"
  }
</script>

<div class="row">
  <button data-testid="room-post-red" onclick={() => post("red")}>Publish to red</button>
  <button data-testid="room-post-blue" onclick={() => post("blue")}>Publish to blue</button>
  <button data-testid="room-switch" onclick={switchRoom}>Watch the other room</button>
</div>

<p>Watching room: <strong data-testid="room-name">{room}</strong> · <code>tail: 3</code>, so switching back replays that room's last three.</p>
<ul class="grid" data-testid="room-log">
  {#for await note of notes({ room })}
    <li>#{note.at} — {note.text}</li>
  {/for}
</ul>
