<script>
import type { State } from 'abide'
import type { Book, Shelf } from '../models.ts'
import { assertType, type Exact } from '../exact.ts'

// Declaring `Args` is what types a component's props. Without it the emitted signature is
// `Record<string, unknown>`, which type-checks a caller's props against nothing at all — so this is
// the declaration that makes `<Props n="x"/>` an error rather than a runtime surprise.
type Args = {
    book: Book
    shelf: Shelf
    /** A prop that IS a cell: declared as one, so the name reads it and `bind:` can write it. */
    note: State<string>
    footnote?: string
}

// The props arrive typed, not as `unknown` — the whole claim of declaring `Args`.
assertType<Exact<typeof args.book, Book>>()
assertType<Exact<typeof args.shelf, Shelf>>()
assertType<Exact<typeof args.footnote, string | undefined>>()
</script>

<article>
    <h3>{args.book.title}</h3>
    <p>{args.book.author.name} · {args.shelf} · {args.book.pages} pages</p>
    <input bind:value={args.note} />
    {#if args.footnote}<small>{args.footnote}</small>{/if}
</article>
