<script module>
import { state } from 'abide'

export interface Row {
    id: number
    label: string
}

export const rows = state<Row[]>([
    { id: 1, label: 'alpha' },
    { id: 2, label: 'beta' },
    { id: 3, label: 'gamma' },
])
</script>

<ul>{#for item of rows}<li>{item.label}</li>{/for}</ul>
