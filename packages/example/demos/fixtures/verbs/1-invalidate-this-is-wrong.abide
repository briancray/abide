<script module>
import { memo } from 'abide'

let served = 0

export const quote = memo(async ({ symbol }: { symbol: string }) => {
    await new Promise((settle) => setTimeout(settle, 400))
    return `${symbol} @ ${++served}`
})
</script>

<!-- `invalidate` DROPS the data: nothing is started, so the region is back to its placeholder and the
     next read is a cold one. -->
{#if quote({ symbol: 'ABC' }).pending()}
    <p>loading…</p>
{:else}
    <p>{quote({ symbol: 'ABC' })()}</p>
{/if}

<button onclick={() => quote({ symbol: 'ABC' }).invalidate()}>invalidate</button>
