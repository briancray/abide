<script module>
import { state, watch } from 'abide'

export const name = state('ada')
export const other = state('grace')
export const both = state(false)
export const runs = state(0)

// The dependency set is what the LAST RUN read — so while `both` is false, writing `other` wakes nobody.
watch(() => {
    if (both()) other()
    name()
    runs.set(runs.peek() + 1)
})
</script>

<p>body runs: {runs}</p>
<button onclick={() => (name = name === 'ada' ? 'alan' : 'ada')}>write the one it reads</button>
<button onclick={() => (other = other === 'grace' ? 'hedy' : 'grace')}>write the one it does not</button>
<button onclick={() => (both = !both)}>read both</button>
