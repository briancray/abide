<!-- Three independent loads in three sections, which is the shape that says WHEN a load starts.

     A cell begins its load on the first READ, and in a render that read is the walk ARRIVING at the
     slot — so read in document order these three cost their sum. Every slot below is an
     unconditional plain read, so the compiler starts all three at setup instead, and the walk then
     waits on the longest rather than on each in turn.

     The counter is the whole assertion: the markup is identical either way, so only the peak number
     in flight AT ONCE can tell the two apart. -->
<script module>
import { memo } from 'abide'

let inFlight = 0
let peak = 0

/** The most loads in flight at any one moment — a count, because the output cannot show this. */
export const peakInFlight = (): number => peak

/** Cold again, and counting from zero: these cells are module scope, so they outlive one render. */
export const reset = (): void => {
    one.invalidate()
    two.invalidate()
    three.invalidate()
    inFlight = 0
    peak = 0
}

async function load(label: string): Promise<string> {
    inFlight++
    if (inFlight > peak) peak = inFlight
    await new Promise((settle) => setTimeout(settle, 10))
    inFlight--
    return label
}

export const one = memo(() => load('ONE'))
export const two = memo(() => load('TWO'))
export const three = memo(() => load('THREE'))
</script>

<div>
    <section>{one}</section>
    <section>{two}</section>
    <section>{three}</section>
</div>
