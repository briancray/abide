<script module>
import { state } from 'abide'

async function* ticking(): AsyncGenerator<number> {
    for (let i = 1; i <= 5; i++) {
        await new Promise((settle) => setTimeout(settle, 300))
        yield i
    }
}

// The cell holds the LATEST chunk; `chunks()` holds the transcript.
export const ticks = state(ticking())
</script>

<p>latest {ticks ?? 0}</p>
<ul>{#for tick of ticks.chunks()}<li>{tick}</li>{/for}</ul>
