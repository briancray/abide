<script module>
import { memo, state } from 'abide'

export const query = state('ab')

export const hits = memo(async ({ text }: { text: string }) => {
    await new Promise((settle) => setTimeout(settle, 400))
    return text === '' ? [] : [`${text}-one`, `${text}-two`]
})
</script>

<input bind:value={query} />

<!-- Nothing here awaits: the read SIGNALS, and the walk runs this body again when the load lands. -->
{#if hits({ text: query }).pending()}
    <p>searching…</p>
{:else}
    <ul>{#for hit of hits({ text: query })()}<li>{hit}</li>{/for}</ul>
{/if}
