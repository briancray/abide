<!-- Every capability against a hand-written equivalent, one row per arm.

     A table rather than a stack of cards, because forty-odd benches are read by SCANNING. Every row
     on the page is laid on ONE column template, so a number sits directly under every other number of
     its kind and the eye runs down the page instead of re-entering each card's own little grid.

     The numbers are cells, so a row repaints when its own measurement lands and no other row hears
     about it — and the filter drops rows from the list rather than hiding them with a class, so a
     kind nobody is reading is a row that is not on the page at all. -->
<script module>
import { memo, state } from 'abide'
import type { Bench } from 'abide-kit'
import { clockResolution } from 'abide-kit/measure'
import { SMALL_BUTTON } from '../../demos/dom.ts'
import Arms from '../../site/arms.abide'
import { type BenchRow, benchRows } from '../../site/bench.ts'
import { CHIP, CHIP_ON, GROUP, grouped, HEAD, STICKY, TABLE } from '../../site/table.ts'

const KINDS = ['all', 'time', 'work', 'wake', 'budget'] as const
type Kind = (typeof KINDS)[number]

/** The one column template every row is laid on. */
const ROW = 'grid grid-cols-[minmax(0,1fr)_6.5rem_7rem_9.5rem] items-center gap-x-4 px-3'

const CLOCK =
    `This browser reports time in steps of ${clockResolution().toFixed(3)} ms; each batch is sized ` +
    'to take about 40 ms, so that clamp is the noise floor under every number below. A 1.05× ' +
    'difference is not a difference.'

const AFTERWORD =
    'What the ratios do not show: the vanilla arms above are ~250 lines that each do one of these ' +
    'jobs and none of the others. The failure behaviour — a stale load landing on top of a newer ' +
    'one, a throwing effect stranding the batch, a status record waking every reader on every ' +
    'settle — is where the hand-written versions actually lose, and it is measured on this page as ' +
    'wakes and DOM calls rather than as time.'
</script>

<script>
const kind = state<Kind>('all')
const progress = state('')

/**
 * Every benched case, loaded once — and the failure, if the load is what failed.
 *
 * A page whose whole content is one load has to say when the load did not happen: a silent empty
 * table reads as "there are no benches", which is the one thing it never means. The `catch` is the
 * page's, not the console's.
 */
const failure = state('')
const loaded = memo(async (): Promise<BenchRow[]> => {
    try {
        return await benchRows()
    } catch (error: unknown) {
        failure = `the benches did not load — ${String(error)}`
        return []
    }
})

/**
 * The rows this filter is showing, grouped by suite.
 *
 * The filter DROPS rows from the list rather than hiding them with a class, so a kind nobody is reading
 * is a row that is not on the page at all — and `grouped` then leaves no heading for a suite it emptied.
 */
const groups = memo((): { suite: string; rows: BenchRow[] }[] => {
    const showing: BenchRow[] = []
    // No cold check: this body is re-run, so a read of a load that has not landed signals out of
    // here rather than handing back `undefined`.
    for (const row of loaded()) {
        if (kind !== 'all' && row.kind !== kind) continue
        showing.push(row)
    }
    return grouped(showing)
})

async function runEverything(): Promise<void> {
    const showing: BenchRow[] = []
    for (const group of groups) for (const row of group.rows) showing.push(row)
    for (let i = 0; i < showing.length; i++) {
        const row = showing[i] as BenchRow
        progress = `${i + 1} / ${showing.length} — ${row.title}`
        await row.run()
    }
    progress = `done — ${showing.length} cases`
}
</script>

<div class="mx-auto max-w-6xl px-6 pt-10 pb-2">
    <h1 class="text-3xl font-semibold text-slate-100">bench</h1>
    <p class="mt-2 text-slate-400 max-w-3xl">Every capability against a hand-written equivalent, one row per arm. Blue is abide; the last column is abide ÷ that arm. Time cases are best-of-many batches, so they are comparable within a run and meaningless between machines — read the ratio, not the number.</p>
</div>

<main class="mx-auto max-w-6xl px-6 pb-24 space-y-6">
    <div class="flex flex-wrap items-center gap-3">
        <button class={SMALL_BUTTON} onclick={() => void runEverything()}>run everything</button>
        <span class="text-sm text-slate-500">{progress}</span>
        <div class="flex flex-wrap items-center gap-1.5 ml-auto">
            {#for name of KINDS}<button class={kind === name ? CHIP_ON : CHIP} onclick={() => (kind = name)}>{name}</button>{/for}
        </div>
    </div>

    <p class="text-xs text-slate-600">{CLOCK}</p>

    {#if failure}<p class="text-sm text-rose-400">{failure}</p>{/if}

    <div class={TABLE}>
        <div class="{ROW} {STICKY}">
            <span class={HEAD}>case · arm</span>
            <span class="{HEAD} text-right">per op</span>
            <span class={HEAD}></span>
            <span class="{HEAD} text-right">abide ÷ arm</span>
        </div>

        {#for group of groups}
            <div class={GROUP}>
                <a href="/bench/{group.suite}" class="hover:text-slate-200">{group.suite}</a> · {group.rows.length}
            </div>
            <Arms rows={group.rows}/>
        {/for}
    </div>

    <p class="pt-2 text-sm text-slate-500">{AFTERWORD}</p>
</main>
