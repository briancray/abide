<!-- One suite's measurements.

     The same rows `/bench` builds, filtered to one capability — because forty benches are read by
     scanning and eight are read by running them. This page loads ONE suite through `LOADERS`, so
     measuring `state` does not cost the compiler's chunk.

     `run everything` here means everything on this page, which is the other half of why the split is
     worth a route: a run of eight cases finishes while somebody is still looking at it. The table it
     lives on is `bench-table.abide`, the same one the index mounts. -->
<script module>
import { memo } from 'abide'
import { type BenchRow, benchRowsOf, exposeBench } from 'abide-kit'
import { clockResolution } from 'abide-kit/measure'
import { LOADERS, type SuiteName } from '../../../demos/index.ts'
import Table from '../../../site/bench-table.abide'

const rowsFor = memo(async ({ name }: { name: string }): Promise<BenchRow[] | null> => {
    if (!Object.hasOwn(LOADERS, name)) return null
    const rows = benchRowsOf([(await LOADERS[name as SuiteName]()).default])
    // The out-of-process profiler's handle on these same arms — see `exposeBench`. Installed here
    // rather than guarded behind a flag: it is a read of what the page already holds, and a seam
    // that only exists under a flag is a seam nothing routinely proves still works.
    exposeBench(rows)
    return rows
})

const CLOCK =
    `This browser reports time in steps of ${clockResolution().toFixed(3)} ms; each batch is sized to ` +
    'take about 40 ms, so that clamp is the noise floor under every number below. A 1.05× difference is ' +
    'not a difference.'
</script>

<script>
import { route } from 'abide'
</script>

{#if rowsFor({ name: route().params.suite ?? '' }).pending()}
    <p class="mx-auto max-w-6xl px-6 py-16 text-slate-500">loading…</p>
{:else}
    <script>
    const rows = rowsFor({ name: route().params.suite ?? '' })
    </script>
    {#if rows}
        <div class="mx-auto max-w-6xl px-6 pt-10 pb-2">
            <h1 class="text-3xl font-semibold text-slate-100">{route().params.suite} · bench</h1>
            <p class="mt-2 text-slate-400 max-w-3xl">Every case in this suite that carries a bench, against a hand-written equivalent. Open a row for its prose, its other arms and the per-item numbers.</p>
        </div>

        <main class="mx-auto max-w-6xl px-6 pb-24 space-y-6">
            <p class="text-xs text-slate-600">{CLOCK}</p>
            <Table rows={rows}>
                <p class="pt-2 text-sm"><a href="/bench" class="text-sky-400 hover:text-sky-300">every suite →</a></p>
            </Table>
        </main>
    {:else}
        <div class="mx-auto max-w-6xl px-6 py-16">
            <h1 class="text-3xl font-semibold text-slate-100">nothing here</h1>
            <p class="mt-2 text-slate-400">There is no suite named “{route().params.suite}”.</p>
        </div>
    {/if}
{/if}
