<script module>
import { memo, state } from 'abide'

// The same component as `app.ts`, written in the `.abide` spelling — and the two are asserted to
// render identically in the `compiler` demo suite. Everything lives in `<script module>` for the
// same reason it lives at module scope there: these cells outlive any one render.
//
// Reads and writes go by NAME. `count` is the value, `count = n` is the write; the explicit
// `count()` / `count.set(n)` spelling still compiles, because this is sugar over it rather than a
// replacement for it.
export const count = state(0)
export const filter = state('')

// The load form: args are the cache key, so one slot per query.
export const search = memo(async ({ q }: { q: string }) => {
    await new Promise((resolve) => setTimeout(resolve, 30))
    return ['alpha', 'beta', 'gamma'].filter((word) => word.includes(q))
})

// The derive form: no args, so dependencies come from the body.
const doubled = memo(() => count * 2)

// A promise handed to `state` is a LOAD, not a value: `session` reads the settled thing, and the
// read below is the same one it would be if this had been `state({ name: 'guest' })`.
export const session = state(
    new Promise<{ name: string }>((resolve) => setTimeout(() => resolve({ name: 'ada' }), 20)),
)
</script>

<main>
    <h1>abide</h1>
    <p>{session.pending() ? 'loading…' : `hello ${session?.name}`}</p>
    <p class:high={count > 2} class:low={count <= 2}>count {count} · doubled {doubled}</p>
    <button onclick={() => count++}>increment</button>
    <input bind:value={filter} />
    <ul>
        {#for word of search({ q: filter })()}<li>{word}</li>{/for}
    </ul>
</main>
