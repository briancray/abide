<!-- One suite as a page of cards: its title, its blurb, and a card per case.

     Whatever is nested inside it lands after the cards — which is how the hub puts its index of the
     other suites underneath its own. -->
<script module>
import { watch } from 'abide'
import type { Suite } from 'abide/tests'
import Card from './card.abide'
</script>

<script>
import { props } from 'abide'

// `children` is absent from this: the `<slot/>` below is what asks for them, and it needs no name.
const { suite } = props<{ suite: Suite }>()

// The document's title, which is the one piece of chrome that is not an element. Guarded rather than
// assumed: this component renders on the server too, and there is no document there to name.
watch(() => {
    if (typeof document !== 'undefined') document.title = `${suite().title} — abide`
})
</script>

<div class="mx-auto max-w-5xl px-6 pt-10 pb-2">
    <h1 class="text-3xl font-semibold text-slate-100">{suite.title}</h1>
    <p class="mt-2 text-slate-400 max-w-3xl">{suite.blurb}</p>
</div>

<main class="mx-auto max-w-5xl px-6 pb-24 space-y-6">
    {#for spec of suite.cases}
        <Card spec={spec} suite={suite.name}/>
    {/for}
    <slot/>
</main>
