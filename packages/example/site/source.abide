<!-- One source pane: the body of a case, as it is written in the file it is written in.

     The text comes over an rpc rather than out of `Function.prototype.toString`, because a built
     bundle's idea of a function's source is one minified line — see `server/rpc/sources.ts`. In this
     lane that import is the address and nothing else, so the slicer and the disk it reads stay on the
     server.

     Asked for on OPEN, not on mount: a page of twelve cards would otherwise fetch two dozen bodies
     nobody looked at. The endpoint is a `memo` with the args as its cache key, so two cards showing
     one body ask once and the second reads the first one's answer. -->
<script module>
import { isPending, memo, state } from 'abide'
import { bodyOf } from '../server/rpc/sources.ts'
import { type Face, painted, type Painted } from './code.ts'

/** A pane that has nothing to show yet has nothing to say either. One identity, so it wakes nobody. */
const NOTHING: Painted[] = []
</script>

<script>
import { props } from 'abide'

const { suite, title, face, label } = props<{
    suite: string
    title: string
    face: Face
    label: string
}>()

const open = state(false)

const spans = memo((): Painted[] => {
    if (!open) return NOTHING
    try {
        // The call SELECTS the slot and the read is the fetch, exactly as a local keyed memo reads —
        // an rpc is one, so there is no handle to hold and nothing to narrow. A body that has not
        // arrived signals from here, so the pane paints nothing until it does rather than rendering
        // an empty `<pre>` and then filling it.
        return painted(bodyOf({ suite: suite(), title: title(), face: face() }).source)
    } catch (failure: unknown) {
        // A SIGNAL lands here too, because a JavaScript catch is TOTAL, and it is passed on: the body
        // has not arrived, this memo will be re-run when it does, and anything returned here is a
        // frame of red where the answer is merely late. That is what `isPending` is on `abide` for.
        if (isPending(failure)) throw failure
        // A body the file does not have, or a server that could not be asked. The pane says so in the
        // place the code would have been, which is where somebody is already looking.
        return [{ class: 'text-rose-400', text: String(failure) }]
    }
})

const toggle = (event: Event): void => {
    open = (event.currentTarget as HTMLDetailsElement).open
}
</script>

<details class="border-t border-slate-800 bg-slate-950" ontoggle={toggle}>
    <summary class="px-5 py-2 text-xs text-slate-500 cursor-pointer select-none hover:text-slate-300">{label}</summary>
    <!-- An unpainted run is text, not a `<span class="">` — whitespace and punctuation are a third of
         a body, and a wrapper that carries no class is an element per run for nothing. -->
    <pre class="px-5 pb-4 overflow-auto max-h-96 text-xs leading-relaxed text-slate-300">{#for span of spans}{#if span.class}<span class={span.class}>{span.text}</span>{:else}{span.text}{/if}{/for}</pre>
</details>
