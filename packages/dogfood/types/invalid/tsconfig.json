{
    // The fixtures here are SUPPOSED to fail, so they are checked by `test/types.test.ts` through
    // this config and excluded from the root one — a repo whose own typecheck is red says nothing.
    //
    // `exclude` is reset because it is INHERITED and resolved against this directory, so the root's
    // own "skip types/invalid" would otherwise skip everything this config exists to include.
    //
    // The include reaches into the generated tree rather than into this directory, because that is
    // where a `.abide` compiles to now — nothing beside these fixtures is a module. `rootDirs` is
    // inherited and stays anchored to the ROOT config's directory, which is what still resolves
    // `imported.abide`'s own `../models.ts` back out into the source.
    "extends": "../../../../tsconfig.json",
    "include": ["../../.abide/types/types/invalid/**/*.ts"],
    "exclude": []
}
