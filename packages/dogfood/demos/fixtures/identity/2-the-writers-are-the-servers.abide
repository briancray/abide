<script>
import { signIn, signOut } from '../../../server/rpc/docs/identity/the-writers-are-the-servers.ts'
import Answer from '../../../site/answer.abide'
import { identity, state } from 'abide'

const said = state('nobody has signed in yet')

const show = async (): Promise<void> => {
    identity.invalidate()
    said = JSON.stringify(await identity(), null, 2)
}

const inAsAda = async (): Promise<void> => {
    await signIn({ id: 'ada' })
    await show()
}

const out = async (): Promise<void> => {
    await signOut({})
    await show()
}

// The refusal, pressed rather than described: this is the SAME call the endpoint makes, from the one
// lane that may not make it.
const fromHere = async (): Promise<void> => {
    try {
        await identity.set({ id: 'nobody' })
        said = 'the browser wrote a principal, which should not have happened'
    } catch (refused) {
        said = `refused here: ${String(refused)}`
    }
}
</script>

<button onclick={inAsAda}>sign in as ada</button>
<button onclick={out}>sign out</button>
<button onclick={fromHere}>try writing one from this page</button>
<Answer source={said}/>
