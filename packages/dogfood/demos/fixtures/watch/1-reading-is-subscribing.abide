<script module>
import { state, watch } from 'abide'

export const name = state('ada')
export const runs = state(0)

// Reading a cell inside a `watch` IS the subscription. There is no dependency array.
watch(() => {
    name()
    runs += 1
})
</script>

<p>body runs: {runs}</p>
<button onclick={() => (name = name === 'ada' ? 'alan' : 'ada')}>write it</button>
