<script module>
import { memo } from 'abide'

// MODULE scope, which is about this PAGE rather than about the verb: nothing addresses this load, so
// nothing seeds it, and per-instance setup hands each substrate its own cold memo. A memo's cache is
// per CALLER, so here the three renders behind one page read one slot. See `demos/proofs.ts`.
let served = 0

const quote = memo(async ({ symbol }: { symbol: string }) => {
    await new Promise((settle) => setTimeout(settle, 400))
    return `${symbol} @ ${++served}`
})
</script>

<!-- `invalidate` DROPS the data: nothing is started, so the region is back to its placeholder and the
     next read is a cold one. -->
{#if quote({ symbol: 'ABC' }).pending()}
    <p>loading…</p>
{:else}
    <p>{quote({ symbol: 'ABC' })()}</p>
{/if}

<button onclick={() => quote({ symbol: 'ABC' }).invalidate()}>invalidate</button>
