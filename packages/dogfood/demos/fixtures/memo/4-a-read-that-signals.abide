<script>
import { memo, state } from 'abide'

const user = memo(async ({ id }: { id: number }) => {
    await new Promise((settle) => setTimeout(settle, 400))
    if (id < 1) throw new Error('no user by that id')
    return { id, name: `user ${id}` }
})

/**
 * A read with nothing to serve YET signals by THROWING, and a JavaScript `catch` is total — so a
 * try/catch written for the failures catches the signal too. Nothing is owed for that.
 *
 * The read RECORDS the signal as it raises it, and the boundary of whatever body is running re-throws
 * from that record rather than from what reached it. So the `'could not load'` below is built and
 * then discarded: the region waits, and it repaints when the load lands. Only the failure arm ever
 * reaches a reader.
 */
const nameOrTrouble = (id: number): string => {
    try {
        return user({ id })().name
    } catch {
        return 'could not load'
    }
}

const id = state(0)
</script>

<!-- Press either one: the first paint after a press is the PENDING arm, because the read signalled and
     the walk was told to come back. The `catch` above cannot change that — press "load user 1" and the
     box goes from "waiting…" to "user 1" without ever showing the fallback the catch returns. Press the
     other one and the same catch does its actual job, because a REJECTED load is not a signal. -->
<button onclick={() => id = 1}>load user 1</button>
<button onclick={() => id = -1}>load one that fails</button>
{#if id}
    {#try}<p>{nameOrTrouble(id)}</p>{:catch}<p>waiting…</p>{/try}
{/if}
