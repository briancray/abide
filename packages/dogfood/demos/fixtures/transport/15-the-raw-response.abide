<script>
import { user } from '../../../server/rpc/docs/transport/a-get-is-a-keyed-memo.ts'
import { state } from 'abide'

const shown = state('nothing asked yet')

// The same call handed back as the RESPONSE instead of a decoded value — for the cases where the
// envelope is the point: a header to read, a status to branch on, a body to hand somewhere else whole.
//
// A hatch and not a second API: `user.raw({ id })` and `user({ id })` reach the same handler by the
// same address, and the second is what a component should read. Nothing about the raw form is
// memoised, because a `Response` body can be consumed once — which is why this is a press rather than
// a slot the template subscribes to.
const envelope = async (): Promise<void> => {
    const answered = await user.raw({ id: 1 })
    shown = `${answered.status} ${answered.headers.get('content-type')}\n\n${await answered.text()}`
}
</script>

<!-- And what the DECLARATION said, readable off the handle rather than out of a parallel manifest —
     which is what lets a generated surface describe an endpoint with nothing to keep in step. -->
<p><code>{user.method}</code> — {user.description ?? 'no description'}</p>
<button onclick={envelope}>ask for the envelope</button>
<pre>{shown}</pre>
