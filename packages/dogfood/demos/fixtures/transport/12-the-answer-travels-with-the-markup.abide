<script>
import { activity } from '../../../server/rpc/docs/transport/the-answer-travels-with-the-markup.ts'
import { state } from 'abide'

const asked = state(false)
</script>

<!-- The visible half of `seed: false` is that this FETCHES: a seeded slot adopts warm and never shows
     `pending`, and this one does, because the server was told not to write its answer into the
     document. What is not visible is the point — `trail` is in the answer and was never in the HTML. -->
<button onclick={() => asked = true}>ask the server</button>
{#if asked}
    {#if activity({ id: 1 }).pending()}
        <p>asking…</p>
    {:else}
        <p>visits: {activity({ id: 1 })().visits}</p>
    {/if}
{/if}
