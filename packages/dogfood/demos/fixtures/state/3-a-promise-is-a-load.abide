<script module>
import { state } from 'abide'

// Handed a promise, `state` starts a LOAD rather than storing the promise. `who` reads the settled
// value, with the same call it would take if this had been `state({ name: 'guest' })`.
//
// MODULE scope, and that is about this PAGE rather than about the lesson: a load with no endpoint
// behind it is seeded by nothing, so per-instance setup hands the server arm and the client arm each
// its own cold one and the two disagree about `pending()`. Per caller they are one. See `demos/proofs.ts`.
const who = state(
    new Promise<{ name: string }>((settle) => setTimeout(() => settle({ name: 'ada' }), 200)),
)
</script>

{#if who.pending()}
    <p>loading…</p>
{:else}
    <p>hello {who?.name}</p>
{/if}
