<script>
import { url } from 'abide'
</script>

<!-- The same TARGET `navigate` takes, built as an href instead of taken as a move — so a link and a
     programmatic navigation cannot disagree about where they go. `navigate(url(x))` and `navigate(x)`
     are the same move for every `x`.

     Not a template literal, and that is the whole of what this buys: the pattern is the thing the app
     already writes down, a root-absolute one is NORMALISED so a trailing slash goes, and the refusals
     five rungs down happen here rather than as a 404 nobody traced.

     This form reads NOTHING, which makes it the fast path — the one called per row. -->
<ul>
    <li><a href={url('/users/[id]', { id: 42 })}>{url('/users/[id]', { id: 42 })}</a></li>
    <li><code>{url('/users/[id]/', { id: 42 })}</code> — the trailing slash is normalised away</li>
</ul>
