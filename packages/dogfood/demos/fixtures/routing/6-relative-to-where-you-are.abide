<script>
import { state, url } from 'abide'

// The rows below are the only `url` shapes that READ where the caller is, so they are the only ones
// with nothing to answer in a substrate that is neither serving a request nor a document. Behind a
// press for that reason, and because an answer resolved against `/docs/url` is the demonstration.
const asked = state(false)
</script>

<!-- A relative target is resolved against `route().url`, which makes this the one form that READS: a
     relative href in a template MOVES when the route does. That is why the pattern form three rungs up
     is the fast path and this one is not — it is one `charCodeAt` off the row that never reaches here.

     `''` is where the caller already is, which is the shape a "reload this page with a different query"
     link wants. `?tab=x` is the same idea spelled as a query alone, and both keep whatever the caller's
     own path was. -->
<button onclick={() => asked = true}>resolve against this page</button>
{#if asked}
    <ul>
        <li><code>{url('sibling')}</code> — beside where you are</li>
        <li><code>{url('./sibling')}</code> — the same thing, said explicitly</li>
        <li><code>{url('../up')}</code> — one level out</li>
        <li><code>{url('?tab=posts')}</code> — this page, another query</li>
        <li><code>{url('')}</code> — exactly where the caller is</li>
    </ul>
{/if}
