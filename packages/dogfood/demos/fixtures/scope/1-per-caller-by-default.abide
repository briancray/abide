<script>
import { readTwice } from '../../../server/rpc/docs/scope/per-caller-by-default.ts'
import { state } from 'abide'

// `invalidate` on the way in is what makes the button open a NEW REQUEST rather than repaint the slot
// this one already holds — and a new request is the whole subject of the rung.
const asked = state(false)
const ask = (): void => {
    asked = true
    readTwice({}).invalidate()
}
</script>

<!-- `first` and `second` are equal, so the second read INSIDE a request was the cache. Press again and
     both go up: the next request brought a cache of its own, and neither could see the other's. -->
<button onclick={ask}>ask the server</button>
{#if asked}
    {#if readTwice({}).pending()}
        <p>asking…</p>
    {:else}
        <pre>{JSON.stringify(readTwice({})(), null, 2)}</pre>
    {/if}
{/if}
