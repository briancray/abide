<script>
import { whatArrived } from '../../../server/rpc/docs/request/your-own-store.ts'
import Answer from '../../../site/answer.abide'
import { state } from 'abide'

const asked = state(false)
const ask = (): void => {
    asked = true
    whatArrived({}).invalidate()
}
</script>

<!-- `held` stays at 1 however many times this is pressed, which is the claim: a module-level `Map`
     would keep growing, and this one is a new store per request. -->
<button onclick={ask}>ask the server</button>
{#if asked}
    {#if whatArrived({}).pending()}
        <p>asking…</p>
    {:else}
        <Answer source={JSON.stringify(whatArrived({})(), null, 2)}/>
    {/if}
{/if}
