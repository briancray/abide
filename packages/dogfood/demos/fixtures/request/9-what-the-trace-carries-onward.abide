<script>
import { whatArrived } from '../../../server/rpc/docs/request/what-the-trace-carries-onward.ts'
import Answer from '../../../site/answer.abide'
import { state } from 'abide'

const asked = state(false)
const ask = (): void => {
    asked = true
    whatArrived({}).invalidate()
}
</script>

<!-- `outbound` names THIS request's span as the parent, so a hop made under it is a child rather than
     a root. `onTheResponse` is what abide already set on the answer you are reading. And `state` is the
     `tracestate` entry the handler added, beside whatever the caller sent — which is the row that says
     the vendor text propagates rather than being rewritten. -->
<button onclick={ask}>ask the server</button>
{#if asked}
    {#if whatArrived({}).pending()}
        <p>asking…</p>
    {:else}
        <Answer source={JSON.stringify(whatArrived({})(), null, 2)}/>
    {/if}
{/if}
