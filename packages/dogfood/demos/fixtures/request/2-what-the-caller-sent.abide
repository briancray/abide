<script>
import { whatArrived } from '../../../server/rpc/docs/request/what-the-caller-sent.ts'
import { state } from 'abide'

const asked = state(false)
const ask = (): void => {
    asked = true
    whatArrived({}).invalidate()
}

// The browser's half of a cookie, so the two buttons are the whole round trip: this writes one and
// `ask` reads back what the server parsed out of the header it travelled in.
const setTheme = (theme: string) => (): void => {
    document.cookie = `theme=${theme}; path=/`
}
</script>

<button onclick={setTheme('dark')}>set theme=dark</button>
<button onclick={setTheme('light')}>set theme=light</button>
<button onclick={ask}>ask the server</button>
{#if asked}
    {#if whatArrived({}).pending()}
        <p>asking…</p>
    {:else}
        <pre>{JSON.stringify(whatArrived({})(), null, 2)}</pre>
    {/if}
{/if}
