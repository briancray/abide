<script>
import { catalogue } from '../../../server/rpc/docs/responses/answer-with-events.ts'
import { state } from 'abide'

// The same source and the same reader as the rung above; what shows the difference is the FRAMING,
// so the raw text is printed rather than parsed. `data: …` per record is what an `EventSource` reads.
const shown = state('nothing asked yet')

const ask = async (): Promise<void> => {
    const answered = await catalogue.raw({})
    shown = `${answered.headers.get('content-type')}\n\n${await answered.text()}`
}
</script>

<button onclick={ask}>ask for them</button>
<pre>{shown}</pre>
