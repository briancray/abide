<script>
import { catalogue } from '../../../server/rpc/docs/responses/answer-with-a-location.ts'
import { state } from 'abide'

// A browser is not allowed to READ a redirect — `redirect: 'manual'` hands back an opaque response
// with no headers on it — so what a page can honestly show is the hop having been taken: `redirected`
// is true and `url` is where it ended up, which is the Location the server sent.
const shown = state('nothing asked yet')

const ask = async (): Promise<void> => {
    const answered = await catalogue.raw({ id: 1 })
    shown = `followed: ${answered.redirected}\nlanded on: ${answered.url}\nwith: ${answered.status}`
}
</script>

<button onclick={ask}>ask for it</button>
<pre>{shown}</pre>
