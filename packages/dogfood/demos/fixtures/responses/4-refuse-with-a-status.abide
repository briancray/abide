<script>
import { catalogue, whatItWas } from '../../../server/rpc/docs/responses/refuse-with-a-status.ts'
import { state } from 'abide'

const shown = state('nothing asked yet')

// LEFT TO FLY: nothing caught the throw, so what arrives is the refusal itself — a 400 carrying the
// phrase the handler gave it.
const refused = async (): Promise<void> => {
    const answered = await catalogue.raw({ id: 0 })
    shown = `${answered.status}\n\n${await answered.text()}`
}

// And the same throw caught on the way out, which is what `onError` and any `catch` between sees:
// `HttpError` is the class, and 400 is still 400 four frames later.
const caught = async (): Promise<void> => {
    shown = JSON.stringify(await whatItWas({ id: 0 }), null, 2)
}
</script>

<button onclick={refused}>ask for id 0</button>
<button onclick={caught}>…and what a catch sees</button>
<pre>{shown}</pre>
