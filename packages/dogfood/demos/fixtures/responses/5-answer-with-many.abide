<script>
import { catalogue } from '../../../server/rpc/docs/responses/answer-with-many.ts'
import { state } from 'abide'

// Read as a STREAM rather than as one body, because arriving-as-they-are-produced is the claim: each
// line is appended as it lands, and nothing here waited for the last one.
const lines = state<string[]>([])

const ask = async (): Promise<void> => {
    lines = []
    const answered = await catalogue.raw({})
    const reader = answered.body?.getReader()
    if (reader === undefined) return
    const decoder = new TextDecoder()
    for (;;) {
        const { done, value } = await reader.read()
        if (done) break
        for (const line of decoder.decode(value, { stream: true }).split('\n')) {
            if (line !== '') lines = [...lines, line]
        }
    }
}
</script>

<button onclick={ask}>ask for them</button>
<ul>{#for line of lines}<li><code>{line}</code></li>{/for}</ul>
