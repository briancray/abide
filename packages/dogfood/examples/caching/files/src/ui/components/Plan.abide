<script>
import { memo, props } from 'abide'
import { getCustomer } from '#server/rpc/customers'

const { id } = props<{ id: string }>()

// The SAME args key as the page, so this is the load already in
// flight rather than a second request. Nothing was lifted and
// nothing was threaded back down.
const customer = memo(() => getCustomer({ id }))
</script>

<p>Plan: {customer.plan}</p>
