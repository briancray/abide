<script>
import { reactive } from 'abide'
import { getViewer } from '#server/rpc/session'

const viewer = reactive(() => getViewer())

// Until the gate lands this run is abandoned, never branched.
const mode = reactive(() => (viewer.readOnly ? 'locked' : 'editable'))
</script>

<ul class="fields stacked">
    <li><span>branched on the gate</span>
        <button disabled={mode === 'locked'}>Save</button></li>
    <li><span>locked until the gate lands</span>
        <button disabled={!mode.ready() || mode === 'locked'}>Save</button></li>
</ul>
