<script>
import { computed, reactive } from '@abide/abide'

import askClaude from '../askClaude.handler.ts'

const QUESTION = 'Which company is Ada at?'

let asked = reactive(false)
const events = computed(() =>
    asked ? askClaude({ messages: [{ role: 'user', content: QUESTION }] }) : [],
)
</script>

<div class="row">
    <button disabled={asked} onclick={() => {
        asked = true
    }}>Ask</button>
    <span class="status">{QUESTION}</span>
</div>

{#for event of events}
    {#if event.type === 'content_block_delta' && event.delta.type === 'text_delta'}
        <pre class="rounded-md border border-rule bg-raised p-snug
            text-chrome">{event.delta.text}</pre>
    {/if}
{/for}
