<script>
import { pairing, reactive } from '@abide/abide'

import askClaudeCode from '../askClaudeCode.handler.ts'
import permitClaudeCode from '../permitClaudeCode.handler.ts'

const QUESTION = 'Which company is Grace at?'

const { status, step, copied, start, copyInstall } = pairing()
let asked = reactive(0)
const events = reactive(() =>
    asked
        ? askClaudeCode({ messages: [{ role: 'user', content: QUESTION }] })
        : [],
)

// The reply arrives in pieces, one `text` event each.
const answer = reactive(() => {
    let text = ''
    for (const event of events) if (event.type === 'text') text += event.text
    return text
})

// A tool auto mode would not approve on its own waits on you.
let answered = reactive<string[]>([])
const prompt = reactive(() => {
    for (const event of events)
        if (event.type === 'permission' && !answered.includes(event.id))
            return event
    return undefined
})

async function permit(allow: boolean) {
    const asked = prompt
    if (asked === undefined) return
    answered = [...answered, asked.id]
    await permitClaudeCode({ id: asked.id, allow })
}
</script>

{#if status.error()}
    <p class="status">claude code is unavailable</p>
{:else if status?.paired}
    <ul class="fields">
        <li><span>your claude code</span><strong>paired</strong></li>
    </ul>
    <div class="row">
        <button disabled={step === 'waiting'} onclick={start}>
            Reconnect</button>
    </div>
{:else if !status}
    <p class="status">Connecting…</p>
{:else if step === 'install'}
    <pre class="rounded-md border border-rule bg-raised p-snug
        text-chrome">{status.install}</pre>
    <div class="row">
        <button onclick={copyInstall}>
            {copied ? 'Copied' : 'Copy'}</button>
        <span class="status">then pair again</span>
    </div>
{:else}
    <pre class="rounded-md border border-rule bg-raised p-snug
        text-chrome">{status.command}</pre>
    <div class="row">
        <button disabled={step === 'waiting'} onclick={start}>
            {step === 'waiting' ? 'Pairing…' : 'Pair with a click'}</button>
    </div>
{/if}

<ul class="chat">
    <li data-speaker="you"><span>you</span><p>{QUESTION}</p></li>
{#if answer}
        <li><span>claude code</span><p>{answer}</p></li>
    {/if}
</ul>

{#if prompt}
    <div class="row">
        <span class="status">claude code asks to run {prompt.name}</span>
        <button onclick={() => permit(true)}>Allow</button>
        <button onclick={() => permit(false)}>Deny</button>
    </div>
{/if}

<div class="row">
    <button onclick={() => {
        asked += 1
    }}>Ask</button>
    <span class="status">{events.error()?.message ?? ''}</span>
</div>
