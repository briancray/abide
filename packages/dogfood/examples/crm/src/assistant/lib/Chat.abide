<script>
// THE CRM'S CONVERSATION, its markup over `chat`'s parts: an answer as the CRM's markdown, a tool
// call as one line, Ask again under an answer that ended, and a prompt Claude Code asks permission
// with.
import {
    type AssistantTurn,
    type Attributes,
    chat,
    type ChatOptions,
    props,
} from '@abide/abide'

import Markdown from '#src/lib/Markdown.abide'

const {
    ask,
    permit,
    turns = [],
    placeholder = 'Ask anything',
    ...rest
} = props<
    {
        ask: ChatOptions['ask']
        permit?: ChatOptions['permit']
        turns?: AssistantTurn[]
        placeholder?: string
    } & Attributes<'section'>
>()

const talk = chat({ ask, permit, turns })
</script>

<section {...rest} {...talk.root} class="flex flex-col gap-snug">
    <ol {...talk.transcript} class="chat">
        {#for turn, index of talk.turns by turn}
            <li {...talk.turn(turn, index).turn}>
                <span {...talk.turn(turn, index).speaker}>{talk.turn(turn, index).role}</span>
                {#for part of turn.parts by part}
                    {#if part.type === 'text' && turn.role === 'assistant'}
                        <Markdown {...talk.text} source={part.text}
                            streaming={talk.turn(turn, index).streaming} />
                    {:else if part.type === 'text'}
                        <p {...talk.text}>{part.text}</p>
                    {:else if part.type === 'image'}
                        <img {...talk.image(part)} alt="an image you sent">
                    {:else if part.type === 'tool'}
                        <span {...talk.tool(part).tool} class="status">used {part.name.split('_').at(-1)}</span>
                    {:else if part.type === 'permission'}
                        <div {...talk.permission(part).permission}>
                            <span {...talk.permission(part).name}>{part.name}</span>
                            <pre {...talk.permission(part).input}>{JSON.stringify(part.input, null, 2) ?? ''}</pre>
                            <button {...talk.permission(part).allow}>Allow</button>
                            <button {...talk.permission(part).deny}>Deny</button>
                        </div>
                    {/if}
                {/for}
                {#if turn.failed !== undefined}
                    <p {...talk.turn(turn, index).failure}>{turn.failed}</p>
                {/if}
                {#if turn.role === 'assistant' && !talk.turn(turn, index).streaming}
                    <div {...talk.turn(turn, index).actions}>
                        <button type="button" onclick={talk.turn(turn, index).retry}>Ask again</button>
                    </div>
                {/if}
            </li>
        {/for}
    </ol>
    <button {...talk.jump}>↓ Latest</button>

    <form {...talk.composer} class="row">
        {#if talk.attached.length > 0}
            <div {...talk.attachments}>
                {#for image of talk.attached by image}
                    <span {...talk.attachment(image).attachment}>
                        <img {...talk.attachment(image).image} alt="an image to send">
                        <button {...talk.attachment(image).remove}>×</button>
                    </span>
                {/for}
            </div>
        {/if}
        {#if talk.pending}
            <div {...talk.queued}>
                <span>{talk.pending
                    .map((part) => (part.type === 'text' ? part.text : 'an image'))
                    .join(' ')}</span>
                <button {...talk.cancel}>Cancel</button>
            </div>
        {/if}
        <textarea {...talk.input} placeholder={placeholder}></textarea>
        {#if talk.streaming}
            <button {...talk.stop}>Stop</button>
        {/if}
        <button {...talk.send}>{talk.streaming ? 'Queue' : 'Send'}</button>
    </form>
</section>
