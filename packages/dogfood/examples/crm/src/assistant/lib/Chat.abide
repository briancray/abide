<script>
// THE CRM'S CONVERSATION, its markup over `chat`'s parts: an answer as the CRM's markdown, a tool
// call as one line, Ask again under an answer that ended, and a prompt Claude Code asks permission
// with.
import {
    type AssistantMessage,
    type Attributes,
    chat,
    type ChatOptions,
    props,
} from '@abide/abide'

import Markdown from '#src/lib/Markdown.abide'

const {
    ask,
    permit,
    messages = [],
    placeholder = 'Ask anything',
    ...rest
} = props<
    {
        ask: ChatOptions['ask']
        permit?: ChatOptions['permit']
        messages?: AssistantMessage[]
        placeholder?: string
    } & Attributes<'section'>
>()

const talk = chat({ ask, permit, messages })
</script>

<section {...rest} {...talk.root} class="flex flex-col gap-snug">
    <ol {...talk.transcript} class="chat">
        {#for message, index of talk.messages key message}
            {#if talk.message(message, index).shown}
                <li {...talk.message(message, index).message}>
                    <span {...talk.message(message, index).speaker}>{talk.message(message, index).role}</span>
                    {#for block of talk.message(message, index).blocks key block}
                        {#if block.type === 'text' && message.role === 'assistant'}
                            <Markdown {...talk.text} source={block.text}
                                streaming={talk.message(message, index).streaming} />
                        {:else if block.type === 'text'}
                            <p {...talk.text}>{block.text}</p>
                        {:else if block.type === 'image'}
                            <img {...talk.image(block)} alt="an image you sent">
                        {:else if block.type === 'document'}
                            <span {...talk.document(block)} class="status">{block.title ?? 'a document'}</span>
                        {:else if block.type === 'tool_use'}
                            <span {...talk.tool(block).tool} class="status">used {block.name.split('_').at(-1)}</span>
                        {/if}
                    {/for}
                    {#if talk.message(message, index).ends &&
                        !talk.message(message, index).streaming}
                        <div {...talk.message(message, index).actions}>
                            <button type="button" onclick={talk.message(message, index).retry}>Ask again</button>
                        </div>
                    {/if}
                </li>
            {/if}
        {/for}
        {#for prompt of talk.permissions key prompt}
            <li {...talk.permission(prompt).permission}>
                <span {...talk.permission(prompt).name}>{prompt.name}</span>
                <pre {...talk.permission(prompt).input}>{JSON.stringify(prompt.input, null, 2) ?? ''}</pre>
                <button {...talk.permission(prompt).allow}>Allow</button>
                <button {...talk.permission(prompt).deny}>Deny</button>
            </li>
        {/for}
    </ol>
    {#if talk.failed !== undefined}
        <p {...talk.failure}>{talk.failed}</p>
    {/if}
    <button {...talk.jump}>↓ Latest</button>

    <form {...talk.composer} class="row">
        {#if talk.attached.length > 0}
            <div {...talk.attachments}>
                {#for piece of talk.attached key piece}
                    <span {...talk.attachment(piece).attachment}>
                        {#if piece.type === 'image'}
                            <img {...talk.attachment(piece).image} alt="an image to send">
                        {:else}
                            <span>{piece.title ?? 'a document'}</span>
                        {/if}
                        <button {...talk.attachment(piece).remove}>×</button>
                    </span>
                {/for}
            </div>
        {/if}
        {#if talk.pending}
            <div {...talk.queued}>
                <span>{talk.pending
                    .map((block) =>
                        block.type === 'text' ? block.text : `a ${block.type}`,
                    )
                    .join(' ')}</span>
                <button {...talk.cancel}>Cancel</button>
            </div>
        {/if}
        <textarea {...talk.input} placeholder={placeholder}></textarea>
        {#if talk.streaming}
            <button {...talk.stop}>Stop</button>
        {/if}
        <button {...talk.send}>{talk.streaming ? 'Queue' : 'Send'}</button>
    </form>
</section>
