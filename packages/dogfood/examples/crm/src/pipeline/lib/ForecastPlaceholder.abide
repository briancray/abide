<script>
import { format, memo } from '@abide/abide'

import getForecast from '../getForecast.handler.ts'

const forecast = memo(() => getForecast())
</script>

{#try}
    <ul class="tiles">
        <li><span>forecast</span><strong>{format.money(forecast, { maximumFractionDigits: 0 })}</strong></li>
    </ul>
{:pending}
    <p class="status">Adding up the pipeline…</p>
{/try}

<div class="row">
    <button onclick={() => forecast.refresh()}>Reload now</button>
</div>
