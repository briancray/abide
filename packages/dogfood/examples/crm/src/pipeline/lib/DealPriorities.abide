<script>
import { reactive, sortableList } from '@abide/abide'

const DEALS = [
    { id: 'd1', name: 'Engine renewal' },
    { id: 'd2', name: 'Babbage pilot' },
    { id: 'd3', name: 'Hopper expansion' },
]
let order = reactive<readonly string[]>([])
const ranks = sortableList({
    items: DEALS,
    order,
    key: (deal) => deal.id,
    label: (deal) => deal.name,
})
</script>

<ol class="flex flex-col gap-hair" {...ranks.list}>
    {#for deal of ranks.sorted by deal.id}
        <li class="row" {...ranks.item(deal).item}>
            <button {...ranks.item(deal).handle}>⠿</button>
            <span>{deal.name}</span>
        </li>
    {/for}
</ol>
