<script>
import { reactive } from '@abide/abide'

let copied = reactive(false, { ttl: 2_000 })

async function copy(): Promise<void> {
    await navigator.clipboard.writeText(`${location.origin}/pipeline#d1`)
    copied = true
}
</script>

<div class="row">
    <span>Analytical Engines renewal</span>
    <button onclick={copy}>{copied ? 'Copied' : 'Copy link'}</button>
</div>
