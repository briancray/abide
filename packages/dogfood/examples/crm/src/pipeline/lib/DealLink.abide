<script>
import { copyText } from '@abide/abide'

// The address is read as the click lands, on whichever origin serves the page.
const copyLink = copyText(() => `${location.origin}/pipeline#d1`, {
    copiedFor: 2_000,
})
</script>

<div class="row">
    <span>Analytical Engines renewal</span>
    <button class="group" bind:element={copyLink}>
        <span class="group-data-copied:hidden">Copy link</span>
        <span class="hidden group-data-copied:inline">Copied</span>
    </button>
</div>
