<script>
import { isFailed, reactive } from '@abide/abide'

import getArchivedDeal from '../archive/getArchivedDeal.handler.ts'
import reopenDeal from '../archive/reopenDeal.handler.ts'

const deal = reactive(() => getArchivedDeal())

let status = reactive('')

async function reopen() {
    try {
        await reopenDeal()
    } catch (refusal) {
        // A lane's refusal is not one of the handler's typed failures.
        if (!isFailed(refusal)) throw refusal
        status = `${refusal.status} ${refusal.name}: ${refusal.message}`
    }
}
</script>

<ul class="fields">
    <li><span>{deal.ready() ? deal.name : '—'}</span>
        <strong>{deal.ready() ? deal.stage : '—'}</strong></li>
</ul>
<div class="row">
    <button onclick={reopen}>Reopen</button>
    <span class="status">{status}</span>
</div>
