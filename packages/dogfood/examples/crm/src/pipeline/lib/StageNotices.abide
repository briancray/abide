<script>
import { reactive, toasts } from '@abide/abide'

const shown = toasts.host({ label: 'Stage changes' })
let stage = reactive('Proposal')

function advance() {
    const from = stage
    stage = 'Verbal'
    toasts.notify('Engine renewal moved to Verbal', {
        tone: 'success',
        action: { label: 'Undo', run: () => (stage = from) },
    })
}
</script>

<p class="row">
    <span>stage</span><strong>{stage}</strong>
    <button onclick={advance}>Advance</button>
</p>

<ol {...shown.region} class="flex flex-col gap-tight">
    {#for toast of shown.notices by toast.id}
        <li {...shown.notice(toast).notice} class="row data-[tone=success]:text-good">
            <span>{toast.text}</span>
            {#if toast.action}
                <button {...shown.notice(toast).action}>{toast.action.label}</button>
            {/if}
            <button {...shown.notice(toast).close}>Close</button>
        </li>
    {/for}
</ol>
