<script>
import { format, reactive } from '@abide/abide'

import listTargets from '../listTargets.server.ts'
import setTarget from '../setTarget.server.ts'

let next = reactive<number | undefined>(600_000)
const targets = reactive.derived(() => listTargets())

// The log reads the targets table, so a target set loads it again.
async function record() {
    if (next === undefined) return
    await setTarget({ target: next })
}
</script>

<div class="row">
    <input type="number" step="50000" aria-label="new target" bind:value={next}>
    <button onclick={record}>Set target</button>
</div>

<ul class="fields stacked">
    {#for row of targets key row.id}
        <li><span>{row.setAt}</span><strong>{format.money(row.target, { maximumFractionDigits: 0 })}</strong></li>
    {/for}
</ul>
