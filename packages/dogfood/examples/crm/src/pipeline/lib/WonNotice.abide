<script>
import { toasts } from '@abide/abide'

const shown = toasts.host()

// The notice fades out, and stays in the page until it has (32.38).
function fadeOut(element: Element) {
    return () =>
        element.animate([{ opacity: 1 }, { opacity: 0 }], { duration: 200 })
            .finished
}
</script>

<button onclick={() => toasts.notify('Engine renewal is won', { tone: 'success' })}>
    Mark won
</button>

<div {...shown.region} class="fixed right-5 bottom-5 flex flex-col gap-tight">
    {#for toast of shown.notices by toast.id}
        <div {...shown.notice(toast).notice}>
            <p class="row" bind:element={fadeOut}>
                <strong>Won.</strong> {toast.text}
                <button onclick={shown.notice(toast).dismiss}>Close</button>
            </p>
        </div>
    {/for}
</div>
