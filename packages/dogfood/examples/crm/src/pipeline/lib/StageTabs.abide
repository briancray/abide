<script>
import { reactive, tabs } from '@abide/abide'

import listDeals from '../listDeals.server.ts'

const STAGES = ['lead', 'qualified', 'proposal']

const deals = reactive(() => listDeals())
let stage = reactive<string | undefined>('lead')
const view = tabs({ items: STAGES, selected: stage })
</script>

<div class="tabs" {...view.list}>
    {#for each of STAGES}
        <button {...view.tab(each).button}>{each}</button>
    {/for}
</div>
<ul class="fields stacked" {...view.panel}>
    {#for deal of deals.filter((each) => each.stage === stage) key deal.id}
        <li><span>{deal.stage}</span><strong>{deal.name}</strong></li>
    {/for}
</ul>
