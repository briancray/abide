<script>
import { reactive } from '@abide/abide'

import { listDeals } from '../listDeals.server.ts'
import { selectedDeal } from './selectedDeal.ts'

const deals = reactive(() => listDeals())
const selected = selectedDeal()
const deal = reactive(() =>
    deals.ready() ? deals.find((each) => each.id === selected) : undefined,
)
</script>

<ul class="fields stacked">
    <li><span>selected</span><strong>{deal?.name ?? '—'}</strong></li>
    <li><span>stage</span><strong>{deal?.stage ?? '—'}</strong></li>
</ul>
