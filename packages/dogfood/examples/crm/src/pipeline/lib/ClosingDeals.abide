<script>
import {
    type Column,
    format,
    reactive,
    type Sort,
    sortableTable,
} from '@abide/abide'

import { listClosing } from '../listClosing.server.ts'
import { STAGES } from './STAGES.ts'

type Deal = { id: string; name: string; stage: string; amount: number }

const COLUMNS: Column<Deal>[] = [
    { key: 'name', label: 'Deal', sortable: false },
    {
        key: 'stage',
        label: 'Stage',
        value: (deal) => STAGES.indexOf(deal.stage),
        format: (_, deal) => deal.stage,
    },
    {
        key: 'amount',
        label: 'Amount',
        align: 'end',
        // The largest deal first, on the first press.
        firstDirection: 'descending',
        format: (amount) =>
            format.money(Number(amount), { maximumFractionDigits: 0 }),
    },
    { key: 'closes', label: 'Closes', format: (date) => String(date ?? '—') },
]

const deals = reactive(() => listClosing())
let sort = reactive<Sort | undefined>({ key: 'closes', direction: 'ascending' })
let picked = reactive<string | undefined>(undefined)
const table = sortableTable({
    rows: () => deals,
    columns: COLUMNS,
    sort,
})
</script>

<p class="status">{picked ?? 'no deal picked'}</p>
<table
    {...table.table}
    class="[&_[data-align=end]]:text-right [&_[data-sort]_button]:text-signal
    [&_[data-sort=ascending]_button]:after:content-['_↑']
    [&_[data-sort=descending]_button]:after:content-['_↓']"
>
    <thead>
        <tr>
            {#for column of COLUMNS key column.key}
                <th {...table.column(column).header}>
                    {#if column.sortable === false}
                        {column.label}
                    {:else}
                        <button
                            {...table.column(column).sort}
                            class="bg-transparent p-0 text-muted"
                        >{column.label}</button>
                    {/if}
                </th>
            {/for}
        </tr>
    </thead>
    <tbody>
        {#for deal of table.rows key deal.id}
            <tr
                {...table.row(deal).row}
                data-stage={deal.stage}
                onclick={() => (picked = deal.name)}
                class="cursor-pointer data-[stage=won]:font-semibold"
            >
                {#for column of COLUMNS key column.key}
                    <td {...table.column(column).cell}>
                        {table.text(deal, column)}
                    </td>
                {/for}
            </tr>
        {/for}
    </tbody>
</table>
