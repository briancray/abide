<script>
import { format, reactive } from '@abide/abide'

import { targetStore } from './targetStore.ts'

// One option, and the reads and writes below are untouched.
let target = reactive<number | undefined>(500_000, { store: targetStore })
</script>

<label>the team's target this quarter
    <input type="number" step="50000" bind:value={target}>
</label>

<ul class="tiles">
    <li><span>target</span><strong>{format.money(target ?? 0, { digits: 0 })}</strong></li>
</ul>
