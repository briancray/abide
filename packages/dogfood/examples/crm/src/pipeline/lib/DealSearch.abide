<script>
import { computed, memo, reactive } from '@abide/abide'

import searchDeals from '../searchDeals.handler.ts'

let q = reactive('')
const searching = memo(({ q }: { q: string }) => searchDeals({ q }), {
    debounce: 300,
})
const found = computed(() => searching({ q }))
</script>

<label>search deals
    <input bind:value={q} placeholder="hopper">
</label>

<ul class="fields">
    {#for name of found}
        <li><strong>{name}</strong></li>
    {/for}
</ul>
