<script>
import { computed, reactive } from '@abide/abide'

import searchDeals from '../searchDeals.handler.ts'

let q = reactive('', { debounce: 300 })
const found = computed(() => searchDeals({ q }))
</script>

<label>search deals
    <input bind:value={q} placeholder="hopper">
</label>

<ul class="fields">
    {#for name of found}
        <li><strong>{name}</strong></li>
    {/for}
</ul>
