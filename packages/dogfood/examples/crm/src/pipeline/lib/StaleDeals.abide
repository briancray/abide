<script>
import { type Column, format, reactive, sortableTable } from '@abide/abide'

type Deal = { id: string; name: string; amount: number; stage: string }

const COLUMNS: Column<Deal>[] = [
    { key: 'name', label: 'Deal' },
    { key: 'stage', label: 'Stage' },
    { key: 'amount', label: 'Amount', align: 'end' },
]

let deals = reactive<Deal[]>([
    {
        id: 'lovelace-audit',
        name: 'Lovelace audit',
        amount: 9_000,
        stage: 'qualified',
    },
    {
        id: 'turing-seats',
        name: 'Turing seats',
        amount: 22_000,
        stage: 'proposal',
    },
    {
        id: 'hopper-renewal',
        name: 'Hopper renewal',
        amount: 48_000,
        stage: 'proposal',
    },
    {
        id: 'noether-pilot',
        name: 'Noether pilot',
        amount: 6_500,
        stage: 'lead',
    },
])
let selected = reactive<readonly string[]>([])
// The table as parts on markup of the page's own: an amount written as money.
const table = sortableTable({
    rows: () => deals,
    columns: COLUMNS,
    selected,
})

// A bulk action over the rows picked: each goes to lost, and the pick is cleared.
function markLost() {
    deals = deals.map((deal) =>
        selected.includes(deal.id) ? { ...deal, stage: 'lost' } : deal,
    )
    selected = []
}
</script>

<div class="row">
    <span class="status">{selected.length} selected</span>
    <button onclick={markLost} disabled={selected.length === 0}>Mark lost</button>
</div>
<table class="[&_[data-selected]]:bg-signal/10">
    <thead>
        <tr>
            <th {...table.selectAll.select}><input {...table.selectAll.checkbox}></th>
            {#for column of COLUMNS key column.key}
                <th {...table.column(column).header} class="data-[align=end]:text-right">
                    <button {...table.column(column).sort} class="bg-transparent p-0 text-muted">{column.label}</button>
                </th>
            {/for}
        </tr>
    </thead>
    <tbody>
        {#for deal of table.rows key deal.id}
            <tr {...table.row(deal).row}>
                <td {...table.row(deal).select}><input {...table.row(deal).checkbox}></td>
                <td>{deal.name}</td>
                <td>{deal.stage}</td>
                <td class="text-right">{format.money(deal.amount, { maximumFractionDigits: 0 })}</td>
            </tr>
        {/for}
    </tbody>
</table>
