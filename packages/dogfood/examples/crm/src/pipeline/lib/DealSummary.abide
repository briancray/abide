<script>
import { reactive } from '@abide/abide'

import Markdown from '#src/lib/Markdown.abide'

import summarizeDeal from '../summarizeDeal.server.ts'

let asked = reactive(false)
const summary = reactive.derived(() => (asked ? summarizeDeal() : []))
</script>

<div class="row">
    <button disabled={asked} onclick={() => (asked = true)}>
        Summarize the renewal
    </button>
</div>
<Markdown
    source={summary.join('')}
    aria-label="Summary"
    class="flex flex-col gap-tight"
 />
