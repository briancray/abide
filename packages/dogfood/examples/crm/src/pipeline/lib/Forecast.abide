<script>
import { format, memo } from '@abide/abide'

import getForecast from '../getForecast.handler.ts'

const forecast = memo(() => getForecast())
const reloading = memo(() => forecast.busy() && forecast.ready())
</script>

{#if forecast.busy() && !forecast.ready()}
    <p class="status">Adding up the pipeline…</p>
{:else}
    <ul class="tiles">
        <li><span>forecast</span><strong>{format.money(forecast, { digits: 0 })}</strong></li>
    </ul>
{/if}

<div class="row">
    <button onclick={() => forecast.invalidate()}>Mark stale</button>
    <button onclick={() => forecast.refresh()}>Reload now</button>
    <span class="status">{reloading ? 'reloading…' : ''}</span>
</div>
