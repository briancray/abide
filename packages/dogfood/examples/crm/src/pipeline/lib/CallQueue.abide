<script>
import { listbox, reactive } from '@abide/abide'

import listDeals from '../listDeals.handler.ts'

type Deal = { id: string; name: string; stage: string; amount: number }

const deals = reactive(() => listDeals())
const leads = reactive(() => deals.filter((deal) => deal.stage === 'lead'))
let calling = reactive('')

const queue = listbox({
    id: 'leads',
    options: () => leads,
    key: (deal: Deal) => deal.id,
    onpick: (deal) => {
        calling = deal.name
    },
})
</script>

<ul
    role="listbox"
    tabindex="0"
    aria-label="Leads to call"
    aria-activedescendant={queue.activeId}
    onkeydown={queue.keydown}
    class="fields rounded-md border border-rule p-2
        [&>[data-active]]:bg-signal/10"
>
    {#for deal of leads by deal.id}
        <li
            id={queue.idOf(deal.id)}
            role="option"
            aria-selected={queue.active === deal.id ? 'true' : 'false'}
            data-active={queue.active === deal.id ? '' : undefined}
            onclick={() => queue.activate(deal.id)}
        >{deal.name}</li>
    {/for}
</ul>

<ul class="fields">
    <li><span>calling</span><strong>{calling || '—'}</strong></li>
</ul>
