<script>
import { computed, listbox, reactive } from '@abide/abide'

import listDeals from '../listDeals.handler.ts'

const deals = computed(() => listDeals())
const leads = computed(() => deals.filter((deal) => deal.stage === 'lead'))
let calling = reactive('')

const queue = listbox({
    id: 'leads',
    options: () => leads,
    onpick: (deal) => {
        calling = deal.name
    },
})
</script>

<ul
    {...queue.listbox}
    tabindex="0"
    aria-label="Leads to call"
    aria-activedescendant={queue.activeId}
    onkeydown={queue.onkeydown}
    class="fields rounded-md border border-rule p-2
        [&>[data-active]]:bg-signal/10"
>
    {#for deal of leads key deal.id}
        <li {...queue.option(deal)}>{deal.name}</li>
    {/for}
</ul>

<ul class="fields">
    <li><span>calling</span><strong>{calling || '—'}</strong></li>
</ul>
