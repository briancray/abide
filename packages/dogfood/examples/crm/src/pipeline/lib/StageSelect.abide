<script>
import { reactive, select } from '@abide/abide'

import { STAGES } from './STAGES.ts'

let stage = reactive<string | undefined>(undefined)
const choose = select({
    id: 'deal-stage',
    options: STAGES,
    name: 'stage',
    value: stage,
})
</script>

<form class="fields stacked" onsubmit={(event) => event.preventDefault()}>
    <span id="deal-stage-label">Stage</span>
    <div {...choose.root} class="picker">
        <div {...choose.trigger} aria-labelledby="deal-stage-label">
            {stage ?? 'Pick a stage'}
        </div>
        <input {...choose.input}>
        {#if choose.open}
            <div {...choose.popup}>
                <ul {...choose.listbox}>
                    {#for each of choose.items key each}
                        <li {...choose.option(each)}>{each}</li>
                    {/for}
                </ul>
            </div>
        {/if}
    </div>
</form>
