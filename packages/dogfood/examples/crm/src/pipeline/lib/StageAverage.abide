<script>
import { format, reactive } from '@abide/abide'

import { getStage } from '../getStage.server.ts'
import { STAGES } from './STAGES.ts'

let stage = reactive('lead')
const totals = reactive(() => getStage({ stage }))
const average = reactive(() =>
    totals.ready() && totals.count > 0
        ? format.money(Math.round(totals.value / totals.count), {
              maximumFractionDigits: 0,
          })
        : '—',
)
</script>

<ul class="fields stacked">
    <li><span>stage</span>
        <select bind:value={stage}>
            {#for one of STAGES}
                <option value={one}>{one}</option>
            {/for}
        </select></li>
    <li><span>average</span><strong>{average}</strong></li>
</ul>
