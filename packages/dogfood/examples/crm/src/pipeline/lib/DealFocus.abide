<script>
import { sortableList } from '@abide/abide'

const DEALS = [
    { id: 'd1', name: 'Engine renewal' },
    { id: 'd2', name: 'Babbage pilot' },
    { id: 'd3', name: 'Hopper expansion' },
    { id: 'd4', name: 'Lovelace audit' },
]
const thisWeek = sortableList({
    items: DEALS.slice(0, 1),
    group: 'focus',
    label: (deal) => deal.name,
})
const later = sortableList({
    items: DEALS.slice(1),
    group: 'focus',
    label: (deal) => deal.name,
})
</script>

<div class="tiles">
    <ol class="flex min-h-24 flex-col gap-hair" aria-label="This week" {...thisWeek.list}>
        {#for deal of thisWeek.sorted key deal.id}
            <li class="row data-active:bg-raised" {...thisWeek.item(deal).item}>
                <span class="cursor-grab" {...thisWeek.item(deal).handle}>⠿</span>
                <span>{deal.name}</span>
            </li>
        {/for}
    </ol>
    <ol class="flex min-h-24 flex-col gap-hair" aria-label="Later" {...later.list}>
        {#for deal of later.sorted key deal.id}
            <li class="row data-active:bg-raised" {...later.item(deal).item}>
                <span class="cursor-grab" {...later.item(deal).handle}>⠿</span>
                <span>{deal.name}</span>
            </li>
        {/for}
    </ol>
</div>
