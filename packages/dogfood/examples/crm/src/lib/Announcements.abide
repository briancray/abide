<script>
// The banner across the top of a CRM page.
import { announcements } from './announcements.ts'

const shown = announcements.host({ label: 'Announcements' })
</script>

<ul {...shown.region} class="flex flex-col gap-tight">
    {#for notice of shown.notices key notice.id}
        <li
            {...shown.notice(notice).notice}
            class="row rounded-lg border border-rule bg-raised px-4 py-2"
        >
            <span {...shown.notice(notice).text}>{notice.text}</span>
            <button {...shown.notice(notice).close} class="bg-transparent text-muted">×</button>
        </li>
    {/for}
</ul>
