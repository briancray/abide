<script>
// The corner every `toasts.notify` on a CRM page lands in.
import { toasts } from '@abide/abide'

const shown = toasts.host()
</script>

<div {...shown.region} class="fixed right-5 bottom-5 flex flex-col gap-tight">
    {#for toast of shown.notices by toast.id}
        <div
            {...shown.notice(toast).notice}
            class="flex items-center gap-snug rounded-lg border border-rule bg-raised
            px-4 py-2 shadow-sm data-[tone=error]:border-bad
            data-[tone=success]:border-good"
        >
            <span {...shown.notice(toast).text}>{toast.text}</span>
            {#if toast.action}
                <button {...shown.notice(toast).action}>{toast.action.label}</button>
            {/if}
            <button {...shown.notice(toast).close} class="bg-transparent text-muted">×</button>
        </div>
    {/for}
</div>
