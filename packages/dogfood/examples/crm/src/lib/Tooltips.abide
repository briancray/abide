<script>
// The one popover every `tooltip.tip` on a CRM page opens in, its markdown rendered; each page styles
// it with `class`.
import { type Attributes, props, tooltip } from '@abide/abide'

const { ...rest } = props<Omit<Attributes<'div'>, 'popover' | 'role'>>()

const shown = tooltip.host()
</script>

<div {...rest} {...shown.hint}>{raw(shown.html)}</div>
