<script>
// What `announce` says, read out by a screen reader and shown nowhere: both regions, so an
// assertive message is never dropped by a host that holds only the polite one (50.36).
import { announce } from '@abide/abide'

const regions = announce.host()
</script>

<div class="sr-only">
    <div {...regions.polite}>
        {#for message of regions.said('polite') key message.count}
            <span>{message.text}</span>
        {/for}
    </div>
    <div {...regions.assertive}>
        {#for message of regions.said('assertive') key message.count}
            <span>{message.text}</span>
        {/for}
    </div>
</div>
