<script>
import {
    commandPalette,
    keyLabel,
    navigate,
    props,
    reactive,
    url,
} from '@abide/abide'

// Where a command goes: the router's `navigate`, or a test's own record of it.
const { go = (address: string) => void navigate(address) } = props<{
    go?: (address: string) => void
}>()

const COMMANDS = [
    { label: 'Contacts', run: () => go(url('/contacts')) },
    { label: 'Companies', run: () => go(url('/companies')) },
    { label: 'Deals', run: () => go(url('/deals')) },
    {
        label: 'Pipeline',
        keywords: ['stages', 'forecast'],
        run: () => go(url('/pipeline')),
    },
    {
        label: 'Add a deal',
        keywords: ['new', 'create'],
        key: 'n',
        run: () => go(url('/deals')),
    },
]

let open = reactive(false)
const palette = commandPalette({
    commands: COMMANDS,
    open,
    id: 'command-palette',
    label: 'Jump to',
})
</script>

<dialog {...palette.dialog} class="palette">
    <input
        {...palette.input}
        placeholder="Go to a page or run a command"
        data-part="input"
    >
    <ul {...palette.listbox} data-part="listbox">
        {#for command of palette.results() by command.label}
            <li {...palette.option(command)} data-part="option">
                <span data-part="label">{command.label}</span>
                {#if command.key}
                    <kbd data-part="key">{keyLabel(command.key)}</kbd>
                {/if}
            </li>
        {/for}
    </ul>
    {#if palette.results().length === 0}
        <p {...palette.empty} data-part="empty">Nothing matches.</p>
    {/if}
</dialog>
