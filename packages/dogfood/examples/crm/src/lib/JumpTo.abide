<script>
import {
    commandPalette,
    keyLabel,
    navigate,
    props,
    reactive,
    url,
} from '@abide/abide'

// Where a command goes: the router's `navigate`, or a test's own record of it.
const { go = (address: string) => void navigate(address) } = props<{
    go?: (address: string) => void
}>()

const COMMANDS = [
    { label: 'Contacts', run: () => go(url('/contacts')) },
    { label: 'Companies', run: () => go(url('/companies')) },
    { label: 'Deals', run: () => go(url('/deals')) },
    {
        label: 'Pipeline',
        keywords: ['stages', 'forecast'],
        run: () => go(url('/pipeline')),
    },
    {
        label: 'Add a deal',
        keywords: ['new', 'create'],
        key: 'n',
        run: () => go(url('/deals')),
    },
]

let open = reactive(false)
const palette = commandPalette({
    commands: COMMANDS,
    open,
    id: 'command-palette',
    label: 'Jump to',
})
</script>

<dialog {...palette.dialog} class="palette">
    <input
        {...palette.input}
        placeholder="Go to a page or run a command"
    >
    <ul {...palette.listbox}>
        {#for command of palette.results by command.label}
            <li {...palette.command(command).option}>
                <span {...palette.command(command).label}>
                    {#for run of palette.command(command).runs}
                        {#if run.match}
                            <mark {...run.match}>{run.text}</mark>
                        {:else}
                            {run.text}
                        {/if}
                    {/for}
                </span>
                {#if command.key}
                    <kbd {...palette.command(command).key}>{keyLabel(command.key)}</kbd>
                {/if}
            </li>
        {/for}
    </ul>
    {#if palette.results.length === 0}
        <p {...palette.empty}>Nothing matches.</p>
    {/if}
</dialog>
