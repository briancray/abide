<script>
import { reactive } from '@abide/abide'
import Time from '@abide/abide/Time.abide'

const HOUR = 3_600_000
const now = Date.now()

let touches = reactive([
    { contact: 'Ada Lovelace', kind: 'Call', at: now - 3 * HOUR },
    { contact: 'Grace Hopper', kind: 'Email', at: now - 26 * HOUR },
])

function logCall() {
    touches = [
        { contact: 'Katherine Johnson', kind: 'Call', at: Date.now() },
        ...touches,
    ]
}
</script>

<ul class="fields">
    {#for touch of touches by touch.contact}
        <li><span>{touch.kind}</span>
            <strong>{touch.contact}, <Time value={touch.at} /></strong></li>
    {/for}
</ul>
<div class="row">
    <button disabled={touches.length > 2} onclick={logCall}>
        Log a call with Katherine
    </button>
</div>
