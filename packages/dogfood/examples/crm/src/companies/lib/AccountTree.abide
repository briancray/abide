<script>
import { reactive, tree } from '@abide/abide'

type Account = { id: string; name: string; under?: Account[] }

const REGIONS: Account[] = [
    {
        id: 'europe',
        name: 'Europe',
        under: [
            {
                id: 'hopper',
                name: 'Hopper & Co',
                under: [
                    { id: 'grace', name: 'Grace Hopper' },
                    { id: 'howard', name: 'Howard Aiken' },
                ],
            },
            {
                id: 'babbage',
                name: 'Babbage & Co',
                under: [{ id: 'ada', name: 'Ada Lovelace' }],
            },
        ],
    },
    {
        id: 'americas',
        name: 'Americas',
        under: [
            {
                id: 'turing',
                name: 'Turing Labs',
                under: [{ id: 'alan', name: 'Alan Turing' }],
            },
        ],
    },
]

let expanded = reactive<readonly string[]>(['europe'])
let selected = reactive<string | undefined>(undefined)
const accounts = tree({
    roots: REGIONS,
    children: (account: Account) => account.under,
    key: (account: Account) => account.id,
    label: (account: Account) => account.name,
    expanded,
    selected,
})
</script>

<p class="status">{selected ?? 'no account picked'}</p>
<ul {...accounts.tree} aria-label="Accounts" class="tree">
    {#for region of REGIONS by region.id}
        <li {...accounts.node(region).item}>
            {region.name}
            <ul {...accounts.node(region).group}>
                {#for company of region.under by company.id}
                    <li {...accounts.node(company).item}>
                        {company.name}
                        <ul {...accounts.node(company).group}>
                            {#for person of company.under by person.id}
                                <li {...accounts.node(person).item}>{person.name}</li>
                            {/for}
                        </ul>
                    </li>
                {/for}
            </ul>
        </li>
    {/for}
</ul>
