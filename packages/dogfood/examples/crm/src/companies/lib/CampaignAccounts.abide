<script>
import { reactive, tree } from '@abide/abide'

type Account = { id: string; name: string; under?: Account[] }

const REGIONS: Account[] = [
    {
        id: 'europe',
        name: 'Europe',
        under: [
            { id: 'hopper', name: 'Hopper & Co' },
            { id: 'babbage', name: 'Babbage & Co' },
        ],
    },
    {
        id: 'americas',
        name: 'Americas',
        under: [{ id: 'turing', name: 'Turing Labs' }],
    },
]

let expanded = reactive<readonly string[]>(['europe', 'americas'])
let selected = reactive<readonly string[]>([])
const accounts = tree({
    roots: REGIONS,
    children: (account: Account) => account.under,
    label: (account: Account) => account.name,
    multiple: true,
    expanded,
    selected,
})
</script>

<p class="status">{selected.join(', ') || 'no account in the campaign'}</p>
<ul {...accounts.tree} aria-label="Campaign accounts" class="tree">
    {#for region of REGIONS by region.id}
        <li {...accounts.node(region).item}>
            {region.name}
            <ul {...accounts.node(region).group}>
                {#for company of region.under by company.id}
                    <li {...accounts.node(company).item}>{company.name}</li>
                {/for}
            </ul>
        </li>
    {/for}
</ul>
