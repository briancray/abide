<script>
import { reactive } from '@abide/abide'

import getRegistration from '../getRegistration.server.ts'

const COMPANIES = [
    { id: 'hopper-and-co', name: 'Hopper & Co' },
    { id: 'langley-research', name: 'Langley Research' },
]

let id = reactive('hopper-and-co')

const registration = reactive(() => getRegistration({ id }))

// Whether there is an answer from the registry to show.
const answered = () => registration.ready() && !registration.error()

function said() {
    if (registration.busy()) return 'asking the registry…'
    const failed = registration.error()
    return failed ? `${failed.status} ${failed.message}` : ''
}
</script>

<div class="tabs">
    {#for one of COMPANIES}
        <button aria-pressed={id === one.id}
            onclick={() => {
                id = one.id
            }}>{one.name}</button>
    {/for}
</div>

<p class="status">{said()}</p>

<ul class="fields">
    <li><span>founded</span>
        <strong>{answered() ? registration?.founded : '—'}</strong></li>
    <li><span>employees</span>
        <strong>{answered() ? registration?.employees : '—'}</strong></li>
</ul>
