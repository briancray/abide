<script>
import { reactive, route, tabs } from '@abide/abide'

const TABS = ['deals', 'notes']

const view = tabs({ items: TABS, selected: route.query('tab', 'deals') })
let draft = reactive('')
</script>

<div class="tabs" {...view.list}>
    {#for name of TABS}
        <button {...view.tab(name).button}>{name}</button>
    {/for}
</div>

<label>Draft a note
    <input bind:value={draft} placeholder="Follow up on Friday">
</label>

<ul class="fields">
    <li><span>address</span><strong>{route.url.search || '—'}</strong></li>
</ul>
