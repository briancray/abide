<script>
import { type Column, memo, sortableTable, url } from '@abide/abide'

import listCompanies from '../listCompanies.handler.ts'

type Company = { id: string; name: string; city: string; contact: string }

const COLUMNS: Column<Company>[] = [
    { key: 'name', label: 'Company' },
    { key: 'city', label: 'City' },
]

const companies = memo(() => listCompanies())
const table = sortableTable({
    rows: () => companies,
    columns: COLUMNS,
})
</script>

<table {...table.table}>
    <thead>
        <tr>
            {#for column of COLUMNS by column.key}
                <th {...table.column(column).header}>
                    <button
                        {...table.column(column).sort}
                        class="bg-transparent p-0 text-muted"
                    >{column.label}</button>
                </th>
            {/for}
        </tr>
    </thead>
    <tbody>
        {#for company of table.rows by company.id}
            <tr {...table.row(company).row}>
                <td>
                    <a href={url('/companies/[id=SLUG]', { id: company.id })}>
                        {company.name}
                    </a>
                </td>
                <td>{company.city}</td>
            </tr>
            <tr {...table.row(company).detail}>
                <td colspan={COLUMNS.length} class="text-muted">
                    Contact: {company.contact}
                </td>
            </tr>
        {/for}
    </tbody>
</table>
