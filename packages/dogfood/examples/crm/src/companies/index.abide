<script>
import { reactive, url } from '@abide/abide'

import Announcements from '#src/lib/Announcements.abide'

import AccountTree from './lib/AccountTree.abide'
import CampaignAccounts from './lib/CampaignAccounts.abide'
import { listCompanies } from './listCompanies.server.ts'

const companies = reactive(() => listCompanies())
</script>

<Announcements />
<ul class="fields">
    {#for company of companies key company.id}
        <li><span>{company.city}</span>
            <a href={url('/companies/[id=SLUG]', { id: company.id })}
                style:view-transition-name="company-{company.id}"
            >{company.name}</a></li>
    {/for}
</ul>
<h2>By region</h2>
<AccountTree />
<h2>In the campaign</h2>
<CampaignAccounts />

<style>
::view-transition-group(*) {
    animation-duration: 0.5s;
}
</style>
