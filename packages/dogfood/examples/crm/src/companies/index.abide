<script>
import { memo, url } from '@abide/abide'

import AccountTree from './lib/AccountTree.abide'
import CampaignAccounts from './lib/CampaignAccounts.abide'
import listCompanies from './listCompanies.handler.ts'

const companies = memo(() => listCompanies())
