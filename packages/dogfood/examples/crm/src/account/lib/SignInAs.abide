<script>
import { principal } from '@abide/abide'

import signIn from '../signIn.handler.ts'
import signOut from '../signOut.handler.ts'

const PEOPLE = [
    { name: 'Nobody', email: '' },
    { name: 'Maya Chen', email: 'maya@crm.example' },
    { name: 'Theo Park', email: 'theo@crm.example' },
]

const become = (email: string) => (email === '' ? signOut() : signIn({ email }))
</script>

<div class="tabs">
    {#for one of PEOPLE}
        <button aria-selected={(principal.resolved().name ?? 'Nobody') === one.name}
            onclick={() => become(one.email)}>{one.name}</button>
    {/for}
</div>
