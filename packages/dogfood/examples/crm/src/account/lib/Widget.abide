<script>
import { reactive } from '@abide/abide'

let refused = reactive('—')

function addWidget() {
    const widget = document.createElement('script')
    widget.src = 'https://widget.example/chat.js'
    document.addEventListener(
        'securitypolicyviolation',
        (event) => {
            refused = `${event.blockedURI} by ${event.violatedDirective}`
        },
        { once: true },
    )
    document.head.append(widget)
}
</script>

<div class="row">
    <button onclick={addWidget}>Add the chat widget</button>
</div>

<ul class="fields stacked">
    <li><span>refused</span><strong>{refused}</strong></li>
</ul>
