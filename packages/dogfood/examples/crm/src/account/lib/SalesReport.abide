<script>
import { reactive, toggleGroup } from '@abide/abide'

import { salesReport } from '../salesReport.server.ts'

const REGIONS = ['north', 'south']

let region = reactive('north')
const regions = toggleGroup({ items: REGIONS, value: region, label: 'Region' })

const rows = reactive(() => salesReport({ region }))

function refusal() {
    const failed = rows.error()
    return failed ? `${failed.status} ${failed.message}` : ''
}
</script>

<div class="tabs" {...regions.group}>
    {#for one of REGIONS}
        <button {...regions.item(one)}>{one}</button>
    {/for}
</div>

<p class="status">{refusal()}</p>

<ul class="fields">
    <li><span>rows</span>
        <strong>{rows.ready() ? rows.length : 0}</strong></li>
</ul>
