<script>
import { form } from '@abide/abide'

import createDeal from '../createDeal.handler.ts'

const deal = form(createDeal)
</script>

<form {...deal.element} class="row">
    <label>name <input {...deal.field('name')} value="Ledger audit"></label>
    <label>company <input {...deal.field('company')}></label>
    <label>amount <input type="number" {...deal.field('amount')} value="0"></label>
    <button {...deal.submit()}>Add deal</button>
</form>

<ul class="fields">
    {#for name of ['name', 'company', 'amount'] as const}
        <li {...deal.error(name)}><span>{name}</span><strong>{deal.message(name)}</strong></li>
    {/for}
</ul>
