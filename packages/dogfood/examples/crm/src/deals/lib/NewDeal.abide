<script>
import { form, reactive } from '@abide/abide'

import createDeal from '../createDeal.server.ts'

let added = reactive('')

const deal = form(createDeal, {
    resetOnSuccess: true,
    onsuccess: (created) => (added = `Added ${created.name}`),
})
</script>

<form {...deal.form} class="row">
    <label>name <input {...deal.field('name').input} value="Ledger audit"></label>
    <label>company <input {...deal.field('company').input}></label>
    <label>amount <input type="number" {...deal.field('amount').input} value="0"></label>
    <button {...deal.submit}>Add deal</button>
</form>

<ul class="fields">
    {#for name of ['name', 'company', 'amount'] as const}
        <li {...deal.field(name).error}><span>{name}</span><strong>{deal.field(name).message}</strong></li>
    {/for}
</ul>

<p {...deal.error} class="status">{deal.message}</p>
<p class="status">{added}</p>
