<script>
import { reactive } from '@abide/abide'

import createDeal from '../createDeal.handler.ts'

let name = reactive('Ledger audit')
let company = reactive('')
let amount = reactive<number | undefined>(0)
// The last call made: its probes are the form's.
let saving = reactive<typeof createDeal>()

function add() {
    saving = createDeal({ name, company, amount: amount ?? 0 })
}
</script>

<div class="row">
    <label>name <input bind:value={name}></label>
    <label>company <input bind:value={company}></label>
    <label>amount <input type="number" bind:value={amount}></label>
    <button onclick={add} disabled={saving.busy()}>Add deal</button>
</div>

<ul class="fields">
    {#for [field, messages] of Object.entries(saving.issues() ?? {})}
        <li><span>{field}</span><strong>{messages?.[0]}</strong></li>
    {/for}
</ul>
