<script server>
const NOTES: Record<string, string[]> = {
    d1: ['Wants a three-year term.'],
}

// Private to this file: the browser gets a call in its place.
export const getNotes = ({ id }: { id: string }) => NOTES[id] ?? []
</script>

<script>
import { reactive } from '@abide/abide'

const notes = reactive(() => getNotes({ id: 'd1' }))
</script>

<ul class="fields stacked">
    {#for note of notes}
        <li><span>note</span><strong>{note}</strong></li>
    {/for}
</ul>
