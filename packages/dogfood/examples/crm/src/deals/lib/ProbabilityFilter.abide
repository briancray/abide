<script>
import { memo, reactive, slider } from '@abide/abide'

const DEALS = [
    { id: 'noether-pilot', name: 'Noether pilot', probability: 20 },
    { id: 'turing-seats', name: 'Turing seats', probability: 55 },
    { id: 'hopper-renewal', name: 'Hopper renewal', probability: 90 },
]

let likely = reactive<readonly [number, number]>([50, 100])
const shown = memo(() =>
    DEALS.filter(
        (deal) =>
            deal.probability >= likely[0] && deal.probability <= likely[1],
    ),
)
const probability = slider({
    value: likely,
    label: 'Win probability',
    step: 5,
    format: (each) => `${each}%`,
})
</script>

<div {...probability.root} class="slider">
    <div {...probability.track}>
        <div {...probability.fill} />
        <span {...probability.end(0).thumb} />
        <span {...probability.end(1).thumb} />
    </div>
</div>
<ul>
    {#for deal of shown key deal.id}
        <li>{deal.name}</li>
    {/for}
</ul>
