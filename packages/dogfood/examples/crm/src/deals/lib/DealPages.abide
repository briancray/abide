<script>
import { computed, pages, reactive } from '@abide/abide'

const DEALS = Array.from({ length: 23 }, (_, at) => `Deal ${at + 1}`)
const PER_PAGE = 3
let page = reactive(1)
const list = pages({ count: Math.ceil(DEALS.length / PER_PAGE), page })
const shown = computed(() =>
    DEALS.slice((page - 1) * PER_PAGE, page * PER_PAGE),
)
</script>

<ul>
    {#for deal of shown key deal}<li>{deal}</li>{/for}
</ul>
<nav class="row" {...list.nav}>
    <button {...list.previous}>Previous</button>
    {#for item of list.items}
        {#if item === 'gap'}<span>…</span>{:else}
            <button {...list.link(item)}>{item}</button>
        {/if}
    {/for}
    <button {...list.next}>Next</button>
</nav>
