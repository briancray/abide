<script>
import { dropzone, reactive } from '@abide/abide'

let contracts = reactive<string[]>([])

const drop = dropzone({
    accept: '.pdf',
    onfiles: (files) => {
        for (const file of files) contracts.push(file.name)
    },
})
</script>

<div class="flex flex-col gap-snug rounded-md border border-dashed border-rule
    p-flow data-dragging:border-signal data-dragging:bg-signal/10"
    {...drop.host}>
    <p>Ledger audit — drop the signed contract here, as a PDF.</p>
    <ul class="fields">
        {#for name of contracts}
            <li><span>contract</span><strong>{name}</strong></li>
        {/for}
    </ul>
</div>
