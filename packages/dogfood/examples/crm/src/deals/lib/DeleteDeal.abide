<script>
import { reactive } from '@abide/abide'
import Prompts, { prompts } from '@abide/abide/Prompts.abide'

let deals = reactive(['Engine renewal', 'Compiler pilot'])

async function remove(deal: string) {
    const sure = await prompts.confirm({
        title: `Delete ${deal}?`,
        body: 'Its notes and its stage history go with it.',
        confirm: 'Delete',
        danger: true,
    })
    if (sure) deals.splice(deals.indexOf(deal), 1)
}
</script>

<ul class="fields">
    {#for deal of deals}
        <li>
            <span>deal</span><strong>{deal}</strong>
            <button onclick={() => remove(deal)}>Delete</button>
        </li>
    {/for}
</ul>

<Prompts
    class="m-auto w-96 max-w-[calc(100%-2rem)] rounded-xl border border-rule
    bg-raised p-5 text-ink backdrop:bg-paper/70
    [&_[data-prompts=form]]:flex [&_[data-prompts=form]]:flex-col
    [&_[data-prompts=form]]:gap-snug [&_[data-prompts=actions]]:row
    data-[danger]:[&_[data-prompts=confirm]]:bg-bad"
 />
