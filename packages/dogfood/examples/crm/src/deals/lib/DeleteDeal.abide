<script>
import { prompts, reactive } from '@abide/abide'

import Prompts from '#src/lib/Prompts.abide'

let deals = reactive(['Engine renewal', 'Compiler pilot'])

async function remove(deal: string) {
    const sure = await prompts.confirm({
        title: `Delete ${deal}?`,
        body: 'Its notes and its stage history go with it.',
        confirm: 'Delete',
        danger: true,
    })
    if (sure) deals.splice(deals.indexOf(deal), 1)
}
</script>

<ul class="fields">
    {#for deal of deals}
        <li>
            <span>deal</span><strong>{deal}</strong>
            <button onclick={() => remove(deal)}>Delete</button>
        </li>
    {/for}
</ul>

<Prompts />
