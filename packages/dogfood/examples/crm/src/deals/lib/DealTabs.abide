<script>
import { format, reactive, tabs } from '@abide/abide'

import getDeal from '../getDeal.server.ts'

const VIEWS = [
    { id: 'details', label: 'Details' },
    { id: 'value', label: 'Value' },
    { id: 'stage', label: 'Stage' },
]

let tab = reactive<string | undefined>('details')
const view = tabs({ items: VIEWS, selected: tab })
const deal = reactive.derived(() => getDeal({ id: 'd1' }))
</script>

<div class="flex flex-col gap-snug">
    <div class="tabs" {...view.list}>
        {#for each of VIEWS key each.id}
            <button {...view.tab(each).button}>{each.label}</button>
        {/for}
    </div>
    <ul class="fields" {...view.panel}>
        {#if tab === 'details'}
            <li><span>deal</span><strong>{deal.name}</strong></li>
            <li><span>company</span><strong>{deal.company}</strong></li>
        {:else if tab === 'value'}
            <li><span>amount</span>
                <strong>{format.money(deal.amount, { maximumFractionDigits: 0 })}</strong></li>
        {:else}
            <li><span>stage</span><strong>{deal.stage}</strong></li>
        {/if}
    </ul>
</div>
