<script>
import { reactive, tabs } from '@abide/abide'

import getDeal from '../getDeal.handler.ts'

const VIEWS = [
    { key: 'details', label: 'Details' },
    { key: 'value', label: 'Value' },
    { key: 'stage', label: 'Stage' },
]

let tab = reactive<string | undefined>('details')
const view = tabs({ keys: VIEWS.map((each) => each.key), selected: tab })
const deal = reactive(() => getDeal({ id: 'd1' }))
</script>

<div class="flex flex-col gap-snug">
    <div class="tabs" {...view.list}>
        {#for each of VIEWS by each.key}
            <button {...view.tab(each.key)}>{each.label}</button>
        {/for}
    </div>
    <ul class="fields" {...view.panel()}>
        {#if tab === 'details'}
            <li><span>deal</span><strong>{deal.name}</strong></li>
            <li><span>company</span><strong>{deal.company}</strong></li>
        {:else if tab === 'value'}
            <li><span>amount</span>
                <strong>${deal.amount.toLocaleString('en-US')}</strong></li>
        {:else}
            <li><span>stage</span><strong>{deal.stage}</strong></li>
        {/if}
    </ul>
</div>
