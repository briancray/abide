<script>
import { format, reactive, slider } from '@abide/abide'

const DEALS = [
    { id: 'noether-pilot', name: 'Noether pilot', amount: 6_500 },
    { id: 'lovelace-audit', name: 'Lovelace audit', amount: 9_000 },
    { id: 'turing-seats', name: 'Turing seats', amount: 22_000 },
    { id: 'hopper-renewal', name: 'Hopper renewal', amount: 48_000 },
]

let amount = reactive<readonly [number, number]>([0, 50_000])
const band = slider({
    range: true,
    value: amount,
    label: 'Deal amount',
    max: 50_000,
    step: 500,
    name: 'amount',
    format: (each) => format.money(each, { notation: 'compact' }),
})
const shown = reactive(() =>
    DEALS.filter(
        (deal) => deal.amount >= amount[0] && deal.amount <= amount[1],
    ),
)
</script>

<form class="fields stacked">
    <div class="slider" {...band.root}>
        <div {...band.track}>
            <div {...band.fill} />
            <span {...band.end(0).thumb} />
            <span {...band.end(1).thumb} />
        </div>
        <input {...band.end(0).input}>
        <input {...band.end(1).input}>
    </div>
</form>
<p class="status">
    {format.money(amount[0], { notation: 'compact' })} to {format.money(amount[1], { notation: 'compact' })}
</p>
<ul>
    {#for deal of shown key deal.id}
        <li>{deal.name}</li>
    {/for}
</ul>
