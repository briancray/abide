<script>
import { reactive } from '@abide/abide'

import Markdown from '#src/lib/Markdown.abide'

let note = reactive(`**Ada** wants the annual plan. [Brief](https://x.co/b7)

- legal review by *Friday*
- [open the quote](javascript:alert('pwned'))

<script>alert('pwned')<\/script>`)

// A link off the CRM opens in a tab of its own; one inside it stays in this one.
function linkTo(address: string) {
    return address.startsWith('/')
        ? address
        : { href: address, target: '_blank', rel: 'noopener noreferrer' }
}
</script>

<label>
    Deal note
    <textarea rows="7" bind:value={note}></textarea>
</label>
<Markdown
    source={note}
    headingLevel={3}
    href={linkTo}
    aria-label="Preview"
    class="flex flex-col gap-tight"
 />
