<script>
import { commandPalette, keyLabel, reactive } from '@abide/abide'

let done = reactive('')
const COMMANDS = [
    { label: 'Mark won', run: () => (done = 'Marked won.') },
    { label: 'Mark lost', run: () => (done = 'Marked lost.') },
    {
        label: 'Export deals',
        keywords: ['csv', 'download'],
        run: () => (done = 'Exported.'),
    },
]
const palette = commandPalette({
    commands: COMMANDS,
    hotkey: 'mod+j',
    id: 'deal-commands',
    label: 'Deal commands',
})
</script>

<dialog {...palette.dialog} class="palette">
    <input {...palette.input} placeholder="Run a deal command">
    <ul {...palette.listbox}>
        {#for command of palette.results key command.label}
            <li {...palette.command(command).option}>
                <span {...palette.command(command).label}>
                    {#for run of palette.command(command).runs}
                        {#if run.match}
                            <mark {...run.match}>{run.text}</mark>
                        {:else}
                            {run.text}
                        {/if}
                    {/for}
                </span>
                {#if command.key}
                    <kbd {...palette.command(command).key}>
                        {keyLabel(command.key)}
                    </kbd>
                {/if}
            </li>
        {/for}
    </ul>
    {#if palette.results.length === 0}
        <p {...palette.empty}>No command matches.</p>
    {/if}
</dialog>
<p class="status">{done}</p>
