<script>
import { reactive } from '@abide/abide'
import CommandPalette from '@abide/abide/CommandPalette.abide'

let done = reactive('')
const COMMANDS = [
    { label: 'Mark won', run: () => (done = 'Marked won.') },
    { label: 'Mark lost', run: () => (done = 'Marked lost.') },
    {
        label: 'Export deals',
        keywords: ['csv', 'download'],
        run: () => (done = 'Exported.'),
    },
]
</script>

<CommandPalette
    commands={COMMANDS}
    hotkey="mod+j"
    id="deal-commands"
    label="Deal commands"
    placeholder="Run a deal command"
    class="palette"
>
    No command matches.
</CommandPalette>
<p class="status">{done}</p>
