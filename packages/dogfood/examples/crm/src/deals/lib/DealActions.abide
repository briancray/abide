<script>
import { menu, reactive } from '@abide/abide'

import { STAGES } from '#src/pipeline/lib/STAGES.ts'

let stage = reactive('proposal')
let pinned = reactive(false)
const move = menu()
</script>

<div class="row">
    <strong>Engine renewal</strong>
    <span class="status">{stage}</span>
    {#if pinned}<span>pinned</span>{/if}
    <button type="button" {...move.trigger}>Move to…</button>
    <div
        {...move.menu}
        class="m-0 flex-col gap-hair rounded-lg border border-rule bg-raised
        p-tight open:flex"
    >
        {#for next of STAGES}
            <button
                {...move.item}
                disabled={next === stage}
                onclick={() => (stage = next)}
            >{next}</button>
        {/for}
        <button
            role="menuitemcheckbox"
            aria-checked={pinned ? 'true' : 'false'}
            onclick={() => (pinned = !pinned)}
        >pin to the top</button>
    </div>
</div>
