<script>
import { reactive, wizard } from '@abide/abide'

import { STAGES } from '#src/pipeline/lib/STAGES.ts'

let name = reactive('')
let stage = reactive('lead')
const STEPS = ['name', 'stage', 'review']
const setup = wizard({
    steps: STEPS,
    valid: (step) => step !== 'name' || name.trim() !== '',
})
</script>

<ol class="row capitalize">
    {#for step of STEPS key step}<li {...setup.step(step)}>{step}</li>{/for}
</ol>
{#if setup.current() === 'name'}
    <input aria-label="Deal name" bind:value={name} />
{:else if setup.current() === 'stage'}
    <select aria-label="Stage" bind:value={stage}>
        {#for each of STAGES key each}<option>{each}</option>{/for}
    </select>
{:else}
    <p class="status">{name} — {stage}</p>
{/if}
<button {...setup.previous}>Back</button>
<button {...setup.next}>Next</button>
