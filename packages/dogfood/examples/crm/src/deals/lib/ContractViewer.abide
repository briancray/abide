<script>
import { lightbox } from '@abide/abide'

const PAGES = ['Terms', 'Pricing', 'Signatures']
// A reader paging through a contract goes from its last page back to its first.
const viewer = lightbox({ items: PAGES, loop: true })
</script>

<div class="row">
    {#for page of PAGES by page}
        <button onclick={() => viewer.show(page)}>{page}</button>
    {/for}
</div>
<dialog aria-label="Contract" {...viewer.dialog}>
    <ul class="flex w-80 snap-x snap-mandatory overflow-x-auto" {...viewer.host}>
        {#for page of PAGES by page}
            <li class="shrink-0 basis-full snap-center p-8" {...viewer.item(page)}>
                {page}
            </li>
        {/for}
    </ul>
    <p class="status">{viewer.centered}</p>
</dialog>
