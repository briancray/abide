<script>
import { combobox, reactive } from '@abide/abide'

import listContacts from '../listContacts.server.ts'

type Contact = { id: string; name: string; company: string }

const contacts = reactive(() => listContacts())
let team = reactive<Contact[]>([])
// Each option names the contact's company under them, and each chip is the contact's name with
// its own remove button.
const box = combobox({
    id: 'deal-team',
    options: () => contacts,
    label: (each) => each.name,
    multiple: true,
    value: team,
})
</script>

<label for={box.id}>On the deal</label>
<div {...box.root} class="picker flex-row flex-wrap">
    {#for contact of box.value key contact.id}
        <span {...box.chip(contact).chip} class="rounded-md bg-signal/10 px-2"><span>{contact.name}</span>
            <button {...box.chip(contact).remove}>×</button></span>
    {/for}
    <input {...box.input} placeholder="Add a contact">
    {#if box.open}
        <div {...box.popup}>
            <ul {...box.listbox}>
                {#for contact of box.items key contact.id}
                    <li {...box.option(contact)}>
                        <span>{contact.name}</span>
                        <small class="block text-muted">{contact.company}</small>
                    </li>
                {/for}
            </ul>
            {#if box.nothingFound}
                <p {...box.empty}>No contact matches</p>
            {/if}
        </div>
    {/if}
</div>

<p class="status">{team.length} on the deal</p>
