<script>
import { reactive } from '@abide/abide'
import Combobox from '@abide/abide/Combobox.abide'

import listContacts from '../listContacts.handler.ts'

type Contact = { id: string; name: string; company: string }

const contacts = reactive(() => listContacts())
let team = reactive<Contact[]>([])
</script>

<label for="deal-team">On the deal</label>
<Combobox
    id="deal-team"
    options={contacts}
    key={(each: Contact) => each.id}
    label={(each: Contact) => each.name}
    bind:value={team}
    placeholder="Add a contact"
    class="picker flex-row flex-wrap [&_[data-part=chip]]:rounded-md
        [&_[data-part=chip]]:bg-signal/10 [&_[data-part=chip]]:px-2"
>
    No contact matches
</Combobox>

<p class="status">{team.length} on the deal</p>
