<script>
import { combobox, memo, reactive } from '@abide/abide'

import listContacts from '../listContacts.handler.ts'

type Contact = { id: string; name: string; company: string }

const contacts = memo(() => listContacts())
let contact = reactive<Contact | undefined>(undefined)
const box = combobox({
    id: 'deal-contact',
    options: () => contacts,
    label: (each) => each.name,
    value: contact,
})
</script>

<label for={box.id}>Contact</label>
<div {...box.root} class="picker">
    <input {...box.input} placeholder="Type a name">
    {#if box.open}
        <div {...box.popup}>
            <ul {...box.listbox}>
                {#for each of box.items key each.id}
                    <li {...box.option(each)}>
                        {#for run of box.runs(each)}
                            {#if run.match}
                                <mark {...run.match}>{run.text}</mark>
                            {:else}
                                {run.text}
                            {/if}
                        {/for}
                    </li>
                {/for}
            </ul>
            {#if box.nothingFound}
                <p {...box.empty}>No contact matches</p>
            {/if}
        </div>
    {/if}
</div>

<ul class="fields">
    <li><span>with</span><strong>{contact?.company ?? '—'}</strong></li>
</ul>
