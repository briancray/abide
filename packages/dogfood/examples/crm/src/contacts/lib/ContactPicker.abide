<script>
import { reactive } from '@abide/abide'
import Combobox from '@abide/abide/Combobox.abide'

import listContacts from '../listContacts.handler.ts'

type Contact = { id: string; name: string; company: string }

const contacts = reactive(() => listContacts())
let contact = reactive<Contact | undefined>(undefined)
</script>

<label for="deal-contact">Contact</label>
<Combobox
    id="deal-contact"
    options={contacts}
    key={(each: Contact) => each.id}
    label={(each: Contact) => each.name}
    bind:value={contact}
    placeholder="Type a name"
    class="flex flex-col gap-hair [&_[data-part=listbox]]:list-none
        [&_[data-part=listbox]]:p-0 [&_[data-part=option]]:px-3
        [&_[data-part=option]]:py-1 [&_[data-active]]:bg-signal/10"
>
    No contact matches
</Combobox>

<ul class="fields">
    <li><span>with</span><strong>{contact?.company ?? '—'}</strong></li>
</ul>
