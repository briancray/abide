<script>
import { dismissible, reactive } from '@abide/abide'

let open = reactive(false)
let company = reactive('Analytical Engines')

const edit = dismissible(() => (open = false))
</script>

<ul class="fields">
    <li><span>Ada Lovelace</span><strong>{company}</strong></li>
</ul>

<button {...edit.inside} onclick={() => (open = !open)}>
    {open ? 'Done' : 'Quick edit'}</button>

{#if open}
    <form class="row rounded-md border border-rule bg-raised p-snug" {...edit.host}>
        <label>company <input bind:value={company}></label>
    </form>
{/if}
