<script>
import { inlineEdit, reactive } from '@abide/abide'

let title = reactive('Head of procurement')
const rename = inlineEdit({
    value: title,
    save: async (text) => {
        if (text.trim() === '') throw new Error('A title cannot be blank')
    },
})
</script>

<ul class="fields">
    <li>
        <span>Ada Lovelace</span>
        <button {...rename.view}>{title}</button>
        <input aria-label="Title" {...rename.input} />
    </li>
</ul>
<p class="status">{rename.error ?? ''}</p>
