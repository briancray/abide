<script>
import { reactive } from '@abide/abide'

const search = reactive<HTMLInputElement | undefined>(undefined)

function shortcut(event: KeyboardEvent) {
    if (event.key !== '/' || event.target === search) return
    event.preventDefault()
    search?.focus()
}
</script>

<window onkeydown={shortcut} />

<label>
    Find a contact
    <input type="search" placeholder="press /" bind:element={search}>
</label>
