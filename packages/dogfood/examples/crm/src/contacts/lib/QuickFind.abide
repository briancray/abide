<script>
import { hotkeys, reactive } from '@abide/abide'

const search = reactive<HTMLInputElement | undefined>(undefined)

// 53.7 — a `/` typed into a field, this one or any other, is left to the field.
const keys = hotkeys({ '/': () => search?.focus() })
</script>

<window onkeydown={keys} />

<label>
    Find a contact
    <input type="search" placeholder="press /" bind:element={search}>
</label>
