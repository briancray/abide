<script>
import { computed } from '@abide/abide'

import getDealScores from '../getDealScores.handler.ts'

const scores = computed(() => getDealScores())
</script>

<ul class="fields stacked">
    {#for deal of scores}
        <li><span>{deal.name}</span><strong>{deal.score}</strong></li>
    {/for}
</ul>
