<script>
import { isServer, log } from '@abide/abide'

const billing = log.named('billing')
const sync = log.named('sync')
// This page's own lines: a server's are its process's, which the browser never had to adopt.
const lines = () => (isServer() ? [] : log.records.slice(-20))
</script>

<div class="row">
    <button onclick={() => billing.info('invoice sent', { id: '4310' })}>
        Send an invoice
    </button>
    <button onclick={() => sync.debug('polled', { rows: 0 })}>Poll</button>
</div>

<ul class="fields stacked">
    {#for record of lines()}
        {#if /:(billing|sync)$/.test(record.namespace)}
            <li>
                <span>{record.namespace}</span><strong>{record.message}</strong>
            </li>
        {/if}
    {/for}
</ul>
