<script>
import { jsonInspector } from '@abide/abide'

import { WEBHOOK } from './WEBHOOK.ts'

const payload = jsonInspector({ id: 'webhook', value: WEBHOOK })
</script>

<input {...payload.search} aria-label="Search the payload"
    placeholder="Search keys and values">
<p class="status">{payload.query
    ? `${payload.matches.length} found`
    : (payload.inspected?.pointer ?? 'no value picked')}</p>
<ul {...payload.tree} aria-label="Payload" class="tree">
    {#for row of payload.rows key row.pointer}
        <li {...payload.row(row).item}
            style:padding-inline-start="{row.level - 1}rem">
            {#if row.size !== undefined}
                <button type="button" tabindex="-1" aria-hidden="true"
                    onclick={(event) => {
                        event.stopPropagation()
                        payload.row(row).toggle()
                    }}></button>
            {/if}
            {#for run of payload.row(row).keyRuns}
                {#if run.match}
                    <mark {...run.match}>{run.text}</mark>
                {:else}
                    {run.text}
                {/if}
            {/for}
            {#if row.size === undefined}
                <code>
                    {#for run of payload.row(row).valueRuns}
                        {#if run.match}
                            <mark {...run.match}>{run.text}</mark>
                        {:else}
                            {run.text}
                        {/if}
                    {/for}
                </code>
            {:else}
                <small>{row.size} {row.kind === 'array' ? 'items' : 'keys'}</small>
            {/if}
        </li>
    {/for}
</ul>
{#if payload.inspected}
    <pre>{JSON.stringify(payload.inspected.value, null, 2)}</pre>
{/if}
