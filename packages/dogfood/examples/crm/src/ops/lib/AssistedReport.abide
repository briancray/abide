<script>
import {
    chat,
    onRefusal,
    reactive,
    report,
    type ReportDraft,
    watch,
} from '@abide/abide'

import askReport from '../askReport.server.ts'
import draftReport from '../draftReport.server.ts'
import sendStatement from '../sendStatement.server.ts'

let draft = reactive<ReportDraft | undefined>(undefined)

onRefusal((_refusal, call) => {
    draft = report({ trace: call.trace })
})

// The assistant reads the draft as the person sees it, and nothing more.
const talk = chat({
    ask: (_conversation, options) =>
        askReport({ draft: draft?.markdown() ?? '' }, options),
})

// What the assistant wrote through draftReport goes into the draft as it lands.
watch(() => {
    const current = draft
    for (const written of talk.calls(draftReport))
        if (current !== undefined && written.value !== undefined) {
            current.summary.set(written.value.summary)
            current.description.set(written.value.description)
        }
})

function ask() {
    talk.draft = { role: 'user', content: 'Write my problem report.' }
    talk.submit()
}
</script>

<div class="row">
    <button onclick={() => sendStatement({ id: 'c2' })}>
        Email Grace her statement</button>
    <button disabled={draft === undefined || talk.messages.length > 0}
        onclick={ask}>Ask the assistant</button>
    <button disabled={draft === undefined} onclick={() => draft?.open()}>
        Review and send</button>
</div>

<ul class="fields stacked">
    <li><span>summary</span>
        <strong>{draft?.summary() || '—'}</strong></li>
</ul>
