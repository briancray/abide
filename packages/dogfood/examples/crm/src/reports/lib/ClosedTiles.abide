<script>
import { reactive, toggleGroup } from '@abide/abide'

import { closedTotals } from './closedTotals.ts'

let days = reactive('7')
const spans = toggleGroup({ items: ['7', '30'], value: days, label: 'Days' })
const closed = reactive(() => closedTotals(Number(days)))
</script>

<div class="tabs" {...spans.group}>
    {#for choice of ['7', '30']}
        <button {...spans.item(choice)}>{choice} days</button>
    {/for}
</div>
<ul class="tiles">
    <li><span>deals closed</span><strong>{closed.deals}</strong></li>
    <li><span>revenue</span><strong>${closed.revenue}</strong></li>
</ul>
