<script>
import { format, reactive } from '@abide/abide'

import getSummary from '../getSummary.server.ts'

const summary = reactive(() => getSummary())
</script>

<ul class="tiles">
    <li><span>open deals</span><strong>{summary?.open ?? '—'}</strong></li>
    <li><span>pipeline</span><strong>{summary === undefined
        ? '—'
        : format.money(summary.pipeline, { maximumFractionDigits: 0 })}</strong></li>
</ul>
