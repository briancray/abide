<script>
import { format, reactive } from '@abide/abide'
import Sparkline from '@abide/abide/Sparkline.abide'

// Won revenue per month, June to November; Grace's August is not closed yet, and Joan, new this
// summer, has closed nothing.
const REPS = [
    {
        name: 'Ada Lovelace',
        won: [12_000, 18_000, 15_000, 22_000, 26_000, 31_000],
        closed: [2, 3, 3, 4, 5, 6],
    },
    {
        name: 'Grace Hopper',
        won: [24_000, 21_000, null, 11_000, 14_000, 17_000],
        closed: [4, 4, null, 2, 3, 3],
    },
    {
        name: 'Alan Turing',
        won: [9_000, 9_000, 9_000, 9_000, 9_000, 9_000],
        closed: [1, 1, 1, 1, 1, 1],
    },
    {
        name: 'Joan Clarke',
        won: [0, 0, 0, 0, 0, 0],
        closed: [0, 0, 0, 0, 0, 0],
    },
]

let months = reactive(6)
</script>

<div class="tabs">
    {#for choice of [6, 3]}
        <button
            aria-selected={months === choice}
            onclick={() => (months = choice)}
        >
            {choice} months
        </button>
    {/for}
</div>
<table>
    <thead><tr><th>Rep</th><th>November</th><th>Trend</th><th>Deals</th></tr></thead>
    <tbody>
        {#for rep of REPS by rep.name}
            <tr>
                <td>{rep.name}</td>
                <td>{format.money(rep.won.at(-1), { digits: 0 })}</td>
                <td>
                    <Sparkline
                        values={rep.won.slice(-months)}
                        label="{rep.name}'s won revenue, {months} months"
                        dot
                        zero
                        class="h-6 w-24 text-muted data-[trend=up]:text-good
                            data-[trend=down]:text-bad"
                     />
                </td>
                <td>
                    <Sparkline
                        kind="bar"
                        values={rep.closed.slice(-months)}
                        label="{rep.name}'s deals closed, {months} months"
                        class="h-6 w-24 text-muted"
                     />
                </td>
            </tr>
        {/for}
    </tbody>
</table>
