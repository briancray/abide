<script>
import { format, reactive, sparkline, toggleGroup } from '@abide/abide'

// Won revenue per month, June to November; Grace's August is not closed yet, and Joan, new this
// summer, has closed nothing.
const REPS = [
    {
        name: 'Ada Lovelace',
        won: [12_000, 18_000, 15_000, 22_000, 26_000, 31_000],
        closed: [2, 3, 3, 4, 5, 6],
    },
    {
        name: 'Grace Hopper',
        won: [24_000, 21_000, null, 11_000, 14_000, 17_000],
        closed: [4, 4, null, 2, 3, 3],
    },
    {
        name: 'Alan Turing',
        won: [9_000, 9_000, 9_000, 9_000, 9_000, 9_000],
        closed: [1, 1, 1, 1, 1, 1],
    },
    {
        name: 'Joan Clarke',
        won: [0, 0, 0, 0, 0, 0],
        closed: [0, 0, 0, 0, 0, 0],
    },
]

let months = reactive('6')
const spans = toggleGroup({ items: ['6', '3'], value: months, label: 'Months' })

// Each rep's two trends, over the months shown.
const ROWS = REPS.map((rep) => ({
    name: rep.name,
    november: rep.won.at(-1),
    won: sparkline({
        values: () => rep.won.slice(-Number(months)),
        label: () => `${rep.name}'s won revenue, ${months} months`,
        zero: true,
    }),
    closed: sparkline({
        kind: 'bar',
        values: () => rep.closed.slice(-Number(months)),
        label: () => `${rep.name}'s deals closed, ${months} months`,
    }),
}))
</script>

<div class="tabs" {...spans.group}>
    {#for choice of ['6', '3']}
        <button {...spans.item(choice)}>{choice} months</button>
    {/for}
</div>
<table>
    <thead><tr><th>Rep</th><th>November</th><th>Trend</th><th>Deals</th></tr></thead>
    <tbody>
        {#for row of ROWS key row.name}
            <tr>
                <td>{row.name}</td>
                <td>{format.money(row.november, { maximumFractionDigits: 0 })}</td>
                <td>
                    <svg
                        {...row.won.svg}
                        class="h-6 w-24 text-muted data-[trend=up]:text-good
                            data-[trend=down]:text-bad"
                    >
                        <path {...row.won.line} />
                        {#if row.won.ended}
                            <path {...row.won.dot} />
                        {/if}
                    </svg>
                </td>
                <td>
                    <svg {...row.closed.svg} class="h-6 w-24 text-muted">
                        <path {...row.closed.bars} />
                    </svg>
                </td>
            </tr>
        {/for}
    </tbody>
</table>
