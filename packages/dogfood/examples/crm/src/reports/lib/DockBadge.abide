<script>
import { reactive, watch } from '@abide/abide'

import getSummary from '../getSummary.handler.ts'

const summary = reactive(() => getSummary())

// The native app's Dock icon counts open deals; a browser may draw no badge.
watch(() => {
    if (summary) void navigator.setAppBadge?.(summary.open)
})
</script>

<p class="status">{summary?.open ?? '—'} open deals on the Dock icon</p>
