<script>
import { chart, format, reactive } from '@abide/abide'

import ChartPlot from '#src/lib/ChartPlot.abide'
import Tooltips from '#src/lib/Tooltips.abide'

const MONTHS = [5, 6, 7, 8, 9, 10].map((month) => Date.UTC(2026, month, 1))
const LEADS = [40_000, 52_000, 47_000, 61_000, 58_000, 66_000]
const QUALIFIED = [22_000, 25_000, null, 31_000, 36_000, 34_000]
const PROPOSALS = [12_000, 18_000, 21_000, 19_000, 26_000, 30_000]
const TARGET = [90_000, 95_000, 100_000, 105_000, 110_000, 115_000]

let leads = reactive(true)

const plot = chart({
    label: 'Open pipeline by stage against target, June to November',
    series: () => [
        { label: 'Proposals', values: PROPOSALS, kind: 'area', curve: true },
        { label: 'Qualified', values: QUALIFIED, kind: 'area', curve: true },
        ...(leads
            ? [
                  {
                      label: 'Leads',
                      values: LEADS,
                      kind: 'area',
                      curve: true,
                  } as const,
              ]
            : []),
        { label: 'Target', values: TARGET, stack: false },
    ],
    x: MONTHS,
    xFormat: (month) => format.date(month, { style: 'month' }),
    yFormat: (amount) => format.money(amount, { compact: true }),
    stack: true,
    bounds: { y: [0, 150_000] },
})
</script>

<label><input type="checkbox" bind:checked={leads} /> Leads</label>
<ChartPlot
    plot={plot}
    class="block h-60 w-full overflow-visible text-chrome text-muted
        [&_[data-chart=area]]:opacity-30 [&_[data-chart=line]]:[stroke-dasharray:4_4]"
 />
<Tooltips
    class="m-0 w-max rounded-md border border-rule bg-raised px-3 py-2 text-chrome text-ink
    shadow-sm"
 />
