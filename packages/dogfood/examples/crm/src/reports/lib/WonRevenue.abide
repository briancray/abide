<script>
import { format, props } from '@abide/abide'
import Announcer from '@abide/abide/Announcer.abide'
import Chart from '@abide/abide/Chart.abide'
import Line from '@abide/abide/Line.abide'
import Tooltips from '@abide/abide/Tooltips.abide'

const MONTHS = [5, 6, 7, 8, 9, 10].map((month) => Date.UTC(2026, month, 1))
// August's books are not closed yet.
const WON = [18_000, 24_500, null, 31_000, 27_000, 42_000]
const TARGET = [20_000, 22_000, 24_000, 26_000, 28_000, 30_000]

const { won = WON, target = TARGET } = props<{
    won?: readonly (number | null)[]
    target?: readonly number[]
}>()
</script>

<Chart
    x={MONTHS}
    label="Won revenue against target, June to November"
    xFormat={(month) => format.date(month, { style: 'month' })}
    yFormat={(amount) => format.money(amount, { compact: true })}
    zero
    class="block h-60 w-full overflow-visible text-chrome text-muted
        [&_[data-part=line]]:stroke-2 [&_[data-series='0']]:text-signal
        [&_[data-series='0']]:stroke-signal
        [&_[data-part=line][data-series='1']]:[stroke-dasharray:4_4]"
>
    <Line label="Won" values={won} />
    <Line label="Target" values={target} />
</Chart>
<Tooltips
    class="m-0 grid w-max gap-0.5 rounded-md border border-rule bg-raised px-3 py-2
    text-chrome text-ink shadow-sm [&_[data-part=readout-x]]:text-muted"
 />
<Announcer class="sr-only" />
