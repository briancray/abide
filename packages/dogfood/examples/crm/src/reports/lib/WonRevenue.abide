<script>
import { announce, chart, format, props } from '@abide/abide'

const MONTHS = [5, 6, 7, 8, 9, 10].map((month) => Date.UTC(2026, month, 1))
// August's books are not closed yet.
const WON = [18_000, 24_500, null, 31_000, 27_000, 42_000]
const TARGET = [20_000, 22_000, 24_000, 26_000, 28_000, 30_000]

const { won = WON, target = TARGET } = props<{
    won?: readonly (number | null)[]
    target?: readonly number[]
}>()

// Where a move the keys make is read out (50.49).
const regions = announce.host()

// Drawn over `chart`'s parts rather than by `ChartPlot`, for a dot of its own at every month won.
const plot = chart({
    label: 'Won revenue against target, June to November',
    series: () => [
        { label: 'Won', values: won },
        { label: 'Target', values: target },
    ],
    x: MONTHS,
    xFormat: (month) => format.date(month, { style: 'month' }),
    yFormat: (amount) => format.money(amount, { notation: 'compact' }),
    zero: true,
})
</script>

<div class="pb-6 pl-12">
    <svg
        {...plot.svg}
        class="block h-60 w-full overflow-visible text-chrome text-muted
            [&_[data-chart=line]]:stroke-2 [&_[data-series='0']]:text-signal
            [&_[data-series='0']]:stroke-signal
            [&_[data-chart=line][data-series='1']]:[stroke-dasharray:4_4]"
    >
        {#for tick of plot.yTicks}
            <line {...tick.grid} />
            <text {...tick.text} dx="-6">{tick.label}</text>
        {/for}
        {#if plot.zero}
            <line {...plot.zero?.line} />
        {/if}
        {#for tick of plot.xTicks}
            <text {...tick.text} dy="6">{tick.label}</text>
        {/for}
        {#for line of plot.lines key line.series}
            <path {...line.path} />
        {/for}
        {#for point of plot.points key point.key}
            {#if point.series === 0}
                <circle {...point.circle} r="3" />
            {/if}
        {/for}
        {#if plot.readout}
            <line {...plot.crosshair?.line} />
        {/if}
    </svg>
</div>
{#if plot.readout}
    <span
        {...plot.tip}
        class="m-0 grid w-max gap-0.5 rounded-md border border-rule bg-raised px-3 py-2
        text-chrome text-ink shadow-sm"
    >
        <span {...plot.readout?.heading} class="text-muted">{plot.readout?.label}</span>
        {#for point of plot.readout?.values ?? []}
            <span {...point.text}>{point.label}: {point.value}</span>
        {/for}
    </span>
{/if}
<div class="sr-only">
    <div {...regions.polite}>
        {#for message of regions.said('polite') key message.count}
            <span>{message.text}</span>
        {/for}
    </div>
    <div {...regions.assertive}>
        {#for message of regions.said('assertive') key message.count}
            <span>{message.text}</span>
        {/for}
    </div>
</div>
