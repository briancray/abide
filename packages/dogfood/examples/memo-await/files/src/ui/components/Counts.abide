<script>
import { reactive } from 'abide'

const TOTAL = 12
const MATCHING: Record<string, number> = { all: 12, customers: 4, leads: 1 }

let filter = reactive('all')

const loadCounts = () => new Promise<Record<string, number>>((done) =>
    setTimeout(() => done(MATCHING), 200),
)

const label = reactive(async () => {
    const of = filter // read BEFORE the await
    const counts = await loadCounts()
    return `showing ${counts[of]} of ${TOTAL} for ${of}`
})

const stale = reactive(async () => {
    const counts = await loadCounts()
    const of = filter // read AFTER it, and warned
    return `showing ${counts[of]} of ${TOTAL} for ${of}`
})
</script>

<label>filter
    <select bind:value={filter}>
        <option value="all">all</option>
        <option value="customers">customers</option>
        <option value="leads">leads</option>
    </select>
</label>

<ul class="fields stacked">
    <li><span>filter read before the await</span>
        <strong>{label.ready() ? label : '…'}</strong></li>
    <li><span>filter read after the await</span>
        <strong>{stale.ready() ? stale : '…'}</strong></li>
</ul>
