<script>
import { memo, structural, watch } from 'abide'
import { applyOrderChange, loadOrders, orderChanged } from '#shared/orders'

// The list is held as an INDEX, not an array: a frame names one id,
// and a `Map` is what turns that name into a row without a scan.
// `transform` is where the shape is chosen, so the fetch stays a
// fetch and nothing downstream re-indexes per frame.
const byId = memo(() => loadOrders(), {
    transform: (rows) => new Map(rows.map((row) => [row.id, row])),
})

// One frame, one in-place write, one production. `set` here would
// copy every other row to change one.
watch(async () => {
    for await (const change of orderChanged()) {
        byId.patch((index) => applyOrderChange(index, change))
    }
})

// What the table renders. The default `structural` is what stops
// a frame that changed nothing this view can see from repainting
// the table.
const rows = memo(() => [...byId.values()].sort((a, b) => a.id - b.id))
</script>

<h1>Orders</h1>

{#if byId.pending()}<p>Loading orders…</p>{/if}

<table>
    <tr><th>Order</th><th>Customer</th><th>Status</th><th>Total</th></tr>
    {#for order of rows by order.id}
        <tr><td>#{order.id}</td><td>{order.customer}</td>
            <td>{order.status}</td><td>${order.total.toFixed(2)}</td></tr>
    {/for}
</table>

<p class="hint">{rows.length} open</p>
