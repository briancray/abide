<script>
import { reactive } from '@abide/abide'
import getForecast from '../getForecast.ts'
import { dollars } from './dollars.ts'

const forecast = reactive(() => getForecast())
const reloading = reactive(() => forecast.busy() && forecast.ready())
</script>

{#if forecast.busy() && !forecast.ready()}
    <p class="status">Adding up the pipeline…</p>
{:else}
    <ul class="tiles">
        <li><span>forecast</span><strong>{dollars(forecast)}</strong></li>
    </ul>
{/if}

<div class="row">
    <button onclick={() => forecast.invalidate()}>Mark stale</button>
    <button onclick={() => forecast.refresh()}>Reload now</button>
    <span class="status">{reloading ? 'reloading…' : ''}</span>
</div>
