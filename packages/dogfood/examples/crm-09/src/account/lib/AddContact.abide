<script>
import { reactive } from '@abide/abide'
import addContact from '../addContact.handler.ts'

let added = reactive<{ status: number; location: string | null }>()

async function add() {
    const answer = await addContact.raw({ name: 'Katherine Johnson' })
    return { status: answer.status, location: answer.headers.get('location') }
}
</script>

<div class="row">
    <button onclick={() => { added = add() }}>Add Katherine Johnson</button>
</div>

<ul class="fields">
    <li><span>status</span>
        <strong>{added.ready() ? added.status : '—'}</strong></li>
    <li><span>location</span>
        <strong>{added.ready() ? added.location : '—'}</strong></li>
</ul>
