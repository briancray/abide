<script>
import { memo, state } from 'abide'
import { getMetrics } from '#server/rpc/metrics'

const RANGES = ['7d', '30d']

let range = state('7d')

// Its own range, and no way to reach the tile above — the args are the
// whole of what decides whether these two are one load.
const metrics = memo(() => getMetrics({ range }))
</script>

<ul class="grid">
    <li><span>range</span>
        <div class="tabs">
        {#for one of RANGES}
            <button aria-selected={range === one}
                onclick={() => { range = one }}>{one}</button>
        {/for}
        </div></li>
    <li><span>average order</span>
        <strong>{metrics.pending() ? '—' : metrics.average}</strong>
    </li>
    <li><span>times computed</span>
        <strong>{metrics.pending() ? '—' : metrics.computed}</strong>
    </li>
</ul>
