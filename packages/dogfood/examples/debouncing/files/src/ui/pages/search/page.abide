<script>
import { memo, state } from 'abide'
import { search } from '#server/rpc/search'

const query = state('')

// The cap goes on the memo that pays for it, and no markup moved:
// `debounce` fires once the triggers stop, so a half-typed query
// never becomes a request anybody was waiting on.
const results = memo(() => search({ q: query }), { debounce: 200 })
</script>

<label>
    Search
    <input bind:value={query} placeholder="Search invoices">
</label>

<p class="hint">Query {query}</p>

{#if results.refreshing()}<span class="hint">Searching…</span>{/if}

<ul>
    {#for row of results ?? []}
        <li>{row.title}</li>
    {/for}
</ul>
