<script>
import { reactive } from '@abide/abide'
// The same import reaches the same channel: no prop, no provider.
import { activity } from './activity.ts'

const last = reactive(() => activity.at(-1))
</script>

<ul class="fields">
    <li><span>last touch</span>
        <strong>
            {last ? `${last.kind} with ${last.contact}` : 'none yet'}
        </strong>
    </li>
</ul>
