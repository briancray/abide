<script>
import { reactive, url } from '@abide/abide'

import getTeam from '../admin/getTeam.handler.ts'
import SignInAs from './SignInAs.abide'

let page = reactive('—')
let handler = reactive('—')

const answered = (answer: Response) =>
    `${answer.status} ${answer.headers.get('content-type')?.split(';')[0]}`

async function open() {
    page = answered(await fetch(url('/account/admin')))
    handler = answered(await getTeam.raw())
}
</script>

<SignInAs />

<div class="row">
    <button onclick={open}>Open the admin section</button>
</div>

<ul class="fields stacked">
    <li><span>page</span><strong>{page}</strong></li>
    <li><span>getTeam</span><strong>{handler}</strong></li>
</ul>
