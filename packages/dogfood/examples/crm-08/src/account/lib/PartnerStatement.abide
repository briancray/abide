<script server>
import { GET } from '@abide/abide/server'
import getStatement from '../getStatement.ts'

// Another site's browser, asking for the statement under its own origin.
const askAs = GET(
    async ({ origin }: { origin: string }) => {
        const answer = await getStatement.raw(undefined, {
            headers: { origin },
        })
        return answer.headers.get('access-control-allow-origin') ?? 'none'
    },
    { description: 'The origin the statement names back to a caller.' },
)
</script>

<script>
import { reactive } from '@abide/abide'

const ORIGINS = ['https://books.example', 'https://elsewhere.example']

let origin = reactive(ORIGINS[0] ?? '')
const allowed = reactive(() => askAs({ origin }))
</script>

<div class="tabs">
    {#for each of ORIGINS}
        <button aria-selected={origin === each}
            onclick={() => (origin = each)}>{each.slice(8)}</button>
    {/for}
</div>

<ul class="fields stacked">
    <li><span>access-control-allow-origin</span><strong>{allowed}</strong></li>
</ul>
