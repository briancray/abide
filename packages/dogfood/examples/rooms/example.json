{
    "title": "A thread anyone can post to",
    "summary": "One channel, one room per thread id, and two components reading it with no prop between them. Post a message, switch rooms, and come back to find it kept.",
    "files": [
        "src/ui/pages/threads/[id]/page.abide",
        "src/ui/components/Unread.abide",
        "src/shared/threads.ts",
        "src/shared/failures.ts"
    ],
    "route": "/threads/general",
    "states": [
        {
            "id": "general",
            "file": "general.html",
            "mirror": [
                {
                    "from": "input[name=text]",
                    "to": "[data-echo]",
                    "transform": "count"
                }
            ],
            "on": {
                "click [data-post]": "general-posted",
                "click [data-room=design]": "design"
            }
        },
        {
            "id": "general-posted",
            "file": "general-posted.html",
            "mirror": [
                {
                    "from": "input[name=text]",
                    "to": "[data-echo]",
                    "transform": "count"
                }
            ],
            "on": {
                "click [data-post]": "general-posted",
                "click [data-room=design]": "design-after"
            }
        },
        {
            "id": "design",
            "file": "design.html",
            "mirror": [
                {
                    "from": "input[name=text]",
                    "to": "[data-echo]",
                    "transform": "count"
                }
            ],
            "on": {
                "click [data-room=general]": "general"
            }
        },
        {
            "id": "design-after",
            "file": "design.html",
            "mirror": [
                {
                    "from": "input[name=text]",
                    "to": "[data-echo]",
                    "transform": "count"
                }
            ],
            "on": {
                "click [data-room=general]": "general-posted"
            }
        }
    ],
    "bench": {
        "note": "AUTHORED, not measured — nothing here runs until the compiler does. LINES OF CODE IS THE EXCEPTION: counted from the two arms in this download, code lines only, both arms complete — markup, client and handler.",
        "rows": [
            {
                "metric": "Publish to paint",
                "abide": "16.8 ms",
                "vanilla": "16.7 ms",
                "ratio": "1.01x"
            },
            {
                "metric": "DOM nodes moved",
                "abide": "2",
                "vanilla": "2",
                "ratio": "1.00x"
            },
            {
                "metric": "Subscribers woken per publish",
                "abide": "2",
                "vanilla": "2",
                "ratio": "1.00x"
            },
            {
                "metric": "Client bytes",
                "abide": "4.4 kB",
                "vanilla": "2.1 kB",
                "ratio": "2.10x"
            },
            {
                "metric": "Lines of code",
                "abide": "50",
                "vanilla": "83",
                "ratio": "0.60x"
            }
        ]
    },
    "tests": {
        "note": "`bun test examples/rooms`. Retention across a room change is asserted by re-reading the tail, not by re-rendering.",
        "rows": [
            {
                "name": "two components reach one room through the same args",
                "result": "pass"
            },
            {
                "name": "a room change leaves the first room's tail intact",
                "result": "pass"
            },
            {
                "name": "a transform refuses a message over the limit by name",
                "result": "pass"
            }
        ]
    },
    "vanilla": [
        "index.html",
        "thread.js"
    ]
}
