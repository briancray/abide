<script>
import { route, state, url } from 'abide'
import { thread } from '#shared/threads'
import Unread from '#ui/components/Unread.abide'

const room = thread({ id: route.params.id })
const draft = state('')
</script>

<nav class="switch">
    <a href={url('/threads/[id]', { id: 'general' })}>#general</a>
    <a href={url('/threads/[id]', { id: 'design' })}>#design</a>
</nav>

<h1>#{route.params.id}</h1>
<Unread/>

{#if room.pending()}<p>Nothing posted here yet.</p>{/if}

<ul>
{#for await post of room.tail(20)}
    <li><b>{post.author}</b> {post.text}</li>
{/for}
</ul>

<label>
    Message
    <input bind:value={draft}>
</label>
<p class="hint">{draft.length} of 500 characters</p>

<button onclick={() => room.publish({ author: 'ada', text: draft })}>
    Post
</button>
