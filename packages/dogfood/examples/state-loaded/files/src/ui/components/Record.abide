<script>
import { state } from 'abide'
import { getContact } from '#server/rpc/contacts'

const contact = state(getContact({ id: '42' }))
</script>

<ul class="fields">
    <li><span>name</span>
        <strong>{contact.name ?? '—'}</strong></li>
    <li><span>role</span>
        <strong>{contact.role ?? '—'}</strong></li>
</ul>

<p class="status">{contact.pending() ? 'loading…' : ''}</p>
