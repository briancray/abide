<script>
import { principal, reactive } from '@abide/abide'
import signIn from '../signIn.ts'
import signOut from '../signOut.ts'

let email = reactive('maya@crm.example')
</script>

<div class="row">
    <label>email
        <input bind:value={email}>
    </label>
    <button onclick={() => {
        if (principal.authenticated()) signOut()
        else signIn({ email })
    }}>{principal.authenticated() ? 'Sign out' : 'Sign in'}</button>
</div>
