<script>
import { reactive } from '@abide/abide'
import salesReport from '../salesReport.handler.ts'

const REGIONS = ['north', 'south']

let region = reactive('north')

const rows = reactive(() => salesReport({ region }))

function refusal() {
    const failed = rows.error()
    return failed ? `${failed.status} ${failed.message}` : ''
}
</script>

<div class="tabs">
{#for one of REGIONS}
    <button aria-selected={region === one}
        onclick={() => { region = one }}>{one}</button>
{/for}
</div>

<p class="status">{refusal()}</p>

<ul class="fields">
    <li><span>rows</span>
        <strong>{rows.ready() ? rows.length : 0}</strong></li>
</ul>
