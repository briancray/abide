<script>
import { reactive } from '@abide/abide'
import listDeals from '../listDeals.ts'
import DealDetail from './DealDetail.abide'
import DealRow from './DealRow.abide'

const deals = reactive(() => listDeals())

// Held HERE, above both readers, so each finds this one on the way up.
reactive.share('selectedDeal', () => reactive('d1'))
</script>

<DealDetail/>

<div class="row">
{#for deal of deals.ready() ? deals : [] by deal.id}
    <DealRow id={deal.id} name={deal.name}/>
{/for}
</div>
