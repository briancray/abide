<script>
import { reactive, route } from '@abide/abide'

const TABS = ['deals', 'notes']

const query = route.query({ tab: 'deals' })
let draft = reactive('')
</script>

<div class="tabs">
    {#for name of TABS}
        <button aria-selected={query.tab === name}
            onclick={() => {
                query.tab = name
            }}
        >{name}</button>
    {/for}
</div>

<label>Draft a note
    <input bind:value={draft} placeholder="Follow up on Friday">
</label>

<ul class="fields">
    <li><span>address</span><strong>{route.url.search || '—'}</strong></li>
</ul>
