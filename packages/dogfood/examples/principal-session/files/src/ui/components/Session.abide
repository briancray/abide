<script>
import { principal, state } from 'abide'
import { signIn } from '#server/rpc/session'

let email = state('ada@example.com')
</script>

<div class="row">
    <label>email
        <input bind:value={email}>
    </label>
    <button onclick={() => {
        if (principal.authenticated) principal.clear()
        else signIn({ email })
    }}>{principal.authenticated ? 'Sign out' : 'Sign in'}</button>
</div>
