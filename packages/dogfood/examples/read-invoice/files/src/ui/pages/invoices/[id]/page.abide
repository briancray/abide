<script>
import { memo, route } from 'abide'
import { getInvoice } from '#server/rpc/invoices'

const invoice = memo(() => getInvoice({ id: route.params.id }))
</script>

<h1>Invoice {invoice.number}</h1>
{#if invoice.pending()}
    <p>Loading…</p>
{:else}
    <p>{invoice.total} due {invoice.dueOn}</p>
{/if}
