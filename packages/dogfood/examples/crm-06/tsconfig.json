{
    "compilerOptions": {
        "strict": true,
        "target": "esnext",
        "module": "preserve",
        "moduleResolution": "bundler",
        "allowImportingTsExtensions": true,
        "noEmit": true,
        "skipLibCheck": true,
        "types": ["bun"],
        "paths": {
            "#src/*": ["./src/*", "./src/*.ts"]
        }
    },
    "include": ["src", "e2e"]
}
