<script>
import { memo, state } from 'abide'
import { countOrders } from '#server/rpc/metrics'

let region = state('north')

// The cap goes on the value that pays for it, and no markup moved.
const orders = memo(() => countOrders({ region }), { debounce: 400 })
</script>

<div class="row">
    <label>region
        <input bind:value={region}>
    </label>
    <span class="status">{orders.refreshing() ? 'updating…' : ''}</span>
</div>

<ul class="fields stacked">
    <li><span>orders</span>
        <strong>{orders.pending() ? '—' : orders}</strong>
    </li>
</ul>
