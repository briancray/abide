<script>
import { state } from 'abide'
import InvoiceTable from '#ui/components/InvoiceTable.abide'

// The SAME key the component asks for, and exactly one of the two
// thunks ever runs. This one writes it; nothing between here and
// the `Money` instances is told that it did.
const currency = state.share('currency', () => state('USD'))
</script>

<h1>Invoices</h1>

<label>
    <div>Currency</div>
    <select bind:value={currency}>
        <option value="USD">US dollars</option>
        <option value="EUR">Euros</option>
        <option value="GBP">Pounds</option>
    </select>
</label>

<InvoiceTable/>
