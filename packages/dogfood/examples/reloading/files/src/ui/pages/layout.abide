<script>
import { online, refresh, watch } from 'abide'

// BOUNDED BY WHAT IS SUBSCRIBED, not by the scope. A `refresh()`
// over two hundred entries reloads only the ones something is
// reading and degenerates to a mark for the rest, so this catches
// up what a reader is holding and costs the mark everywhere else.
//
// `invalidate()` here would leave that handful standing at what it
// had until the reader navigated away and back — and following one
// with a `refresh()` is worse than either, throwing away exactly
// what stale-while-revalidate would have served.
watch(() => {
    if (online) refresh()
})
</script>

<slot/>
