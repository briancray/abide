<script>
import { memo, route, url, watch } from 'abide'
import { bookOut, getStock } from '#server/rpc/stock'

const level = memo(() =>
    getStock({
        warehouse: route.params.warehouse,
        sku: route.params.sku,
    }),
)

async function book() {
    await bookOut(route.params)
    // The pattern form, in the scope that is DISPLAYING the value:
    // `refresh` and not `invalidate`, so East reloads under
    // stale-while-revalidate instead of this page dropping to its
    // pending branch. West is not displayed, so the same call
    // degenerates to a mark there.
    getStock.refresh({ sku: route.params.sku })
}

const shelf = (warehouse: string) =>
    url('/stock/[warehouse]/[sku]', { warehouse, sku: route.params.sku })

// TRACKED, so `route` wakes this. The level is read through
// `peek` — a read that registers no subscriber — so a new count
// never does. A `sources` list would reach the same place by
// REPLACING the tracking rather than taking one read out of it,
// which is why writing both is redundant.
watch(() => {
    const held = level.peek()?.onHand ?? '…'
    document.title = `${route.params.sku} — ${held} on hand`
})
</script>

<nav class="switch">
    <a href={shelf('east')}>East</a>
    <a href={shelf('west')}>West</a>
</nav>

<h1>{route.params.sku}</h1>

{#if level.refreshing()}<span class="hint">Reloading…</span>{/if}

{#if level.pending()}
    <p>Counting the shelf…</p>
{:else}
    <p>On hand {level.onHand}</p>
    <p class="hint">Counted {level.countedOn}</p>
{/if}

<button onclick={() => level.invalidate()}>Mark stale</button>
<button onclick={() => level.refresh()}>Reload now</button>
<button onclick={book}>Book one out</button>
