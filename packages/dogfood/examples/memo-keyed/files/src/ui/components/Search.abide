<script>
import { memo, state } from 'abide'
import { searchContacts } from '#server/rpc/search'

let query = state('a')

const matches = memo(() => searchContacts({ query }))
</script>

<div class="row">
    <label>search
        <input bind:value={query}>
    </label>
    <span class="status">{matches.pending() ? 'searching…' : ''}</span>
</div>

<ul>
{#for one of matches}
    <li>{one}</li>
{/for}
</ul>
