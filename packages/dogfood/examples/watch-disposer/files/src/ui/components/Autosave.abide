<script>
import { reactive, watch } from 'abide'

let notes = reactive('Called Tuesday.')
let saved = reactive('Called Tuesday.')

watch(() => {
    // Read HERE: a read in the callback subscribes to nothing.
    const draft = notes
    const timer = setTimeout(() => {
        saved = draft
    }, 600)
    return () => clearTimeout(timer)
})
</script>

<label>notes
    <input bind:value={notes}>
</label>

<ul class="fields stacked">
    <li><span>saved</span><strong>{saved}</strong></li>
</ul>
