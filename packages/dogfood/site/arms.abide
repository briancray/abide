<!-- The bench page, as ONE table: what was measured, what abide cost, what the hand-written arm cost,
     and the difference. Four columns, one row per claim, and everything else behind the row.

     It was a stack of cards — a heading, a paragraph of prose and one line per arm, six deep. Every
     number on it was correct and the page was unreadable: forty cases at six arms is 240 lines of
     equal weight, and the two numbers a reader came for sit somewhere inside that. A comparison is
     read by SCANNING DOWN A COLUMN, which is a thing a page can only offer if the column exists.

     So the arms did not go away, they went BEHIND. Opening a row gives back the prose, the other
     arms, the per-item numbers and the bars — which is the right place for them, because they are the
     evidence for the line rather than the claim itself.

     What arrives from `harness` is FACTS — which arm is the subject, which is the harness floor, how
     full a bar would be, which way the ratio went — and this file is the only place those become
     colours. That seam is why the perf app can draw the same rows without a stylesheet. -->
<script module>
import type { ArmRow, BenchRow } from 'harness'
import { armBar, armTone, armWidth, tailTone } from './bench.ts'
import { BENCH_ARM as ARM, BENCH_ROW as ROW, HEAD, LABEL, NUMBER } from './table.ts'

// The kind is a chip rather than a column: it says how to read the rest of the row, and four colours are
// quicker to skip past than four words in the same grey. `LABEL` and not `HEAD` — see `LABEL`: `HEAD`
// carries a colour of its own, and which of the two won was Tailwind's emit order to decide.
const KIND_TONE: Record<BenchRow['kind'], string> = {
    time: 'kind is-time',
    work: 'kind is-work',
    wake: 'kind is-wake',
    budget: 'kind is-budget',
}

const SMALL = 'button-small'

/** A bench with no hand-written arm has nothing to put in the column, and says so rather than lying. */
const NONE = '—'

/**
 * The hand-written column, which is the only one of the two that can be ABSENT — `row.abide` is
 * always an arm, so it is read directly and needs no guard pretending otherwise.
 */
const handWrittenValue = (arm: ArmRow | null): string => (arm === null ? NONE : arm.value())
const handWrittenEach = (arm: ArmRow | null): string => (arm === null ? '' : arm.each())

/**
 * The hand-written arm ONCE it carries a ratio: `null` while the row is unrun, and `null` for a
 * bench that never made the comparison.
 *
 * ONE predicate, which the number and its colour both come off. Written as two — one testing
 * `?.tail()` and the other `!== null && tail() !== ''` — they are two spellings of the same question
 * and can drift into answering it differently, and what that looks like is a colour saying one thing
 * and the number under it another.
 */
const compared = (row: BenchRow): ArmRow | null => {
    const arm = row.handWritten
    return arm !== null && arm.tail() !== '' ? arm : null
}

/**
 * The difference column, which carries the row's STATUS until there is a difference to report.
 *
 * An unrun row would otherwise be blank in the one column a reader is scanning, which reads as a
 * measurement that came back empty rather than as one nobody has taken yet.
 */
const differenceText = (row: BenchRow): string => compared(row)?.tail() ?? row.status()
const differenceTone = (row: BenchRow): string => {
    const arm = compared(row)
    return arm === null ? 'head tail' : tailTone(arm)
}
</script>

<script>
import { props } from 'abide'

const { rows } = props<{ rows: BenchRow[] }>()
</script>

{#for row of rows}
    <details class="row" data-bench={row.title}>
        <summary class={ROW}>
            <div class="bench-what">
                <span class="bench-title" title={row.title}>{row.title}</span>
                <span class={KIND_TONE[row.kind]}>{row.kind}</span>
                <!-- What one op IS, beside the title rather than behind the row: without it the two
                     numbers to its right cannot be read at all, and this is the column a reader
                     scans. Absent on a bench that does not divide, where an op is just an op. -->
                {#if row.per}<span class="head bench-per">{row.per}</span>{/if}
                {#if row.noisy()}<span class="warn-chip">noisy</span>{/if}
            </div>

            <!-- The two numbers the page exists for, in the same two columns on every row of every
                 suite. The per-item number rides under each of them rather than in a column of its
                 own: it is only present on a bench that declared `per`, and an empty column on the
                 other thirty rows is a column that reads as missing data.

                 NEITHER is coloured, and abide's used to be. Verdigris means two things on this page
                 — `is-abide` marks whose arm it is, `is-good` marks who won — and on the one element
                 that wore both they disagreed out loud: `8.00 ms` in green beside a hand-written
                 `2.64 ms` and a red `3.03×`, one row saying abide won and lost. Identity is already
                 carried by the column head and by `armTone` on the label below, so the number gives
                 the colour up and the VERDICT is the only thing on a row still spending it. -->
            <div class="cell-right">
                <div class={NUMBER}>{row.abide.value()}</div>
                {#if row.abide.each()}<div class="{NUMBER} is-sub">{row.abide.each()}</div>{/if}
            </div>
            <div class="cell-right">
                <div class={NUMBER}>{handWrittenValue(row.handWritten)}</div>
                {#if handWrittenEach(row.handWritten)}<div class="{NUMBER} is-sub">{handWrittenEach(row.handWritten)}</div>{/if}
            </div>

            <!-- The memory column, and it is a COUNT of DOM nodes made per op rather than bytes.
                 `performance.memory` reads 9.5 MB against a renderer holding 2.8 GB — nodes are not
                 on the JS heap — and a net count cannot stand in either, because detaching a subtree
                 of ten thousand is one `remove`. This is exact, is the same in every engine, and is
                 one of the three numbers this project already budgets emitted code in.

                 Abide's count over abide's PER-ITEM count, which is the sub-line every other column
                 on this row already means. It held the hand-written arm's count there instead, and
                 the two are indistinguishable by eye: `30,003` over `10,001` reads as one op and its
                 tenth part, so a reader took 10,001 for the per-row figure of the number above it.
                 The hand-written count is one click away, in the per-arm `nodes` column below. -->
            <div class="cell-right">
                <div class={NUMBER}>{row.abide.nodes() || NONE}</div>
                {#if row.abide.nodesEach()}<div class="{NUMBER} is-sub">{row.abide.nodesEach()}</div>{/if}
            </div>

            <span class={differenceTone(row)}>{differenceText(row)}</span>

            <!-- Inside the summary, and it needs no `stopPropagation` to stay there: a summary skips
                 its own toggle when the click landed on an interactive descendant, so the button runs
                 without closing the row under whoever opened it. Written with one first, then removed
                 — the e2e passes either way, which is what says the guard was doing nothing. -->
            <button class={SMALL} onclick={() => void row.run()}>run</button>
        </summary>

        <div class="row-body">
            {#if row.note}<p class="row-note">{row.note}</p>{/if}

            <!-- The DISTRIBUTION, on its own seven columns, p50 FIRST because p50 is what the summary
                 and every ratio use — the column a reader is checking the headline against has to be
                 the one their eye lands on. `min` is the pass where the tab was quiet, which is a
                 floor rather than a cost, and `max` is the worst the machine did. Then `ops`, which
                 is the SAMPLE SIZE the three of them are averages of: a ns/op with no count under it
                 cannot be read, and the count is also what catches an arm sized against a world that
                 changed before it ran — nine passes of 320,000 iterations, every ns/op correct. -->
            <div class="{ARM} arm-head">
                <span class={HEAD}>every arm · {row.status()}</span>
                <span class="head head-right">p50</span>
                <span class="head head-right">min</span>
                <span class="head head-right">max</span>
                <span class="head head-right">ops</span>
                <span class="head head-right">nodes</span>
                <span class="head head-right">abide ÷ arm</span>
            </div>

            {#for arm of row.arms}
                <div class={ARM}>
                    <div class="arm-what">
                        <span class={armTone(arm)} title={arm.label}>{arm.label}</span>
                        {#if row.kind === 'time'}
                            <!-- `style=` because the width is a MEASUREMENT: this arm's time against
                                 the slowest arm in its row, which no class can name. -->
                            <div class="bar"><div class="bar-fill {armBar(arm)}" style:width={armWidth(arm)}></div></div>
                        {:else}
                            <span class="arm-of" title={arm.of()}>{arm.of() || NONE}</span>
                        {/if}
                    </div>
                    <div class="cell-right">
                        <div class={NUMBER}>{arm.value()}</div>
                        {#if arm.each()}<div class="{NUMBER} is-sub">{arm.each()}</div>{/if}
                    </div>
                    <span class={NUMBER}>{arm.min() || NONE}</span>
                    <span class="{NUMBER} is-sub">{arm.max() || NONE}</span>
                    <span class="{NUMBER} is-sub">{arm.ops() || NONE}</span>
                    <span class={NUMBER}>{arm.nodes() || NONE}</span>
                    <span class={tailTone(arm)}>{arm.tail()}</span>
                </div>
            {/for}

            {#if row.noisy()}
                <p class="row-warn">noisy: most passes were far off the best one. Re-run this case on its own before quoting the ratio.</p>
            {/if}
        </div>
    </details>
{/for}
