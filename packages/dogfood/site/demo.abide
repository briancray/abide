<!-- One demo app: the thing running, and what it costs, side by side.

     A demo that is only a picture rots the same way a demo that is only a demo does — it renders
     something plausible and nobody notices when the plausible thing is wrong. So the frame is not the
     whole card: the ops the app declares are DRIVEN here and priced, and the result is the same
     `Profile` record `/tests` and `/docs` paint.

     THREE STATES, and each is a different thing to say:
       waiting   the fleet is up and the ops have not run yet
       priced    they ran, and these are the numbers
       missing   nothing is listening on the app's own port — `bun run fleet` is what serves it

     The last one exists because the alternative is an empty box, and an empty box is exactly what a
     demo that is broken, slow, or never built also looks like. -->
<script module>
import { state, watch } from 'abide'
import type { DemoApp } from '../demos/APPS.ts'
import type { Metric, Profile } from 'harness'
import { priceOps } from './drive.ts'
import ProfileView from './profile.abide'

/** What the card shows before anything has been driven. */
const NOTHING: Metric[] = []

const rest = (ms: number): Promise<void> => new Promise((done) => setTimeout(done, ms))

/**
 * The frame's document, once it is the DEMO's and not the blank one.
 *
 * `about:blank` is what a frame holds before its `src` lands, and its `readyState` is already
 * `complete` — so a check for `complete` alone drives an empty document and prices nothing, which
 * renders as four ops that could not find their controls. The URL is what tells the two apart.
 */
async function loaded(element: HTMLIFrameElement): Promise<Document | null> {
    for (let waited = 0; waited < 100; waited++) {
        const inner = element.contentDocument
        if (inner !== null && inner.location.href !== 'about:blank' && inner.readyState === 'complete') {
            return inner
        }
        await rest(50)
    }
    return null
}
</script>

<script>
import { props } from 'abide'

const { app, up } = props<{ app: DemoApp; up: boolean }>()

const frame = state<HTMLIFrameElement | null>(null)
const priced = state<Metric[]>(NOTHING)
const trouble = state('')

/**
 * Drive the app once its own document has loaded.
 *
 * `bind:element` is client-only, which is what decides WHEN this happens: a server render writes the
 * card and drives nothing, and the browser that adopts it is what asks the app to do anything. So a
 * page of these server-renders in one pass with no demo having been touched.
 */
watch(() => {
    const element = frame()
    if (element === null || !up()) return

    void (async (): Promise<void> => {
        try {
            const inner = await loaded(element)
            if (inner === null) {
                trouble = 'the frame never loaded the demo — is it on another origin?'
                return
            }
            priced = await priceOps(inner, app().ops)
        } catch (error: unknown) {
            // Said out loud. A demo whose ops threw is a demo that is broken, and a card that
            // silently showed no metrics would be reporting that it is fast.
            trouble = `the ops did not run — ${String(error)}`
        }
    })()
})

/** The record, built from what this lane actually saw. */
function profile(): Profile {
    return {
        title: app().title,
        note: app().blurb,
        suite: app().name,
        substrate: 'browser',
        faces: ['visit', 'bench'],
        status: trouble() !== '' ? 'failed' : priced().length > 0 ? 'benched' : 'running',
        lines: trouble() === '' ? [] : [{ label: 'trouble', value: trouble(), kind: 'fail' }],
        metrics: priced(),
    }
}
</script>

<section class="demo" data-demo={app.name}>
    <div class="demo-head">
        <h2 class="demo-title">{app.title}</h2>
        <a class="link" href="{app.prefix}{app.entry}">open it on its own →</a>
    </div>
    <p class="note">{app.blurb}</p>

    {#if up}
        <div class="demo-body">
            <!-- No `loading="lazy"`: the card DRIVES this app, and an op cannot be priced against a
                 document the browser has not decided to fetch yet. -->
            <iframe class="demo-frame" src="{app.prefix}{app.entry}" title={app.title} bind:element={frame}></iframe>
            <div class="demo-profile panel">
                <ProfileView profile={profile()}/>
            </div>
        </div>
    {:else}
        <p class="error">Nothing is listening on port {app.port}. These are separate applications — <code>bun run fleet</code> is what boots them behind this origin.</p>
    {/if}
</section>
