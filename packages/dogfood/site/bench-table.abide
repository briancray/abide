<!-- Measurements as one table: the filter, the sticky header, a heading per suite, and a row per claim.

     Handed the rows it should show rather than reaching for them, which is what lets one component be
     both `/bench` (every suite) and `/bench/<name>` (one), with no branch inside it for which page it is
     on. It is `cases.abide`'s opposite number and deliberately the same shape — the two tables answer
     different questions and share everything around the columns, which is the seam `table.ts` states.

     The filter and the header are the table's rather than either page's, and that is what this file is
     FOR. Written out twice they had already drifted: only the index grew a "nothing matches" line, so
     filtering to nothing on `/bench/<name>` left a bare header, which reads as "this suite has no
     benches" — and the two placeholders named different things to type.

     The filter DROPS rows rather than hiding them with a class, so a kind nobody is reading is a row
     that is not on the page at all — which is also what makes it a control over MINUTES rather than over
     a view: `run everything` walks `groups`, so sixty cases at two minutes is the four somebody is
     looking at in seconds.

     Whatever is nested inside lands under the table. -->
<script module>
import { memo, state } from 'abide'
import type { BenchRow } from 'harness'
import Arms from './arms.abide'
import {
    BENCH_ROW,
    benchText,
    BUTTON,
    CHIP,
    CHIP_ON,
    FIELD,
    GROUP,
    grouped,
    HEAD,
    HEAD_ROW,
    matches,
    TABLE,
    terms,
} from './table.ts'

/** Which kind of measurement a chip asks for. `all` is every row, whatever it counts. */
const KINDS = ['all', 'time', 'work', 'wake', 'budget'] as const
type Kind = (typeof KINDS)[number]
</script>

<script>
import { props } from 'abide'

const { rows } = props<{ rows: BenchRow[] }>()

const kind = state<Kind>('all')
const query = state('')
const progress = state('')

/**
 * The rows this filter is showing, grouped by suite — and no heading left over a suite it emptied.
 *
 * The query is taken apart ONCE, outside the loop: this body re-runs on every character, and sixty
 * rows per keystroke is sixty re-parses of the same string otherwise.
 */
const groups = memo((): { suite: string; rows: BenchRow[] }[] => {
    const wanted = terms(query)
    const showing: BenchRow[] = []
    for (const row of rows) {
        if (kind !== 'all' && row.kind !== kind) continue
        if (!matches(benchText(row), wanted)) continue
        showing.push(row)
    }
    return grouped(showing)
})

/**
 * How many rows the filter is showing, out of how many there are.
 *
 * A function rather than a memo because one slot reads it and nothing else does — there is no second
 * reader for a cell to serve, and the slot it is called from already tracks everything it touches.
 */
function shownCount(): string {
    let showing = 0
    for (const group of groups) showing += group.rows.length
    return showing === rows.length ? `${rows.length}` : `${showing} of ${rows.length}`
}

async function runEverything(): Promise<void> {
    const showing: BenchRow[] = []
    for (const group of groups) for (const row of group.rows) showing.push(row)
    for (let i = 0; i < showing.length; i++) {
        const row = showing[i] as BenchRow
        progress = `${i + 1} / ${showing.length} — ${row.title}`
        await row.run()
    }
    progress = `done — ${showing.length} cases`
}
</script>

<!-- One card holding the filter and the rows it decides, the same shape `cases.abide` draws: `.is-table`
     is what takes the panel's padding off so the rules run edge to edge and the card head pins
     against the page rather than against a scrollport of its own.

     The filter and the column names are ONE element, `.table-top`, because they pin as one block and a
     sticky offset cannot be chained — see `app.css`. -->
<div class="panel is-table">
    <div class="table-top">
        <div class="toolbar">
            <button class={BUTTON} onclick={() => void runEverything()}>run everything</button>
            <input class={FIELD} bind:value={query} placeholder="filter — title, suite or arm"/>
            <span class="toolbar-count">{shownCount()} benches</span>
            <span class="toolbar-progress">{progress}</span>
            <div class="chips">
                {#for name of KINDS}<button class={kind === name ? CHIP_ON : CHIP} onclick={() => (kind = name)}>{name}</button>{/for}
            </div>
        </div>

        <div class="{BENCH_ROW} {HEAD_ROW}">
            <span class={HEAD}>what was measured</span>
            <span class="head head-right">abide</span>
            <span class="head head-right">by hand</span>
            <span class="head head-right">nodes/op</span>
            <span class="head head-right">abide ÷ by hand</span>
            <span class={HEAD}></span>
        </div>
    </div>

    <div class={TABLE}>
        {#if groups.length === 0}
            <p class="table-empty">Nothing matches “{query}”.</p>
        {/if}

        {#for group of groups}
            <div class={GROUP}>
                <a href="/bench/{group.suite}">{group.suite}</a> · {group.rows.length}
            </div>
            <Arms rows={group.rows}/>
        {/for}
    </div>
</div>

<slot/>
