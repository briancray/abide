<script>
// One heading and what it heads. The heading is listed in the page's rail as it is written, so
// the rail is the page's own sections rather than a scan of its markup.
import { props, raw } from '@abide/abide'

import { docHeadings } from './docHeadings.ts'
import { inline, slugify } from './inline.ts'

const {
    title,
    level = 2,
    filed = true,
} = props<{
    title: string
    level?: 2 | 3
    /** Whether it files its own heading in the rail; `Doc` files a page's trailing parts itself. */
    filed?: boolean
}>()
const id = slugify(title)

const headings = docHeadings()
if (filed) headings = [...headings, { id, title, level }]
</script>

<section>
    <div class="flow">
        {#if level === 3}
            <h3 id={id}>{raw(inline(title))}</h3>
        {:else}
            <h2 id={id}>{raw(inline(title))}</h2>
        {/if}
        <slot />
    </div>
</section>
