<script>
// THE NAV, ONE MODULE FOR THE WHOLE SITE rather than markup generated into every page: it is the
// same list on every one of them, and a copy per page is that list in every route chunk a
// reader loads. It reads `SITE`, which is where a page's label has its one home.
//
// TWO ARMS RATHER THAN ONE LINK WITH A CONDITIONAL ATTRIBUTE. Whether an attribute is OMITTED
// where its expression is false is not decided anywhere in the rulebook, and what the compiler
// does today is write it empty — which `a[aria-current]` in the stylesheet matches, so every
// link in the nav rendered as the one you are on.
//
// WHERE YOU ARE COMES FROM THE ROUTE. The nav is the layout's, and a layout outlives the page it
// wraps (41.11), so a prop the page passed would be the FIRST page's for as long as the nav stands.
// The same route decides WHICH pages it lists — the guide or the reference — and the site bar above
// it is where a reader moves between those.
//
// THE LITERAL, NOT THE ADDRESS: `route.name()` is the route an item's `href` is spelled in, where
// `route.url()` is where the app is served — below a mount, `/docs/guide/run-it` for `/guide/run-it` — and the
// link is written through `url` for the same reason (16.10).
import { raw, route, type RouteLiteral, url } from '@abide/abide'

//
// `-ml-2` IS NOT SPACING: it pulls the link's own padding back off the rail so the TEXT lines up
// with the section name above it, hover surface and all. A stub's link recedes further than the
// rest until it is pointed at. `sidebar` carries no rule — it is what `e2e/app.spec.ts` finds the
// nav by.
import { inline } from './inline.ts'
import { sidebarGroupsOf } from './siteSections.ts'

const LINK =
    '-ml-2 block flex-1 rounded-sm px-2 py-1 text-chrome no-underline transition-[opacity,background-color] duration-120 ease-[ease]'
</script>

{#if sidebarGroupsOf(route.name()).length > 0}
    <nav class="sidebar sticky top-bar flex h-[calc(100vh_-_var(--spacing-bar))] flex-col gap-section self-start overflow-y-auto border-r border-rule px-4 pt-7 pb-16 max-lg:static max-lg:h-auto max-lg:border-r-0 max-lg:border-b">
        {#for group of sidebarGroupsOf(route.name())}
            <section class="flex flex-col gap-snug">
                <h2 class="font-mono text-micro/2 font-medium tracking-caps text-muted uppercase">{group.section}</h2>
                <ul class="flex list-none flex-col gap-hair p-0">
                    {#for item of group.pages}
                        <li class="flex items-baseline gap-tight">{#if item.route === route.name()}<a class="{LINK} bg-signal/12 font-semibold text-signal" href={url(item.route as RouteLiteral)} aria-current="page">{raw(inline(item.nav))}</a>{:else}<a class="{LINK} text-ink hover:bg-signal/10 hover:opacity-100 {item.stub ? 'opacity-52' : 'opacity-75'}" href={url(item.route as RouteLiteral)}>{raw(inline(item.nav))}</a>{/if}{#if item.stub}<span class="size-1 flex-none self-center rounded-full bg-muted opacity-55" title="Stub — not written yet"></span>{/if}</li>
                    {/for}
                </ul>
            </section>
        {/for}
    </nav>
{/if}
