<script>
// THE NAV, ONE MODULE FOR THE WHOLE SITE rather than markup generated into every page: it is the
// same list on every one of them, and a copy per page is that list in every route chunk a
// reader loads. It reads `SITE`, which is where a page's label has its one home.
//
// WHERE YOU ARE COMES FROM THE ROUTE. The nav is the layout's, and a layout outlives the page it
// wraps (41.11), so a prop the page passed would be the FIRST page's for as long as the nav stands.
//
// THE LITERAL, NOT THE ADDRESS: `route.name()` is the route an item's `href` is spelled in, where
// `route.url()` is where the app is served — below a mount, `/docs/reactive/watch` for
// `/reactive/watch` — and the link is written through `url` for the same reason (16.10).
import { raw, route, type RouteLiteral, url } from '@abide/abide'

import { inline } from './inline.ts'
import { SITE, WHERE } from './SITE.ts'
import { isFramed, runsOf } from './sitePages.ts'

// `-ml-2` IS NOT SPACING: it pulls the link's own padding back off the rail so the TEXT lines up
// with the group name above it, hover surface and all. `sidebar` carries no rule — it is what
// `e2e/app.spec.ts` finds the nav by.
const LINK =
    '-ml-2 block flex-1 rounded-sm px-2 py-1 text-chrome no-underline transition-[opacity,background-color] duration-120 ease-[ease]'

// The link you are on is marked and carries `aria-current`; every other is absent of it (32.37).
const linkClass = (active: boolean): string =>
    `${LINK} ${active ? 'bg-signal/12 font-semibold text-signal' : 'text-ink opacity-75 hover:bg-signal/10 hover:opacity-100'}`

// A name that runs on one side only is marked with that side, in the color its signature's spine
// carries (40.36); one that runs on both, the default, carries no mark.
const MARK_CLASS: Readonly<Record<string, string>> = {
    server: 'text-warm',
    browser: 'text-cool',
}
</script>

{#if !isFramed(route.name())}
    <nav class="sidebar sticky top-bar flex h-[calc(100vh_-_var(--spacing-bar))] flex-col gap-section self-start overflow-y-auto border-r border-rule px-4 pt-7 pb-16 max-lg:static max-lg:h-auto max-lg:border-r-0 max-lg:border-b">
        {#for group of SITE}
            <section class="flex flex-col gap-snug">
                <h2 class="font-mono text-micro/2 font-medium tracking-caps text-muted uppercase">{raw(inline(group.group))}</h2>
                {#for run of runsOf(group)}
                    {#if run.label}
                        <h3 class="mt-tight text-chrome font-medium text-muted">{run.label}</h3>
                    {/if}
                    <ul class="flex list-none flex-col gap-hair p-0">
                        {#for item of run.pages}
                            <li class="flex items-baseline gap-tight"><a class={linkClass(item.route === route.name())} href={url(item.route as RouteLiteral)} aria-current={item.route === route.name() ? 'page' : undefined}>{raw(inline(item.nav))}</a>{#if WHERE[item.where].mark}<span class="font-mono text-micro/2 {MARK_CLASS[WHERE[item.where].mark ?? '']}">{WHERE[item.where].mark}</span>{/if}</li>
                        {/for}
                    </ul>
                {/for}
            </section>
        {/for}
        <section class="flex flex-col gap-snug">
            <h2 class="font-mono text-micro/2 font-medium tracking-caps text-muted uppercase">Documents</h2>
            <ul class="flex list-none flex-col gap-hair p-0">
                <li class="flex items-baseline gap-tight"><a class={linkClass(route.name() === '/rulebook')} href={url('/rulebook' as RouteLiteral)} aria-current={route.name() === '/rulebook' ? 'page' : undefined}>Rulebook</a></li>
            </ul>
        </section>
    </nav>
{/if}
