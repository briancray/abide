<script server>
import { GET } from '@abide/abide/server'

import { folded } from './folded.ts'
import { ownOrigin } from './ownOrigin.server.ts'

// What changes on every answer and says nothing about the handler: shown, they would make the same
// exchange read differently on each render.
const VOLATILE = new Set([
    'date',
    'traceresponse',
    'server-timing',
    'content-length',
    'etag',
    'transfer-encoding',
])
const LONGEST_BODY = 1200

// A REAL REQUEST TO THE CRM AND ITS ANSWER (40.43), asked as the page loads — the browser's own call,
// so the answer reaches it as every answer does (41.5) — and sent to this server's own origin, where the
// CRM's handlers answer at their own addresses (40.24) — never a request off it.
const exchange = GET(
    async ({
        method,
        path,
        body,
        headers,
        pick,
    }: {
        method: string
        path: string
        body: string | undefined
        /** Each `Name: value` on a line of its own: one string, as a GET's args ride its query. */
        headers: string
        /**
         * JSON pointers (RFC 6901) into a JSON answer, one to a line: the parts of a large body a page
         * is about. One shows its value; several show an object of each, by its last token.
         */
        pick: string | undefined
    }) => {
        if (!path.startsWith('/') || path.startsWith('//'))
            throw new Error(`docs: ${path} is not an address of this site`)
        const sent = new Headers()
        for (const header of headers.split('\n')) {
            const at = header.indexOf(':')
            if (at > 0)
                sent.set(
                    header.slice(0, at).trim(),
                    header.slice(at + 1).trim(),
                )
        }
        if (body !== undefined && !sent.has('content-type'))
            sent.set('content-type', 'application/json')
        const answer = await fetch(new URL(path, ownOrigin()), {
            method,
            headers: sent,
            redirect: 'manual',
            ...(body === undefined ? {} : { body }),
        })
        const received: string[] = []
        for (const [name, value] of answer.headers)
            if (!VOLATILE.has(name))
                // A nonce is fresh on every answer, so it is shown as what it is rather than its value.
                received.push(
                    `${name}: ${value
                        .replace(/'nonce-[^']*'/g, "'nonce-…'")
                        // The caller's handle is fresh for every browser, so it reads as what it is.
                        .replace(/^abide-caller=[^;]*/, 'abide-caller=…')}`,
                )
        let text = await answer.text()
        if (answer.headers.get('content-type')?.includes('json'))
            try {
                let parsed: unknown = JSON.parse(text)
                if (pick !== undefined) {
                    const pointers = pick.split('\n')
                    const picked: Record<string, unknown> = {}
                    for (const pointer of pointers) {
                        let value = parsed
                        let last = ''
                        for (const token of pointer.split('/').slice(1)) {
                            last = token
                                .replaceAll('~1', '/')
                                .replaceAll('~0', '~')
                            // `[key=value]` picks the item of a list whose `key` is `value`, so a
                            // page names the entry it means rather than its place in the list.
                            const match = /^\[(\w+)=(.*)\]$/.exec(last)
                            value = match
                                ? (
                                      value as
                                          Record<string, unknown>[] | undefined
                                  )?.find(
                                      (item) =>
                                          String(item?.[match[1] as string]) ===
                                          match[2],
                                  )
                                : (
                                      value as
                                          Record<string, unknown> | undefined
                                  )?.[last]
                        }
                        picked[last] = value
                    }
                    parsed =
                        pointers.length === 1
                            ? Object.values(picked)[0]
                            : picked
                }
                text = JSON.stringify(parsed, null, 2) ?? 'undefined'
            } catch {}
        if (text.length > LONGEST_BODY)
            text = `${text.slice(0, LONGEST_BODY)}\n…`
        return {
            status: `${answer.status} ${answer.statusText}`,
            headers: received.sort().map(folded),
            body: folded(text),
        }
    },
)
</script>

<script>
// AN EXCHANGE: the request a page names, as HTTP, and the answer the CRM gave it this render —
// read rather than written, so a status, a header or a body on the page is one the server sends.
import { props, reactive } from '@abide/abide'

import Code from './Code.abide'

const {
    method = 'GET',
    path,
    body,
    headers = [],
    pick,
} = props<{
    method?: string
    path: string
    /** The request's body, JSON unless a `content-type` among `headers` says otherwise. */
    body?: string
    /** Each `Name: value`. */
    headers?: readonly string[]
    /**
     * JSON pointers to the parts of a JSON answer shown, e.g. `/paths/~1deals~1getDeal/get/operationId`;
     * a `[key=value]` token picks a list's item by a field, e.g. `/result/tools/[name=get_deals_getDeal]`.
     */
    pick?: readonly string[]
}>()

const answer = reactive.derived(() =>
    exchange({
        method,
        path,
        body,
        headers: headers.join('\n'),
        pick: pick?.join('\n'),
    }),
)
const requested = [
    `${method} ${path}`,
    ...headers,
    ...(body === undefined ? [] : ['', body]),
].join('\n')
const answered = reactive.derived(() =>
    answer
        ? [
              `HTTP/1.1 ${answer.status}`,
              ...answer.headers,
              '',
              answer.body,
          ].join('\n')
        : '',
)
</script>

<div class="exchange">
    <Code language="http" caption="browser" code={requested} />
    <!-- The answer is the browser's own call (41.5), so it is drawn like an example's result:
         a page's twin carries the request alone, and never a copy that depends on timing. -->
    <div class="exchange" data-result>
        {#if answer.error()}
            <p class="shown-missing">The CRM did not answer <code>{method} {path}</code>.</p>
        {:else if answer}
            <Code language="http" caption="server" code={answered} />
        {/if}
    </div>
</div>
