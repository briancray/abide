<script>
// A block of code a page writes out, highlighted, under the caption that says where it lives.
//
// THE CAPTION IS THE SYNTAX AND THE SPINE IS THE SIDE. A path says both by itself; one of the four
// side words — `server`, `browser`, `shared`, `abide` — is shown beside the language, because "browser"
// alone says where the code runs and leaves a reader guessing between a name read by name and `s()`.
import { copy, props, raw, reactive } from '@abide/abide'

import { dedent } from './dedent.ts'
import { highlight, sideOf } from './highlight.ts'

const {
    code,
    language = '',
    caption = '',
} = props<{ code: string; language?: string; caption?: string }>()

// Written inside an indented template literal, the code is shown flush: its first and last blank
// lines dropped and the margin every line shares taken off. A memo, since an example's live
// markup is code that changes as the reader works the example.
const flush = reactive(() =>
    dedent(
        code
            .replace(/^\s*\n/, '')
            .trimEnd()
            .split('\n'),
    ),
)

const shown =
    caption.includes('/') || caption.startsWith('.') || language === ''
        ? caption
        : `.${language} · ${caption}`

// The block as written, copied by `copy` from the button in its caption — the caption alone, so
// the twin, which reads a figure's `pre`, carries no button text.
const copier = copy({ value: () => flush })
</script>

{#if caption}
    <figure class="snippet" data-side={sideOf(caption)} data-caption={caption}>
        <figcaption>{shown}<button class="group ml-auto cursor-pointer border-0 bg-transparent p-0 font-mono text-chrome text-muted hover:text-ink" {...copier}><span class="group-data-copied:hidden">Copy</span><span class="hidden group-data-copied:inline">Copied</span></button></figcaption>
        <pre><code class="language-{language}">{raw(highlight(flush))}</code></pre>
    </figure>
{:else}
    <pre><code class="language-{language}">{raw(highlight(flush))}</code></pre>
{/if}
