<script>
// A docs page: its header from `SITE` — the group it is in, its title and what it is for — then,
// for a page documenting a REGISTRY section, its parts in the order its group's form gives them
// (40.9): its Syntax and the headings under it, the examples the page writes, its Types, its See
// also, its Tests and its Rules — the examples first in an `authoring` group, where what a reader
// came for is how the construct is written (40.40). A guide documents no section, so it is its own
// prose and its See also (40.39). Then the thread to the pages either side, and the rail: the page's own headings, and its two
// markdown downloads.
//
// WHICH PAGE COMES FROM THE ROUTE, so a page names nothing about itself: its words are `SITE`'s,
// keyed by where it is served. A document — a page read off a file in `docs/` — is not in `SITE`,
// so it hands over its own words as `documentPage`, and has no neighbors to thread to and no markdown twin.
//
// THE RAIL IS A `scrollSpy` over the headings the page files, each found by its id: the link of the
// heading the reader has scrolled to is marked `aria-current`.
import './zodJitless.ts'

import {
    props,
    raw,
    route,
    type RouteLiteral,
    scrollSpy,
    url,
} from '@abide/abide'

import { docHeadings } from './docHeadings.ts'
import type { Heading } from './Heading.ts'
import { inline } from './inline.ts'
import Registry, { clausesOf, hasTypes } from './Registry.abide'
import Rules from './Rules.abide'
import Section from './Section.abide'
import SeeAlso from './SeeAlso.abide'
import { type SitePage, WHERE } from './SITE.ts'
import { groupOf, markdownAddressOf, neighborsOf, pageAt } from './sitePages.ts'
import Tests from './Tests.abide'

const {
    documentPage,
    seeAlso = [],
    tests = [],
} = props<{
    documentPage?: Omit<SitePage, 'where' | 'subgroup' | 'guide'>
    /** The routes of the pages a reader of this one goes to next (40.19). */
    seeAlso?: readonly string[]
    /** The test cases that exercise what the page documents, each a file and its anchors (40.15). */
    tests?: readonly { path: string; from: readonly string[] }[]
}>()
const page = documentPage ?? pageAt(route.name())
// Where the name is reached for (40.36): a page of a group says it, the home page and a document do not.
const where =
    documentPage === undefined &&
    groupOf(page.route) !== undefined &&
    !pageAt(page.route).guide
        ? WHERE[pageAt(page.route).where]
        : undefined
const documents = documentPage === undefined && page.registry !== ''
const { previous, next } =
    documentPage === undefined
        ? neighborsOf(page.route)
        : { previous: undefined, next: undefined }
const group = groupOf(page.route)
const examplesFirst = group?.form === 'authoring'
const guide = documentPage === undefined && pageAt(page.route).guide
const plain = page.title.replaceAll('`', '')
const markdown =
    documentPage === undefined
        ? url(markdownAddressOf(page.route) as RouteLiteral)
        : undefined

const headings = docHeadings()

// THE TRAILING PARTS ARE FILED HERE, known before the page renders, rather than by their own
// `<Section>`: Tests and Rules wait on their calls, so a render streams them in after the rail
// (41.4), and a rail they filed themselves would hold fewer rows on the server than on the client.
const rules = documents ? clausesOf(page.registry) : []
const trailing: Heading[] = []
if (documents && hasTypes(page.registry))
    trailing.push({ id: 'types', title: 'Types', level: 2 })
if ((documents || guide) && seeAlso.length > 0)
    trailing.push({ id: 'see-also', title: 'See also', level: 2 })
if (documents && tests.length > 0)
    trailing.push({ id: 'tests', title: 'Tests', level: 2 })
if (rules.length > 0) trailing.push({ id: 'rules', title: 'Rules', level: 2 })
const toc = scrollSpy({ items: () => [...headings, ...trailing] })
</script>

<head>
    <title>{plain} — abide</title>
    {#if markdown}
        <link rel="alternate" type="text/markdown" href={markdown} title="{plain} as Markdown">
    {/if}
</head>

<main id="content">
    <header>
        {#if group}
            <p class="eyebrow">{raw(inline(group.group))}</p>
        {/if}
        <h1>{raw(inline(page.title))}</h1>
        {#if page.description}
            <p class="intent">{raw(inline(page.description))}</p>
        {/if}
        {#if where}
            <p class="where">Runs {raw(inline(where.runs))}, written in {raw(inline(where.written))}.</p>
        {/if}
    </header>
    {#if documents}
        {#if examplesFirst}
            <Section title="Examples">
                <slot />
            </Section>
            <Registry />
        {:else}
            <Registry />
            <Section title="Examples">
                <slot />
            </Section>
        {/if}
        {#if hasTypes(page.registry)}
            <Registry types={true} />
        {/if}
        <SeeAlso routes={seeAlso} />
        <Tests tests={tests} />
        <Rules ids={rules} />
    {:else if guide}
        <slot />
        <SeeAlso routes={seeAlso} />
    {:else}
        <div class="flow">
            <slot />
        </div>
    {/if}
    {#if previous || next}
        <footer>
            {#if previous}
                <a href={url(previous.route as RouteLiteral)}>&larr; {raw(inline(previous.nav))}</a>
            {/if}
            {#if next}
                <a class="next" href={url(next.route as RouteLiteral)}>{raw(inline(next.nav))} &rarr;</a>
            {/if}
        </footer>
    {/if}
</main>
<aside class="toc" {...toc.host}>
    {#if toc.all.length > 1}
        <section>
            <h2 id="toc-title">On this page</h2>
            <ul aria-labelledby="toc-title">
                {#for heading of toc.all}
                    <li class="lvl-{heading.level}"><a {...toc.jump(heading)}>{raw(inline(heading.title))}</a></li>
                {/for}
            </ul>
        </section>
    {/if}
    {#if markdown}
        <section>
            <h2 id="md-title">Markdown</h2>
            <ul class="downloads" aria-labelledby="md-title">
                <li><a href={markdown} download>Download this page</a></li>
                <li><a href={url('/abide.md' as RouteLiteral)} download>Download full docs</a></li>
            </ul>
        </section>
    {/if}
</aside>
