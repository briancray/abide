<script>
// What a CRM test or bench file last reported, as a list: each case passed or failed, or each
// arm's nanoseconds per op and the ratio claimed. The card's test and bench tabs and the answer's
// `<show results>` both render it, so the two read one file's report the same way.
import { format, props } from '@abide/abide'

import type { ExampleResults } from './ExampleResults.ts'

const { reported } = props<{
    reported:
        | { kind: 'test'; cases: ExampleResults['tests'][string]['cases'] }
        | ({ kind: 'bench' } & ExampleResults['benches'][string])
}>()
</script>

{#if reported.kind === 'bench'}
    <ul class="ex-results" data-kind="bench">
        {#for arm of Object.keys(reported.arms)}
            <li><span>{arm}</span>{format.number(reported.arms[arm] ?? 0, { digits: 1 })} ns per op</li>
        {/for}
        <li><small>{reported.claim} · {format.number(reported.n)} ops a sample</small></li>
    </ul>
{:else}
    <ul class="ex-results">
        {#for one of reported.cases}
            <li data-passed={String(one.failure === null)}>
                <span>{one.failure === null ? 'pass' : 'fail'}</span>
                {one.name}
                <small>{format.number(one.milliseconds, { digits: 0 })} ms</small>
            </li>
        {/for}
    </ul>
{/if}
