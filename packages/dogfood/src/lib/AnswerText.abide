<script>
// THE WORDS OF AN ANSWER: markdown a section at a time, so a chunk re-renders only the section still
// growing (52.18), with what its end is still writing left out while it streams (52.50); a fence as
// the docs' code, and a `show` fence as the live thing it names (40.28).
import { markdown, props, raw } from '@abide/abide'

import { answerHref } from './answerHref.ts'
import Code from './Code.abide'
import ShowBlock from './ShowBlock.abide'

const { text, streaming = false } = props<{
    text: string
    streaming?: boolean
}>()

const answer = markdown.incremental({
    source: () => text,
    streaming: () => streaming,
    href: answerHref,
    // `show`, and the languages the system prompt has the model fence code in, and the ones it
    // reaches for besides.
    blocks: [
        'show',
        'abide',
        'ts',
        'typescript',
        'js',
        'javascript',
        'tsx',
        'json',
        'html',
        'css',
        'sh',
        'bash',
        'shell',
    ],
})
</script>

<div class="flow">{#for section of answer.sections key section}{#if section.block?.name === 'show'}<ShowBlock info={section.block.info} />{:else if section.block}<Code code={section.block.source} />{:else}{raw(section.html)}{/if}{/for}</div>
