<script>
// THE PROMPT AT THE TOP OF EVERY PAGE: a question to the visitor's own Claude Code, answered from the
// docs' tools and rendered as it is written — prose, code, and the live things a `show` block names.
// The bar opens the answers, `pairing`'s step says what pairing still needs, and `Conversation` is
// the conversation: its composer, its messages, its prompts.
//
// THE CONVERSATION OUTLIVES A NAVIGATION: the bar is the layout's, and a layout outlives the page it
// wraps (41.11), so a `show open` block can move the page under an answer without ending it. The
// panel is hidden rather than unmounted, so closing it ends no answer, and the messages are bound here.
//
// THE PANEL IS A `popover` OF THE BAR: the bar is its trigger, so it says whether the answers are
// open (`aria-expanded`), and Escape or a press outside closes them as the Close button does.
//
// THE TRANSCRIPT IS THE WORDS, the rendering is not: each turn sends every earlier question and the
// text Claude wrote for it (44.4), and what was rendered from that text stays here.
import {
    type AssistantMessage,
    copy,
    keyLabel,
    navigate,
    pairing,
    popover,
    reactive,
    type RouteLiteral,
    url,
    watch,
} from '@abide/abide'

import answer from '#src/ask/answer.handler.ts'
import permit from '#src/ask/permit.handler.ts'

import Conversation from './Conversation.abide'
import { ASK_ITEM } from './nativeMenus.ts'
import { openedIn } from './showFence.ts'

// Whether the composer can ask yet, and the steps that get it there.
const { status, step, copied, start, retry, copyInstall } = pairing()

const command = () => status.peek()?.command ?? ''

const WORDS = {
    connecting: 'Connecting…',
    slow: 'Still connecting to Claude Code.',
    offline: 'You are offline. Pairing resumes once you are back.',
    unavailable: 'Claude Code is unavailable here.',
    click: 'Pair your Claude Code with this page with a click, or run this in a terminal:',
    waiting:
        'Pair your Claude Code with this page with a click, or run this in a terminal:',
    install:
        'No bridge app opened. Install it once, in a terminal, then pair again:',
    paired: '',
}

let open = reactive(false)
let messages = reactive<AssistantMessage[]>([])
const answers = popover({ open, align: 'start' })

// A `show open` block moves the page under the answer once, as its fence closes: counted per answer,
// so the same answer read again moves nothing — by the message its words are in.
let opened = { message: -1, count: 0 }
watch(() => {
    const at = messages.length - 1
    const message = messages[at]
    if (message?.role !== 'assistant') return
    let text = ''
    for (const block of typeof message.content === 'string'
        ? []
        : message.content)
        if (block.type === 'text') text += `${block.text}\n`
    const routes = openedIn(text)
    if (opened.message !== at) opened = { message: at, count: 0 }
    for (; opened.count < routes.length; opened.count += 1)
        navigate(url(routes[opened.count] as RouteLiteral))
})

// The composer, where pairing has put one in the answers.
const composer = () =>
    document
        .getElementById(answers.id)
        ?.querySelector<HTMLElement>('[data-chat=input]')

function focusComposer(event: ToggleEvent) {
    if (event.newState === 'open') composer()?.focus()
}

function clear() {
    messages = []
    opened = { message: -1, count: 0 }
}

// ⌘K (Ctrl+K off a Mac) opens the answers: the native app's Ask menu item, whose key a page in a
// browser answers itself, from anywhere, a field included (38.213) — and, open already, it goes
// back to the composer.
ASK_ITEM.on(() => {
    if (open) composer()?.focus()
    else open = true
})
</script>

<button type="button" class="ask" aria-label="Ask Claude about abide" {...answers.trigger}>
    <span>Ask how to do anything in abide…</span>
    <kbd>{keyLabel('mod+k')}</kbd>
</button>

<section class="answers" aria-label="Answers" {...answers.popover} ontoggle={focusComposer}>
    <header>
        <span class="eyebrow">Claude Code · answers from these docs</span>
        {#if messages.length > 0}<button class="quiet" onclick={clear}>New conversation</button>{/if}
        <button class="quiet" aria-label="Close" onclick={() => (open = false)}>Close</button>
    </header>

    {#if !status?.paired}
        <p>The answers come from your own Claude Code, run on your machine. This site asks it for
            full access, so it can also build what you ask for, asking you here before anything
            risky; you can allow it only these docs instead. Pair it with this browser once; the
            native app is paired already, with full access.</p>
    {/if}

    <div class="pairing" data-step={step}>
        {#if step !== 'paired'}
            <p data-pairing="message">{WORDS[step]}</p>
        {/if}
        {#if step === 'slow'}
            <button type="button" data-pairing="retry" onclick={retry}>Try again</button>
        {:else if step === 'install'}
            <pre data-pairing="command">{status?.install}</pre>
            <button type="button" data-pairing="copy" onclick={copyInstall}>
                {copied ? 'Copied' : 'Copy'}</button>
            <button type="button" data-pairing="pair" onclick={start}>Pair again</button>
        {:else if step === 'click' || step === 'waiting'}
            <pre data-pairing="command">{status?.command}</pre>
            <button type="button" data-pairing="copy"
                {...copy({ value: command })}>Copy</button>
            <button type="button" data-pairing="pair" disabled={step === 'waiting'}
                onclick={start}>
                {step === 'waiting' ? 'Pairing…' : 'Pair with a click'}</button>
        {:else if step === 'paired'}
            {#if status?.missing.length}
                <p data-pairing="missing">Claude Code here cannot use
                    {status.missing.join(', ')}.</p>
            {/if}
            <Conversation ask={answer} permit={permit} bind:messages={messages}
                placeholder="Ask how to do anything in abide…"
                label="Ask Claude about abide" />
            <button type="button" data-pairing="pair" onclick={start}>Reconnect</button>
        {/if}
    </div>
</section>
