<script module>
import REGISTRY from '../../../../docs/REGISTRY.md' with { type: 'text' }
// A PAGE'S SYNTAX, read off docs/REGISTRY.md as it renders (40.10): the rows directly under the
// page's `##` as its Syntax, then each `###` under it as a heading of its own, every signature in its
// short form, each object a row's parameter is typed by spelled out beneath its table (40.33) — and,
// given `types`, the same rows again with the signatures in full, as the page's Types (40.32). The clause column is left out: the clauses the rows cite are the page's Rules, at
// its foot (40.11).
import { registryRows, sectionsOf } from './registryRows.ts'
import {
    discriminating,
    inSyntax,
    membersOf,
    parametersNamed,
    shortSignature,
} from './shortSignature.ts'

const ROWS = registryRows(REGISTRY)
const SIGNATURE = 'Signature'

/** Whether the REGISTRY section `registry` has a signature to spell out in full as its Types. */
export function hasTypes(registry: string): boolean {
    for (const row of ROWS)
        if (row.section === registry && row.header.includes(SIGNATURE))
            return true
    return false
}

/** Every clause the rows of the REGISTRY section `registry` cite, once each, in rulebook order. */
export function clausesOf(registry: string): string[] {
    const cited = new Set<string>()
    for (const row of ROWS)
        if (row.section === registry)
            for (const id of (row.cells.at(-1) ?? '').split(','))
                if (/^\d+\.\d+$/.test(id.trim())) cited.add(id.trim())
    const order = (id: string) => id.split('.').map(Number) as [number, number]
    return [...cited].sort((a, b) => {
        const [ag, an] = order(a)
        const [bg, bn] = order(b)
        return ag - bg || an - bn
    })
}
</script>

<script>
import { props, raw, reactive, route } from '@abide/abide'

import type { Heading } from './Heading.ts'
import { inline, slugify } from './inline.ts'
import { pageAt } from './sitePages.ts'

const { types = false } = props<{
    /** Render the page's Types — every signature in full — rather than its Syntax and headings. */
    types?: boolean
}>()
const page = pageAt(route.name())
const SYNTAX = 'Syntax'
const TYPES = 'Types'
const sections = sectionsOf(ROWS, page.registry)
const typed = sections
    .map((section) => ({
        ...section,
        tables: section.tables.filter((table) =>
            table.header.includes(SIGNATURE),
        ),
    }))
    .filter((section) => section.tables.length > 0)
// Above the Examples, the rows directly under the section are only what 40.32 has its Syntax show; a
// Syntax left with no row is not rendered, its rows being the page's Types.
const shown: typeof sections = []
for (const section of sections) {
    if (section.heading !== page.registry) {
        shown.push(section)
        continue
    }
    const tables: (typeof section)['tables'] = []
    for (const table of section.tables) {
        const at = table.header.indexOf(SIGNATURE)
        const rows =
            at < 0
                ? table.rows
                : table.rows.filter((row) =>
                      inSyntax(
                          row.cells[0] ?? '',
                          row.cells[at] ?? '',
                          page.registry,
                      ),
                  )
        if (rows.length > 0) tables.push({ header: table.header, rows })
    }
    if (tables.length > 0) shown.push({ heading: section.heading, tables })
}

// A parameter typed by an object the section spells is shown beneath the table of the row declaring
// it, a row per member (40.33), once per parameter and type however many rows declare it.
const spelled = new Map<string, string>()
for (const row of ROWS)
    if (row.section === page.registry) {
        const at = row.header.indexOf(SIGNATURE)
        if (at >= 0)
            spelled.set(
                (row.cells[0] ?? '').replaceAll('`', ''),
                row.cells[at] ?? '',
            )
    }
// Every type REGISTRY spells, by name, so an intersection naming a row of another section resolves.
const everyType = new Map<string, string>()
for (const row of ROWS) {
    const at = row.header.indexOf(SIGNATURE)
    const name = (row.cells[0] ?? '').replaceAll('`', '')
    if (at >= 0 && /^[A-Z]\w*$/.test(name) && !everyType.has(name))
        everyType.set(name, row.cells[at] ?? '')
}
const listed = new Set<string>()
/** The objects the rows of `table` take, each by the parameter it is passed as and its members. */
function optionsOf(table: (typeof sections)[number]['tables'][number]) {
    const options: {
        id: string
        title: string
        members: { name: string; type: string }[]
    }[] = []
    const at = table.header.indexOf(SIGNATURE)
    if (at < 0) return options
    for (const row of table.rows)
        for (const { parameter, type } of parametersNamed(
            row.cells[at] ?? '',
        )) {
            const members = membersOf(spelled.get(type) ?? '', (name) =>
                everyType.get(name),
            )
            const key = `${parameter}: ${type}`
            if (members === undefined || listed.has(key)) continue
            listed.add(key)
            options.push({ id: slugify(key), title: `\`${key}\``, members })
        }
    return options
}
const optioned = new Map<object, ReturnType<typeof optionsOf>>()
if (!types)
    for (const section of shown)
        for (const table of section.tables)
            optioned.set(table, optionsOf(table))

/**
 * A row's cells as the page shows them, the clause column left out. A row sharing its name with
 * others of its table is an overload, and its short form keeps the type that tells it from them.
 */
function cellsShown(
    header: readonly string[],
    rows: readonly { cells: readonly string[] }[],
    cells: readonly string[],
): string[] {
    const shown = cells.slice(0, -1)
    if (types) return shown
    const at = header.indexOf(SIGNATURE)
    if (at < 0) return shown
    const overloads: string[] = []
    for (const row of rows)
        if (row.cells[0] === cells[0]) overloads.push(row.cells[at] ?? '')
    shown[at] = shortSignature(shown[at] ?? '', discriminating(overloads))
    return shown
}

// Types is filed by `Doc` with the parts after Examples, so only the Syntax side files its own.
const headings = reactive.share('docHeadings', () => reactive([]))
const filed: Heading[] = []
if (!types)
    for (const section of shown) {
        const title =
            section.heading === page.registry ? SYNTAX : section.heading
        filed.push({ id: slugify(title), title, level: 2 })
        for (const table of section.tables)
            for (const option of optioned.get(table) ?? [])
                filed.push({ id: option.id, title: option.title, level: 3 })
    }
headings = [...headings, ...filed]
</script>

{#if types}
    <section><div class="flow">
            <h2 id={slugify(TYPES)}>{TYPES}</h2>
            {#for section of typed}
                {#if section.heading !== page.registry}
                    <h3 id="{slugify(TYPES)}-{slugify(section.heading)}">{raw(inline(section.heading))}</h3>
                {/if}
                {#for table of section.tables}
                    <table>
                        <thead><tr>{#for cell of table.header.slice(0, -1)}<th>{cell}</th>{/for}</tr></thead>
                        <tbody>
                            {#for row of table.rows}
                                <tr>{#for cell of cellsShown(table.header, table.rows, row.cells)}<td>{raw(inline(cell))}</td>{/for}</tr>
                            {/for}
                        </tbody>
                    </table>
                {/for}
            {/for}
        </div></section>
{:else}
    {#for section of shown}
        <section><div class="flow">
                {#if section.heading === page.registry}
                    <h2 id={slugify(SYNTAX)}>{SYNTAX}</h2>
                {:else}
                    <h2 id={slugify(section.heading)}>{raw(inline(section.heading))}</h2>
                {/if}
                {#for table of section.tables}
                    <table>
                        <thead><tr>{#for cell of table.header.slice(0, -1)}<th>{cell}</th>{/for}</tr></thead>
                        <tbody>
                            {#for row of table.rows}
                                <tr>{#for cell of cellsShown(table.header, table.rows, row.cells)}<td>{raw(inline(cell))}</td>{/for}</tr>
                            {/for}
                        </tbody>
                    </table>
                    {#for option of optioned.get(table) ?? []}
                        <h3 id={option.id}>{raw(inline(option.title))}</h3>
                        <table>
                            <thead><tr><th>Name</th><th>Type</th></tr></thead>
                            <tbody>
                                {#for member of option.members}
                                    <tr><td>{raw(inline(`\`${member.name}\``))}</td><td>{raw(inline(`\`${member.type}\``))}</td></tr>
                                {/for}
                            </tbody>
                        </table>
                    {/for}
                {/for}
            </div></section>
    {/for}
{/if}
