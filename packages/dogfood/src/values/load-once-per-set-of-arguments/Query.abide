<script server>
import { reactive } from '@abide/abide'
import { GET } from '@abide/abide/server'

type Query = { range: string; region: string; compare?: string | undefined }

const ORDERS: Record<string, number> = { north: 128, south: 94 }

// Counts the work: the orders figure is the same for every spelling.
let computed = 0

/** One entry per args key, and the key is the canonical wire form. */
const queryMetricsFor = reactive(async (query: Query) => {
    // A slow database, so the wait is on screen.
    await Bun.sleep(700)
    computed += 1
    return { orders: ORDERS[query.region] ?? 0, computed }
})

export const getQueryMetrics = GET(queryMetricsFor, {
    description: 'Metrics for a range and a region.',
})
</script>

<script>
import { reactive } from '@abide/abide'

const REGIONS = ['north', 'south']
const SPELLINGS = ['range first', 'region first', 'with compare']

/** One query, three spellings: reordered, then an absent option written. */
function spelled(name: string, region: string) {
    if (name === 'range first') return { range: '7d', region }
    if (name === 'region first') return { region, range: '7d' }
    return { region, range: '7d', compare: undefined }
}

let spelling = reactive('range first')
let region = reactive('north')

const metrics = reactive(() => getQueryMetrics(spelled(spelling, region)))
</script>

<ul class="fields stacked">
    <li><span>spelling</span>
        <div class="tabs">
        {#for name of SPELLINGS}
            <button aria-selected={spelling === name}
                onclick={() => { spelling = name }}>{name}</button>
        {/for}
        </div></li>
    <li><span>region</span>
        <div class="tabs">
        {#for one of REGIONS}
            <button aria-selected={region === one}
                onclick={() => { region = one }}>{one}</button>
        {/for}
        </div></li>
    <li><span>orders</span>
        <strong>{metrics.ready() ? metrics.orders : '—'}</strong>
    </li>
    <li><span>times computed</span>
        <strong>{metrics.ready() ? metrics.computed : '—'}</strong>
    </li>
</ul>
