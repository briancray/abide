<script server>
import { reactive, type Store } from '@abide/abide'
import { GET } from '@abide/abide/server'

type Settings = { theme: string }

const BY_PROFILE: Record<string, Settings> = {
    ada: { theme: 'dark' },
    grace: { theme: 'light' },
}

// In process, standing in for a redis client: the address is what matters here.
const AT_ADDRESS: Record<string, unknown> = {}

function redisStore<T>(address: string): Store<T> {
    return {
        get: async () => AT_ADDRESS[address] as T | undefined,
        set: async (value) => {
            AT_ADDRESS[address] = value
        },
    }
}

/** A store per args key, derived FROM the key rather than closed over. */
const settingsCache = reactive(
    async ({ profile }: { profile: string }) => {
        // A slow database, so the wait is on screen.
        await Bun.sleep(450)
        return BY_PROFILE[profile] ?? { theme: 'dark' }
    },
    { store: ({ profile }) => redisStore<Settings>(`settings:${profile}`) },
)

export const getSettings = GET(settingsCache, {
    description: 'The settings of a profile.',
})
</script>

<script>
import { reactive } from '@abide/abide'

const ada = reactive(() => getSettings({ profile: 'ada' }))
const grace = reactive(() => getSettings({ profile: 'grace' }))
</script>

<ul class="fields stacked">
    <li><span>ada theme</span><strong>{ada.theme}</strong></li>
    <li><span>grace theme</span><strong>{grace.theme}</strong></li>
</ul>
