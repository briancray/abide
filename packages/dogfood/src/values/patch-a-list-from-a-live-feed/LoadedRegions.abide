<script server>
import { GET } from '@abide/abide/server'

type Region = { id: string; name: string; orders: number }

const BOOKED: Region[] = [
    { id: 'north', name: 'North', orders: 120 },
    { id: 'south', name: 'South', orders: 80 },
    { id: 'east', name: 'East', orders: 64 },
    { id: 'west', name: 'West', orders: 91 },
]

export const getRegions = GET(
    async (): Promise<Region[]> => {
        // A slow service, so the wait is on screen.
        await Bun.sleep(450)
        return BOOKED
    },
    { description: 'The orders booked in each region.' },
)
</script>

<script>
import { reactive } from '@abide/abide'

const regions = reactive(() => getRegions())

// Reads the rows rather than adopting the call, so a patch lands here.
const byId = reactive(() => regions, {
    transform: (rows) => new Map(rows.map((row) => [row.id, row])),
})

const rows = reactive(() => [...byId.values()])

const FEED = [
    { id: 'south', orders: 95 },
    { id: 'north', orders: 130 },
    { id: 'west', orders: 88 },
    { id: 'east', orders: 71 },
]

/** A frame names an id, so the write is a `get` rather than a scan. */
function applyNextFrame() {
    const frame = FEED.shift()
    if (!frame) return
    FEED.push(frame)
    byId.patch((held) => {
        const region = held.get(frame.id)
        if (region) region.orders = frame.orders
    })
}
</script>

<ul class="fields stacked">
{#for region of rows by region.id}
    <li><span>{region.name}</span><strong>{region.orders}</strong></li>
{/for}
</ul>

<div class="row">
    <button onclick={applyNextFrame}>Apply next frame</button>
    <span class="status">{byId.busy() ? 'loading…' : ''}</span>
</div>
