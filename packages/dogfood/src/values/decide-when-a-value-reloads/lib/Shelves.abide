<script server>
import { reactive } from '@abide/abide'
import { GET, POST } from '@abide/abide/server'

type Shelf = { warehouse: string; sku: string }

const ON_HAND: Record<string, number> = { 'east/A-70': 12, 'west/A-70': 5 }
// A counter PER SHELF, so reloading east alone shows apart from all.
const loads: Record<string, number> = {}

const stockForShelf = reactive(async ({ warehouse, sku }: Shelf) => {
    // A slow database, so the wait is on screen.
    await Bun.sleep(450)
    const shelf = `${warehouse}/${sku}`
    loads[shelf] = (loads[shelf] ?? 0) + 1
    return { onHand: ON_HAND[shelf] ?? 0, loads: loads[shelf] }
})

const getStock = GET(stockForShelf, {
    description: 'Stock on a shelf, by warehouse and sku.',
})

const bookOut = POST(
    ({ warehouse, sku }: Shelf) => {
        const shelf = `${warehouse}/${sku}`
        ON_HAND[shelf] = (ON_HAND[shelf] ?? 0) - 1
        // The process-wide entry, so the next CALLER loads fresh.
        stockForShelf.invalidate({ warehouse, sku })
    },
    { description: 'Books one unit out of a shelf.' },
)
</script>

<script>
import { reactive } from '@abide/abide'

const east = reactive(() => getStock({ warehouse: 'east', sku: 'A-70' }))
const west = reactive(() => getStock({ warehouse: 'west', sku: 'A-70' }))

async function book() {
    await bookOut({ warehouse: 'east', sku: 'A-70' })
    // A slice of the args space, not one key and not every key.
    getStock.refresh({ warehouse: 'east' })
}
</script>

<ul class="fields stacked">
    <li><span>east on hand</span><strong>{east.onHand}</strong></li>
    <li><span>east loads</span><strong>{east.loads}</strong></li>
    <li><span>west loads</span><strong>{west.loads}</strong></li>
</ul>

<button onclick={book}>Book one out of east</button>
