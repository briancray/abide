<script server>
import { reactive } from '@abide/abide'
import { GET } from '@abide/abide/server'

type Shelf = { warehouse: string; sku: string }

// `loads` is the lapse made visible.
let loads = 0

/** Past it, the next READ recomputes; nothing wakes when it lapses. */
const stockForShelf = reactive(
    async (_shelf: Shelf) => {
        // A slow database, so the wait is on screen.
        await Bun.sleep(450)
        loads += 1
        return { onHand: 12, loads }
    },
    { ttl: 3_000 },
)

const getCachedStock = GET(stockForShelf, {
    description: 'Stock on a shelf, by warehouse and sku.',
})
</script>

<script>
import { reactive } from '@abide/abide'

let opened = reactive(0)

// Re-reading after the lapse fetches; the lapse itself woke nobody.
const level = reactive(() => {
    opened
    return getCachedStock({ warehouse: 'east', sku: 'A-70' })
})
</script>

<ul class="fields stacked">
    <li><span>on hand</span>
        <strong>{level.ready() ? level.onHand : 'counting…'}</strong>
    </li>
    <li><span>loads</span><strong>{level.loads}</strong></li>
</ul>

<button onclick={() => (opened += 1)}>Read it again</button>
