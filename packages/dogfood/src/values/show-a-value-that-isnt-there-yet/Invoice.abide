<script server>
import { GET } from '@abide/abide/server'

type Invoice = { number: string; customer: string; total: string }

const INVOICES: Record<string, Invoice> = {
    '4021': {
        number: 'INV-4021',
        customer: 'Ada Lovelace',
        total: '$1,240.00',
    },
}

export const getInvoice = GET(
    async ({ id }: { id: string }) => {
        // A slow database, so the wait is on screen.
        await Bun.sleep(900)
        const row = INVOICES[id]
        if (row === undefined) throw new Error(`no row ${id}`)
        return row
    },
    { description: 'An invoice, by id.' },
)
</script>

<script>
import { reactive } from '@abide/abide'

const invoice = reactive(() => getInvoice({ id: '4021' }))
</script>

<ul class="fields stacked">
    <li><span>number</span><strong>{invoice.number}</strong></li>
    <li><span>customer</span><strong>{invoice.customer}</strong></li>
    <li><span>total</span><strong>{invoice.total}</strong></li>
</ul>
