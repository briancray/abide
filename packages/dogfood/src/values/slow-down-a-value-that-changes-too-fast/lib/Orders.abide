<script server>
import { GET } from '@abide/abide/server'

const BY_REGION: Record<string, number> = {
    n: 412,
    no: 412,
    nor: 128,
    nort: 128,
    north: 128,
}

const countOrders = GET(
    async (args: { region: string }) => {
        // A slow service, so the wait is on screen.
        await Bun.sleep(450)
        return BY_REGION[args.region.toLowerCase()] ?? 0
    },
    { description: 'How many orders a region has.' },
)
</script>

<script>
import { reactive } from '@abide/abide'

let region = reactive('north')

// The cap goes on the value that pays for it, and no markup moved.
const orders = reactive(() => countOrders({ region }), { debounce: 400 })
const updating = reactive(() => orders.busy() && orders.ready())
</script>

<div class="row">
    <label>region
        <input bind:value={region}>
    </label>
    <span class="status">{updating ? 'updating…' : ''}</span>
</div>

<ul class="fields stacked">
    <li><span>orders</span>
        <strong>{orders.ready() ? orders : '—'}</strong>
    </li>
</ul>
