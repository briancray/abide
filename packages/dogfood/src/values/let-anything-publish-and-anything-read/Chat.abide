<script>
import { reactive } from '@abide/abide'
import { onboarding } from './onboarding.ts'
import LastSpoken from './LastSpoken.abide'

const draft = reactive('How do I rotate an API key?')
</script>

<LastSpoken/>

<div class="row">
    <label>message
        <input bind:value={draft}>
    </label>
    <button onclick={() => onboarding.patch((turns) => {
        turns.push({ id: turns.length + 1, speaker: 'you', text: draft })
    })}>
        Send
    </button>
</div>
