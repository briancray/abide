<script server>
import { GET } from '@abide/abide/server'

const PEOPLE: Record<string, { name: string; role: string }> = {
    '1': { name: 'Ada Lovelace', role: 'Engineer' },
    '2': { name: 'Grace Hopper', role: 'Admiral' },
}

/** A CRM's own audit column, kept here so the example is one file. */
const OPENED: Record<string, number> = {}

/** Runs once per request that reaches it, so `opened` counts loads. */
const getProfile = GET(
    async (args: { id: string }) => {
        // A slow service, so the wait is on screen.
        await Bun.sleep(450)
        const opened = (OPENED[args.id] ?? 0) + 1
        OPENED[args.id] = opened
        return { ...PEOPLE[args.id], opened }
    },
    { description: 'A profile, by id, and how often it was opened.' },
)
</script>

<script>
import { reactive } from '@abide/abide'

const TABS = [
    { id: '1', name: 'Ada' },
    { id: '2', name: 'Grace' },
]

let id = reactive('1')

const profile = reactive(() => getProfile({ id }))

const status = reactive(() => {
    if (!profile.ready()) return 'loading…'
    return profile.busy() ? 'refreshing…' : ''
})
</script>

<div class="tabs">
{#for tab of TABS}
    <button aria-selected={id === tab.id}
        onclick={() => { id = tab.id }}>{tab.name}</button>
{/for}
</div>

<ul class="fields">
    <li><span>name</span>
        <strong>{profile.ready() ? profile.name : '—'}</strong>
        <span class="status">{status}</span></li>
    <li><span>role</span>
        <strong>{profile.ready() ? profile.role : '—'}</strong></li>
    <li><span>times opened</span>
        <strong>{profile.ready() ? profile.opened : '—'}</strong></li>
</ul>
