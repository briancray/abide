<script>
import Code from '#src/lib/Code.abide'
import Doc from '#src/lib/Doc.abide'
import Section from '#src/lib/Section.abide'
</script>

<Doc
    seeAlso={['/browser/online', '/request/is-server', '/behaviors/observe']}
    tests={[
        {
            path: 'packages/abide/tests/media.test.ts',
            from: ["test('media follows matchMedia and its change event"],
        },
        {
            path: 'packages/abide/tests/media.test.ts',
            from: ["test('a server render answers false, and the browser its own"],
        },
    ]}
>
    <Section level={3} title="Swap the stage board for the deal feed on a narrow screen">
        <p>Bind the query once and read it by name. The page follows the window as it resizes.</p>
        <Code language="abide" caption="abide" code={`
            <script>
            import { media } from '@abide/abide'
            import DealFeed from './lib/DealFeed.abide'
            import StageBoard from './lib/StageBoard.abide'

            const narrow = media('(max-width: 760px)')
            </script>

            {#if narrow}<DealFeed />{:else}<StageBoard />{/if}
        `} />
    </Section>

    <Section level={3} title="Skip an animation the reader asked not to see">
        <p>On the server every query is <code>false</code>, and the page hydrates with that answer
            before taking the browser's. Where only styling changes, a CSS media query applies
            before the first paint.</p>
        <Code language="ts" caption="shared" code={`
            import { media } from '@abide/abide'

            const still = media('(prefers-reduced-motion: reduce)')

            function fadeOut(element: Element) {
                const duration = still() ? 0 : 200
                return element.animate([{ opacity: 1 }, { opacity: 0 }], { duration })
            }
        `} />
    </Section>
</Doc>
