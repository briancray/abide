<script>
import Code from '#src/lib/Code.abide'
import Doc from '#src/lib/Doc.abide'
import Section from '#src/lib/Section.abide'
</script>

<Doc
    seeAlso={[
        '/harness/server/ticks',
        '/harness/server/retained',
        '/harness/report/ratio',
    ]}
    tests={[
        {
            path: 'packages/dogfood/examples/crm/src/reports/lib/DealsExport.test.ts',
            from: ["test('every deal adds the same bytes at any length'"],
        },
        {
            path: 'packages/harness/tests/server.test.ts',
            from: [
                "test('bytes() measures a payload by its payload and an object by its retention'",
            ],
        },
    ]}
>
    <Section level={3} title="Check every deal adds the same bytes to the export">
        <p>One size says little, because the table around the rows is in it too. Three sizes say
            how the bytes grow, and an export that repeats rows it already wrote fails.</p>
        <Code language="ts" caption="server" code={`
            import { render } from '@abide/abide/server'
            import { bytes } from '@abide/harness/server'

            const exportOf = async (count: number) =>
                bytes(await render(DealsExport({ deals: dealsOf(count) })))

            test('every deal adds the same bytes at any length', async () => {
                const twenty = await exportOf(20)
                const forty = await exportOf(40)
                const eighty = await exportOf(80)
                expect(eighty - forty).toBe(2 * (forty - twenty))
            })
        `} />
    </Section>

    <Section level={3} title="Measure a response and still serve the response">
        <p>A <code>Response</code> is read from a clone, so the body is still there to
            send.</p>
        <Code language="ts" caption="server" code={`
            const response = new Response(csv)
            const size = await bytes(response)
            return response // body unread
        `} />
    </Section>

    <Section level={3} title="Estimate the size of a held object">
        <p>A string counts its UTF-8 bytes, and a buffer its length. Any other value reads as
            the engine's shallow estimate of its memory.</p>
        <Code language="ts" caption="server" code={`
            await bytes('héllo') // 6
            await bytes(new Uint8Array(12)) // 12
            await bytes({ name: 'Ada', stage: 'won' }) // the engine's estimate
        `} />
    </Section>
</Doc>
