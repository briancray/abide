<script>
import Code from '#src/lib/Code.abide'
import Doc from '#src/lib/Doc.abide'
import Section from '#src/lib/Section.abide'
</script>

<Doc
    seeAlso={[
        '/harness/server/bytes',
        '/harness/server/retained-per-run',
        '/harness/gate/in-a-fresh-process',
    ]}
    tests={[
        {
            path: 'packages/harness/tests/server.test.ts',
            from: [
                "test('ticks() counts the microtask turns an op took to settle'",
            ],
        },
        {
            path: 'packages/harness/tests/server.test.ts',
            from: [
                "test('ticks() terminates on a body that settles on a macrotask'",
            ],
        },
    ]}
>
    <Section level={3} title="Assert a cached contact settles sooner than a chained load">
        <p>The count is the microtask turns the body's result took to settle. A value already
            held settles in fewer than a chain of awaits.</p>
        <Code language="ts" caption="server" code={`
            import { expect } from 'bun:test'
            import { ticks } from '@abide/harness/server'

            const loadContact = async (id: string) => ({ id, companyId: 'acme' })
            const loadCompany = async (id: string) => ({ id, name: 'Acme' })

            const held = await ticks(() => cachedContact)
            const chained = await ticks(async () => {
                const contact = await loadContact(id)
                return await loadCompany(contact.companyId)
            })
            expect(chained).toBeGreaterThan(held)
        `} />
    </Section>

    <Section level={3} title="Count a body that waits on a timer">
        <p>The probe yields to the event loop as it counts, so a body that settles on a timer or
            on I/O still finishes.</p>
        <Code language="ts" caption="server" code={`
            import { ticks } from '@abide/harness/server'

            const turns = await ticks(
                () => new Promise((resolve) => setTimeout(resolve, 10)),
            )
            turns > 0 // true
        `} />
    </Section>
</Doc>
