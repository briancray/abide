<script>
import Code from '#src/lib/Code.abide'
import Doc from '#src/lib/Doc.abide'
import Section from '#src/lib/Section.abide'
</script>

<Doc
    seeAlso={[
        '/harness/engine/trace-op',
        '/harness/report/thresholds',
        '/harness/engine/duration-of',
        '/harness/report/ratio',
    ]}
    tests={[
        {
            path: 'packages/harness/tests/engine.test.ts',
            from: [
                "test('shares() prices the layer against the whole op somebody waits on'",
            ],
        },
        {
            path: 'packages/harness/tests/engine.test.ts',
            from: ["test('an op under one frame has an observed ceiling of zero'"],
        },
        {
            path: 'packages/harness/tests/engine.test.ts',
            from: [
                "test('a layer running outside the op is a throw, not a smaller fraction'",
            ],
        },
    ]}
>
    <Section level={3} title="Mark the layer in the code under test">
        <p>The code names its layer with <code>performance.measure</code>. Ranking five thousand
            deals marks the sort.</p>
        <Code language="ts" caption="browser" code={`
            export function topFive(by: 'amount' | 'idle') {
                performance.mark('sort:start')
                const ranked = [...DEALS].sort((a, b) => b[by] - a[by]).slice(0, 5)
                performance.measure('sort', 'sort:start')
                return ranked
            }
        `} />
    </Section>

    <Section level={3} title="Find the part of a click the sort takes">
        <p>Measure the whole click the same way, from the click to the frame that shows it. A
            faster sort saves at most <code>ceilingCpu</code> of it.</p>
        <Code language="ts" caption="server" code={`
            const trace = await traceOp(page, 'rank by idle', async () => {
                await page.evaluate(async () => {
                    performance.mark('click:start')
                    clickRanking('Most idle')
                    await new Promise((done) =>
                        requestAnimationFrame(() => requestAnimationFrame(done)),
                    )
                    performance.measure('click', 'click:start')
                })
            })
            const sort = shares(trace, { layer: 'sort', of: 'click', threshold: 'frame' })
            sort.ceilingCpu // the sort's fraction of the click
        `} />
    </Section>

    <Section level={3} title="Read the saving a person would see">
        <p>A click that paints inside one frame shows at the same frame however fast the sort
            gets. <code>ceilingObserved</code> is zero there.</p>
        <Code language="ts" caption="server" code={`
            if (sort.underOneFrame) sort.ceilingObserved // 0
            else sort.ceilingObserved // equal to sort.ceilingCpu
        `} />
    </Section>
</Doc>
