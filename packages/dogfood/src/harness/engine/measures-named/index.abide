<script>
import Code from '#src/lib/Code.abide'
import Doc from '#src/lib/Doc.abide'
import Section from '#src/lib/Section.abide'
</script>

<Doc
    seeAlso={[
        '/harness/engine/duration-of',
        '/harness/engine/trace-op',
        '/harness/engine/shares',
    ]}
    tests={[
        {
            path: 'packages/harness/tests/engine.test.ts',
            from: [
                "test('a name is every measure carrying it, in order, and its duration their sum'",
            ],
        },
        {
            path: 'packages/harness/tests/engine.test.ts',
            from: [
                "test('a layer running outside the op is a throw, not a smaller fraction — 43.13'",
            ],
        },
    ]}
>
    <Section level={3} title="Count the times a layer ran inside one op">
        <p>Every measure of the name comes back in trace order, each with its start and end in
            nanoseconds.</p>
        <Code language="ts" caption="server" code={`
            import { measuresNamed, traceOp } from '@abide/harness/engine'
            import { expect } from '@playwright/test'

            const trace = await traceOp(page, 'filter contacts', async () => {
                await page.getByRole('searchbox').fill('ada')
            })
            const runs = measuresNamed(trace, 'filter')
            expect(runs).toHaveLength(1)
        `} />
    </Section>

    <Section level={3} title="Find a layer still running after the click">
        <p>Compare each run's end with the op's. An idle pass or a second flush shows up past
            it.</p>
        <Code language="ts" caption="server" code={`
            import { measuresNamed } from '@abide/harness/engine'
            import { expect } from '@playwright/test'

            const [click] = measuresNamed(trace, 'click')
            const late = measuresNamed(trace, 'filter').filter(
                (run) => run.endNanoseconds > click.endNanoseconds,
            )
            expect(late).toEqual([])
        `} />
    </Section>
</Doc>
