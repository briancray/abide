<script>
import Code from '#src/lib/Code.abide'
import Doc from '#src/lib/Doc.abide'
import Section from '#src/lib/Section.abide'
</script>

<Doc
    seeAlso={[
        '/harness/engine/measures-named',
        '/harness/engine/shares',
        '/harness/engine/trace-op',
    ]}
    tests={[
        {
            path: 'packages/harness/tests/engine.test.ts',
            from: [
                "test('shares() prices the layer against the whole op somebody waits on'",
            ],
        },
        {
            path: 'packages/harness/e2e/engine.spec.ts',
            from: [
                "test('a layer is priced against the op, and the observed ceiling is zero under a frame'",
            ],
        },
    ]}
>
    <Section level={3} title="Total a layer that ran several times">
        <p>The durations of every measure with the name are summed, in nanoseconds. A sort run
            once per column reads as one total.</p>
        <Code language="ts" caption="server" code={`
            import { durationOf, traceOp } from '@abide/harness/engine'

            const trace = await traceOp(page, 'sort every column', sortAllColumns)
            const sorting = durationOf(trace, 'sort')
            expect(sorting / 1e6).toBeLessThan(16) // under a frame, in ms
        `} />
    </Section>

    <Section level={3} title="Fail on a measure the trace never recorded">
        <p>A name with no measure throws, so a mark the code stopped emitting fails the test
            rather than reading as zero.</p>
        <Code language="ts" caption="server" code={`
            durationOf(trace, 'srot')
            // throws: no measure named "srot" in the trace of "sort every column"
        `} />
    </Section>
</Doc>
