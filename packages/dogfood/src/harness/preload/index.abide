<script>
import Code from '#src/lib/Code.abide'
import Doc from '#src/lib/Doc.abide'
import Section from '#src/lib/Section.abide'
</script>

<Doc
    seeAlso={[
        '/harness/abide/preload',
        '/harness/measure/measure',
        '/harness/measure/patch-set',
        '/harness/gate/in-a-fresh-process',
    ]}
    tests={[
        {
            path: 'packages/harness/tests/preload.test.ts',
            from: ["test('the preload leaves bun its own fetch family — 43.28'"],
        },
        {
            path: 'packages/harness/tests/preload.test.ts',
            from: ["test('the preload opens and closes a popover — 43.36'"],
        },
    ]}
>
    <Section level={3} title="Give every bun test a DOM">
        <p>Add the line to <code>bunfig.toml</code>. Every test process then starts with a
            <code>document</code> and the measure lane's counters installed.</p>
        <Code language="toml" caption="server" code={`
            [test]
            preload = ["@abide/harness/preload"]
        `} />
        <p>An abide app takes <code>@abide/harness/abide/preload</code> instead, which adds the
            build of its <code>.abide</code> files.</p>
    </Section>

    <Section level={3} title="Render into the document with no setup">
        <p>A test builds nodes and counts the work with no registration of its own.</p>
        <Code language="ts" caption="shared" code={`
            import { expect, test } from 'bun:test'
            import { measure } from '@abide/harness/measure'

            test('a contact row is one element', () => {
                const work = measure(() => {
                    document.body.appendChild(document.createElement('li'))
                })
                expect(work.nodesCreated).toBe(1)
            })
        `} />
    </Section>

    <Section level={3} title="Keep bun's own fetch beside the DOM">
        <p>The DOM is the emulator's and the wire stays bun's. A request keeps the cookie a test
            sets, and a <code>Blob</code> has <code>bytes()</code>.</p>
        <Code language="ts" caption="shared" code={`
            const request = new Request('http://crm.test/deals', {
                headers: { cookie: 'session=ada' },
            })
            request.headers.get('cookie') // 'session=ada'
            await new Blob(['id,stage']).bytes() // Uint8Array
        `} />
    </Section>
</Doc>
