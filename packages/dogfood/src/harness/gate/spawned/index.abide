</script>

<Doc
    seeAlso={[
        '/harness/gate/in-a-fresh-process',
        '/harness/gate/gate',
        '/harness/runner/test-rows',
    ]}
    tests={[
        {
            path: 'packages/abide/tests/poll.test.ts',
            from: ["test('a poll does not hold the process open — 7.22'"],
        },
        {
            path: 'packages/abide/tests/testPreload.test.ts',
            from: [
                "test('a test under the preload imports a .abide and a handler file of the app, and signs in — 38.109, 38.120'",
            ],
        },
    ]}
>
    <Section level={3} title="Run the CRM's build from a test and read its output">
        <p>Await the child. You get its exit code and everything it wrote.</p>
        <Code language="ts" caption="server" code={`
            import { expect, test } from 'bun:test'
            import { spawned } from '@abide/harness/gate'

            test('the CRM builds', async () => {
                const run = await spawned(['bun', 'run', 'build'], { cwd: CRM })
                expect(run.exitCode, run.stderr).toBe(0)
            })
        `} />
    </Section>

    <Section level={3} title="Fail a test whose child never exits">
        <p>Past <code>deadline</code> milliseconds the child is killed, and the call throws
            naming the command. The default is 60 seconds.</p>
        <Code language="ts" caption="server" code={`
            import { spawned } from '@abide/harness/gate'

            const command = ['bun', 'scripts/syncInvoices.ts']
            const run = await spawned(command, { deadline: 5_000 })
            // throws: \`bun scripts/syncInvoices.ts\` did not finish in 5000 ms
        `} />
    </Section>
</Doc>
