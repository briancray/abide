<script>
import Code from '#src/lib/Code.abide'
import Doc from '#src/lib/Doc.abide'
import Section from '#src/lib/Section.abide'
</script>

<Doc
    seeAlso={[
        '/harness/report/batch',
        '/harness/report/claim-of',
        '/harness/report/thresholds',
    ]}
    tests={[
        {
            path: 'packages/harness/tests/runBenches.test.ts',
            from: ["test('every function a bench file exports is run'"],
        },
        {
            path: 'packages/harness/tests/runBenches.test.ts',
            from: [
                "test('an arm over its ceiling, and a ceiling naming no arm or no bench, are reported'",
            ],
        },
        {
            path: 'packages/harness/tests/runBenches.test.ts',
            from: ["test('harness-bench exits 1 over a ceiling'"],
        },
    ]}
>
    <Section level={3} title="Hold the forecast bench to a ceiling">
        <p>Each function a <code>*.bench.ts</code> file exports is one bench.
            <code>CEILINGS</code> names the most each arm may take, in milliseconds, by bench and
            then by arm.</p>
        <Code language="ts" caption="shared" code={`
            import { batch, type Batched } from '@abide/harness/report'

            export const CEILINGS = { priced: { 'among 1,000': 1 } }

            export function priced(): Batched {
                return batch({
                    case: 'advance one deal, read the forecast',
                    emulated: null,
                    arms: { 'among 100': pipeline(100), 'among 1,000': pipeline(1000) },
                })
            }
        `} />
    </Section>

    <Section level={3} title="Run every bench of the app as its bench script">
        <p><code>harness-bench</code> runs <code>runBenches</code> over the directory it runs in,
            prints each bench, and exits 1 where an arm is over its ceiling or a ceiling names no
            arm or bench.</p>
        <Code language="json" caption="server" code={`
            { "scripts": { "bench": "harness-bench" } }
        `} />
        <Code code={`bun run bench pipeline`} />
    </Section>

    <Section level={3} title="Read the results from a script of your own">
        <p>Pass the app's root, and a word to keep only the bench files whose path holds it.</p>
        <Code language="ts" caption="server" code={`
            import { runBenches } from '@abide/harness/runner'

            for (const bench of await runBenches(process.cwd(), 'pipeline'))
                console.log(bench.name, bench.arms, bench.claim, bench.over)
        `} />
    </Section>
</Doc>
