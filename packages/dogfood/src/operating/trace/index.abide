<script>
import Code from '#src/lib/Code.abide'
import Doc from '#src/lib/Doc.abide'
import Section from '#src/lib/Section.abide'
</script>

<Doc
    seeAlso={[
        '/operating/log',
        '/operating/report',
        '/ambients/request',
        '/app/environment',
    ]}
    tests={[
        {
            path: 'packages/dogfood/examples/crm/src/ops/lib/Sync.test.ts',
            from: ["test('both modules log under the one trace of the request'"],
        },
        {
            path: 'packages/abide/tests/serverTiming.test.ts',
            from: ["test('a span opened with timing is carried under its name"],
        },
        {
            path: 'packages/abide/tests/app.test.ts',
            from: [
                "test('a traceparent is adopted and a span is the parent of what goes out",
            ],
        },
    ]}
>
    <Section level={3} title="Find every line one request wrote">
        <p>Every log line carries the request's trace, in a module that was never handed it. A
            request that arrives with a <code>traceparent</code> continues that trace.</p>
        <Code language="ts" caption="server" code={`
            import { log } from '@abide/abide'
            import { rpc, trace } from '@abide/abide/server'
            import { billing } from './lib/billing.ts'

            export const getContact = rpc(async ({ id }: { id: string }) => {
                log(\`contact \${id} loaded\`)
                await billing.notify(id) // its lines carry the same trace
                return { trace: trace() }
            })
        `} />
    </Section>

    <Section level={3} title="Time the billing call in the network panel">
        <p><code>trace.span</code> returns what its body returned and logs the duration. With
            <code>timing</code> it also joins the answer's <code>server-timing</code>, so the name
            has to be a plain token.</p>
        <Code language="ts" caption="server" code={`
            import { trace } from '@abide/abide/server'

            // The billing service, slow enough to see in the panel.
            await trace.span('billing', () => Bun.sleep(150), { timing: true })
        `} />
    </Section>

    <Section level={3} title="Carry the trace to another service">
        <p><code>trace.headers()</code> is the <code>traceparent</code> an outbound request
            carries, naming the current span as its parent.</p>
        <Code language="ts" caption="server" code={`
            import { trace } from '@abide/abide/server'

            await fetch('https://billing.example/contacts', {
                method: 'POST',
                headers: trace.headers(),
                body: JSON.stringify(contact),
            })
        `} />
    </Section>
</Doc>
