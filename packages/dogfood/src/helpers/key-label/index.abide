<script>
import Code from '#src/lib/Code.abide'
import Doc from '#src/lib/Doc.abide'
import Example from '#src/lib/Example.abide'
import Section from '#src/lib/Section.abide'

import KeyCaps from './lib/KeyCaps.abide'
import keyCaps from './lib/KeyCaps.abide' with { type: 'text' }
import SaveLabel from './lib/SaveLabel.abide'
import saveLabel from './lib/SaveLabel.abide' with { type: 'text' }
</script>

<Doc
    seeAlso={[
        '/behaviors/hotkeys',
        '/behaviors/is-editable-target',
        '/headless/tooltip',
    ]}
    tests={[
        {
            path: 'packages/abide/tests/hotkeys.test.ts',
            from: ["test('a label writes a binding as the platform reads it"],
        },
        {
            path: 'packages/dogfood/examples/crm/src/deals/lib/SaveShortcut.test.ts',
            from: ["test('anywhere else the label and the key are Ctrl+Enter'"],
        },
        {
            path: 'packages/abide/tests/hotkeys.test.ts',
            from: ["test('parts are the keys a label writes, apart"],
        },
    ]}
>
    <Section level={3} title="Show the save shortcut a visitor's keyboard takes">
        <p>Write the hint from the same binding <code>hotkeys</code> matches, so it never names a
            key the binding does not take. The label reads ⌘↩ on a Mac and Ctrl+Enter on
            Windows.</p>
        <Example code={saveLabel}><SaveLabel /></Example>
    </Section>

    <Section level={3} title="Render the same label on the server and in the browser">
        <p>The server reads the platform off the request's user agent and the browser off its
            own, so the label the server renders is the one the page hydrates.</p>
        <Code language="ts" caption="shared" code={`
            import { keyLabel } from '@abide/abide'

            keyLabel('mod+k') // '⌘K' on a Mac, 'Ctrl+K' elsewhere
            keyLabel('shift+n') // '⇧N' on a Mac, 'Shift+N' elsewhere
        `} />
    </Section>

    <Section level={3} title="Draw each key of a shortcut as a key cap">
        <p><code>keyLabel.parts</code> answers the keys apart, so each gets a
            <code>&lt;kbd&gt;</code> of its own. Pass <code>apple</code> to write a Mac's keys
            whatever the visitor's platform is.</p>
        <Example code={keyCaps}><KeyCaps /></Example>
    </Section>
</Doc>
