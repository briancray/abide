<script>
import Code from '#src/lib/Code.abide'
import Doc from '#src/lib/Doc.abide'
import Section from '#src/lib/Section.abide'
</script>

<Doc
    seeAlso={[
        '/helpers/signed-in',
        '/helpers/read-only',
        '/ambient/principal',
        '/hooks/on-principal',
        '/transports/get',
    ]}
    tests={[
        {
            path: 'packages/abide/tests/guards.test.ts',
            from: [
                "test('requireRole refuses a member without the role Forbidden at 403, before the body runs",
            ],
        },
        {
            path: 'packages/abide/tests/guards.test.ts',
            from: ["test('requireRole given a function admits whom it passes"],
        },
    ]}
>
    <Section level={3} title="Show the team's commission to admins alone">
        <p><code>requireRole('admin')</code> compares the <code>role</code> on
            <code>principal.resolved</code>. Nobody signed in is refused <code>SignedOut</code> at
            401, and a member without the role <code>Forbidden</code> at 403, before the body
            runs.</p>
        <Code language="ts" caption="server" code={`
            import { GET, requireRole } from '@abide/abide/server'

            export default GET(() => ({ total: '$18,400' }), {
                middleware: [requireRole('admin')],
            })
        `} />
    </Section>

    <Section level={3} title="Admit a member by any test of the principal">
        <p>Pass a function of the principal in place of the role. <code>message</code> is what
            the <code>Forbidden</code> refusal says.</p>
        <Code language="ts" caption="server" code={`
            import { GET, requireRole } from '@abide/abide/server'

            const auditor = requireRole(
                (member) => member.team === 'finance',
                { message: 'Finance audits the ledger.' },
            )

            export default GET(() => ledger(), { middleware: [auditor] })
        `} />
    </Section>

    <Section level={3} title="Tell a missing role from a missing sign-in">
        <p>Both refusals are typed on the handler's failures, so a page narrows each by name.</p>
        <Code language="abide" caption="abide" code={`
            <script>
            import { reactive } from '@abide/abide'
            import getTeamCommission from './getTeamCommission.handler.ts'

            const commission = reactive(() => getTeamCommission())
            const error = () => commission.error()
            </script>

            {#if getTeamCommission.isError(error(), 'SignedOut')}
                <a href="/sign-in">Sign in to see the team's figure</a>
            {:else if getTeamCommission.isError(error(), 'Forbidden')}
                <p>Admins see the team's figure.</p>
            {:else if commission.ready()}
                <strong>{commission.total}</strong>
            {/if}
        `} />
    </Section>
</Doc>
