<script>
import { virtualRows } from '@abide/abide'

const DEALS = Array.from({ length: 10_000 }, (_, id) => ({
    id,
    name: `Deal ${id + 1}`,
}))
const view = virtualRows({ count: () => DEALS.length, rowHeight: 28 })
</script>

<div
    role="list"
    aria-label="Deals"
    class="h-60 overflow-auto"
    bind:element={view.viewport}
>
    <div style:height="{view.before()}px"></div>
    {#for deal of DEALS.slice(view.start(), view.end()) by deal.id}
        <div
            role="listitem"
            aria-setsize={DEALS.length}
            aria-posinset={deal.id + 1}
            class="h-7"
        >{deal.name}</div>
    {/for}
    <div style:height="{view.after()}px"></div>
</div>
