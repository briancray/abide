<script>
import { popover, reactive } from '@abide/abide'

let field = reactive<HTMLInputElement | undefined>(undefined)
let typed = reactive('')
</script>

<input bind:element={field} bind:value={typed} placeholder="Type to suggest" />

{#if typed !== '' && field}
    <ul
        class="m-0 w-(--anchor-width) list-none rounded-md border border-rule
        bg-raised p-2"
        bind:element={popover(field, { align: 'start', offset: 4 })}
    >
        <li>{typed} Ltd</li>
        <li>{typed} & Co</li>
    </ul>
{/if}
