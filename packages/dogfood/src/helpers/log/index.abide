<script>
import Code from '#src/lib/Code.abide'
import Doc from '#src/lib/Doc.abide'
import Section from '#src/lib/Section.abide'
</script>

<Doc
    seeAlso={[
        '/helpers/report',
        '/ambient/trace',
        '/configuration/environment',
        '/hooks/on-error',
    ]}
    tests={[
        {
            path: 'packages/abide/tests/log.test.ts',
            from: [
                "test('log, log.warning and log.error always write; info and debug are gated",
            ],
        },
        {
            path: 'packages/abide/tests/log.test.ts',
            from: ["test('log.named prefixes the app name, and again appends"],
        },
    ]}
>
    <Section level={3} title="Give billing and sync a log namespace each">
        <p>A named logger writes under the app's name, so billing writes as
            <code>crm:billing</code>. <code>info</code> and <code>debug</code> write only where
            <code>DEBUG</code> names the namespace. <code>warning</code> and <code>error</code>
            always write.</p>
        <Code language="ts" caption="shared" code={`
            import { log } from '@abide/abide'

            const billing = log.named('billing')
            const sync = log.named('sync')

            billing.info('invoice sent', { id: '4310' })
            sync.debug('polled', { rows: 0 })
            billing.warning('card declined', { id: '4310' })
        `} />
    </Section>

    <Section level={3} title="Turn on billing's lines and abide's request lines">
        <p><code>DEBUG</code> takes the comma and wildcard list of the <code>debug</code> package.
            A browser reads it from the document the server wrote.</p>
        <Code code={`DEBUG=crm:billing,abide:request abide dev`} />
    </Section>

    <Section level={3} title="Skip building a costly debug line nobody reads">
        <p>Ask <code>enabled()</code> first where building the line costs more than writing
            it.</p>
        <Code language="ts" caption="shared" code={`
            if (sync.enabled())
                sync.debug('queue', { pending: queue.map(describeChange) })
        `} />
    </Section>

    <Section level={3} title="Show the newest lines a page has logged">
        <p><code>log.records</code> is a reactive list of the lines kept, the page's own in a
            browser and the process's on a server, so a page reading it follows each line as it
            is written.</p>
        <Code language="abide" caption="abide" code={`
            <script>
            import { log } from '@abide/abide'
            </script>

            <ul>
                {#for record of log.records().slice(-20)}
                    <li>{record.namespace} {record.level} {record.message}</li>
                {/for}
            </ul>
        `} />
    </Section>
</Doc>
