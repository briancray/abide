<script>
import { type Column, reactive, type Sort, sortRows } from '@abide/abide'

type Deal = { name: string; amount: number }
const deals: Deal[] = [
    { name: 'Acme renewal', amount: 42_000 },
    { name: 'Engines upgrade', amount: 18_000 },
    { name: 'Hopper & Co', amount: 67_000 },
]
const COLUMNS: Column<Deal>[] = [{ key: 'amount', label: 'Amount' }]

let sort = reactive<Sort | undefined>(undefined)
const sorted = reactive(() => sortRows(deals, COLUMNS, sort))
</script>

<button onclick={() => (sort = { key: 'amount', direction: 'descending' })}>
    Largest first</button>
<ol>{#for deal of sorted by deal.name}<li>{deal.name}</li>{/for}</ol>
