<script>
import Doc from '#src/lib/Doc.abide'
import Example from '#src/lib/Example.abide'
import Section from '#src/lib/Section.abide'

import EscapeOnly from './lib/EscapeOnly.abide'
import escapeOnly from './lib/EscapeOnly.abide' with { type: 'text' }
import OneLayerAtATime from './lib/OneLayerAtATime.abide'
import oneLayerAtATime from './lib/OneLayerAtATime.abide' with { type: 'text' }
import OpenerInside from './lib/OpenerInside.abide'
import openerInside from './lib/OpenerInside.abide' with { type: 'text' }
import QuickEdit from './lib/QuickEdit.abide'
import quickEdit from './lib/QuickEdit.abide' with { type: 'text' }
</script>

<Doc
    seeAlso={[
        '/helpers/observe',
        '/helpers/hotkeys',
        '/helpers/popover',
        '/helpers/dialog',
        '/components/menu',
    ]}
    tests={[
        {
            path: 'packages/abide/tests/elementBehaviors.test.ts',
            from: [
                "test('a press outside closes, a press inside or on an element `inside` is spread on does not",
            ],
        },
        {
            path: 'packages/abide/tests/elementBehaviors.test.ts',
            from: ["test('Escape closes the top panel alone and is prevented"],
        },
    ]}
>
    <Section level={3} title="Close a quick-edit panel on a press outside it or on Escape">
        <p>Spread <code>host</code> on the panel, and your callback runs on a press anywhere
            else or on Escape. Under <code>&#123;#if&#125;</code> it listens only while the panel
            is open.</p>
        <Example code={quickEdit}><QuickEdit /></Example>
    </Section>

    <Section level={3} title="Count the opening button as part of the panel">
        <p>A press on the button that toggles the panel lands outside it, closes it, and the click
            opens it again. Spread <code>inside</code> on the button.</p>
        <Example code={openerInside}><OpenerInside /></Example>
    </Section>

    <Section level={3} title="Close a panel on Escape alone">
        <p>Turn the outside press off with <code>outside: false</code>, or Escape off with
            <code>escape: false</code>. Spread <code>host</code> beside another part, and both bind the
            element.</p>
        <Example code={escapeOnly}><EscapeOnly /></Example>
    </Section>
    <Section level={3} title="Close one layer per Escape">
        <p>A hint open over a panel is the layer on top, so the first Escape closes the hint
            alone and the second closes the panel.</p>
        <Example code={oneLayerAtATime}><OneLayerAtATime /></Example>
    </Section>
</Doc>
