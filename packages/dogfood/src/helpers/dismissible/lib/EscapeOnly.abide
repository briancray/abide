<script>
import { dismissible, dropzone, reactive } from '@abide/abide'

let open = reactive(true)
let files = reactive<string[]>([])
const close = () => (open = false)
const attach = (dropped: File[]) =>
    (files = [...files, ...dropped.map((file) => file.name)])
const panel = [dismissible(close, { outside: false }), dropzone(attach)]
</script>

{#if open}
    <aside bind:element={panel}>Drop files: {files.join(', ') || 'none'}</aside>
{:else}
    <button onclick={() => (open = true)}>Open</button>
{/if}
