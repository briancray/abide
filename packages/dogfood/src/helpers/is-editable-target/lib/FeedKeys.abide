<script>
import { isEditableTarget, reactive } from '@abide/abide'

let selected = reactive(0)
const selectNextActivity = () => (selected = (selected + 1) % 3)

function moveThroughFeed(event: KeyboardEvent) {
    if (isEditableTarget(event.target)) return
    if (event.key === 'j') selectNextActivity()
}
</script>

<window onkeydown={moveThroughFeed} />
<p>Press j for the next entry; typing j below moves nothing.</p>
<p>Entry {selected + 1} of 3</p>
<input placeholder="Type j here">
