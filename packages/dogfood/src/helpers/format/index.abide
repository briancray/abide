<script>
import Code from '#src/lib/Code.abide'
import Doc from '#src/lib/Doc.abide'
import Example from '#src/lib/Example.abide'
import Section from '#src/lib/Section.abide'

import DealColumn from './lib/DealColumn.abide'
import dealColumn from './lib/DealColumn.abide' with { type: 'text' }
import LastTouched from './lib/LastTouched.abide'
import lastTouched from './lib/LastTouched.abide' with { type: 'text' }
import MeetingHour from './lib/MeetingHour.abide'
import meetingHour from './lib/MeetingHour.abide' with { type: 'text' }
import VisitorTime from './lib/VisitorTime.abide'
import visitorTime from './lib/VisitorTime.abide' with { type: 'text' }
</script>

<Doc
    seeAlso={[
        '/headless/sortable-table',
        '/headless/chart',
        '/ambients/is-server',
    ]}
    tests={[
        {
            path: 'packages/abide/tests/format.test.ts',
            from: [
                "test('a formatter writes an em dash for a value it cannot format",
            ],
        },
        {
            path: 'packages/dogfood/examples/crm/src/deals/lib/DealFigures.test.ts',
            from: [
                "test('a lead with no amount reads as a dash, and builds nothing'",
            ],
        },
        {
            path: 'packages/abide/tests/format.test.ts',
            from: ["test('a relative time is measured from the now it is handed"],
        },
        {
            path: 'packages/abide/tests/format.test.ts',
            from: ["test('the parts of a date join to what date writes"],
        },
        {
            path: 'packages/abide/tests/format.test.ts',
            from: [
                "test('a date names the zone the app pins where its caller names none",
            ],
        },
        {
            path: 'packages/abide/tests/format.test.ts',
            from: [
                'test("unpinned, a date is UTC while the page hydrates and the browser\'s zone after',
            ],
        },
        {
            path: 'packages/abide/tests/format.test.ts',
            from: ["test('a relative time is written in the style it is handed"],
        },
    ]}
>
    <Section level={3} title="Write deal amounts and chances in a table column">
        <p>Each formatter takes <code>unknown</code>, so a lead with no amount yet reads as
            <code>—</code> rather than <code>$NaN</code>.</p>
        <Example code={dealColumn}><DealColumn /></Example>
    </Section>

    <Section level={3} title="Summarize a pipeline in a tile">
        <p>Every formatter writes <code>en-US</code> unless you pass a <code>locale</code>, so
            the server and the browser write the same text.</p>
        <Code language="ts" caption="shared" code={`
            import { format } from '@abide/abide'

            format.money(1_250_000, { compact: true }) // '$1.3M'
            format.plural(2, 'open deal') // '2 open deals'
            format.plural(3, 'company', 'companies') // '3 companies'
            format.list(['Ada', 'Grace', 'Alan']) // 'Ada, Grace, and Alan'
            format.percent(0.04, { signed: true }) // '+4%'
            format.bytes(1_500_000) // '1.5 MB'
        `} />
    </Section>

    <Section level={3} title="Say how long ago a contact was last touched">
        <p>Pass <code>now</code> from a reactive value so the words follow it.
            <code>format.date</code> writes UTC unless you pass a <code>timeZone</code>.</p>
        <Example code={lastTouched}><LastTouched /></Example>
    </Section>

    <Section level={3} title="Set a meeting's hour apart from its date">
        <p><code>format.dateParts</code> answers what <code>format.date</code> writes as named
            pieces, so the hour can carry a style of its own.</p>
        <Example code={meetingHour}><MeetingHour /></Example>
    </Section>
    <Section level={3} title="Show a meeting in the visitor's own time">
        <p>A date with no <code>timeZone</code> is written in the visitor's zone: UTC on the
            server and while the page hydrates, so the two agree, and the browser's own once it
            has, every date written again.</p>
        <Example code={visitorTime}><VisitorTime /></Example>
    </Section>

    <Section level={3} title="Write every date in the rep's own zone">
        <p>Set <code>format.timeZone</code> in a layout's setup, which runs on both sides, and
            every date with no <code>timeZone</code> of its own is written in it.</p>
        <Code language="abide" caption="abide" code={`
            <script>
            import { format } from '@abide/abide'

            format.timeZone.set(rep.timeZone)
            </script>
        `} />
    </Section>
    <Section level={3} title="Fit how long ago into a narrow column">
        <p><code>style</code> is <code>'short'</code> for <code>12 min. ago</code> or
            <code>'narrow'</code> for <code>12m ago</code>.</p>
        <Code language="ts" caption="shared" code={`
            import { format } from '@abide/abide'

            format.relative(contact.touchedAt, { style: 'narrow' })
        `} />
    </Section>
</Doc>
