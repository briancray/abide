<script>
import Code from '#src/lib/Code.abide'
import Doc from '#src/lib/Doc.abide'
import Section from '#src/lib/Section.abide'
</script>

<Doc
    seeAlso={[
        '/components/sortable-table',
        '/helpers/chart',
        '/ambient/is-server',
    ]}
    tests={[
        {
            path: 'packages/abide/tests/format.test.ts',
            from: [
                "test('a formatter writes an em dash for a value it cannot format",
            ],
        },
        {
            path: 'packages/dogfood/examples/crm/src/deals/lib/DealFigures.test.ts',
            from: [
                "test('a lead with no amount reads as a dash, and builds nothing'",
            ],
        },
        {
            path: 'packages/abide/tests/format.test.ts',
            from: ["test('a relative time is measured from the now it is handed"],
        },
        {
            path: 'packages/abide/tests/format.test.ts',
            from: ["test('the parts of a date join to what date writes"],
        },
    ]}
>
    <Section level={3} title="Write deal amounts and chances in a table column">
        <p>Each formatter takes <code>unknown</code>, so a lead with no amount yet reads as
            <code>—</code> rather than <code>$NaN</code>.</p>
        <Code language="abide" caption="abide" code={`
            <script>
            import { format } from '@abide/abide'
            </script>

            {#for deal of deals by deal.name}
                <tr>
                    <td>{deal.name}</td>
                    <td>{format.money(deal.amount, { digits: 0 })}</td>
                    <td>{format.percent(deal.probability)}</td>
                </tr>
            {/for}
        `} />
    </Section>

    <Section level={3} title="Summarize a pipeline in a tile">
        <p>Every formatter writes <code>en-US</code> unless you pass a <code>locale</code>, so
            the server and the browser write the same text.</p>
        <Code language="ts" caption="shared" code={`
            import { format } from '@abide/abide'

            format.money(1_250_000, { compact: true }) // '$1.3M'
            format.plural(2, 'open deal') // '2 open deals'
            format.plural(3, 'company', 'companies') // '3 companies'
            format.list(['Ada', 'Grace', 'Alan']) // 'Ada, Grace, and Alan'
            format.percent(0.04, { signed: true }) // '+4%'
            format.bytes(1_500_000) // '1.5 MB'
        `} />
    </Section>

    <Section level={3} title="Say how long ago a contact was last touched">
        <p>Pass <code>now</code> from a reactive value so the words follow it.
            <code>format.date</code> writes UTC unless you pass a <code>timeZone</code>.</p>
        <Code language="abide" caption="abide" code={`
            <script>
            import { format, reactive, watch } from '@abide/abide'

            let now = reactive(Date.now())
            watch(() => {
                const timer = setInterval(() => (now = Date.now()), 60_000)
                return () => clearInterval(timer)
            })
            </script>

            <strong title={format.date(touch.at, { style: 'dateTime' })}>
                {touch.contact}, {format.relative(touch.at, { now })}
            </strong>
        `} />
    </Section>

    <Section level={3} title="Set a meeting's hour apart from its date">
        <p><code>format.dateParts</code> answers what <code>format.date</code> writes as named
            pieces, so the hour can carry a style of its own.</p>
        <Code language="abide" caption="abide" code={`
            <script>
            import { format } from '@abide/abide'
            </script>

            {#for part of format.dateParts(meeting.at, { style: 'dateTime' })}
                {#if part.type === 'hour'}
                    <strong>{part.value}</strong>
                {:else}
                    {part.value}
                {/if}
            {/for}
        `} />
    </Section>
</Doc>
