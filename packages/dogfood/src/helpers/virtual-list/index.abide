<script>
import Doc from '#src/lib/Doc.abide'
import Example from '#src/lib/Example.abide'
import Section from '#src/lib/Section.abide'

import AuditTrail from './lib/AuditTrail.abide'
import auditTrail from './lib/AuditTrail.abide' with { type: 'text' }
import DealGrid from './lib/DealGrid.abide'
import dealGrid from './lib/DealGrid.abide' with { type: 'text' }
import GoToRow from './lib/GoToRow.abide'
import goToRow from './lib/GoToRow.abide' with { type: 'text' }
</script>

<Doc
    seeAlso={[
        '/abide-files/control-flow',
        '/helpers/sort-by',
        '/components/sortable-table',
    ]}
    tests={[
        {
            path: 'packages/dogfood/examples/crm/src/ops/lib/AuditTrail.test.ts',
            from: ["test('only the changes in view, and three past, are rows'"],
        },
        {
            path: 'packages/dogfood/examples/crm/src/ops/lib/AuditTrail.test.ts',
            from: [
                "test('scrolling by a row makes the row coming into view and keeps the others'",
            ],
        },
        {
            path: 'packages/abide/tests/virtualList.test.ts',
            from: [
                "test('rows hold what fits across the host and are as tall as the items measured",
            ],
        },
        {
            path: 'packages/abide/tests/virtualList.test.ts',
            from: [
                "test('sections start where their first item does, the one in view is current",
            ],
        },
    ]}
>
    <Section level={3} title="Scroll through five thousand changes with only a screenful made">
        <p>Spread <code>host</code> on the element the items sit in, and render a keyed
            <code>{'{#for}'}</code> over <code>shown</code>, spreading <code>item</code> on each.
            How tall a row is comes from its CSS: each item is measured as it renders. The
            rows left out are the host's padding, and its scroller is the nearest one above
            it, or the page.</p>
        <Example code={auditTrail}><AuditTrail /></Example>
    </Section>

    <Section level={3} title="Lay deals out in a grid, with a jump to each letter">
        <p>Any layout works: here a CSS grid whose column count changes with its width. A row
            holds as many items as fit, measured, never handed in. Give <code>section</code>
            and <code>sections</code> lists a jump per letter, the one in view current and
            the empty ones disabled.</p>
        <Example code={dealGrid}><DealGrid /></Example>
    </Section>

    <Section level={3} title="Bring a deal into view by its number">
        <p><code>scrollTo</code> scrolls the item to the top of the view and renders it at
            once, so a caller can focus it straight after.</p>
        <Example code={goToRow}><GoToRow /></Example>
    </Section>
</Doc>
