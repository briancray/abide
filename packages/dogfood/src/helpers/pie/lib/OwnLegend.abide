<script>
import { pie } from '@abide/abide'

const ring = pie({
    label: 'Open pipeline by stage',
    slices: [
        { label: 'Lead', value: 66_000 },
        { label: 'Qualified', value: 34_000 },
        { label: 'Proposal', value: 30_000 },
    ],
    inner: 0.6,
})
</script>

<div class="flex items-center gap-6">
    <svg {...ring.svg} class="size-32">
        {#for slice of ring.slices by slice.index}
            <circle {...slice.circle} />
        {/for}
    </svg>
    <ul>
        {#for slice of ring.slices by slice.index}
            <li data-series={slice.index}>
                {slice.label}: {Math.round(slice.share * 100)}%
            </li>
        {/for}
    </ul>
</div>
