<script>
import Doc from '#src/lib/Doc.abide'
import Example from '#src/lib/Example.abide'
import Section from '#src/lib/Section.abide'

import Donut from './lib/Donut.abide'
import donut from './lib/Donut.abide' with { type: 'text' }
import EaseSlices from './lib/EaseSlices.abide'
import easeSlices from './lib/EaseSlices.abide' with { type: 'text' }
import HoverHint from './lib/HoverHint.abide'
import hoverHint from './lib/HoverHint.abide' with { type: 'text' }
import OwnLegend from './lib/OwnLegend.abide'
import ownLegend from './lib/OwnLegend.abide' with { type: 'text' }
import PickSlice from './lib/PickSlice.abide'
import pickSlice from './lib/PickSlice.abide' with { type: 'text' }
import StageMix from './lib/StageMix.abide'
import stageMix from './lib/StageMix.abide' with { type: 'text' }
</script>

<Doc
    seeAlso={['/helpers/chart', '/helpers/sparkline', '/helpers/format']}
    tests={[
        {
            path: 'packages/abide/tests/chartParts.test.ts',
            from: ['test("a slice\'s hint binding stands while its words do"'],
        },
        {
            path: 'packages/dogfood/examples/crm/src/reports/lib/PipelineMix.test.ts',
            from: [
                "test('each stage sweeps its share of the ring, one after the other'",
            ],
        },
        {
            path: 'packages/dogfood/examples/crm/src/reports/lib/PipelineMix.test.ts',
            from: ["test('the pie is a donut with a hole of 0.6 of its radius'"],
        },
        {
            path: 'packages/dogfood/examples/crm/src/reports/lib/PipelineMix.test.ts',
            from: ["test('a slice reads its stage, its value and its share'"],
        },
        {
            path: 'packages/dogfood/examples/crm/src/reports/lib/PipelineMix.test.ts',
            from: [
                "test('a click on a slice opens its stage, and Verbal takes no pick'",
            ],
        },
    ]}
>
    <Section level={3} title="Show the open pipeline's mix of stages">
        <p><code>pie</code> hands back a part per slice to spread on a <code>circle</code>. Each
            sweeps its share of the total, clockwise from the top in the order given, and a stage
            holding nothing draws no slice.</p>
        <Example code={stageMix}><StageMix /></Example>
    </Section>

    <Section level={3} title="Leave a hole for a donut">
        <p><code>inner</code> is the hole's width as a share of the radius.</p>
        <Example code={donut}><Donut /></Example>
    </Section>

    <Section level={3} title="Draw a donut with a legend of your own">
        <p>Each slice carries its label, value and share beside the part its circle spreads, so
            the legend beside the ring is markup of yours.</p>
        <Example code={ownLegend}><OwnLegend /></Example>
    </Section>

    <Section level={3} title="Read a stage's value and share on hover">
        <p>A pointer resting on a slice opens its label, value and share where the page's
            <code>tooltip.host</code> is spread. <code>valueFormat</code> writes the value.</p>
        <Example code={hoverHint}><HoverHint /></Example>
    </Section>

    <Section level={3} title="Ease the slices when the mix changes">
        <p>A slice's sweep is a CSS <code>stroke-dasharray</code> on the same element whatever
            its value becomes, so a transition on it animates every change.</p>
        <Example code={easeSlices}><EaseSlices /></Example>
    </Section>

    <Section level={3} title="Pick a stage from its slice">
        <p><code>onpick</code> is called with the index of the slice clicked. A slice
            <code>disabled</code> holds for takes no pick, and carries
            <code>data-disabled</code>.</p>
        <Example code={pickSlice}><PickSlice /></Example>
    </Section>
</Doc>
