<script>
import Code from '#src/lib/Code.abide'
import Doc from '#src/lib/Doc.abide'
import Section from '#src/lib/Section.abide'
</script>

<Doc
    seeAlso={[
        '/helpers/json-schema',
        '/handlers/post',
        '/reactive/reactive',
        '/reactive/refuse',
    ]}
    tests={[
        {
            path: 'packages/abide/tests/validateJson.test.ts',
            from: ["test('issues are keyed by dot-joined path'"],
        },
        {
            path: 'packages/dogfood/examples/crm/src/deals/lib/NewDeal.test.ts',
            from: [
                'test("a deal that does not fit shows field by field what the handler\'s refusal says"',
            ],
        },
    ]}
>
    <Section level={3} title="Check a pasted contact before the import">
        <p>Hand <code>validateJson</code> a JSON Schema document and a value. It answers
            <code>null</code> when the value fits, or the messages keyed by the path that was
            wrong.</p>
        <Code language="ts" caption="shared" code={`
            import { validateJson } from '@abide/abide'

            type Contact = { name: string; company: { id: string } }
            const CONTACT = {
                type: 'object',
                required: ['name', 'company'],
                properties: {
                    name: { type: 'string', minLength: 2 },
                    company: {
                        type: 'object',
                        required: ['id'],
                        properties: { id: { type: 'string' } },
                    },
                },
            }
            validateJson<Contact>(CONTACT, { name: 'A', company: {} })
            // { name: ['must be at least 2 characters'],
            //   'company.id': ['is required'] }
        `} />
    </Section>

    <Section level={3} title="Show each refused field beside its input">
        <p>Keep the call in a reactive value. A refused call's <code>issues()</code> is the same
            record, keyed by field, and <code>undefined</code> when nothing was wrong.</p>
        <Code language="abide" caption="abide" code={`
            <script>
            import { reactive } from '@abide/abide'
            import addContact from './addContact.handler.ts'

            let name = reactive('')
            let saving = reactive<typeof addContact>()
            </script>

            <input bind:value={name}>
            <button onclick={() => (saving = addContact({ name }))}>Add</button>
            <span>{saving.issues()?.name?.[0]}</span>
        `} />
    </Section>

    <Section level={3} title="Gate a handler's args with a plain function">
        <p>A <code>Schema</code> is a function returning what it accepts, or a Standard Schema
            such as zod's. The function throws what it refuses.</p>
        <Code language="ts" caption="server" code={`
            import { POST } from '@abide/abide/server'
            import { crmDatabase } from './lib/crmDatabase.server.ts'

            const INSERT = 'INSERT INTO targets (target) VALUES (?)'

            export default POST(
                ({ target }) => {
                    crmDatabase().query(INSERT).run(target)
                },
                {
                    args: (value: unknown) => {
                        const { target } = value as { target: number }
                        if (!(target > 0)) throw new Error('target must be positive')
                        return { target }
                    },
                },
            )
        `} />
    </Section>
</Doc>
