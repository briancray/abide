<script>
import Code from '#src/lib/Code.abide'
import Doc from '#src/lib/Doc.abide'
import Section from '#src/lib/Section.abide'
</script>

<Doc
    seeAlso={['/helpers/is-failed', '/orchestration/memo', '/orchestration/pipe']}
    tests={[
        {
            path: 'packages/abide/tests/refuse.test.ts',
            from: ["test('a body that returns a refusal refuses — 15.2, 15.5'"],
        },
        {
            path: 'packages/abide/tests/pipe.test.ts',
            from: [
                "test('a refusal from a pipe step is an answer, not retried unless transient — 57.5, 57.9'",
            ],
        },
        {
            path: 'packages/abide/tests/refuse.test.ts',
            from: [
                "test('a declared refusal narrows on its own name and no other'",
            ],
        },
    ]}
>
    <Section level={3} title="Refuse a forecast for a deal with no amount">
        <p>Declare the refusal once with <code>refuse.named</code>, then return it from any
            body. A <code>memo</code> that returns one holds it as its <code>error()</code>,
            with no handler in the way.</p>
        <Code language="ts" caption="shared" code={`
            import { memo, refuse } from '@abide/abide'
            import { getDeal } from './getDeal.server.ts'

            const noAmount = refuse.named('NoAmount', {
                message: 'This deal has no amount yet.',
            })

            export const forecast = memo(async ({ id }: { id: string }) => {
                const deal = await getDeal({ id })
                return deal.amount > 0 ? deal.amount : noAmount()
            })
        `} />
    </Section>

    <Section level={3} title="Say whether a refusal is worth asking again">
        <p>The <code>status</code> says what kind of refusal it is, and it is 400 where none
            is given. 408, 425, 429 and anything from 500 up are worth asking again: a
            <code>pipe</code> retries the step, and a <code>memo</code> runs its function
            again on the next call. Any other status is the answer, and stays one.</p>
        <Code language="ts" caption="shared" code={`
            import { pipe, refuse } from '@abide/abide'

            const noEmail = refuse.named('NoEmail', {
                message: 'This contact has no email.',
            })
            const mailerBusy = refuse.named('MailerBusy', { status: 503 })

            // a stand-in for the CRM's mailer
            const mailerUp = async () => Math.random() > 0.5

            const send = async (contact: { email?: string }) => {
                if (!contact.email) return noEmail() // 400: the answer
                return (await mailerUp()) ? contact : mailerBusy() // asked again
            }

            export const mail = pipe([send], { retries: 3 })
        `} />
    </Section>

    <Section level={3} title="Refuse to move a closed deal, with the reason as data">
        <p>A handler refuses the same way. Give the refusal a <code>schema</code> and the data
            a caller gets is typed. Over HTTP, the status is the response's.</p>
        <Code language="ts" caption="server" code={`
            import { jsonSchema, refuse } from '@abide/abide'
            import { rpc } from '@abide/abide/server'
            import { DEALS } from './lib/DEALS.server.ts'

            const dealClosed = refuse.named('DealClosed', {
                status: 409,
                message: 'A closed deal does not move.',
                schema: jsonSchema<{ stage: string }>({ type: 'object' }),
            })

            export const moveDeal = rpc(({ id, stage }: { id: string; stage: string }) => {
                const deal = DEALS.find((each) => each.id === id)
                if (deal === undefined) return refuse(404)
                if (deal.stage === 'won') return dealClosed({ stage: deal.stage })
                deal.stage = stage
                return deal
            }, { methods: ['PATCH'] })
        `} />
    </Section>

    <Section level={3} title="Match a refusal by name on the page">
        <p>A refused call throws. <code>isError</code> narrows by name, so
            <code>error.data</code> has the type the handler declared.</p>
        <Code language="ts" caption="browser" code={`
            import { moveDeal } from './moveDeal.server.ts'

            let notice = ''
            try {
                await moveDeal({ id: 'd3', stage: 'lead' })
            } catch (error) {
                if (!moveDeal.isError(error, 'DealClosed')) throw error
                notice = \`Already \${error.data.stage}: \${error.message}\`
            }
        `} />
    </Section>

    <Section level={3} title="Answer a request with a status alone">
        <p><code>refuse(status)</code> is for a handler whose answer is an HTTP status and
            nothing more. It has no name to match, so every one is named
            <code>HttpError</code>.</p>
        <Code language="ts" caption="server" code={`
            import { refuse } from '@abide/abide'
            import { rpc } from '@abide/abide/server'
            import { DEALS } from './lib/DEALS.server.ts'

            export const getDeal = rpc(async ({ id }: { id: string }) =>
                DEALS.find((deal) => deal.id === id) ?? refuse(404),
            )
        `} />
    </Section>
</Doc>
