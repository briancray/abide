<script>
import { copy, url } from '@abide/abide'

const copyLink = copy({
    value: () => {
        const href = `${location.origin}${url('/pipeline')}#d1`
        return {
            'text/html': `<a href="${href}">Analytical Engines renewal</a>`,
            'text/plain': href,
        }
    },
})
</script>

<button {...copyLink}>Copy link</button>
