<script>
import { copy, raw } from '@abide/abide'

const block = (command: string) =>
    `<pre><code>${command}</code><button data-copy>Copy</button></pre>`
const noteHtml = block('bun add @abide/abide') + block('bun run dev')

const copyBlock = copy({
    value: (button) =>
        button.closest('pre')?.querySelector('code')?.textContent ?? '',
    selector: '[data-copy]',
    oncopied: (landed) => console.log(landed),
})
</script>

<article {...copyBlock}>{raw(noteHtml)}</article>
