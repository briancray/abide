<script>
import Code from '#src/lib/Code.abide'
import Doc from '#src/lib/Doc.abide'
import Section from '#src/lib/Section.abide'
</script>

<Doc
    seeAlso={['/helpers/observe', '/components/chat']}
    tests={[
        {
            path: 'packages/abide/tests/elementBehaviors.test.ts',
            from: [
                "test('a scrolling element follows its bottom until the reader scrolls up",
            ],
        },
    ]}
>
    <Section level={3} title="Keep a deal's activity log at its newest entry">
        <p>Bind the scrolling element to <code>followBottom</code>, and each entry added scrolls
            it down. Scroll up to read an earlier entry and it stays put, until you scroll back to
            the bottom.</p>
        <Code language="abide" caption="abide" code={`
            <script>
            import { followBottom, reactive } from '@abide/abide'

            let activity = reactive(['Ledger audit opened'])
            </script>

            <ol class="h-64 overflow-y-auto" bind:element={followBottom}>
                {#for entry of activity by entry}
                    <li>{entry}</li>
                {/for}
            </ol>
            <button onclick={() => {
                activity = [...activity, \`Call \${activity.length} logged\`]
            }}>Log a call</button>
        `} />
    </Section>
</Doc>
