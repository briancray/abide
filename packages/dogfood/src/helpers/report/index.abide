<script>
import Code from '#src/lib/Code.abide'
import Doc from '#src/lib/Doc.abide'
import Section from '#src/lib/Section.abide'
</script>

<Doc
    seeAlso={[
        '/hooks/on-report',
        '/hooks/on-refusal',
        '/helpers/log',
        '/ambient/trace',
        '/ai/results-of',
    ]}
    tests={[
        {
            path: 'packages/abide/tests/report.test.ts',
            from: [
                "test('a draft made on a server holds its lines and sends in process",
            ],
        },
        {
            path: 'packages/dogfood/examples/crm/src/ops/lib/ReportProblem.test.ts',
            from: [
                "test('a report of the failed call is listed by its browser alone'",
            ],
        },
    ]}
>
    <Section level={3} title="Report the call that failed from its trace">
        <p><code>onRefusal</code> hands the page each failed call's trace.
            <code>open()</code> shows the draft in abide's dialog, every word to be sent in view,
            and settles <code>true</code> once the person sends it.</p>
        <Code language="abide" caption="abide" code={`
            <script>
            import { onRefusal, reactive, report } from '@abide/abide'

            let failed = reactive<string | undefined>(undefined)
            onRefusal((_refusal, call) => {
                failed = call.trace
            })
            </script>

            <button disabled={failed === undefined}
                onclick={() => report({ trace: failed }).open()}>
                Report this</button>
        `} />
    </Section>

    <Section level={3} title="Fill and send a problem report from a form of your own">
        <p>Write <code>summary</code> and <code>description</code>, show the person
            <code>markdown</code>, then call <code>send()</code>. A send retried after a refusal
            lands under the same <code>id</code>.</p>
        <Code language="ts" caption="shared" code={`
            const draft = report({ trace })
            draft.summary.set('Statement email fails')
            draft.description.set('Clicked Email Grace her statement.')
            preview.set(draft.markdown())
            const id = await draft.send()
        `} />
    </Section>

    <Section level={3} title="File each report with your tracker">
        <p>The server says where a report goes. With no <code>onReport</code> filed, a send is
            refused.</p>
        <Code language="ts" caption="server" code={`
            import { onReport } from '@abide/abide/server'

            onReport(async (report) => {
                await tracker.create({ id: report.id, title: report.summary,
                    body: report.markdown })
            })
        `} />
    </Section>
</Doc>
