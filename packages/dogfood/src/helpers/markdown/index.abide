<script>
import Code from '#src/lib/Code.abide'
import Doc from '#src/lib/Doc.abide'
import Example from '#src/lib/Example.abide'
import Section from '#src/lib/Section.abide'

import CopyCommands from './lib/CopyCommands.abide'
import copyCommands from './lib/CopyCommands.abide' with { type: 'text' }
import OutsideTab from './lib/OutsideTab.abide'
import outsideTab from './lib/OutsideTab.abide' with { type: 'text' }
import PastedNote from './lib/PastedNote.abide'
import pastedNote from './lib/PastedNote.abide' with { type: 'text' }
import StreamSummary from './lib/StreamSummary.abide'
import streamSummary from './lib/StreamSummary.abide' with { type: 'text' }
</script>

<Doc
    seeAlso={['/abide-files/raw', '/helpers/chat', '/helpers/url']}
    tests={[
        {
            path: 'packages/abide/tests/markdown.test.ts',
            from: ["test('markdown escapes every character of HTML in its source"],
        },
        {
            path: 'packages/abide/tests/markdown.test.ts',
            from: ["test('a link keeps its address only on an allowed scheme"],
        },
        {
            path: 'packages/abide/tests/markdown.test.ts',
            from: [
                "test('inline renders one line of marks with no block around it",
            ],
        },
        {
            path: 'packages/abide/tests/markdown.test.ts',
            from: [
                "test('a fenced block the caller names is its markup, handed the source and the rest of the info",
            ],
        },
        {
            path: 'packages/abide/tests/markdown.test.ts',
            from: [
                "test('a reference link takes the address its definition names, in any case",
            ],
        },
        {
            path: 'packages/abide/tests/markdown.test.ts',
            from: [
                "test('href may answer the address with the target and rel it opens with",
            ],
        },
        {
            path: 'packages/dogfood/examples/crm/src/deals/lib/NotePreview.test.ts',
            from: ["test('a note renders its markdown, and its HTML as text'"],
        },
        {
            path: 'packages/dogfood/examples/crm/src/deals/lib/NotePreview.test.ts',
            from: [
                "test('a heading in a note renders at the level the page gives it'",
            ],
        },
        {
            path: 'packages/dogfood/examples/crm/src/pipeline/lib/DealSummary.test.ts',
            from: ["test('a chunk renders only the section still growing'"],
        },
        {
            path: 'packages/dogfood/examples/crm/src/deals/lib/NotePreview.test.ts',
            from: [
                "test('a fenced sh block renders as the code with a Copy beside it, and once closed only'",
            ],
        },
        {
            path: 'packages/dogfood/examples/crm/src/deals/lib/NotePreview.test.ts',
            from: [
                "test('a reference link takes its address from a definition anywhere in the note, which shows nothing'",
            ],
        },
    ]}
>
    <Section level={3} title="Show a pasted deal note as formatted text">
        <p>The HTML <code>markdown</code> answers is safe to hand <code>raw</code>.
            <code>headingLevel</code> sets the level a <code>#</code> heading renders at, so a
            note's headings sit under the page's own.</p>
        <Example code={pastedNote}><PastedNote /></Example>
    </Section>

    <Section level={3} title="Keep a pasted script tag and a javascript link inert">
        <p>A tag in the note is escaped to text, and the link keeps only its text. An image
            renders as a link to it, so a note never makes the page load anything.</p>
        <Code language="ts" caption="shared" code={`
            import { markdown } from '@abide/abide'

            markdown('**Ada** [quote](javascript:alert(1)) <b>')
            // '<p><strong>Ada</strong> quote &lt;b&gt;</p>'
        `} />
    </Section>

    <Section level={3} title="Format a deal title inside one line">
        <p><code>inline</code> renders the marks of one line with no paragraph around them, for
            a title or a table cell.</p>
        <Code language="ts" caption="shared" code={`
            import { markdown } from '@abide/abide'

            markdown('Q3 *renewal*', { inline: true }) // 'Q3 <em>renewal</em>'
        `} />
    </Section>

    <Section level={3} title="Point a note's site links under the app's mount path">
        <p><code>href</code> rewrites each address a link keeps. Answer
            <code>undefined</code> to drop the link and keep its text.</p>
        <Code language="ts" caption="shared" code={`
            import { markdown, type RouteLiteral, url } from '@abide/abide'

            markdown(note, {
                href: (address) =>
                    address.startsWith('/') ? url(address as RouteLiteral) : address,
            })
        `} />
    </Section>

    <Section level={3} title="Open a note's outside links in a tab of their own">
        <p><code>href</code> may answer the address with the <code>target</code> and
            <code>rel</code> the link opens with.</p>
        <Example code={outsideTab}><OutsideTab /></Example>
    </Section>

    <Section level={3} title="Draw bars from a fenced block in a report">
        <p><code>blocks</code> names a function per fence language, handed the block's source and
            the rest of its info. What it answers is written as it is, so escape what it
            writes.</p>
        <Code language="ts" caption="shared" code={`
            import { markdown } from '@abide/abide'

            markdown(report, {
                blocks: {
                    bars: (source, info) => {
                        let bars = ''
                        for (const share of source.split(','))
                            bars += \`<meter max="100" value="\${Number(share)}"></meter>\`
                        const caption = markdown(info, { inline: true })
                        return \`<figure>\${bars}<figcaption>\${caption}</figcaption></figure>\`
                    },
                },
            })
        `} />
    </Section>

    <Section level={3} title="Render a summary as it streams in">
        <p><code>markdown.incremental</code> takes the same options and hands back
            <code>sections</code> to render one at a time. Hand <code>source</code> a function
            reading the text received until now: a section the stream has moved past is the same
            object on every later read, so a <code>for</code> keyed by the section keeps its nodes
            and a chunk renders only the section still growing.</p>
        <Example code={streamSummary}><StreamSummary /></Example>
    </Section>

    <Section level={3} title="Put a Copy button beside each shell command">
        <p>Given to <code>markdown.incremental</code>, <code>blocks</code> is a list of fence
            languages. A fenced block whose language is one of them is a section with a
            <code>block</code> — its <code>name</code>, its <code>source</code> and the rest of its
            <code>info</code> — once its fence closes, for you to render with a component of your
            own.</p>
        <Example code={copyCommands}><CopyCommands /></Example>
    </Section>
</Doc>
