<script>
import { calendar } from '@abide/abide'

const dates = calendar({ locale: 'en-GB' })
</script>

<div class="calendar">
    {#for shown of dates.months by shown.month}
        <h3 {...shown.heading}>{shown.label}</h3>
        <div {...shown.grid}>
            <div {...dates.header}>
                {#for weekday of dates.weekdays by weekday.day}
                    <div {...weekday.header}>{weekday.short}</div>
                {/for}
            </div>
            {#for week of shown.weeks by week[0]?.date}
                <div {...dates.week}>
                    {#for day of week by day.date}
                        <div {...day.cell}>{day.day}</div>
                    {/for}
                </div>
            {/for}
        </div>
    {/for}
</div>
