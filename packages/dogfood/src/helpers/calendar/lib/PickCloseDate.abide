<script>
import { calendar, reactive } from '@abide/abide'

let closes = reactive<string | undefined>('2026-12-15')
const dates = calendar({ selected: closes })
</script>

<p>Closes {closes ?? 'on no day yet'}</p>
<div class="calendar">
    <div data-bar>
        <button {...dates.previous}>‹</button>
        <h3 {...dates.heading}>{dates.label}</h3>
        <button {...dates.next}>›</button>
    </div>
    <div {...dates.grid}>
        <div {...dates.header}>
            {#for weekday of dates.weekdays by weekday.day}
                <div {...weekday.header}>{weekday.short}</div>
            {/for}
        </div>
        {#for week of dates.weeks by week[0]?.date}
            <div {...dates.week}>
                {#for day of week by day.date}
                    <div {...day.cell}>{day.day}</div>
                {/for}
            </div>
        {/for}
    </div>
</div>
