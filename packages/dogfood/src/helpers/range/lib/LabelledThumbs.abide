<script>
import { range, reactive } from '@abide/abide'

let band = reactive<readonly [number, number]>([20, 80])
const price = range({ value: band, label: 'Price' })
</script>

<div class="range" {...price.root}>
    <div data-part="track" {...price.track}>
        <div data-part="fill" {...price.fill} />
        {#for end of [0, 1] as const}
            <span
                class="absolute top-1/2 -translate-1/2 cursor-grab rounded-md
                bg-signal px-1.5 text-chrome text-paper"
                {...price.thumb(end)}
            >{band[end]}</span>
        {/for}
    </div>
</div>
