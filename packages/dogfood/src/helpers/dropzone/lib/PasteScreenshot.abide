<script>
import { dropzone, reactive } from '@abide/abide'

let note = reactive('')
let image = reactive('')
const attachImage = (files: File[]) => (image = files[0]?.name ?? '')
</script>

<textarea bind:value={note} bind:element={dropzone(attachImage, {
    accept: 'image/*',
    paste: true,
    multiple: false,
})}></textarea>
<p>Image: {image || 'paste a screenshot into the note'}</p>
