<script>
import Code from '#src/lib/Code.abide'
import Doc from '#src/lib/Doc.abide'
import Section from '#src/lib/Section.abide'
</script>

<Doc
    seeAlso={[
        '/reactive/stop-signal',
        '/helpers/log',
        '/helpers/database',
        '/transports/get',
        '/transports/post',
    ]}
    tests={[
        {
            path: 'packages/abide/tests/job.test.ts',
            from: ["test('a run asked for while one is in flight joins it"],
        },
        {
            path: 'packages/abide/tests/job.test.ts',
            from: [
                "test('a last run within the interval is waited out, and an older one is run at once",
            ],
        },
        {
            path: 'packages/abide/tests/job.test.ts',
            from: ["test('a failed run is logged under job:<name> and kept"],
        },
    ]}
>
    <Section level={3} title="Mail the team a follow-up digest every night">
        <p>Declare the job at the top of a server file. Nothing runs as the file loads: the first
            run waits for the app to serve, and the app's stop ends the schedule.</p>
        <Code language="ts" caption="server" code={`
            import { job } from '@abide/abide/server'

            export const digest = job('digest', {
                every: 24 * 60 * 60_000,
                run: async (signal) => {
                    const leads = await listLeads()
                    await mailTeam(leads, { signal })
                },
            })
        `} />
    </Section>

    <Section level={3} title="Serve the digest's status to every page">
        <p><code>status</code> is one value for every caller, written as each run starts and
            ends, so a handler serves it as it is.</p>
        <Code language="ts" caption="server" code={`
            import { GET } from '@abide/abide/server'
            import { digest } from './lib/digest.server.ts'

            export default GET(digest.status)
        `} />
    </Section>

    <Section level={3} title="Send the digest now without sending it twice">
        <p><code>runNow</code> joins a run in flight rather than start a second, so pressing Send
            twice mails the team once.</p>
        <Code language="ts" caption="server" code={`
            import { POST } from '@abide/abide/server'
            import { digest } from './lib/digest.server.ts'

            export default POST(() => digest.runNow())
        `} />
    </Section>

    <Section level={3} title="Keep a restart from sending the digest again">
        <p>A job never run is due at once. <code>lastRun</code> says when the last run ended, in
            epoch milliseconds, so a restart waits out the rest of the night.</p>
        <Code language="ts" caption="server" code={`
            job('digest', {
                every: 24 * 60 * 60_000,
                run: mailDigest,
                lastRun: () =>
                    crmDatabase()
                        .query<{ sentAt: number | null }, []>(
                            'SELECT max(sentAt) AS sentAt FROM digests',
                        )
                        .get()?.sentAt ?? undefined,
            })
        `} />
    </Section>
</Doc>
