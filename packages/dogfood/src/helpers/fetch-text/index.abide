<script>
import Code from '#src/lib/Code.abide'
import Doc from '#src/lib/Doc.abide'
import Section from '#src/lib/Section.abide'
</script>

<Doc
    seeAlso={[
        '/helpers/fetch-json',
        '/reactive/is-failed',
        '/reactive/refuse',
        '/transports/get',
    ]}
    tests={[
        {
            path: 'packages/abide/tests/fetchText.test.ts',
            from: [
                "test('a 404 is answered at once, as a FetchFailed carrying the status",
            ],
        },
        {
            path: 'packages/abide/tests/fetchText.test.ts',
            from: [
                "test('a Retry-After is waited, and one past the deadline is not",
            ],
        },
        {
            path: 'packages/abide/tests/fetchText.test.ts',
            from: ["test('a write is not asked again unless `retries` says so"],
        },
        {
            path: 'packages/abide/tests/fetchText.test.ts',
            from: [
                "test('a FetchFailed carries what fetch threw as its cause, and the wire carries none of it",
            ],
        },
    ]}
>
    <Section level={3} title="Read a company's filing as text">
        <p><code>fetchText</code> asks, retries and settles as <code>fetchJson</code> does, and
            answers the body as a string.</p>
        <Code language="ts" caption="server" code={`
            import { fetchText, GET } from '@abide/abide/server'

            export default GET(({ id }: { id: string }) =>
                fetchText(\`https://registry.example/filings/\${id}.txt\`, {
                    ttl: 300_000,
                }),
            )
        `} />
    </Section>

    <Section level={3} title="Find out why a fetch gave up">
        <p>A <code>FetchFailed</code> carries the last status, or <code>null</code> where nothing
            answered, and a reason: <code>timeout</code>, <code>network</code>,
            <code>status</code> or <code>shape</code>. Where an attempt threw, its
            <code>cause</code> is what <code>fetch</code> threw, a refused certificate's code
            and all; it never leaves the server.</p>
        <Code language="ts" caption="server" code={`
            import { fetchText, isFailed, log } from '@abide/abide/server'

            const filing = await fetchText('https://registry.example/filings/ada.txt', {
                timeout: 2_000,
            })
            if (isFailed(filing))
                log.warning('registry gave up', filing.data, filing.cause)
        `} />
    </Section>

    <Section level={3} title="Retry a write that is safe to repeat">
        <p>A <code>POST</code> is asked once, since asking again may write twice. Set
            <code>retries</code> where the service takes the same write twice safely, and send the
            body as a string.</p>
        <Code language="ts" caption="server" code={`
            import { fetchText } from '@abide/abide/server'

            await fetchText('https://mail.example/send', {
                method: 'POST',
                body: JSON.stringify(email),
                retries: 2,
            })
        `} />
    </Section>
</Doc>
