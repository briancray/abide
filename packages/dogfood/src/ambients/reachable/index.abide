<script>
import Code from '#src/lib/Code.abide'
import Doc from '#src/lib/Doc.abide'
import Section from '#src/lib/Section.abide'
</script>

<Doc
    seeAlso={['/browser/online', '/reactive/refuse', '/data/fetch-json']}
    tests={[
        {
            path: 'packages/dogfood/examples/crm/src/account/lib/SyncContact.test.ts',
            from: ["test('a host is asked once, however many calls ask after it'"],
        },
        {
            path: 'packages/abide/tests/reachable.test.ts',
            from: ["test('a host that answers is reachable whatever it answered"],
        },
    ]}
>
    <Section level={3} title="Refuse at once while billing is down">
        <p>Ask before the call. A host that is down then costs one probe a minute rather than one
            timeout per call.</p>
        <Code language="ts" caption="server" code={`
            import { refuse } from '@abide/abide'
            import { POST, reachable } from '@abide/abide/server'

            export default POST(async ({ id }: { id: string }) => {
                if (!(await reachable('billing.example')))
                    return refuse(503, 'Billing is unreachable.')
                await fetch(\`https://billing.example/contacts/\${id}\`, {
                    method: 'POST',
                })
            })
        `} />
    </Section>

    <Section level={3} title="Handle the failure that follows a true answer">
        <p>Any answer counts, a <code>404</code> included, and the answer can be a minute old. The
            call after a <code>true</code> can still fail, so keep its own error handling.</p>
        <Code language="ts" caption="server" code={`
            import { refuse } from '@abide/abide'
            import { POST, reachable } from '@abide/abide/server'

            export default POST(async (contact: { id: string }) => {
                if (!(await reachable('https://billing.example'))) return refuse(503)
                const sent = await fetch('https://billing.example/contacts', {
                    method: 'POST',
                    body: JSON.stringify(contact),
                })
                if (!sent.ok) return refuse(502, 'Billing refused the contact.')
            })
        `} />
    </Section>
</Doc>
