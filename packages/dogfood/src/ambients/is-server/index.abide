<script>
import Code from '#src/lib/Code.abide'
import Doc from '#src/lib/Doc.abide'
import Section from '#src/lib/Section.abide'
</script>

<Doc
    seeAlso={[
        '/browser/online',
        '/browser/media',
        '/reactive/watch',
        '/pages/render',
    ]}
    tests={[
        {
            path: 'packages/abide/tests/isServer.test.ts',
            from: [
                "test('a request answered beside a DOM is a server, and an effect throw does not fail it",
            ],
        },
        {
            path: 'packages/abide/tests/isServer.test.ts',
            from: ["test('a render outside every request is a server"],
        },
    ]}
>
    <Section level={3} title="Read a browser-only store from shared code">
        <p>Code a page imports runs on both sides. Guard what only a browser has.</p>
        <Code language="ts" caption="shared" code={`
            import { isServer } from '@abide/abide'

            export function lastPipeline(): string {
                if (isServer()) return 'default'
                return localStorage.getItem('pipeline') ?? 'default'
            }
        `} />
    </Section>

    <Section level={3} title="Tell a server render from a browser in a test">
        <p><code>isServer()</code> is true inside a request, a <code>render</code> and an
            <code>App.run</code>, even in a test process that has a DOM. Checking
            <code>typeof document</code> answers wrong there.</p>
        <Code language="ts" caption="shared" code={`
            import { isServer } from '@abide/abide'
            import { createApp } from '@abide/abide/server'

            const app = await createApp()
            isServer() // false in a test body
            await app.run(() => isServer()) // true
        `} />
    </Section>
</Doc>
