<script>
import Code from '#src/lib/Code.abide'
import Doc from '#src/lib/Doc.abide'
import Exchange from '#src/lib/Exchange.abide'
import Section from '#src/lib/Section.abide'
</script>

<Doc
    seeAlso={[
        '/middleware/signed-in',
        '/middleware/read-only',
        '/ambients/principal',
        '/app/on-principal',
        '/middleware/middleware',
        '/app/on-refusal',
    ]}
    tests={[
        {
            path: 'packages/abide/tests/guards.test.ts',
            from: [
                "test('authorize refuses a member the claims do not match Forbidden at 403, before the body runs",
            ],
        },
        {
            path: 'packages/abide/tests/guards.test.ts',
            from: [
                "test('authorize admits a member whose claims hold the ones it names, an array holding every item it lists",
            ],
        },
        {
            path: 'packages/abide/tests/guards.test.ts',
            from: ["test('authorize given a function admits whom it passes"],
        },
        {
            path: 'packages/abide/tests/guards.test.ts',
            from: [
                "test('authorize at 404 answers a member it does not admit as an address nothing serves",
            ],
        },
    ]}
>
    <Section level={3} title="Show the team's commission to admins alone">
        <p>Pass the claims a member must carry. <code>{`authorize({ role: 'admin' })`}</code>
            admits a member whose <code>principal.resolved</code> has the role. Nobody signed in
            is refused <code>SignedOut</code> at 401, as <code>signedIn</code> refuses them, and
            anyone else signed in <code>Forbidden</code> at 403, before the body runs.</p>
        <Code language="ts" caption="server" code={`
            import { authorize, GET } from '@abide/abide/server'

            export default GET(() => ({ total: '$18,400' }), {
                middleware: [authorize({ role: 'admin' })],
            })
        `} />
        <p>The CRM's, asked by nobody signed in, and its answer:</p>
        <Exchange path="/account/getTeamCommission" />
    </Section>

    <Section level={3} title="Admit a member of a group">
        <p>The claims are matched as a subset. An array names items the member's array holds, in
            any order and beside any others, so <code>{`{ groups: ['sales'] }`}</code> admits a
            member in <code>{`['support', 'sales']`}</code>. A nested object is matched the
            same way.</p>
        <Code language="ts" caption="server" code={`
            import { authorize, GET } from '@abide/abide/server'
            import { DEALS } from './lib/DEALS.server.ts'

            export default GET(() => DEALS, {
                middleware: [authorize({ groups: ['sales'] })],
            })
        `} />
    </Section>

    <Section level={3} title="Admit a member by any test of the principal">
        <p>Pass a function of the principal in place of the claims. <code>message</code> is what
            the <code>Forbidden</code> refusal says.</p>
        <Code language="ts" caption="server" code={`
            import { authorize, GET } from '@abide/abide/server'
            import { TEAM } from './lib/TEAM.server.ts'

            const onTheTeam = authorize(
                (member) => member.role === 'admin' || member.role === 'sales',
                { message: 'Only the team sees the team.' },
            )

            export default GET(() => TEAM, { middleware: [onTheTeam] })
        `} />
    </Section>

    <Section level={3} title="Tell a missing claim from a missing sign-in">
        <p>Both refusals are typed on the handler's failures, so a page narrows each by name.</p>
        <Code language="abide" caption="abide" code={`
            <script>
            import { reactive } from '@abide/abide'
            import getTeamCommission from './getTeamCommission.handler.ts'

            const commission = reactive.derived(() => getTeamCommission())
            const error = () => commission.error()
            </script>

            {#if getTeamCommission.isError(error(), 'SignedOut')}
                <a href="/sign-in">Sign in to see the team's figure</a>
            {:else if getTeamCommission.isError(error(), 'Forbidden')}
                <p>Admins see the team's figure.</p>
            {:else if commission.ready()}
                <strong>{commission.total}</strong>
            {/if}
        `} />
    </Section>

    <Section level={3} title="Hide payroll from everyone but admins">
        <p><code>status: 404</code> answers a member it does not admit as an address nothing
            serves, word for word, so they cannot tell the page exists.</p>
        <Code language="ts" caption="server" code={`
            import { authorize, GET } from '@abide/abide/server'

            export default GET(listPayroll, {
                middleware: [authorize({ role: 'admin' }, { status: 404 })],
            })
        `} />
    </Section>
</Doc>
