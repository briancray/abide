<script>
import Code from '#src/lib/Code.abide'
import Doc from '#src/lib/Doc.abide'
import Exchange from '#src/lib/Exchange.abide'
import Section from '#src/lib/Section.abide'
</script>

<Doc
    seeAlso={['/middleware/middleware', '/pages/pages', '/ambients/response']}
    tests={[
        {
            path: 'packages/abide/tests/csp.test.ts',
            from: [
                "test('sources replace, drop and add directives over the baseline",
            ],
        },
        {
            path: 'packages/abide/tests/csp.test.ts',
            from: [
                "test('csp.nonce is the nonce in the header, and a non-document carries no policy",
            ],
        },
        {
            path: 'packages/dogfood/examples/crm/src/account/lib/Widget.test.ts',
            from: [
                'test("a page admits the app\'s own scripts, and no other origin\'s"',
            ],
        },
    ]}
>
    <Section level={3} title="Run the app's own scripts on every page and nobody else's">
        <p>File the rung in the root layout. The policy admits the build's scripts and styles,
            and a support widget pasted from another origin is refused.</p>
        <Code language="abide" caption="abide" code={`
            <script server>
            import { csp } from '@abide/abide'
            import { middleware } from '@abide/abide/server'

            middleware(csp())
            </script>

            <slot />
        `} />
        <p>The CRM's contacts page, asked when this page loaded. Its policy names the build's
            scripts by hash and the render's by nonce, fresh on every answer.</p>
        <Exchange method="HEAD" path="/contacts" />
    </Section>

    <Section level={3} title="Let a partner site frame the CRM's pages">
        <p>A directive you name replaces the baseline's, and the rest stay. An empty list drops
            the directive.</p>
        <Code language="abide" caption="abide" code={`
            <script server>
            import { csp } from '@abide/abide'
            import { middleware } from '@abide/abide/server'

            middleware(csp({ 'frame-ancestors': ["'self'", 'https://docs.example'] }))
            </script>
        `} />
    </Section>

    <Section level={3} title="Start an analytics queue in an inline script">
        <p>An inline script of your own carries <code>csp.nonce()</code>, the nonce this
            response was served with.</p>
        <Code language="abide" caption="abide" code={`
            <script>
            import { csp } from '@abide/abide'
            </script>

            <head>
                <script nonce={csp.nonce()}>window.dataLayer = []</script>
            </head>
        `} />
    </Section>
</Doc>
