<script>
import Code from '#src/lib/Code.abide'
import Doc from '#src/lib/Doc.abide'
import Section from '#src/lib/Section.abide'
</script>

<Doc
    seeAlso={['/behaviors/observe', '/headless/autoscroll']}
    tests={[
        {
            path: 'packages/dogfood/examples/crm/src/pipeline/lib/OpenDeals.test.ts',
            from: ['test("deals past the list\'s height mark its bottom'],
        },
        {
            path: 'packages/abide/tests/scrollEdges.test.ts',
            from: [
                "test('the edges content lies beyond are written as data-scrollable",
            ],
        },
        {
            path: 'packages/abide/tests/scrollEdges.test.ts',
            from: ["test('a change anywhere inside reads the element again"],
        },
    ]}
>
    <Section level={3} title="Fade a list's edges while there is more to scroll to">
        <p>Spread <code>scrollEdges()</code> on the scrolling element, and its
            <code>data-scrollable</code> lists the edges with content beyond them:
            <code>top</code>, <code>bottom</code>, <code>start</code> and <code>end</code>.
            Style each one from your stylesheet. Deals landing, a row that changes and an image
            loading inside all mark it again.</p>
        <Code language="abide" caption="abide" code={`
            <script>
            import { memo, scrollEdges } from '@abide/abide'

            import listDeals from '../listDeals.handler.ts'

            const deals = memo(() => listDeals())
            </script>

            <ol
                class="h-24 overflow-y-auto data-[scrollable~=top]:mask-t-from-70%
                    data-[scrollable~=bottom]:mask-b-from-70%"
                {...scrollEdges()}>
                {#for deal of deals key deal.id}<li>{deal.name}</li>{/for}
            </ol>
        `} />
    </Section>
</Doc>
