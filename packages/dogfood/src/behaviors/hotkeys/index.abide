<script>
import Code from '#src/lib/Code.abide'
import Doc from '#src/lib/Doc.abide'
import Example from '#src/lib/Example.abide'
import Section from '#src/lib/Section.abide'

import NewDealKey from './lib/NewDealKey.abide'
import newDealKey from './lib/NewDealKey.abide' with { type: 'text' }
import SaveNote from './lib/SaveNote.abide'
import saveNote from './lib/SaveNote.abide' with { type: 'text' }
import StageKeys from './lib/StageKeys.abide'
import stageKeys from './lib/StageKeys.abide' with { type: 'text' }
</script>

<Doc
    seeAlso={[
        '/helpers/key-label',
        '/behaviors/is-editable-target',
        '/behaviors/dismissible',
        '/headless/listbox',
    ]}
    tests={[
        {
            path: 'packages/dogfood/examples/crm/src/deals/lib/DealShortcuts.test.ts',
            from: ["test('n opens a deal, and an n typed in it stays there'"],
        },
        {
            path: 'packages/abide/tests/hotkeys.test.ts',
            from: [
                "test('the first binding a press matches runs alone, and only it is prevented",
            ],
        },
        {
            path: 'packages/abide/tests/hotkeys.test.ts',
            from: ["test('a symbol is matched by what it types, shift or not"],
        },
        {
            path: 'packages/dogfood/examples/crm/src/deals/lib/StageKeys.test.ts',
            from: ["test('the number row picks a stage by where its keys sit"],
        },
        {
            path: 'packages/abide/tests/hotkeys.test.ts',
            from: ["test('a key written as its code is matched by where it sits"],
        },
        {
            path: 'packages/abide/tests/hotkeys.test.ts',
            from: [
                "test('a binding whose prevent is false runs and leaves the key",
            ],
        },
        {
            path: 'packages/abide/tests/hotkeys.test.ts',
            from: [
                'test("a native menu\'s spellings read as the modifiers they name',
            ],
        },
    ]}
>
    <Section level={3} title="Open a new deal with a key anywhere on the page">
        <p>Put the listener on <code>&lt;window onkeydown&gt;</code> to hear the whole page. It
            leaves with the component. A bare <code>n</code> stands aside while the visitor types
            in a field.</p>
        <Example code={newDealKey}><NewDealKey /></Example>
    </Section>

    <Section level={3} title="Close a form with Escape from inside its field">
        <p>A binding written with <code>editable: true</code> also runs while the visitor types,
            so Escape closes the field it was pressed in.</p>
        <Code language="ts" caption="shared" code={`
            import { hotkeys, reactive } from '@abide/abide'

            const adding = reactive(true)
            const keys = hotkeys({
                Escape: {
                    run: () => adding.set(false),
                    editable: true,
                },
            })
        `} />
    </Section>

    <Section level={3} title="Clear a search on Escape and still let the dialog close">
        <p>A binding takes the key's default with <code>preventDefault</code>. Write
            <code>prevent: false</code> and the press keeps it, so the dialog around the search
            closes on the same Escape.</p>
        <Code language="ts" caption="shared" code={`
            import { hotkeys, reactive } from '@abide/abide'

            const query = reactive('')
            const keys = hotkeys({
                Escape: {
                    run: () => query.set(''),
                    editable: true,
                    prevent: false,
                },
            })
        `} />
    </Section>

    <Section level={3} title="Bind the number row on any keyboard layout">
        <p>Write a key as its <code>KeyboardEvent.code</code>, like <code>Digit1</code> or
            <code>KeyQ</code>, and the binding matches where the key sits rather than what it
            types. A French keyboard's <code>&amp;</code> still runs <code>Digit1</code>.
            <code>keyLabel</code> writes the key a US layout types there.</p>
        <Example code={stageKeys}><StageKeys /></Example>
    </Section>

    <Section level={3} title="Save a note with ⌘↩ on a Mac and Ctrl+Enter elsewhere">
        <p><code>mod</code> is ⌘ on Apple platforms and Ctrl on any other. On an element, the
            listener hears only the keys pressed inside it.</p>
        <Example code={saveNote}><SaveNote /></Example>
    </Section>
    <Section level={3} title="Bind the shortcut a native menu names">
        <p>A binding reads <code>cmd</code> and <code>command</code> as <code>meta</code>,
            <code>option</code> as <code>alt</code> and <code>control</code> as
            <code>ctrl</code>, so a menu item's <code>key</code> binds as it is written.</p>
        <Code language="ts" caption="browser" code={`
            import { hotkeys } from '@abide/abide'

            addEventListener('keydown', hotkeys({ 'cmd+shift+r': refreshPipeline }))
        `} />
    </Section>
</Doc>
