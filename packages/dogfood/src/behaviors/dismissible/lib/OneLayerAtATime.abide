<script>
import { dismissible, reactive, tooltip } from '@abide/abide'

let open = reactive(false)
const edit = dismissible(() => (open = false))
const hint = tooltip.tip('Press Escape: this hint closes first', { delay: 0 })
</script>

<button onclick={() => (open = true)}>Quick edit</button>
{#if open}
    <form {...edit.host}>
        <input value="Analytical Engines" {...hint}>
    </form>
{/if}
