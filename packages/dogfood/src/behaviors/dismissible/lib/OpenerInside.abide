<script>
import { dismissible, reactive } from '@abide/abide'

let open = reactive(false)
const edit = dismissible(() => (open = false))
</script>

<button {...edit.inside} onclick={() => (open = !open)}>
    {open ? 'Done' : 'Quick edit'}</button>
{#if open}
    <form {...edit.host}>
        <input value="Analytical Engines">
    </form>
{/if}
