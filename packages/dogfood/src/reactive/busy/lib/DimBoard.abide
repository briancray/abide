<script>
import { busy, reactive } from '@abide/abide'

import getStage from './DimBoard.server.ts'

const lead = reactive.derived(() => getStage({ stage: 'lead' }))
const won = reactive.derived(() => getStage({ stage: 'won' }))
</script>

<ul class={busy({ tags: ['board'] }) ? 'tiles opacity-40' : 'tiles'}>
    <li>lead: {lead}</li>
    <li>won: {won}</li>
</ul>
<button onclick={() => getStage.refresh({ stage: 'won' })}>Reload won</button>
