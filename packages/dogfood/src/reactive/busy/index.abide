<script>
import Code from '#src/lib/Code.abide'
import Doc from '#src/lib/Doc.abide'
import Example from '#src/lib/Example.abide'
import Section from '#src/lib/Section.abide'

import DimBoard from './lib/DimBoard.abide'
import dimBoard from './lib/DimBoard.abide' with { type: 'text' }
</script>

<Doc
    seeAlso={[
        '/reactive/ready',
        '/reactive/synced',
        '/reactive/refresh',
        '/reactive/reactive',
    ]}
    tests={[
        {
            path: 'packages/abide/tests/reactive.test.ts',
            from: [
                "test('busy and ready over tags answer ANY and EVERY across the values carrying them'",
            ],
        },
        {
            path: 'packages/abide/tests/outbox.test.ts',
            from: [
                "test('a bare busy is true while the outbox sends a call — 46.11'",
            ],
        },
    ]}
>
    <Section level={3} title="Dim the board while any stage reloads">
        <p>Tag the tiles, and <code>busy</code> over the tag answers for every one of them, so
            reloading one stage dims the whole board.</p>
        <Example code={dimBoard} server="reactive/busy/lib/DimBoard.server.ts"><DimBoard /></Example>
    </Section>

    <Section level={3} title="Ask the derived value that reads a handler, not the handler">
        <p>A handler's call answers a promise, which has no status to ask. Read it inside a
            <code>reactive.derived</code> and ask that: one value, a set of <code>tags</code>, or with
            nothing, every load in this scope and any call the outbox is sending.</p>
        <Code language="ts" caption="shared" code={`
            import { busy, reactive } from '@abide/abide'
            // declared rpc(…, { tags: ['stages'] })
            import getStage from './getStage.server.ts'

            const won = reactive.derived(() => getStage({ stage: 'won' }))

            busy(won) // won.busy()
            busy({ tags: ['stages'] })
            busy()
        `} />
    </Section>
</Doc>
