<script>
import Code from '#src/lib/Code.abide'
import Doc from '#src/lib/Doc.abide'
import Example from '#src/lib/Example.abide'
import Section from '#src/lib/Section.abide'

import DimBoard from './lib/DimBoard.abide'
import dimBoard from './lib/DimBoard.abide' with { type: 'text' }
</script>

<Doc
    seeAlso={[
        '/reactive/ready',
        '/reactive/synced',
        '/reactive/refresh',
        '/reactive/reactive',
    ]}
    tests={[
        {
            path: 'packages/abide/tests/reactive.test.ts',
            from: [
                "test('busy and ready over tags answer ANY and EVERY across the values carrying them'",
            ],
        },
        {
            path: 'packages/abide/tests/outbox.test.ts',
            from: [
                "test('busy is true over a handler while the outbox sends its call — 46.11'",
            ],
        },
    ]}
>
    <Section level={3} title="Dim the board while any stage reloads">
        <p>Pass a handler, and <code>busy</code> answers for every entry the tiles called it
            with, so reloading one stage dims the whole board.</p>
        <Example code={dimBoard}><DimBoard /></Example>
    </Section>

    <Section level={3} title="Ask about one stage, or one tag">
        <p>A pattern narrows a keyed handler to the entries it matches. A set of
            <code>tags</code> asks across every value carrying one.</p>
        <Code language="ts" caption="shared" code={`
            import { busy } from '@abide/abide'
            import getStage from './getStage.handler.ts'

            busy(getStage, { stage: 'won' })
            busy({ tags: ['stage:won'] })
            busy() // every load in this scope
        `} />
    </Section>
</Doc>
