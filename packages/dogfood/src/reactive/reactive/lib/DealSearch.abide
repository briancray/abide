<script server>
import { GET } from '@abide/abide/server'

const NAMES = ['Acme renewal', 'Babbage audit', 'Hopper & Co', 'Lovelace pilot']

const searchDeals = GET(({ q }: { q: string }) =>
    NAMES.filter((name) => name.toLowerCase().includes(q.toLowerCase())),
)
</script>

<script>
import { computed, reactive } from '@abide/abide'

let q = reactive('', { debounce: 300 })
const found = computed(() => searchDeals({ q }))
</script>

<input bind:value={q}>
{#for name of found}<p>{name}</p>{/for}
