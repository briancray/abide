<script>
import { reactive } from '@abide/abide'

let price = reactive(() => (amount: number) => `$${amount}`)

function shown(amount: number): string {
    const format = price
    return format(amount)
}
</script>

<p>{shown(40)}</p>
<button onclick={() => (price = (amount) => `€${amount}`)}>Euros</button>
