<script server>
import { rpc } from '@abide/abide/server'

export const saveNote = rpc(({ note }: { id: string; note: string }) => note, {
    methods: ['POST'],
})
</script>

<script>
import { reactive, watch } from '@abide/abide'

let note = reactive('')
let saved = reactive('')
watch(() => {
    const text = note
    const timer = setTimeout(async () => {
        saved = await saveNote({ id: 'd2', note: text })
    }, 500)
    return () => clearTimeout(timer)
})
</script>

<textarea bind:value={note}></textarea>
<p>Saved: {saved}</p>
