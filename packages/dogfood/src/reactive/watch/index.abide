<script>
import Code from '#src/lib/Code.abide'
import Doc from '#src/lib/Doc.abide'
import Example from '#src/lib/Example.abide'
import Section from '#src/lib/Section.abide'

import SaveNote from './lib/SaveNote.abide'
import saveNote from './lib/SaveNote.abide' with { type: 'text' }
</script>

<Doc
    seeAlso={[
        '/reactive/reactive',
        '/testing/flush-sync',
        '/reactive/tracking',
        '/ambients/is-server',
    ]}
    tests={[
        {
            path: 'packages/abide/tests/reactive.test.ts',
            from: [
                "test('an effect runs immediately and again on change, and its disposer runs first'",
            ],
        },
        {
            path: 'packages/abide/tests/reactive.test.ts',
            from: [
                "test('a watch given sources runs only when those sources change'",
            ],
        },
    ]}
>
    <Section level={3} title="Save a note a beat after the typing stops">
        <p>The effect reads <code>note</code>, so each keystroke reruns it. The disposer clears the
            timer the run before started, so a burst of typing is one save.</p>
        <Example code={saveNote} server="reactive/watch/lib/SaveNote.server.ts"><SaveNote /></Example>
    </Section>

    <Section level={3} title="Wake only on the sources named">
        <p>Given its sources, a watch reruns when one of them changes and on nothing else it
            reads.</p>
        <Code language="ts" caption="shared" code={`
            import { log, reactive, watch } from '@abide/abide'

            const stage = reactive('lead')
            const owner = reactive('ada')
            watch(stage, () => log.info('stage', { stage: stage(), owner: owner() }))
            owner.set('grace') // no run
            stage.set('won') // runs
        `} />
    </Section>

    <Section level={3} title="Stop a watch">
        <p><code>watch</code> returns its stop. A watch in a component stops with the component.</p>
        <Code language="ts" caption="shared" code={`
            import { reactive, watch } from '@abide/abide'

            const count = reactive(0)
            const stop = watch(() => console.log(count()))
            stop()
        `} />
    </Section>
</Doc>
