<script>
import Code from '#src/lib/Code.abide'
import Doc from '#src/lib/Doc.abide'
import Section from '#src/lib/Section.abide'
</script>

<Doc
    seeAlso={['/reactive/busy', '/reactive/synced', '/reactive/reactive']}
    tests={[
        {
            path: 'packages/abide/tests/reactive.test.ts',
            from: [
                "test('busy and ready over tags answer ANY and EVERY across the values carrying them'",
            ],
        },
        {
            path: 'packages/abide/tests/rpc.test.ts',
            from: [
                "test('a probe takes no rpc, and a trigger checks its pattern against Args — 13.1, 13.12'",
            ],
        },
    ]}
>
    <Section level={3} title="Enable an export once both lists have loaded">
        <p>Tag the handlers the export needs, where they are declared. <code>ready</code> over the
            tag is true once every value read from them has one to serve.</p>
        <Code language="abide" caption="abide" code={`
            <script>
            import { computed, ready } from '@abide/abide'
            // each declared GET(…, { tags: ['export'] })
            import listContacts from './listContacts.handler.ts'
            import listDeals from './listDeals.handler.ts'

            const contacts = computed(() => listContacts())
            const deals = computed(() => listDeals())
            </script>

            <p>{contacts.length} contacts, {deals.length} deals</p>
            <button disabled={!ready({ tags: ['export'] })}>Export both</button>
        `} />
    </Section>

    <Section level={3} title="Ask the computed that reads a handler, not the handler">
        <p>A handler's call answers a promise, which has no status to ask. Read the stage inside
            a <code>computed</code>, and <code>ready</code> over it is true once that stage has a
            figure to show.</p>
        <Code language="abide" caption="abide" code={`
            <script>
            import { computed, ready } from '@abide/abide'
            import getStage from './getStage.handler.ts'

            const won = computed(() => getStage({ stage: 'won' }))
            </script>

            <p>{ready(won) ? \`\${won.count} won\` : 'loading…'}</p>
        `} />
    </Section>
</Doc>
