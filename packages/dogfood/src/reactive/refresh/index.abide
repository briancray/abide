<script>
import Code from '#src/lib/Code.abide'
import Doc from '#src/lib/Doc.abide'
import Example from '#src/lib/Example.abide'
import Section from '#src/lib/Section.abide'

import WinLead from './lib/WinLead.abide'
import winLead from './lib/WinLead.abide' with { type: 'text' }
</script>

<Doc
    seeAlso={['/reactive/invalidate', '/reactive/busy', '/reactive/reactive']}
    tests={[
        {
            path: 'packages/abide/tests/rpc.test.ts',
            from: [
                "test('a pattern narrows an rpc to the entries it matches — 13.12'",
            ],
        },
        {
            path: 'packages/abide/tests/bareSelection.test.ts',
            from: [
                "test('refreshing on reconnect reloads what is read and marks the rest'",
            ],
        },
    ]}
>
    <Section level={3} title="Reload the two stages a won deal moved between">
        <p>Winning a lead changes <code>lead</code> and <code>won</code>. Call the handler's own
            <code>refresh</code> with a pattern of its args to reload those two entries, and every
            other stage stays as it is: <code>proposal</code> never reloads.</p>
        <Example code={winLead} server="reactive/refresh/lib/WinLead.server.ts"><WinLead /></Example>
    </Section>

    <Section level={3} title="Reload every value about one stage by tag">
        <p>Tag the handler's entries, then refresh the tag. It reaches every value carrying it,
            whichever handler it came from.</p>
        <Code language="ts" caption="server" code={`
            import { rpc } from '@abide/abide/server'
            import { DEALS } from './lib/DEALS.server.ts'

            export default rpc(
                async ({ stage }: { stage: string }) =>
                    DEALS.filter((deal) => deal.stage === stage).length,
                { tags: ({ stage }) => [\`stage:\${stage}\`] },
            )
        `} />
        <Code language="ts" caption="browser" code={`
            import { refresh } from '@abide/abide'

            refresh({ tags: ['stage:won'] })
        `} />
    </Section>

    <Section level={3} title="Reload everything when the connection comes back">
        <p>With no selection, <code>refresh</code> reloads every load this scope has that
            something reads, and marks the rest stale.</p>
        <Code language="ts" caption="browser" code={`
            import { online, refresh, watch } from '@abide/abide'

            watch(() => {
                if (online()) refresh()
            })
        `} />
    </Section>
</Doc>
