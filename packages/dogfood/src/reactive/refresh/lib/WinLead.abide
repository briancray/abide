<script server>
import { rpc } from '@abide/abide/server'

const ACME = { stage: 'lead', amount: 12_000 }
const DEALS = [
    ACME,
    { stage: 'won', amount: 30_000 },
    { stage: 'proposal', amount: 9_000 },
]

export const getStage = rpc(async ({ stage }: { stage: string }) => {
    await Bun.sleep(400)
    let value = 0
    for (const deal of DEALS) if (deal.stage === stage) value += deal.amount
    return value
})

export const winDeal = rpc(
    () => {
        ACME.stage = ACME.stage === 'lead' ? 'won' : 'lead'
    },
    { methods: ['POST'] },
)
</script>

<script>
import { reactive } from '@abide/abide'

const lead = reactive.derived(() => getStage({ stage: 'lead' }))
const won = reactive.derived(() => getStage({ stage: 'won' }))
const proposal = reactive.derived(() => getStage({ stage: 'proposal' }))

async function win() {
    await winDeal()
    getStage.refresh({ stage: 'lead' })
    getStage.refresh({ stage: 'won' })
}
</script>

<ul class="tiles">
    <li class={lead.busy() ? 'opacity-40' : ''}>lead: ${lead}</li>
    <li class={won.busy() ? 'opacity-40' : ''}>won: ${won}</li>
    <li class={proposal.busy() ? 'opacity-40' : ''}>proposal: ${proposal}</li>
</ul>
<button onclick={win}>Win Acme</button>
