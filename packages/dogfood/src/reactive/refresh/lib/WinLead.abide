<script server>
import { GET, POST } from '@abide/abide/server'

const ACME = { stage: 'lead', amount: 12_000 }
const DEALS = [
    ACME,
    { stage: 'won', amount: 30_000 },
    { stage: 'proposal', amount: 9_000 },
]

const getStage = GET(async ({ stage }: { stage: string }) => {
    await Bun.sleep(400)
    let value = 0
    for (const deal of DEALS) if (deal.stage === stage) value += deal.amount
    return value
})

const winDeal = POST(() => {
    ACME.stage = ACME.stage === 'lead' ? 'won' : 'lead'
})
</script>

<script>
import { memo, refresh } from '@abide/abide'

const lead = memo(() => getStage({ stage: 'lead' }))
const won = memo(() => getStage({ stage: 'won' }))
const proposal = memo(() => getStage({ stage: 'proposal' }))

async function win() {
    await winDeal()
    refresh(getStage, { stage: 'lead' })
    refresh(getStage, { stage: 'won' })
}
</script>

<ul class="tiles">
    <li class={lead.busy() ? 'opacity-40' : ''}>lead: ${lead}</li>
    <li class={won.busy() ? 'opacity-40' : ''}>won: ${won}</li>
    <li class={proposal.busy() ? 'opacity-40' : ''}>proposal: ${proposal}</li>
</ul>
<button onclick={win}>Win Acme</button>
