<script>
import { reactive } from '@abide/abide'

import { getStage, winDeal } from './WinLead.server.ts'

const lead = reactive.derived(() => getStage({ stage: 'lead' }))
const won = reactive.derived(() => getStage({ stage: 'won' }))
const proposal = reactive.derived(() => getStage({ stage: 'proposal' }))

async function win() {
    await winDeal()
    getStage.refresh({ stage: 'lead' })
    getStage.refresh({ stage: 'won' })
}
</script>

<ul class="tiles">
    <li class={lead.busy() ? 'opacity-40' : ''}>lead: ${lead}</li>
    <li class={won.busy() ? 'opacity-40' : ''}>won: ${won}</li>
    <li class={proposal.busy() ? 'opacity-40' : ''}>proposal: ${proposal}</li>
</ul>
<button onclick={win}>Win Acme</button>
