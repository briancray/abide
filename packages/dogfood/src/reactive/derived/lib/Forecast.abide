<script server>
export const getForecast = async () => {
    await Bun.sleep(500)
    return Math.round(42_000 * (0.9 + Math.random() * 0.2))
}
</script>

<script>
import { reactive } from '@abide/abide'

const forecast = reactive.derived(() => getForecast())
</script>

{#if forecast.ready()}
    <strong>${forecast}</strong>
{:else}
    <p>Adding up the pipeline…</p>
{/if}
<button onclick={() => forecast.refresh()}>Reload</button>
