<script>
import { reactive } from '@abide/abide'

let seats = reactive(5)
let price = reactive(40)
let note = reactive('')
const total = reactive.derived(() => seats * price)
</script>

<p>{seats} seats at ${price} each: ${total}</p>
<div class="row">
    <button onclick={() => (seats += 1)}>Add a seat</button>
    <input bind:value={note} placeholder="A note the total never reads">
</div>
