<script>
import Code from '#src/lib/Code.abide'
import Doc from '#src/lib/Doc.abide'
import Example from '#src/lib/Example.abide'
import Section from '#src/lib/Section.abide'

import OpenedAs from './lib/OpenedAs.abide'
import openedAs from './lib/OpenedAs.abide' with { type: 'text' }
import PeekOwner from './lib/PeekOwner.abide'
import peekOwner from './lib/PeekOwner.abide' with { type: 'text' }
</script>

<Doc
    seeAlso={['/reactive/reactive', '/reactive/watch', '/reactive/is-reactive']}
    tests={[
        {
            path: 'packages/abide/tests/props.test.ts',
            from: [
                "test('a child setup in an arm does not wake the arm choice — 14.7'",
            ],
        },
        {
            path: 'packages/abide/tests/reactive.test.ts',
            from: [
                "test('a keyed entry does not recompute when a value its body read changes'",
            ],
        },
        {
            path: 'packages/abide/tests/trackingAwait.test.ts',
            from: [
                "test('a read inside what is awaited tracks, and one after it warns — 14.14'",
            ],
        },
    ]}
>
    <Section level={3} title="Read a stage once at setup, and follow it in the template">
        <p>A component's <code>&lt;script&gt;</code> runs once and follows nothing. The template
            follows every value it reads, so a click moves <code>stage</code> and leaves
            <code>openedAs</code>.</p>
        <Example code={openedAs}><OpenedAs /></Example>
    </Section>

    <Section level={3} title="Read an owner without rerunning when the owner changes">
        <p><code>peek()</code> reads what is held and subscribes to nothing. Hand the deal to
            Grace and no binding runs. Win it, and the label reruns and reads Grace then.</p>
        <Example code={peekOwner}><PeekOwner /></Example>
    </Section>

    <Section level={3} title="Read every value a body follows before its first await">
        <p>Tracking is synchronous. A read after an <code>await</code> follows nothing, and the
            compiler warns on it.</p>
        <Code language="abide" caption="abide" code={`
            <script>
            import { reactive } from '@abide/abide'
            import getDeal from './getDeal.handler.ts'

            let owner = reactive('ada')
            let dealId = reactive('d2')
            const deal = reactive.derived(async () => {
                const who = owner // before the await: followed
                const found = await getDeal({ id: dealId }) // awaited: followed
                return { ...found, owner: who }
            })
            </script>
        `} />
    </Section>
</Doc>
