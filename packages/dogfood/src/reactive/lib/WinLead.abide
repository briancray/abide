<script server>
import { rpc } from '@abide/abide/server'

const ACME = { stage: 'lead', amount: 12_000 }
const DEALS = [ACME, { stage: 'won', amount: 30_000 }]

export const getStage = rpc(async ({ stage }: { stage: string }) => {
    await Bun.sleep(400)
    let value = 0
    for (const deal of DEALS) if (deal.stage === stage) value += deal.amount
    return { value }
})

export const moveAcme = rpc(
    () => {
        ACME.stage = ACME.stage === 'lead' ? 'won' : 'lead'
    },
    { methods: ['POST'] },
)
</script>

<script>
import { reactive } from '@abide/abide'

const leads = reactive.derived(() => getStage({ stage: 'lead' }))
const won = reactive.derived(() => getStage({ stage: 'won' }))

async function move() {
    await moveAcme()
    getStage.refresh()
}
</script>

<div class={leads.busy() || won.busy() ? 'tiles opacity-40' : 'tiles'}>
    <p>lead: ${leads.value}</p>
    <p>won: ${won.value}</p>
</div>
<button onclick={move}>Move Acme</button>
