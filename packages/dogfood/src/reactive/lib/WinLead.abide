<script>
import { reactive } from '@abide/abide'

import { getStage, moveAcme } from './WinLead.server.ts'

const leads = reactive(() => getStage({ stage: 'lead' }))
const won = reactive(() => getStage({ stage: 'won' }))

async function move() {
    await moveAcme()
    getStage.refresh()
}
</script>

<div class={leads.busy() || won.busy() ? 'tiles opacity-40' : 'tiles'}>
    <p>lead: ${leads.value}</p>
    <p>won: ${won.value}</p>
</div>
<button onclick={move}>Move Acme</button>
