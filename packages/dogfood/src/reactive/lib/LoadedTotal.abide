<script server>
const DEALS = [
    { stage: 'lead', amount: 12_000 },
    { stage: 'won', amount: 30_000 },
    { stage: 'lead', amount: 8_000 },
]

export const getStage = async ({ stage }: { stage: string }) => {
    await Bun.sleep(400)
    let value = 0
    for (const deal of DEALS) if (deal.stage === stage) value += deal.amount
    return { value }
}
</script>

<script>
import { reactive } from '@abide/abide'

let stage = reactive('lead')
const total = reactive(() => getStage({ stage }))
</script>

<select bind:value={stage}>
    <option>lead</option>
    <option>won</option>
</select>
{#if total.ready()}
    <p>Total: ${total.value}</p>
{:else}
    <p>Adding up {stage}…</p>
{/if}
