<script>
import Code from '#src/lib/Code.abide'
import Doc from '#src/lib/Doc.abide'
import Section from '#src/lib/Section.abide'
</script>

<Doc
    seeAlso={[
        '/reactive/reactive',
        '/reactive/tracking',
        '/reactive/refresh',
        '/reactive/stop-signal',
    ]}
    tests={[
        {
            path: 'packages/abide/tests/reactive.test.ts',
            from: [
                "test('a body declaring a parameter is keyed, and one declaring none is not'",
            ],
        },
        {
            path: 'packages/abide/tests/reactive.test.ts',
            from: [
                "test('an async generator body streams: ready from its first chunk, busy until it closes'",
            ],
        },
        {
            path: 'packages/abide/tests/reactive.test.ts',
            from: [
                "test('memo refuses anything but a body at construction — 11.74'",
            ],
        },
    ]}
>
    <Section level={3} title="Derive a total from the values a body reads">
        <p>Pass a body. The total reruns when <code>seats</code> or <code>price</code> changes, and
            on nothing else.</p>
        <Code language="abide" caption="abide" code={`
            <script>
            import { memo, reactive } from '@abide/abide'

            let seats = reactive(5)
            let price = reactive(40)
            const total = memo(() => seats * price)
            </script>

            <p>{seats} seats at {price} each: {total}</p>
        `} />
    </Section>

    <Section level={3} title="Load a forecast from a handler">
        <p>A body that calls a handler loads. Ask <code>ready()</code> before showing the figure,
            and <code>refresh()</code> reloads it while the old figure stays.</p>
        <Code language="abide" caption="abide" code={`
            <script>
            import { memo } from '@abide/abide'
            import getForecast from './getForecast.handler.ts'

            const forecast = memo(() => getForecast())
            </script>

            {#if forecast.ready()}
                <strong>{forecast}</strong>
            {:else}
                <p>Adding up the pipeline…</p>
            {/if}
            <button onclick={() => forecast.refresh()}>Reload</button>
        `} />
    </Section>

    <Section level={3} title="Keep one entry per stage with a keyed body">
        <p>A body that declares a parameter is keyed. Each set of args is one entry, held and
            reloaded on its own.</p>
        <Code language="ts" caption="shared" code={`
            import { memo } from '@abide/abide'
            import getStage from './getStage.handler.ts'

            const stageTotals = memo(({ stage }: { stage: string }) =>
                getStage({ stage }),
            )
            const won = stageTotals({ stage: 'won' })
            stageTotals({ stage: 'won' }) === won // true
            stageTotals.refresh({ stage: 'won' }) // reloads that entry alone
        `} />
    </Section>

    <Section level={3} title="Stream the leads still waiting on a follow-up">
        <p>A generator body streams. The value is every name yielded until now: ready from the first,
            busy until the generator ends.</p>
        <Code language="ts" caption="shared" code={`
            import { memo } from '@abide/abide'
            import listDeals from './listDeals.handler.ts'

            const waiting = memo(async function* () {
                for (const deal of await listDeals())
                    if (deal.stage === 'lead') yield deal.name
            })
        `} />
    </Section>
</Doc>
