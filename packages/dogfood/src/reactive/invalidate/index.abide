<script>
import Code from '#src/lib/Code.abide'
import Doc from '#src/lib/Doc.abide'
import Example from '#src/lib/Example.abide'
import Section from '#src/lib/Section.abide'

import MarkStale from './lib/MarkStale.abide'
import markStale from './lib/MarkStale.abide' with { type: 'text' }
</script>

<Doc
    seeAlso={['/reactive/refresh', '/reactive/store', '/reactive/reactive']}
    tests={[
        {
            path: 'packages/abide/tests/bareSelection.test.ts',
            from: [
                "test('a bare invalidate marks every load, starts none of them, and skips a value with no producer — 13.6, 7.3'",
            ],
        },
        {
            path: 'packages/abide/tests/reactive.test.ts',
            from: [
                "test('invalidate over tags reaches every value carrying any of them, and no other'",
            ],
        },
    ]}
>
    <Section level={3} title="Mark the forecast stale without reloading it now">
        <p><code>invalidate</code> starts nothing, so marking the forecast stale does no work at
            all. The next read loads it again: hide the forecast and show it, and a new figure
            arrives.</p>
        <Example code={markStale}><MarkStale /></Example>
    </Section>

    <Section level={3} title="Mark every value about one stage stale">
        <p>A set of <code>tags</code> reaches every value carrying one. With no selection,
            <code>invalidate</code> marks every load in this scope.</p>
        <Code language="ts" caption="browser" code={`
            import { invalidate } from '@abide/abide'

            invalidate({ tags: ['stage:won'] })
            invalidate()
        `} />
    </Section>
</Doc>
