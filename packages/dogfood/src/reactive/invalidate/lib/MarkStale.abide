<script server>
import { GET } from '@abide/abide/server'

const getForecast = GET(async () => {
    await Bun.sleep(500)
    return Math.round(42_000 * (0.9 + Math.random() * 0.2))
})
</script>

<script>
import { reactive } from '@abide/abide'

let open = reactive(true)
const forecast = reactive.derived(() => getForecast())
</script>

<div class="row">
    <button onclick={() => getForecast.invalidate()}>Mark stale</button>
    <button onclick={() => (open = !open)}>
        {open ? 'Hide' : 'Show'} forecast
    </button>
</div>
{#if open}<p>${forecast}</p>{/if}
