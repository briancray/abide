<script>
import Code from '#src/lib/Code.abide'
import Doc from '#src/lib/Doc.abide'
import Section from '#src/lib/Section.abide'
</script>

<Doc
    seeAlso={['/reactive/watch', '/reactive/reactive']}
    tests={[
        {
            path: 'packages/dogfood/examples/crm/src/pipeline/lib/DealPicker.test.ts',
            from: [
                "test('picking a deal in the list shows it in the detail panel'",
            ],
        },
        {
            path: 'packages/abide/tests/reactive.test.ts',
            from: [
                "test('flushSync delivers a stream wake held for the next task'",
            ],
        },
    ]}
>
    <Section level={3} title="Check the page right after a click in a test">
        <p>A write wakes its effects at the end of the turn, the template's included. Call
            <code>flushSync</code> to run them before the next line asserts.</p>
        <Code language="ts" caption="shared" code={`
            import { expect, test } from 'bun:test'
            import { flushSync } from '@abide/abide'
            import { mount, settled } from '@abide/harness/abide'
            import DealPicker from './DealPicker.abide'

            test('picking a deal shows it in the panel', async () => {
                using _picker = await mount(DealPicker({}))
                await settled()
                document.querySelectorAll('button')[1]?.click()
                flushSync()
                const picked = document.querySelector('strong')?.textContent
                expect(picked).toBe('Hopper & Co pilot')
            })
        `} />
    </Section>

    <Section level={3} title="Scroll to a note the moment it renders">
        <p>Flush before a layout read, so the measurement sees the row the write added.</p>
        <Code language="ts" caption="browser" code={`
            import { flushSync, reactive } from '@abide/abide'

            const notes = reactive<string[]>([])
            const list = document.querySelector('ul') as HTMLUListElement

            function addNote(note: string) {
                notes.patch((all) => all.push(note))
                flushSync()
                list.scrollTop = list.scrollHeight
            }
        `} />
    </Section>
</Doc>
