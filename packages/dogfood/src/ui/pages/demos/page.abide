<!-- The demo apps, running and priced — full use cases rather than cases.

     Everything else this site shows lives INSIDE it: a rung is a file it compiles, a case is a body it
     runs, a bench is an arm it times. These are separate applications, and the separation is the point
     rather than an implementation detail. `perf` ships no stylesheet on purpose, because one CSS rule
     was the whole of a “4.5x faster” reading once — and an app cannot ship none while being a page in
     an app that ships one. Its own shell, its own headers, its own process.

     Framed rather than linked, so the thing is on the page rather than one navigation away — and each
     frame is DRIVEN: the ops an app declares in `APPS.ts` are run against it and priced, and what comes
     back is the same `Profile` record `/tests` and `/docs` paint.

     SERVED BY THE FLEET, and the page asks rather than assuming: `fleetStatus` pings each app's own
     port from the server, because a browser asking is a cross-origin request that fails whether or not
     the app is up — and would report every demo down, most confidently when they were all running. -->
<script module>
import { memo } from 'abide'
import { APPS } from '#shared/demos/APPS.ts'
import { fleetStatus } from '#server/rpc/fleet.ts'
import Demo from '#ui/lib/Demo.abide'

/** Asked once per render. The answer is "is a local process listening", which does not need caching. */
const status = memo(() => fleetStatus({}))
</script>

<div class="page-head">
    <h1 class="page-title">demos</h1>
    <p class="page-blurb">Full use cases, each its own application, served under a prefix on this origin by <code>bun run fleet</code>. They are separate apps because of what they must NOT inherit — a stylesheet, a header, a hydration that already happened — and each one is framed here as the real document it is, then asked to do the work it exists to do.</p>
</div>

<!-- Asking about `.pending()` is what sends the shell out with the placeholder in it, rather than
     holding the whole page on a handful of localhost pings. -->
{#if status.pending()}
    <p class="note">asking which demos are up…</p>
{:else}
    {#for app of APPS}
        <Demo app={app} up={status?.up[app.name] === true}/>
    {/for}
{/if}

<p class="note">What is measured here is what each op DID — DOM calls, and a coarse wall clock. What it cost the ENGINE is <code>bun run e2e</code>’s to say: style, layout and paint are only reachable over the devtools protocol, which a page cannot speak. The card proves it works; the standalone run prices it.</p>
