<script>
import { reactive } from 'abide'
import { listInvoices } from '#server/rpc/probeDerivedInvoices'

const rows = reactive(() => listInvoices())

// Reads a value still in flight, so it is pending too rather than
// confidently answering over the nothing it got.
const unpaid = reactive(() => rows.filter((row) => !row.paid))
</script>

<ul class="fields stacked">
    <li><span>unpaid</span>
        <strong>{unpaid.ready() ? unpaid.length : 'counting…'}</strong>
    </li>
</ul>
