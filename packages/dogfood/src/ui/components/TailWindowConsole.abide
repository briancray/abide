<script>
import { token } from '#shared/tailWindowTokens'

const WORDS = ['Rotate', 'the', 'key', 'in', 'Settings', 'then', 'Keys.']

let sent = 0

function emit() {
    sent += 1
    token.publish({ at: sent, text: WORDS[sent % WORDS.length] ?? '…' })
}
</script>

<ul class="chat">
{#for line of token.history(50)}
    <li><span>{line.at}</span><p>{line.text}</p></li>
{/for}
</ul>

<button onclick={emit}>Next token</button>
