<script>
import { token } from '#shared/tailWindowTokens'

const WORDS = ['Rotate', 'the', 'key', 'in', 'Settings', 'then', 'Keys.']

let sent = 0

function emit() {
    sent += 1
    token.patch((tokens) => {
        tokens.push({ at: sent, text: WORDS[sent % WORDS.length] ?? '…' })
        if (tokens.length > 4) tokens.shift()
    })
}
</script>

<ul class="chat">
{#for line of token}
    <li><span>{line.at}</span><p>{line.text}</p></li>
{/for}
</ul>

<button onclick={emit}>Next token</button>
