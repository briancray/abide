<script>
import { reactive } from 'abide'

let volume = reactive.share('volume', () => reactive(4))

// Built out here and handed in: the call returns the winner, not this.
const built = reactive(4)
const shared = reactive.share('volume', () => built)
</script>

<ul class="grid">
    <li><span>volume</span>
        <div class="stepper">
            <button onclick={() => (volume -= 1)}>−</button>
            <strong>{volume}</strong>
            <button onclick={() => (volume += 1)}>+</button>
        </div></li>
    <li><span>what the second call returned</span><strong>{shared}</strong></li>
    <li><span>what it handed in</span><strong>{built}</strong></li>
</ul>
