    <label>email
        <input bind:value={email}>
    </label>
    <label>plan
        <select bind:value={plan}>
            <option value="monthly">Monthly</option>
            <option value="yearly">Yearly</option>
        </select>
    </label>
</div>

<ul class="fields stacked">
    <li><span>what will be saved</span><strong>{email} on {plan}</strong></li>
