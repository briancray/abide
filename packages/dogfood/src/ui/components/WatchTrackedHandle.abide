<script>
import { reactive, watch } from '@abide/abide'

let handle = reactive('ada')
let tab = reactive('')

// The tab title is not the page's to own: it follows the VALUE, not the field.
watch(() => {
    // A server has no tab to name, though the watch runs there too (12.5).
    if (typeof document === 'undefined') return
    document.title = `@${handle} — Contacts`
    tab = document.title
})
</script>

<div class="row">
    <label>handle
        <input bind:value={handle}>
    </label>
    <button onclick={() => (handle = 'ada')}>Reset</button>
</div>

<ul class="fields stacked">
    <li><span>browser tab</span><strong>{tab}</strong></li>
</ul>
