<script>
import { reactive } from '@abide/abide'
import { bookOut, getStock } from '#server/rpc/reloadArgsStock'

const east = reactive(() => getStock({ warehouse: 'east', sku: 'A-70' }))
const west = reactive(() => getStock({ warehouse: 'west', sku: 'A-70' }))

async function book() {
    await bookOut({ warehouse: 'east', sku: 'A-70' })
    // A slice of the args space, not one key and not every key.
    getStock.refresh({ warehouse: 'east' })
}
</script>

<ul class="fields stacked">
    <li><span>east on hand</span><strong>{east.onHand}</strong></li>
    <li><span>east loads</span><strong>{east.loads}</strong></li>
    <li><span>west loads</span><strong>{west.loads}</strong></li>
</ul>

<button onclick={book}>Book one out of east</button>
