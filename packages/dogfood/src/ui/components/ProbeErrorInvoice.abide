<script>
import { reactive, refresh } from 'abide'
import { getInvoice } from '#server/rpc/probeErrorInvoices'

const invoice = reactive(() => getInvoice({ id: '4021' }))
</script>

<div class="row">
    <button onclick={() => refresh(invoice)}>Retry</button>
</div>

<p class="status">{invoice.error()?.message ?? ''}</p>

<ul class="fields stacked">
    <li><span>total</span>
        <strong>{invoice.error() ? 'unavailable' : invoice.total}</strong>
    </li>
</ul>
