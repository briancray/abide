<script>
import { reactive } from 'abide'

let note = reactive('Chased <b>twice</b> — no answer')
</script>

<label>note
    <input bind:value={note}>
</label>

<ul class="fields stacked">
    <li><span>as text</span>
        <strong>{note}</strong></li>
    <li><span>as markup</span>
        <strong>{raw(note)}</strong></li>
</ul>
