<script>
import { props } from 'abide'

type Invoice = {
    number: string
    customer: string
    due: string
    lines: { item: string; amount: string }[]
    total: string
}

const { invoice } = props<{ invoice: Invoice }>()
</script>

<h1>Invoice {invoice.number}</h1>
<p>{invoice.customer} · due {invoice.due}</p>
<table>
{#for line of invoice.lines by line.item}
    <tr><td>{line.item}</td><td>{line.amount}</td></tr>
{/for}
    <tr><th>Total</th><th>{invoice.total}</th></tr>
</table>
