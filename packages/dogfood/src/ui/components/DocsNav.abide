<script>
// THE NAV, ONE MODULE FOR THE WHOLE SITE rather than markup generated into every page: it is the
// same list on all eighty-five of them, and a copy per page is that list in every route chunk a
// reader loads. `NAV_ITEMS.ts` is generated from the same front matter the pages are, so a
// page's label has one home (`scripts/buildPages.ts`).
//
// TWO ARMS RATHER THAN ONE LINK WITH A CONDITIONAL ATTRIBUTE. Whether an attribute is OMITTED
// where its expression is false is not decided anywhere in the rulebook, and what the compiler
// does today is write it empty — which `a[aria-current]` in the stylesheet matches, so every
// link in the nav rendered as the one you are on.
//
// WHERE YOU ARE COMES FROM THE ROUTE. The nav is the layout's, and a layout outlives the page it
// wraps (41.11), so a prop the page passed would be the FIRST page's for as long as the nav stands.
// The same route decides WHICH pages it lists — the guides, or the reference, or none beside an
// instrument — and the site bar above it is where a reader moves between those.
import { raw, route } from 'abide'
import { sidebarGroupsOf } from '#ui/siteSections.ts'
</script>

{#if sidebarGroupsOf(route.url().pathname).length > 0}
<nav class="sidebar">
    {#for group of sidebarGroupsOf(route.url().pathname)}
        <section>
            <h2>{group.section}</h2>
            <ul>
                {#for item of group.pages}
                    <li>{#if item.href === route.url().pathname}<a href={item.href} aria-current="page">{raw(item.nav)}</a>{:else}<a href={item.href}>{raw(item.nav)}</a>{/if}{#if item.stub}<span class="stub" title="Stub — not written yet"></span>{/if}</li>
                {/for}
            </ul>
        </section>
    {/for}
</nav>
{/if}
