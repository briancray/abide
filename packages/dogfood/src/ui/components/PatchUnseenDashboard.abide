<script>
import { reactive } from '@abide/abide'

type Region = { id: string; name: string; orders: number }
type OrderCount = { id: string; orders: number }

const byId = reactive(
    new Map<string, Region>([
        ['north', { id: 'north', name: 'North', orders: 120 }],
        ['south', { id: 'south', name: 'South', orders: 80 }],
        ['east', { id: 'east', name: 'East', orders: 64 }],
        ['west', { id: 'west', name: 'West', orders: 91 }],
    ]),
)

const rows = reactive(() => [...byId.values()])

const FEED: OrderCount[] = [
    { id: 'south', orders: 95 },
    { id: 'north', orders: 130 },
    { id: 'west', orders: 88 },
    { id: 'east', orders: 71 },
]

function applyOrderCount(index: Map<string, Region>, frame: OrderCount) {
    const region = index.get(frame.id)
    if (region) region.orders = frame.orders
}

function applyNextFrame() {
    const frame = FEED.shift()
    if (!frame) return
    FEED.push(frame)
    byId.patch((held) => applyOrderCount(held, frame))
}

/** The same map and the same fold, reached without `patch`. */
function applyNextFrameWithoutPatch() {
    const frame = FEED.shift()
    if (!frame) return
    FEED.push(frame)
    applyOrderCount(byId, frame)
}
</script>

<ul class="fields stacked">
{#for region of rows by region.id}
    <li><span>{region.name}</span><strong>{region.orders}</strong></li>
{/for}
</ul>

<div class="row">
    <button onclick={applyNextFrame}>Apply next frame</button>
    <button onclick={applyNextFrameWithoutPatch}>Apply without patch</button>
</div>
