<script>
import { reactive } from '@abide/abide'
import { countOrders } from '#server/rpc/capDebounceMetrics'

let region = reactive('north')

// The cap goes on the value that pays for it, and no markup moved.
const orders = reactive(() => countOrders({ region }), { debounce: 400 })
const updating = reactive(() => orders.busy() && orders.ready())
</script>

<div class="row">
    <label>region
        <input bind:value={region}>
    </label>
    <span class="status">{updating ? 'updating…' : ''}</span>
</div>

<ul class="fields stacked">
    <li><span>orders</span>
        <strong>{orders.ready() ? orders : '—'}</strong>
    </li>
</ul>
