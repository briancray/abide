<script>
import { reactive } from '@abide/abide'
import { searchContacts } from '#server/rpc/search'

let query = reactive('a')

const matches = reactive(() => searchContacts({ query }))
</script>

<div class="row">
    <label>search
        <input bind:value={query}>
    </label>
    <span class="status">{matches.busy() ? 'searching…' : ''}</span>
</div>

<ul>
{#for one of matches}
    <li>{one}</li>
{/for}
</ul>
