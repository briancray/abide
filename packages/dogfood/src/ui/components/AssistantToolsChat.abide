<script>
import { reactive } from '@abide/abide'
import { ask } from '#server/rpc/assistantToolsSupport'

const QUESTION = 'Is invoice INV-4021 paid?'

let asked = reactive(false)
const events = reactive(() =>
    asked ? ask({ messages: [{ role: 'user', content: QUESTION }] }) : [],
)
</script>

<ul class="chat">
    <li data-speaker="you"><span>you</span><p>{QUESTION}</p></li>
{#for event of events}
    {#if event.type === 'tool'}
        <li><span>tool call</span>
            <p class="font-mono text-chrome">
                {event.name} {JSON.stringify(event.input)}
            </p></li>
    {:else if event.type === 'result'}
        <li><span>your handler answered</span>
            <p class="font-mono text-chrome">{event.text}</p></li>
    {:else if event.type === 'text'}
        <li><span>assistant</span><p>{event.text}</p></li>
    {/if}
{/for}
</ul>

<div class="row">
    <button disabled={asked} onclick={() => { asked = true }}>Ask</button>
    <span class="status">{events.at(-1)?.type === 'done' ? 'done' : ''}</span>
</div>
