<script>
import { reactive } from 'abide'
import { ping } from '#server/rpc/middlewareStampPing'

let servedBy = reactive('—')
</script>

<div class="row">
    <button onclick={async () => {
        const answer = await ping.raw()
        servedBy = answer.headers.get('x-served-by') ?? 'no header'
    }}>Ask the app</button>
</div>

<ul class="fields">
    <li><span>served by</span><strong>{servedBy}</strong></li>
</ul>
