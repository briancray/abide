<script>
import { reactive } from 'abide'

let rate = reactive('1.09')

/** Called from the markup, so a throw here fails the render. */
function convert(typed: string) {
    const value = Number(typed)
    if (!(value > 0)) throw new Error('Rate must be a positive number.')
    return (1240 * value).toFixed(2)
}
</script>

<label>rate
    <input bind:value={rate}>
</label>

{#try}
    <ul class="fields">
        <li><span>invoice</span><strong>#4310</strong></li>
        <li><span>converted</span><strong>${convert(rate)}</strong></li>
    </ul>
{:catch problem}
    <p class="status">{problem.message}</p>
{/try}
