<script>
import { reactive } from 'abide'
import { getInvoice } from '#server/rpc/refuseNarrowedInvoices'

const ON_ACCOUNT = ['4310', '4311', '4312']

let id = reactive('4310')

const invoice = reactive(() => getInvoice({ id }))

/** What the refusal says, matched by the name it was refused under. */
function refusal() {
    const failed = invoice.error()
    if (invoice.isError(failed, 'NotYours'))
        return `Owned by ${failed.data.owner}.`
    if (invoice.isError(failed, 'Superseded'))
        return `Replaced by #${failed.data.replacedBy}.`
    return ''
}
</script>

<div class="tabs">
{#for one of ON_ACCOUNT}
    <button aria-selected={id === one}
        onclick={() => { id = one }}>{one}</button>
{/for}
</div>

<p class="status">{refusal()}</p>

<ul class="fields">
    <li><span>total</span>
        <strong>{invoice.error() ? '—' : invoice.total}</strong></li>
</ul>
