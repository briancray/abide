<script>
import { reactive } from '@abide/abide'
import { payInvoice } from '#server/rpc/writeCoalescedInvoices'

let paid = reactive()
</script>

<div class="row">
    <button onclick={() => { paid = payInvoice({ id: '4310' }) }}>Pay</button>
</div>

<p class="status">{paid.busy() ? 'paying…' : ''}</p>

<ul class="fields">
    <li><span>payments</span>
        <strong>{paid.ready() ? paid : '—'}</strong></li>
</ul>
