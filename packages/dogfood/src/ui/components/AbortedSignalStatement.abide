<script>
import { aborted, reactive } from '@abide/abide'
import { getStatement } from '#server/rpc/abortedSignalStatements'

let stop = new AbortController()
let asked = reactive(0)

const statement = reactive(() =>
    asked > 0 ? getStatement({ id: '4021' }, { signal: stop.signal }) : null,
)

function load() {
    stop = new AbortController()
    asked += 1
}
</script>

<div class="row">
    <button onclick={load}>Load statement</button>
    <button disabled={!statement.busy()} onclick={() => stop.abort()}>
        Cancel</button>
    <span class="status">{statement.busy() ? 'loading…' : ''}</span>
</div>

<ul class="fields">
    <li><span>statement</span>
        <strong>{aborted.is(statement.error()) ? 'cancelled'
            : statement?.total ?? '—'}</strong></li>
</ul>
