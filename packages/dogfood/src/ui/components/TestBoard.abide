<script>
// EVERY TEST FILE, RUN FROM THE PAGE — one file per process, so a row lands when its own file
// finishes (`harness/scripts/testRows.ts`). The bench board's shape, for the bench board's
// reasons: one value holds the rows and a run patches into it as each lands.
import { reactive } from 'abide'
import { matchesFilter, type RowItem, type TestCase, type TestRow } from 'harness/rows'
import { runTests, testCatalog } from '#server/rpc/tests'
import { messageOf } from '#ui/messageOf.ts'
import { readRows } from '#ui/readRows.ts'
import { ROW_STATES } from '#ui/ROW_STATES.ts'

type Section = { name: string; items: RowItem[] }

let filter = reactive('')
// 44.9 — every `gate()` also runs the broken arm it names and asserts it fails.
let gates = reactive(false)
const catalog = reactive(() => testCatalog())
const landed = reactive(new Map<string, TestRow>())
let running = reactive(false)
let failure = reactive('')
let stopping: AbortController | undefined

// THE CATALOG'S OWN ITEMS, grouped — and NOT the readings, for the bench board's reason: a keyed
// list remakes a row whose item is a new object, so the readings are looked up by each row's slots.
const sections = reactive(() => {
    const grouped: Section[] = []
    for (const item of catalog) {
        if (!matchesFilter(item, filter)) continue
        let section = grouped[grouped.length - 1]
        if (section === undefined || section.name !== item.section) {
            section = { name: item.section, items: [] }
            grouped.push(section)
        }
        section.items.push(item)
    }
    return grouped
})

function failingIn(items: RowItem[]): number {
    let failing = 0
    for (const item of items) {
        const row = landed.get(item.id)
        if (row !== undefined && (row.failures > 0 || row.state === 'broken')) failing += 1
    }
    return failing
}

const tally = reactive(() => {
    let shown = 0
    let failing = 0
    for (const section of sections) {
        shown += section.items.length
        failing += failingIn(section.items)
    }
    return { shown, failing }
})

/**
 * A test file's row cells, as text and tone.
 *
 * Read from `landed` inside the row's own slots — so a file finishing rewrites the slots of its
 * own row and no other.
 */
function cellsOf(item: RowItem) {
    const row = landed.get(item.id)
    if (row === undefined || row.state !== 'done') {
        const state = ROW_STATES[row?.state ?? 'none']
        return { passing: state.label, passingTone: state.tone, skipped: '', time: '—', timeTone: 'text-muted' }
    }
    return {
        passing: `${row.tests - row.failures - row.skipped}/${row.tests - row.skipped}`,
        passingTone: row.failures > 0 ? 'text-bad' : 'text-good',
        skipped: row.skipped > 0 ? String(row.skipped) : '',
        time: seconds(row),
        timeTone: '',
    }
}

async function start(scope: string) {
    running = true
    failure = ''
    stopping = new AbortController()
    try {
        await readRows<TestRow>(
            await runTests.raw({ scope, filter, gates }, { signal: stopping.signal }),
            (row) => landed.patch((map) => map.set(row.id, row)),
        )
    } catch (error) {
        if (!stopping.signal.aborted) failure = messageOf(error)
    }
    // A row a stopped run only queued or started has no reading, so it goes back to having none.
    landed.patch((map) => {
        for (const [id, row] of map)
            if (row.state === 'queued' || row.state === 'running') map.delete(id)
    })
    running = false
}

function stop() {
    stopping?.abort()
}

/** One test's line: a mark, and its tone, for how it came out. */
function markOf(one: TestCase): { mark: string; tone: string } {
    if (one.failure !== null) return { mark: '✗', tone: 'text-bad' }
    if (one.skipped) return { mark: '–', tone: 'text-muted' }
    return { mark: '✓', tone: 'text-good' }
}

function caseTime(one: TestCase): string {
    return one.skipped ? '' : `${one.milliseconds.toFixed(one.milliseconds < 10 ? 1 : 0)} ms`
}

function seconds(row: TestRow): string {
    return `${(row.milliseconds / 1000).toFixed(row.milliseconds < 10_000 ? 2 : 1)} s`
}
</script>

<main id="content" class="col-span-full mx-auto w-full max-w-320 gap-section">
    <header>
        <h1>Tests</h1>
        <p class="max-w-170 text-title/8 text-muted">Every test file in the repo, and every browser spec, one file to a process. Unit files run eight at a time; browser specs one at a time, because they share one app server.</p>
    </header>

    <div class="sticky top-bar z-1 flex flex-wrap items-center gap-snug border-b border-rule bg-paper py-3">
        <input type="search" class="min-w-60 flex-1" placeholder="Filter test files" aria-label="Filter test files" bind:value={filter}>
        <label class="text-chrome/4 text-muted"><input type="checkbox" bind:checked={gates}> Run gate reverts</label>
        {#if running}
            <button onclick={stop}>Stop</button>
        {:else}
            <button onclick={() => start('all')}>{filter.trim() === '' ? 'Run all' : `Run ${tally.shown} shown`}</button>
        {/if}
        <span class={`font-mono text-chrome/4 font-medium ${failure !== '' || tally.failing > 0 ? 'text-bad' : 'text-muted'}`}>{failure !== '' ? failure : running ? 'running…' : tally.failing > 0 ? `${tally.failing} failing` : `${tally.shown} files`}</span>
    </div>

    {#if catalog.error()}
        <p class="text-bad">{messageOf(catalog.error())}</p>
    {:else if catalog.ready()}
        {#for section of sections by section.name}
            <section class="gap-snug">
                <div class="flex items-baseline gap-snug">
                    <h2 class="mr-auto">{section.name}</h2>
                    <span class={`font-mono text-chrome/4 font-medium ${failingIn(section.items) > 0 ? 'text-bad' : 'text-muted'}`}>{failingIn(section.items) > 0 ? `${failingIn(section.items)} of ${section.items.length} failing` : section.items.length}</span>
                    <button class="border border-rule bg-transparent px-2 py-1 font-mono text-chrome/4 font-medium text-muted enabled:hover:border-signal enabled:hover:text-signal" onclick={() => start(`section:${section.name}`)} disabled={running}>Run section</button>
                </div>
                <table class="[&_td]:py-2 [&_td]:pr-4 [&_td]:pl-0 [&_td]:align-baseline [&_td]:text-chrome/5 [&_th]:py-2 [&_th]:pr-4 [&_th]:pl-0 [&_th]:align-baseline">
                    <thead>
                        <tr><th>File</th><th class="text-right whitespace-nowrap font-mono tabular-nums">Passing</th><th class="text-right whitespace-nowrap font-mono tabular-nums">Skipped</th><th class="text-right whitespace-nowrap font-mono tabular-nums">Time</th><th></th></tr>
                    </thead>
                    <tbody>
                        {#for item of section.items by item.id}
                            <tr class="group">
                                <td>
                                    {#if landed.get(item.id)?.state === 'broken'}
                                        {item.name}
                                        <span class="block text-bad">{landed.get(item.id)?.note}</span>
                                    {:else if (landed.get(item.id)?.cases.length ?? 0) > 0}
                                        <details class="mt-1" open={(landed.get(item.id)?.failures ?? 0) > 0}>
                                            <summary class="cursor-pointer" class:text-bad={(landed.get(item.id)?.failures ?? 0) > 0}>{item.name}</summary>
                                            <ul class="mt-2 mb-1 grid list-none grid-cols-[1rem_minmax(0,1fr)_auto] gap-x-2 p-0">
                                                {#for one of landed.get(item.id)?.cases ?? []}
                                                    <li class="contents">
                                                        <span class={markOf(one).tone}>{markOf(one).mark}</span>
                                                        <span class:text-muted={one.skipped}>{one.name}</span>
                                                        <span class="text-right whitespace-nowrap font-mono tabular-nums">{caseTime(one)}</span>
                                                        {#if one.failure !== null}<pre class="col-[2/-1] mt-1 mb-2 whitespace-pre-wrap text-bad">{one.failure}</pre>{/if}
                                                    </li>
                                                {/for}
                                            </ul>
                                        </details>
                                    {:else}
                                        {item.name}
                                    {/if}
                                </td>
                                <td class={`text-right whitespace-nowrap font-mono tabular-nums ${cellsOf(item).passingTone}`}>{cellsOf(item).passing}</td>
                                <td class="text-right whitespace-nowrap font-mono tabular-nums">{cellsOf(item).skipped}</td>
                                <td class={`text-right whitespace-nowrap font-mono tabular-nums ${cellsOf(item).timeTone}`}>{cellsOf(item).time}</td>
                                <td class="text-right whitespace-nowrap font-mono tabular-nums"><button class="border border-rule bg-transparent px-2 py-1 font-mono text-chrome/4 font-medium text-muted enabled:hover:border-signal enabled:hover:text-signal opacity-50 transition-opacity duration-120 ease-[ease] group-hover:opacity-100 focus-visible:opacity-100" onclick={() => start(`item:${item.id}`)} disabled={running}>Run</button></td>
                            </tr>
                        {/for}
                    </tbody>
                </table>
            </section>
        {/for}
    {:else}
        <p class="font-mono text-chrome/4 font-medium text-muted">Listing the test files…</p>
    {/if}
</main>
