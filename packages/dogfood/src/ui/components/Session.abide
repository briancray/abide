<script>
import { principal, reactive } from '@abide/abide'
import { signIn, signOut } from '#server/rpc/principalSessionSession'

let email = reactive('ada@example.com')
</script>

<div class="row">
    <label>email
        <input bind:value={email}>
    </label>
    <button onclick={() => {
        if (principal.authenticated()) signOut()
        else signIn({ email })
    }}>{principal.authenticated() ? 'Sign out' : 'Sign in'}</button>
</div>
