<script>
import { reactive } from 'abide'
import { getContact } from '#server/rpc/oneTypeContacts'

let draft = reactive('')

const words = reactive(() => (draft ? draft.split(' ').length : 0))
const contact = reactive(() => getContact({ id: '1' }))
const notes = reactive<{ text: string }>()
</script>

<ul class="fields">
    <li><span>owned</span>
        <strong>{draft.ready() ? (draft || '—') : '…'}</strong></li>
    <li><span>derived</span>
        <strong>{words.ready() ? words : '…'}</strong></li>
    <li><span>loaded</span>
        <strong>{contact.ready() ? contact.name : '…'}</strong></li>
    <li><span>pushed</span>
        <strong>{notes.ready() ? notes.text : '…'}</strong></li>
</ul>

<div class="row">
    <label>note
        <input bind:value={draft}>
    </label>
    <button onclick={() => {
        notes.publish({ text: draft })
        draft = ''
    }}>Add</button>
</div>
