<script>
// THE BAR OVER EVERY PAGE, the layout's like the sidebar under it — so where you are comes from
// the route for the same reason: a layout outlives the page it wraps (41.11) — the route's literal,
// and every link through `url`, for the reason `DocsNav` gives.
//
// `aria-current="true"` rather than `"page"`: a tab marks the PLACE you are in, and the sidebar's
// link is the page — two `"page"` marks on one document would each claim the same thing.
import { route, url } from '@abide/abide'
//
// SPANS EVERY COLUMN of the body grid, and its own two are the sidebar's and the reading column's,
// so the brand sits over the nav and the tabs start where a page's title does. Sticky, which is why
// the sidebar and the rail stop at `bar` rather than at the top of the viewport.
//
// A TAB'S UNDERLINE SITS ON THE BAR'S OWN RULE, so where you are reads as the bar opening onto the
// page under it: `-mb-px` sets the 2px line over the 1px border rather than above it.
//
// `site` and `brand` carry no rule — they are what `e2e/dev.spec.ts` finds the bar by, and it
// edits the brand's markup as written, which is why its span is styled from the link.
import { SITE_TABS, tabOf } from '#ui/siteSections.ts'

const TAB =
    '-mb-px flex items-center border-b-2 font-medium text-chrome/4 whitespace-nowrap no-underline transition-[color,border-color] duration-120 ease-[ease]'
</script>

<header class="site sticky top-0 z-1 col-span-full grid h-bar grid-cols-[15.5rem_minmax(0,1fr)] border-b border-rule bg-paper max-lg:grid-cols-[auto_minmax(0,1fr)]">
    <a class="brand flex items-baseline gap-tight self-center px-4 font-display text-title/5 font-bold tracking-display text-ink no-underline *:font-mono *:text-micro/2 *:font-medium *:tracking-brand *:text-muted *:uppercase" href={url('/')}>abide<span>docs</span></a>
    <nav class="flex gap-flow overflow-x-auto px-10 max-lg:px-5" aria-label="Site">
        {#for tab of SITE_TABS}
            {#if tab.href === tabOf(route.name())}<a class="{TAB} border-signal text-ink" href={url(tab.href)} aria-current="true">{tab.label}</a>{:else}<a class="{TAB} border-transparent text-muted hover:text-ink" href={url(tab.href)}>{tab.label}</a>{/if}
        {/for}
    </nav>
</header>
