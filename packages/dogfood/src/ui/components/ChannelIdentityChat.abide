<script>
import { reactive } from 'abide'
import { onboarding } from '#shared/channelIdentityConversations'

let draft = reactive('Resend me the key rotation steps.')
let cursor = reactive(0)

function send() {
    cursor = onboarding.publish({ speaker: 'you', text: draft })
}
</script>

<ul class="fields stacked">
    <li><span>resume from</span><strong>{cursor}</strong></li>
    <li><span>last turn</span>
        <strong>
            {onboarding ? onboarding.text : 'nothing sent yet'}
        </strong>
    </li>
</ul>

<div class="row">
    <label>message
        <input bind:value={draft}>
    </label>
    <button onclick={send}>Send</button>
</div>
