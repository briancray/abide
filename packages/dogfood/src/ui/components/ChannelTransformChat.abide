<script>
import { reactive } from 'abide'
import { onboarding } from '#shared/channelTransformConversations'
import { tooLong } from '#shared/channelTransformFailures'

let refusal = reactive('')
let draft = reactive(
    'Walk me through rotating an API key, revoking the old one, and ' +
        'updating each of the three services that still hold it today.',
)

function send() {
    const answer = onboarding.publish({ speaker: 'you', text: draft })
    if (!tooLong.is(answer)) {
        refusal = ''
        return
    }
    refusal = `${answer.name} at ${answer.data.length} characters`
}
</script>

<ul class="fields stacked">
    <li><span>last sent</span>
        <strong>
            {onboarding ? onboarding.text : 'nothing sent yet'}
        </strong>
    </li>
</ul>

<div class="row">
    <label>message
        <input bind:value={draft}>
    </label>
    <button onclick={send}>Send</button>
</div>
<p class="status">{refusal}</p>
