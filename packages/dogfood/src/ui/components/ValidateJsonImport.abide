<script>
import { reactive, validateJson } from 'abide'

const CONTACT = {
    type: 'object',
    required: ['name', 'plan', 'seats'],
    properties: {
        name: { type: 'string', minLength: 1 },
        plan: { enum: ['starter', 'team', 'enterprise'] },
        seats: { type: 'integer', minimum: 1, maximum: 50 },
    },
}

let pasted = reactive('{ "name": "Ada Lovelace", "plan": "pro", "seats": 80 }')

// Text that is not JSON is checked as the string it is.
function parse(text: string): unknown {
    try {
        return JSON.parse(text)
    } catch {
        return text
    }
}

type Contact = { name: string; plan: string; seats: number }

const issues = reactive(() => validateJson<Contact>(CONTACT, parse(pasted)))
</script>

<label class="w-full">pasted row
    <textarea class="font-mono" rows="2" bind:value={pasted}></textarea>
</label>

<ul class="fields">
{#if issues}
    {#for [path, messages] of Object.entries(issues)}
        <li><span>{path || 'the row'}</span>
            <strong>{messages?.[0]}</strong></li>
    {/for}
{:else}
    <li><span>import</span><strong>ready</strong></li>
{/if}
</ul>
