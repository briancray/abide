<script>
import { reactive, watch } from '@abide/abide'

let notes = reactive('Called Tuesday.')
let owner = reactive('ada')
let audited = reactive('')

// Reads both, wakes on one: `sources` REPLACES the tracking.
watch([owner], () => {
    audited = `${owner} — ${notes.length} characters of notes`
})
</script>

<div class="row">
    <label>notes
        <input bind:value={notes}>
    </label>
    <label>owner
        <select bind:value={owner}>
            <option value="ada">ada</option>
            <option value="grace">grace</option>
        </select>
    </label>
</div>

<ul class="fields stacked">
    <li><span>last audit line</span><strong>{audited}</strong></li>
</ul>
