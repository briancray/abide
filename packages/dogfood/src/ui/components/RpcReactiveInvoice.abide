<script>
import { reactive, refresh } from '@abide/abide'
import { getInvoice } from '#server/rpc/rpcReactiveInvoices'

// The call hands back a `Reactive`, so probes and triggers are on the RESULT.
const invoice = reactive(() => getInvoice({ id: '4021' }))
const reloading = reactive(() => invoice.busy() && invoice.ready())
</script>

<ul class="fields stacked">
    <li><span>total</span><strong>{invoice.total}</strong></li>
</ul>

<div class="row">
    <button disabled={!invoice.ready()}>Send a reminder</button>
    <button onclick={() => refresh(invoice)}>Reload</button>
    <span class="status">{reloading ? 'reloading…' : ''}</span>
</div>
