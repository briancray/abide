<!-- Source, painted. The one place a `<pre>` of code is written.

     Two callers with two different questions behind them: the reference shows a WHOLE file, which the
     loader inlined at import; a case's pane shows a SLICE of one, which an rpc cut out and sent. What
     they share is everything after the text arrives, which is this.

     An unpainted run is text, not a `<span class="">` — whitespace and punctuation are a third of a
     body, and a wrapper carrying no class is an element per run for nothing. -->
<script module>
import { painted } from './code.ts'
</script>

<script>
import { props } from 'abide'

const { source } = props<{ source: string }>()
</script>

<!-- No `class` prop: the frame around a `<pre>` is the CALLER's, and a component that takes a class
     string is a styling seam with two owners. -->
<pre class="code">{#for span of painted(source)}{#if span.class}<span class={span.class}>{span.text}</span>{:else}{span.text}{/if}{/for}</pre>
