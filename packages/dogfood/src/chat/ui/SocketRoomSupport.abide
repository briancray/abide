<script>
import { cookies, reactive } from '@abide/abide'
import { room, say } from '#server/rpc/socketRoomSupport'

// This browser's room, by an id in a cookie every tab of it sends.
const id = cookies().get('room') ?? crypto.randomUUID()
cookies().set('room', id)
const turns = reactive(() => room({ id }))
const last = reactive(() => turns.at(-1))
const draft = reactive('Is invoice 4021 paid yet?')
</script>

<ul class="chat">
    <li data-speaker={last?.speaker}>
        <span>{last?.speaker ?? 'connecting'}</span>
        <p>{last?.text ?? '…'}</p>
    </li>
</ul>

<div class="row">
    <label>message
        <input bind:value={draft}>
    </label>
    <button onclick={() => say({ id, text: draft })}>Send</button>
</div>
