<script>
import { url } from '@abide/abide'

import Code from '#src/lib/Code.abide'
import Doc from '#src/lib/Doc.abide'
import Section from '#src/lib/Section.abide'
</script>

<Doc
    seeAlso={['/app/on-launcher', '/native-app/native', '/cli/commands']}
    tests={[
        {
            path: 'packages/dogfood/examples/crm/src/reports/lib/UpdateNotice.test.ts',
            from: [
                "test('an update waits for quit, and a required one for nothing'",
            ],
        },
        {
            path: 'packages/abide/tests/pendingUpdate.test.ts',
            from: ["test('install asks the window to restart into the update"],
        },
    ]}
>
    <Section level={3} title="Tell people an update installs when they quit">
        <p>The value is <code>undefined</code> until the window stages an update, and always in a
            browser. <code>install()</code> restarts into it now.</p>
        <Code language="abide" caption="abide" code={`
            <script>
            import { pendingUpdate } from '@abide/abide'
            </script>

            {#if pendingUpdate}
                <p class="status">
                    CRM {pendingUpdate.version} installs when you quit.
                    <button onclick={() => pendingUpdate?.install()}>Restart now</button>
                </p>
            {/if}
        `} />
    </Section>

    <Section level={3} title="Block the CRM until a required update is installed">
        <p>An update bundled with <code>--required</code> reads <code>required: true</code>.
            Spread a <a href={url('/headless/dialog')}><code>dialog</code></a> that is not
            <code>dismissible</code>: it opens modal, so the CRM behind it takes no press, and
            Escape cannot close it.</p>
        <Code language="abide" caption="abide" code={`
            <script>
            import { dialog, pendingUpdate, reactive } from '@abide/abide'

            const required = dialog({
                open: reactive(() => pendingUpdate?.required === true),
                dismissible: false,
            })
            </script>

            <dialog {...required.dialog}>
                <p>CRM {pendingUpdate?.version} has to be installed to go on.</p>
                <p>{pendingUpdate?.notes}</p>
                <button onclick={() => pendingUpdate?.install()}>Restart now</button>
            </dialog>
        `} />
    </Section>
</Doc>
