<script>
import Code from '#src/lib/Code.abide'
import Doc from '#src/lib/Doc.abide'
import Section from '#src/lib/Section.abide'
</script>

<Doc
    seeAlso={['/native-app/on-menu', '/reactive/watch', '/native-app/native']}
    tests={[
        {
            path: 'packages/abide/tests/onMenu.test.ts',
            from: [
                "test('a mount tells the window once, its menus outermost first",
            ],
        },
        {
            path: 'packages/abide/tests/launcher.test.ts',
            from: [
                "test('a menu named for the app grows the application menu below About",
            ],
        },
    ]}
>
    <Section level={3} title="Print the report from the menu bar">
        <p><code>menuItem</code> makes an entry the page answers. <code>on</code> files what
            runs when it is picked and returns what stops it, which is what
            <code>watch</code> takes.</p>
        <Code language="abide" caption="abide" code={`
            <script>
            import { menuItem, onMenu, watch } from '@abide/abide'

            const printReport = menuItem({ label: 'Print Report…', key: 'cmd+p' })

            onMenu(() => [{ label: 'Reports', items: [printReport] }])
            watch(() => printReport.on(() => print()))
            </script>
        `} />
    </Section>

    <Section level={3} title="Let the platform perform reload and full screen">
        <p>An item with a <code>role</code> needs no code of yours: the platform performs
            it. <code>'separator'</code> draws a line between items.</p>
        <Code language="abide" caption="abide" code={`
            <script>
            import { onMenu } from '@abide/abide'

            onMenu(() => [
                {
                    label: 'View',
                    items: [
                        { label: 'Reload', role: 'reload', key: 'cmd+r' },
                        'separator',
                        { label: 'Enter Full Screen', role: 'fullscreen' },
                    ],
                },
            ])
            </script>
        `} />
    </Section>
</Doc>
