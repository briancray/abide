<script>
import { reactive } from '@abide/abide'

const stages = ['lead', 'qualified', 'proposal', 'won']
let at = reactive(0)

function advance() {
    at = (at + 1) % stages.length
}
</script>

<ul class="fields">
    <li><span>Hopper &amp; Co</span><strong>{stages[at]}</strong>
        <button onclick={advance}>Advance</button></li>
</ul>
