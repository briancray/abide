<script>
import { raw, reactive, type RouteLiteral, url } from '@abide/abide'

import Doc from '#src/lib/Doc.abide'
import { inline, slugify } from '#src/lib/inline.ts'
import { REFERENCE } from '#src/lib/REFERENCE.ts'
import { sidebarGroupsOf } from '#src/lib/siteSections.ts'

// Where each export's page imports it from.
const ENTRY = new Map<string, string>()
for (const page of REFERENCE)
    if (page.entry !== undefined) ENTRY.set(page.route, `\`${page.entry}\``)
// Every group the reference nav lists, save the overview this is and the documents after the pages.
const groups = sidebarGroupsOf('/reference').filter(
    (group) => group.section !== 'Reference' && group.section !== 'Documents',
)

// The rail's headings, filed here: a `<Section>` per group would file each from inside the loop,
// after `<Doc>` has decided whether there is a rail (as `lib/Reference.abide` does).
const headings = reactive.share('docHeadings', () =>
    reactive<{ id: string; title: string; level: number }[]>([]),
)
headings = groups.map((group) => ({
    id: slugify(group.section),
    title: group.section,
    level: 2,
}))
</script>

<Doc>
    <p>Arrive here knowing which name you want. Each page is read off the registry: the name's
        signature, what it is, the rules that govern it, its members and options, and the guide that
        teaches it. What an app writes in place rather than imports, such as template syntax, files and
        commands, has one page per area.</p>

    {#for group of groups}
        <section><div class="flow">
                <h2 id={slugify(group.section)}>{group.section}</h2>
                <table>
                    <thead><tr><th>Page</th><th>Imported from</th></tr></thead>
                    <tbody>
                        {#for page of group.pages}
                            <tr>
                                <td><a href={url(page.route as RouteLiteral)}>{raw(inline(page.nav))}</a></td>
                                <td>{raw(inline(ENTRY.get(page.route) ?? 'written in place'))}</td>
                            </tr>
                        {/for}
                    </tbody>
                </table>
            </div></section>
    {/for}
</Doc>
