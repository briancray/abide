<script>
// RULEBOOK.md, served as the docs app builds: the file is the page's text, so the page cannot hold
// a clause the file does not (40.34). It is a document rather than a guide, so it is not in `SITE`
// and none of the voice gates read it — every clause carries a requirement keyword by design.
import { raw, reactive } from '@abide/abide'

import Doc from '#src/lib/Doc.abide'

import RULEBOOK from '../../../../docs/RULEBOOK.md' with { type: 'text' }
import { rulebookOf } from './lib/rulebookOf.ts'

const { summary, html, headings: filed } = rulebookOf(RULEBOOK)

// The rail's headings, filed here: they are read off the file, not written as a `<Section>` each.
const headings = reactive.share('docHeadings', () => reactive([]))
headings = filed
</script>

<Doc documentPage={{
    route: '/rulebook',
    title: 'Rulebook',
    nav: 'Rulebook',
    intent: summary,
    lead: '',
}}>
    {raw(html)}
</Doc>
