<script>
import { props, type State } from 'abide'
import type { Media } from './media.ts'
import Progress from './Progress.abide'

// `details` is declared as a CELL, not a boolean: a prop is recognised as reactive at the binding
// from its type in `T`, so `details?: boolean` would have taken a value read once at construction
// and every later toggle would have changed nothing — silently, with the right output on screen.
const { media, details } = props<{ media: Media; details: State<boolean> }>()
</script>

<!-- Modelled on ~/code/media's `MediaPoster`: a nested component, a slot, and the branch chain its
     details block actually has. The census that motivated this page counts {#if} at 184 uses against
     {#for}'s 57, so a realistic row is mostly conditionals. -->
<div class="poster {media.matched ? '' : 'unmatched'}">
    <div class="frame">
        <span class="title">{media.title}</span>
        {#if media.available}
            <Progress media={media}/>
        {/if}
    </div>
    {#if details}
        <div class="details">
            <slot/>
            {#if media.type === 'series'}
                <span>{media.releaseYear} &bull; {media.seasonCount}</span>
                <span>{media.seasonCount === 1 ? 'season' : 'seasons'}</span>
                {#if media.status === 'upcoming'}
                    <em>unreleased</em>
                {:else if !media.matched}
                    <em>missing</em>
                {/if}
            {:else if media.type === 'season'}
                <span>{media.releaseYear} &bull; {media.episodeCount}</span>
                <span>{media.episodeCount === 1 ? 'episode' : 'episodes'}</span>
                {#if media.status === 'upcoming'}
                    <em>unreleased</em>
                {/if}
            {:else}
                <span>{media.releaseYear}</span>
                {#if !media.matched}
                    <em>missing</em>
                {/if}
            {/if}
        </div>
    {/if}
</div>
