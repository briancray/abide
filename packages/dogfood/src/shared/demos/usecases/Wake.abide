<script>
import { state } from 'abide'
import { profileWakePath, type Arm } from './wake.ts'

// Not run on load: the arms build four thousand-row structures and the page would be measuring its
// own startup. The harness clicks the button, then reads `#wake-out`.
let arms = state<Arm[]>([])
let floor = state(0)

async function run(attached: boolean): Promise<void> {
    try {
        const result = await profileWakePath(attached)
        floor = result.arms[0]?.ms ?? 0
        arms = result.arms
    } catch (error) {
        // Surfaced onto the page rather than only into the console: the profile is driven headlessly,
        // and a throw that reaches devtools alone reads from outside as "it produced nothing".
        ;(globalThis as unknown as Record<string, unknown>).__wakeError = String(error)
        throw error
    }
}
</script>

<button id="wake-run" onclick={() => run(false)}>profile (detached)</button>
<button id="wake-run-live" onclick={() => run(true)}>profile (in the document)</button>

<table>
    <tbody id="wake-out">
        {#for arm of arms by arm.label}
            <tr>
                <td>{arm.label}</td>
                <td class="col-id">{arm.ms.toFixed(3)} ms</td>
                <td class="col-id">{floor === 0 ? '' : `${(arm.ms / floor).toFixed(2)}x`}</td>
                <td>{arm.through}</td>
            </tr>
        {/for}
    </tbody>
</table>
