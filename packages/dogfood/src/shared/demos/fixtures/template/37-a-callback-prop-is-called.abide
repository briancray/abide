<script>
import { props } from 'abide'

// A FUNCTION member is a callback, and it is handed over as written rather than read: `onpick(…)`
// calls it. That is one of exactly two exceptions to "every prop is a cell", and it is recognised from
// the member's own TEXT — `onpick: (t: string) => void` — because the emit has no type-checker.
//
// A function reached through a NAME cannot be recognised, and that is the one hole this has: a props
// type declared as `{ onpick: Handler }` reads `Handler` as data, so write the signature inline.
//
// The rename below is ordinary TypeScript and means what it means anywhere else, as do the default and
// a rest element.
const { label: text = 'pick me', onpick } = props<{
    label?: string
    onpick?: (chosen: string) => void
}>()
</script>

<button onclick={() => onpick?.(text)}>{text}</button>
