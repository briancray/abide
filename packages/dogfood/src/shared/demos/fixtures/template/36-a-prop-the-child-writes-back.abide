<script>
import { props } from 'abide'

// EVERY prop is a state, so the type names the VALUE — `note: State<string>` is a compile error, and
// the message says to write this instead. The declaration used to claim it was what let the child
// write back; it never was, and both spellings emitted the same file.
//
// Whether this component's write REACHES the parent is not this file's decision at all. It is the
// parent's spelling, next door.
const { note, count = 0 } = props<{ note: string; count?: number }>()
</script>

<!-- `note` is a state like every other prop, so this input edits it. WHOSE state it is decides
     whether the edit leaves this component. `count` is a default lifted onto the state rather than
     left in the pattern — a caller that omitted it would otherwise satisfy the default with a value
     and never see it again. -->
<input bind:value={note} />
<p>{note} · seen {count} times</p>
