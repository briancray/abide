<script>
import { state } from 'abide'

const name = state('ada')
const level = state(0)
</script>

<!-- `{:else if}` is a CHAIN and not a nested block, so the arms are siblings and exactly one shows.

     A condition reads ONCE into a local and its arm narrows off that local, which is what lets a `{#if}`
     over a cell that might be undefined drop the `?.` inside it — TypeScript narrows a const, never a
     call, and every read in a template is a call. -->
{#if level > 1}
    <p>{name}: danger</p>
{:else if level === 1}
    <p>{name}: warning</p>
{:else}
    <p>{name}: quiet</p>
{/if}

<button onclick={() => (level = (level + 1) % 3)}>next level</button>
