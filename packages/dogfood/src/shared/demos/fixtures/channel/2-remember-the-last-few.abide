<script>
import { channel } from 'abide'

// `tail` is what the channel REMEMBERS. The default is 0 — latest only — because a channel that
// remembered everything by default would be a leak nobody asked for.
const feed = channel<string>({ tail: 5 })

let sent = 0
const send = (): void => feed.publish(`message ${++sent}`)
</script>

<p>latest: {feed ?? 'nothing yet'}</p>
<ul>{#for message of feed.chunks()}<li>{message}</li>{/for}</ul>
<button onclick={send}>publish</button>
