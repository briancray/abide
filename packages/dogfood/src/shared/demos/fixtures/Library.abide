<script module>
import { invalidate, memo, state } from 'abide'

export const query = state('a')
export const shelf = state(['dune', 'neuromancer', 'anathem'])

// DERIVE — no args, so the dependencies come from the body. `shelf` and `query` are read by name,
// including inside the nested arrow: `title` shadows nothing, so only the states are rewritten.
const matching = memo(() => shelf.filter((title) => title.includes(query)))
const found = memo(() => matching.length)

// ARGLESS ASYNC — the dependencies are the ones read BEFORE the first await, which is all tracking
// can honestly see. Reading `query` into a local first is therefore load-bearing, and reads exactly
// as it would in a `.ts` file.
export const summary = memo(async () => {
    const term = query
    await new Promise((resolve) => setTimeout(resolve, 20))
    return term === '' ? 'the whole shelf' : `everything matching “${term}”`
})

// KEYED — the args ARE the cache key, so there is one independently cached slot per title, each
// with its own probes and its own verbs.
export const details = memo(
    async ({ title }: { title: string }) => {
        await new Promise((resolve) => setTimeout(resolve, 30))
        return { title, pages: title.length * 40 }
    },
    { ttl: 5_000, tags: ({ title }) => [`book:${title}`, 'catalog'] },
)
</script>

<section>
    <h2>{found} of {shelf.length} on the shelf</h2>

    <!-- A probe observes; it never causes. `summary` named alone hands over the state, and the slot
         reads it — so the two branches are the same value asked about two ways. -->
    {#if summary.pending()}<em>summarising…</em>{:else}<p class:stale={summary.refreshing()}>{summary}</p>{/if}

    <input bind:value={query} />

    <ul>
        {#for title of matching by title}
            <li>
                <!-- A keyed memo is read by its CALL the way a state is read by its name. The
                     condition takes that read into a local, so the branch NARROWS off it — `.pages`
                     needs no `?.` and no assertion, and the read happens once rather than twice. -->
                {title} — {#if details({ title })}{details({ title }).pages} pages{:else}counting…{/if}
            </li>
        {/for}
    </ul>

    <button onclick={() => shelf = [...shelf, `book ${shelf.length}`]}>add a book</button>
    <button onclick={() => summary.refresh()}>refresh the summary</button>
    <button onclick={() => details.invalidate()}>forget every page count</button>
    <button onclick={() => invalidate({ tags: ['catalog'] })}>…or by tag</button>
</section>
