<script module>
import { memo, state } from 'abide'

let made = 0
/** How many times the BODY has run. A block that re-made its own load would make this unbounded. */
export const calls = (): number => made
export const label = state('idle')

/**
 * A LAZY handle: a keyed slot starts nothing until something asks for its value, and a probe is not
 * asking. So this is also the case that says a chain over the probes still streams — the block
 * starts the operand before it renders the arm that asks about it.
 */
export const user = memo(async ({ id }: { id: number }) => {
    made++
    await new Promise((resolve) => setTimeout(resolve, 20))
    return { id, name: 'ada' }
})
</script>

<div>
    <!-- The chain IS the block, and it is asked twice: once for what to show now, once when the load
         lands. Choosing an arm can never re-make the load, because the operand is the STATE rather
         than an expression the thunk evaluates — and the `label` arm is here because only a change
         of ARM can show that the settled chain is still the live reactive thunk. -->
    {#if user({ id: 1 }).pending()}<em>loading…</em>{:else if user({ id: 1 }).error()}<i>failed</i>{:else if label === 'moved'}<i>{label}</i>{:else}<b>{user({ id: 1 }).name}</b>{/if}

</div>
