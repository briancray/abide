<script>
import Answer from '#ui/lib/Answer.abide'
import { health, state } from 'abide'

// The same call as the rung above, and what is new in the answer is the `example` field — merged OVER
// the floor by this app's own reporter, which `packages/dogfood/app.ts` exports in exactly the form
// the server half beside this shows.
const own = state('nothing asked yet')

const ask = async (): Promise<void> => {
    const now = await health()
    own = JSON.stringify(now.example ?? 'this app reported nothing of its own', null, 2)
}
</script>

<button onclick={ask}>ask for the app’s own fields</button>
<Answer source={own}/>
