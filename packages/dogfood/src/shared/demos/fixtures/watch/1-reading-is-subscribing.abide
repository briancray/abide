<script>
import { state, watch } from 'abide'

const name = state('ada')
const runs = state(0)

// Reading a state inside a `watch` IS the subscription. There is no dependency array — naming it is the
// whole of it, the same as naming it in a slot.
watch(() => {
    name
    runs += 1
})
</script>

<p>body runs: {runs}</p>
<button onclick={() => (name = name === 'ada' ? 'alan' : 'ada')}>write it</button>
