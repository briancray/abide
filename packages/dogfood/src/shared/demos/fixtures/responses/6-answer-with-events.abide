<script>
import { catalogue } from '#server/rpc/docs/responses/answer-with-events.ts'
import { state } from 'abide'

// The same client as the rung above, and that IS the rung: the only line that differs between the
// two is which module the stub came from. `isChunked` asks the response what it is, so
// `text/event-stream` is read as chunks exactly as `application/jsonl` is, and `data: ` comes off
// the front before the value gets here. Which framing a route answers with stays a question about
// the address, not about the caller.
const asked = state(false)
</script>

<button onclick={() => (asked = true)}>ask for them</button>
<ul>{#if asked}{#for row of catalogue().chunks()}<li><code>{row.id}</code></li>{/for}{/if}</ul>
