<script>
import { catalogue } from '#server/rpc/docs/responses/answer-with-many.ts'
import { state } from 'abide'

// Nothing here decodes anything. The stub is a keyed memo whose body happens to be the request, so
// `for await` over the call is the same loop a local async iterable gets — `application/jsonl` on
// the response is what told it to read chunks, and each row is a value rather than a line of text.
const rows = state<{ id: number }[]>([])

const ask = async (): Promise<void> => {
    rows = []
    for await (const row of catalogue({})) rows = [...rows, row]
}
</script>

<button onclick={ask}>ask for them</button>
<ul>{#for row of rows}<li><code>{row.id}</code></li>{/for}</ul>
