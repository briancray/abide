<script>
import { upload } from '#server/rpc/docs/transport/the-three-limits.ts'
import { state } from 'abide'

const note = state('a short note')
const shown = state('nothing sent yet')

const send = async (): Promise<void> => {
    try {
        shown = JSON.stringify(await upload({ note }))
    } catch (thrown) {
        shown = thrown instanceof Error ? thrown.message : String(thrown)
    }
}

// Past `maxBodySize`, so the body is refused before the handler is reached — the limit is on the DOOR
// rather than on anything this file can be trusted to check.
const flood = async (): Promise<void> => {
    try {
        shown = JSON.stringify(await upload({ note: 'x'.repeat(100_000) }))
    } catch (thrown) {
        shown = thrown instanceof Error ? thrown.message : String(thrown)
    }
}
</script>

<!-- `crossOrigin` is the third, and it is the one a preview cannot press: this page IS the endpoint's
     origin, so every call here is same-origin and the list is never consulted. What the declaration
     says is that `https://studio.example.com` is the only other caller — and that the websocket
     upgrade is gated by the same list, so there is no transport that reads a different answer. -->
<input bind:value={note}/>
<button onclick={send}>send it</button>
<button onclick={flood}>send 100 kB</button>
<pre>{shown}</pre>
