<script>
import { attach } from '#server/rpc/docs/transport/a-file-is-an-argument.ts'
import { state } from 'abide'

const note = state('the covering note')
const shown = state('nothing sent yet')

// Built here rather than picked, because the rung is about the ARGUMENT and not about a file input:
// nothing at this call site says "upload", and the switch to multipart is the client's own conclusion
// from the args holding something JSON cannot carry.
const send = async (): Promise<void> => {
    const page = new File(['# august\n\nnotes for the month\n'], 'august.md', { type: 'text/markdown' })
    shown = JSON.stringify(await attach({ note, page }), null, 2)
}
</script>

<input bind:value={note}/>
<button onclick={send}>send a note and a file</button>
<pre>{shown}</pre>
