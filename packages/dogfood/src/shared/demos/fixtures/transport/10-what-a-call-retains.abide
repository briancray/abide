<script>
import { user } from '#server/rpc/docs/transport/what-a-call-retains.ts'
import { invalidate, state } from 'abide'

const id = state(0)
</script>

<!-- The same keyed-memo behaviour rung 1 shows, now DECLARED: `ttl` and `tags` are the local memo's own
     options, on the call. Going back to a key already asked for still paints from the slot. -->
<button onclick={() => id++}>ask for user {id + 1}</button>
<button onclick={() => id--} disabled={id < 2}>back to user {id - 1}</button>

<!-- And the tag is what makes ONE row droppable without naming the memo: this reaches `user:1` and
     leaves every other user's slot alone. -->
<button onclick={() => invalidate({ tags: ['user:1'] })}>drop user 1 only</button>

{#if id}
    {#if user({ id: id }).pending()}<p>asking…</p>{:else}<p>{user({ id: id })().name}</p>{/if}
{/if}
