<script>
import { secrets } from '#server/rpc/docs/transport/authorize-every-read.ts'
import { state } from 'abide'

const shown = state('nothing asked yet')

const ask = async (id: number): Promise<void> => {
    try {
        shown = JSON.stringify(await secrets({ id }))
    } catch (thrown) {
        shown = thrown instanceof Error ? thrown.message : String(thrown)
    }
}
</script>

<!-- The chain runs for THIS fetch, and it would run identically for a websocket frame and for a render
     on the server that never made a request at all. That last one is why authorization belongs here
     rather than in the app's `middleware`, which only ever sees requests. -->
<button onclick={() => void ask(1)}>ask for 1</button>
<button onclick={() => void ask(0)}>ask for 0</button>
<pre>{shown}</pre>
