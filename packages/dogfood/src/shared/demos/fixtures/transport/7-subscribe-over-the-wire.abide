<script>
import { rooms } from '#server/sockets/feed.ts'
import { state } from 'abide'

const said = state('hello')
// The connection opens on the READ, so nothing is subscribed until this is set — a socket opened
// while the preview mounted would be one `#shared/demos/proofs.ts` had to wait on. See rung 1.
const joined = state(false)
</script>

<button onclick={() => joined = true} disabled={joined}>join the room</button>

<!-- `rooms({ room })` is the same keyed read a local `channel` gets, and `chunks()` is the transcript
     `tail: 8` decided the length of. What comes back says `echoed:` because a client publish is a
     REQUEST to publish — the server's `clientPublish` is what made a message of it. -->
{#if joined}
    <input bind:value={said}/>
    <button onclick={() => rooms({ room: 'lobby' }).publish(said)}>say it</button>
    <ul>{#for line of rooms({ room: 'lobby' }).chunks()}<li>{line}</li>{/for}</ul>
{/if}
