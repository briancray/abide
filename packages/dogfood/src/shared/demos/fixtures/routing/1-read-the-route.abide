<script>
import { route, state } from 'abide'

// `route()` refuses rather than guessing where there is neither a request being served nor a document
// — which is the honest answer, and is also the substrate `#shared/demos/proofs.ts` renders this in. So the
// read is behind a press, and what it reads is the page you are on right now.
const asked = state(false)
</script>

<!-- Where you are, as a REACTIVE ambient. The PATTERN is what `name` gives you — `/docs/[callable]`
     for every name under it — because that is the thing an app writes down and compares against; the
     path is `url`.

     `params` is what the segments matched. An absent OPTIONAL segment is OMITTED rather than present
     and empty, so `??` is the check and `=== ''` is not. -->
<button onclick={() => asked = true}>read where this page is</button>
{#if asked}
    <ul>
        <li>name: <code>{route().name}</code></li>
        <li>params: <code>{JSON.stringify(route().params)}</code></li>
        <li>url: <code>{route().url.pathname}</code></li>
    </ul>
{/if}
