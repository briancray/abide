<script>
import { route, state } from 'abide'

// Behind a press for the reason the rung above gives: `route()` refuses where there is neither a
// request being served nor a document, and that is the substrate `#shared/demos/proofs.ts` renders this in.
const asked = state(false)
</script>

<!-- The other two, and the reason they are separate reads at all: `route()` is FOUR SMALL STATES rather
     than one record. A move that changes only the segments wakes a reader of `params` and leaves a
     reader of `name` asleep, so a same-route move republishes instead of remounting — which is what
     rung 9 asks you to watch. One record rebuilt per navigation makes that impossible.

     `kind` says whether anything matched: `page`, or `missing` for a path no pattern serves. It is
     derived from `name` rather than held, so there is no second fact to keep in step.

     `navigating` is true only while there is an in-flight window — a route is committed once its page
     has ARRIVED, so a move to one already loaded never sets it. This is the read a spinner subscribes
     to, and it wakes for nothing else. -->
<button onclick={() => asked = true}>read the other two</button>
{#if asked}
    <ul>
        <li>kind: <code>{route().kind}</code></li>
        <li>navigating: <code>{String(route().navigating)}</code></li>
    </ul>
{/if}
