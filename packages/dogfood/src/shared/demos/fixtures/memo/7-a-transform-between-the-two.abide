<script module>
import { memo, state } from 'abide'

// Module scope for the reason rung 2's is: one cache per caller, so the two substrates agree about
// `pending()` instead of each starting a cold load. See `#shared/demos/proofs.ts`.
const query = state('ab')

// A function BETWEEN the body and the options is a transform, and the memo becomes its return: the
// body says what to fetch and this says what the readers get. Untracked, so reading a state in here
// subscribes nobody — which is what keeps it a projection rather than a second dependency set.
//
// Options still follow third, so the shape reads body → transform → options wherever all three appear.
const hits = memo(
    async ({ text }: { text: string }) => {
        await new Promise((settle) => setTimeout(settle, 200))
        return text === '' ? [] : [`${text}-one`, `${text}-two`]
    },
    (found) => found.length,
    { ttl: 5_000 },
)
</script>

<input bind:value={query} />
<p>{hits({ text: query })} hits — the readers never see the array</p>
