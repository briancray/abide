<script>
import { asShipped } from '#server/rpc/docs/ceilings/unset-costs-nothing.ts'
import Answer from '#ui/lib/Answer.abide'
import { state } from 'abide'

// Nothing is asked until the button is pressed — see `#shared/demos/proofs.ts`.
const asked = state(false)
</script>

<!-- Both say `unset` on an app nobody handed a ceiling to, which is what this rung is claiming: the
     default is not a large number, it is no ceiling and no path that charges for one. -->
<button onclick={() => asked = true}>ask what is bounded</button>
{#if asked}
    {#if asShipped({}).pending()}
        <p>asking…</p>
    {:else}
        <Answer source={JSON.stringify(asShipped({})(), null, 2)}/>
    {/if}
{/if}
