<script>
import { whatArrived } from '#server/rpc/docs/request/the-request-being-answered.ts'
import Answer from '#ui/lib/Answer.abide'
import { state } from 'abide'

// Nothing is asked until this is written: `#shared/demos/proofs.ts` renders this on a server and mounts it on
// a client and compares the two, so a read on sight would put a round trip inside the comparison.
//
// `invalidate` on the way in is what makes the button ASK rather than repaint — a `GET` is a keyed
// memo, so the second press of an unchanged key would otherwise be served from the slot.
const asked = state(false)
const ask = (): void => {
    asked = true
    whatArrived({}).invalidate()
}
</script>

<button onclick={ask}>ask the server</button>
{#if asked}
    {#if whatArrived({}).pending()}
        <p>asking…</p>
    {:else}
        <Answer source={JSON.stringify(whatArrived({})(), null, 2)}/>
    {/if}
{/if}
