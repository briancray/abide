<script>
import { memo } from 'abide'

const report = memo(async ({ month }: { month: string }): Promise<string[]> => {
    await new Promise((settle) => setTimeout(settle, 400))
    return [`${month}: 41 open`, `${month}: 7 closed`]
})
</script>

<h1>this month</h1>

<!-- The shell goes out immediately with this arm in it; the region under it arrives later, out of order,
     and the client patches it in. A snapshot renderer has nothing to wake later, so a read with nothing
     to serve yet SIGNALS and the walk runs the body again. -->
{#if report({ month: 'may' }).pending()}
    <p>counting…</p>
{:else}
    <ul>{#for line of report({ month: 'may' })()}<li>{line}</li>{/for}</ul>
{/if}
