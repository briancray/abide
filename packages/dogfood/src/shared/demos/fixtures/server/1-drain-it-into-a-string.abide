<script>
import { overview } from '#server/rpc/docs/server/drain-a-render.ts'
import { state } from 'abide'

// What a render PRODUCED, read as the envelope: `raw({ … })` reaches the same handler by the same
// address and hands the response back whole, so what is shown here is the markup the walk wrote
// rather than a value decoded out of it. Nothing is asked until the button is pressed — see
// `#shared/demos/proofs.ts`.
const shown = state('nothing asked yet')

const ask = async (): Promise<void> => {
    const answered = await overview.raw({})
    shown = await answered.text()
}
</script>

<button onclick={ask}>render it</button>
<pre>{shown}</pre>
