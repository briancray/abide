<script>
import { state } from 'abide'

const count = state(0)

/**
 * What every rung above is sugar OVER, and it never stops compiling: `count()` reads and subscribes,
 * `count.set(v)` writes, `count.peek()` reads without subscribing and starts nothing.
 *
 * `peek` is what a write already uses on your behalf. `count += 1` reads the target through it on
 * purpose, so an effect is never woken by its own write — and `count = count() + 1` is how a write that
 * DOES mean to subscribe is spelled, which is why there is no `untrack` to reach for.
 *
 * In a handler `peek` is also the honest type: a read among a setup block's statements is emitted as
 * `peek()` and typed `T | undefined` for it, while a read in a FUNCTION body is a real read.
 */
const twice = (): void => count.set(count.peek() + 2)
</script>

<p>count {count()}</p>
<button onclick={() => count.set(count.peek() + 1)}>add one, explicitly</button>
<button onclick={twice}>add two</button>
