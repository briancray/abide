<script>
import Code from '#src/lib/Code.abide'
import Doc from '#src/lib/Doc.abide'
import Section from '#src/lib/Section.abide'
</script>

<Doc
    seeAlso={[
        '/ambients/abort-signal',
        '/reactive/pipe',
        '/operating/log',
        '/data/database',
        '/handlers/get',
        '/handlers/post',
    ]}
    tests={[
        {
            path: 'packages/abide/tests/job.test.ts',
            from: ["test('a run asked for while one is in flight joins it"],
        },
        {
            path: 'packages/dogfood/examples/crm/src/ops/lib/DealImport.test.ts',
            from: [
                "test('an import asked for while one is running is refused 409'",
            ],
        },
        {
            path: 'packages/abide/tests/job.test.ts',
            from: [
                "test('a last run within the interval is waited out, and an older one is run at once",
            ],
        },
        {
            path: 'packages/abide/tests/job.test.ts',
            from: ["test('a failed run is logged under job:<name> and kept"],
        },
        {
            path: 'packages/abide/tests/job.test.ts',
            from: [
                "test('a job measured from the start names its next run an interval after the last run started",
            ],
        },
        {
            path: 'packages/abide/tests/job.test.ts',
            from: [
                "test('a paused job starts no run from a look, and runNow still runs — 54.38'",
            ],
        },
        {
            path: 'packages/abide/tests/workerFiles.test.ts',
            from: [
                "test('a job whose run is a worker export runs it off the main thread, and stopping it aborts it there",
            ],
        },
    ]}
>
    <Section level={3} title="Mail the team a follow-up digest every night">
        <p>Declare the job at the top of a server file. Nothing runs as the file loads: the first
            run waits for the app to serve, and the app's stop ends the schedule.</p>
        <Code language="ts" caption="server" code={`
            import { job, log } from '@abide/abide/server'
            import { DEALS } from '../../pipeline/lib/DEALS.server.ts'

            export const digest = job('digest', {
                every: 24 * 60 * 60_000,
                run: async () => {
                    const leads = DEALS.filter((deal) => deal.stage === 'lead')
                    await Bun.sleep(300) // the mail going out
                    log.info(\`digest sent: \${leads.length} leads to follow up\`)
                },
            })
        `} />
    </Section>

    <Section level={3} title="Serve the digest's status to every page">
        <p><code>status</code> is one value for every caller, written as each run starts and
            ends, so a handler serves it as it is.</p>
        <Code language="ts" caption="server" code={`
            import { GET } from '@abide/abide/server'
            import { digest } from './lib/digest.server.ts'

            export default GET(digest.status)
        `} />
    </Section>

    <Section level={3} title="Send the digest now without sending it twice">
        <p><code>runNow</code> joins a run in flight rather than start a second, so pressing Send
            twice mails the team once.</p>
        <Code language="ts" caption="server" code={`
            import { POST } from '@abide/abide/server'
            import { digest } from './lib/digest.server.ts'

            export default POST(() => digest.runNow())
        `} />
    </Section>

    <Section level={3} title="Start an import by hand, and refuse a second press while it runs">
        <p>A job whose <code>every</code> is 0 never runs on its own, so <code>runNow</code> from a
            handler is the only start. Leave the run in flight and answer with
            <code>status</code>; a press while <code>running</code> reads true is refused 409.</p>
        <Code language="ts" caption="server" code={`
            import { refuse } from '@abide/abide'
            import { job, POST } from '@abide/abide/server'

            export const dealImport = job('dealImport', { every: 0, run: importDeals })

            const importRunning = refuse.named(
                'ImportRunning',
                409,
                'An import is already running.',
            )

            export default POST(() => {
                if (dealImport.status.peek()?.running) return importRunning()
                void dealImport.runNow()
                return dealImport.status.peek()
            })
        `} />
    </Section>

    <Section level={3} title="Keep a restart from sending the digest again">
        <p>A job never run is due at once. <code>lastRun</code> says when the last run ended, in
            epoch milliseconds, so a restart waits out the rest of the night.</p>
        <Code language="ts" caption="server" code={`
            import { job } from '@abide/abide/server'
            import { crmDatabase } from '../../pipeline/lib/crmDatabase.server.ts'

            job('digest', {
                every: 24 * 60 * 60_000,
                run: mailDigest,
                lastRun: () =>
                    crmDatabase()
                        .query<{ sentAt: number | null }, []>(
                            'SELECT max(sentAt) AS sentAt FROM digests',
                        )
                        .get()?.sentAt ?? undefined,
            })
        `} />
    </Section>
    <Section level={3} title="Score deals every five minutes from the start of each run">
        <p><code>from: 'start'</code> measures <code>every</code> from when the last run
            started. A run due while the last one overran starts at the look after it ends.</p>
        <Code language="ts" caption="server" code={`
            import { job } from '@abide/abide/server'

            job('score', { every: 300_000, from: 'start', run: scoreAll })
        `} />
    </Section>

    <Section level={3} title="Run the scoring in a thread of its own">
        <p>A worker file's export is a function a job's <code>run</code> can be: each run is a
            thread of its own, and stopping the job aborts it there.</p>
        <Code language="ts" caption="server" code={`
            import { job } from '@abide/abide/server'

            import { scoreDeals } from './scoreDeals.worker.ts'

            job('score', { every: 300_000, run: (signal) => scoreDeals(signal) })
        `} />
    </Section>

    <Section level={3} title="Hold the scoring while a migration runs">
        <p><code>paused</code> is read as state: while it reads true no look starts a run, and the
            look its turning false makes runs one that is due. <code>runNow</code> still runs.</p>
        <Code language="ts" caption="server" code={`
            import { job, reactive } from '@abide/abide/server'

            import { scoreDeals } from './scoreDeals.worker.ts'

            export const migrating = reactive(false)
            job('score', { every: 300_000, paused: migrating, run: scoreDeals })
        `} />
    </Section>

    <Section level={3} title="Run a pipe of steps on a schedule">
        <p>A job's <code>run</code> is handed the signal alone, and a <code>pipe</code> takes the
            item first: hand it no item and the signal second, and the job's stop ends the steps in
            flight.</p>
        <Code language="ts" caption="server" code={`
            import { job, pipe } from '@abide/abide/server'
            import getDeal from '../deals/getDeal.handler.ts'

            const nightly = pipe([() => getDeal({ id: 'd2' }), (deal) => deal.name])
            job('nightly', {
                every: 86_400_000,
                run: (signal) => nightly(undefined, signal),
            })
        `} />
    </Section>
</Doc>
