<script>
import Code from '#src/lib/Code.abide'
import Doc from '#src/lib/Doc.abide'
import Section from '#src/lib/Section.abide'
</script>

<Doc
    seeAlso={[
        '/data/store',
        '/handlers/rpc',
        '/ambients/config',
        '/app/environment',
        '/reactive/refresh',
    ]}
    tests={[
        {
            path: 'packages/abide/tests/database.test.ts',
            from: [
                "test('each migration runs once, in order, across boots over one file",
            ],
        },
        {
            path: 'packages/dogfood/examples/crm/src/pipeline/lib/TargetLog.test.ts',
            from: ["test('a target set is a row in the file, listed newest first'"],
        },
        {
            path: 'packages/abide/tests/sql.test.ts',
            from: [
                "test('sql binds every interpolated value as a parameter — 47.29'",
            ],
        },
        {
            path: 'packages/abide/tests/sql.test.ts',
            from: [
                'test("a change to a table refreshes no value for carrying the table\'s name as a tag — 47.26"',
            ],
        },
        {
            path: 'packages/abide/tests/describedTable.test.ts',
            from: [
                "test('a list of any length is bound in one statement per shape — 47.34'",
            ],
        },
        {
            path: 'packages/abide/tests/migratedTables.test.ts',
            from: [
                "test('a table is typed by the migrations that declare it — 47.45, 47.46'",
            ],
        },
        {
            path: 'packages/abide/tests/database.test.ts',
            from: [
                "test('a migration rebuilds a referenced table without cascading, and a dangling reference is refused — 47.43, 47.7'",
            ],
        },
    ]}
>
    <Section level={3} title="Keep the team's targets through a restart">
        <p>The first call opens <code>crm.sqlite</code> in <code>APP_DATA_DIR</code> and runs
            the migrations it has not run. Every call after hands back the same
            <code>bun:sqlite</code> <code>Database</code>.</p>
        <Code language="ts" caption="server" code={`
            import { database } from '@abide/abide/server'

            export const crmDatabase = database('crm', {
                migrations: [
                    \`CREATE TABLE targets (
                        id INTEGER PRIMARY KEY,
                        target INTEGER NOT NULL
                    )\`,
                    'CREATE TABLE digests (sentAt INTEGER NOT NULL)',
                ],
            })

            crmDatabase().query('INSERT INTO targets (target) VALUES (?)').run(250_000)
        `} />
    </Section>

    <Section level={3} title="List the latest targets, and send each new one to the browser">
        <p><code>sql</code> answers the rows at once and follows nothing, so the list carries a
            tag, and the rpc that sets a target refreshes it with <code>refreshes</code> — which
            sends a browser showing this list the new rows.</p>
        <Code language="ts" caption="server" code={`
            import { rpc } from '@abide/abide/server'
            import { crmDatabase } from './lib/crmDatabase.server.ts'

            export const listTargets = rpc(
                () => crmDatabase.sql\`SELECT id, target, setAt FROM targets
                    ORDER BY id DESC LIMIT 5\`,
                { tags: ['targets'] },
            )
        `} />
    </Section>

    <Section level={3} title="Set a target with its value bound">
        <p>Every value written into the template is a bound parameter, never text, so a value
            from a request cannot change the statement. Each call site prepares its statement once.</p>
        <Code language="ts" caption="server" code={`
            import { rpc } from '@abide/abide/server'
            import { crmDatabase } from './lib/crmDatabase.server.ts'

            export const setTarget = rpc(
                ({ target }: { target: number }) => {
                    crmDatabase.sql\`INSERT INTO targets (target) VALUES (\${target})\`
                },
                { methods: ['POST'], refreshes: ['targets'] },
            )
        `} />
    </Section>

    <Section level={3} title="Read several targets at once with IN">
        <p>An array is bound as a list of its values, of any length. An empty one matches no
            row.</p>
        <Code language="ts" caption="server" code={`
            import { crmDatabase } from './lib/crmDatabase.server.ts'

            const ids = [3, 5, 8]
            const picked = crmDatabase.sql\`SELECT * FROM targets WHERE id IN \${ids}\`
        `} />
    </Section>

    <Section level={3} title="Add a column with one more migration">
        <p>Append to the list and never edit a migration already shipped. A function seeds rows
            on the boot that runs it.</p>
        <Code language="ts" caption="server" code={`
            import { database } from '@abide/abide/server'

            export const crmDatabase = database('crm', {
                migrations: [
                    \`CREATE TABLE targets (
                        id INTEGER PRIMARY KEY,
                        target INTEGER NOT NULL
                    )\`,
                    'CREATE TABLE digests (sentAt INTEGER NOT NULL)',
                    'ALTER TABLE targets ADD COLUMN quarter TEXT',
                    (db) => db.run('INSERT INTO targets (target) VALUES (100000)'),
                ],
            })
        `} />
    </Section>

    <Section level={3} title="Rebuild a table in a migration">
        <p>SQLite cannot change a column's type in place, so a migration makes the table anew,
            copies the rows and renames it. Foreign keys are checked once the migrations have
            run, so dropping the old table cascades into nothing.</p>
        <Code language="ts" caption="server" code={`
            import { database } from '@abide/abide/server'

            export const crmDatabase = database('crm', {
                migrations: [
                    \`CREATE TABLE targets (
                        id INTEGER PRIMARY KEY,
                        target INTEGER NOT NULL
                    )\`,
                    \`CREATE TABLE targets_new (
                        id INTEGER PRIMARY KEY,
                        target INTEGER NOT NULL,
                        stretch BOOLEAN NOT NULL DEFAULT false
                    );
                    INSERT INTO targets_new (id, target) SELECT id, target FROM targets;
                    DROP TABLE targets;
                    ALTER TABLE targets_new RENAME TO targets\`,
                ],
            })
        `} />
    </Section>

    <Section level={3} title="Open the file the config names">
        <p>A function names the file as it opens, so it reads the config of that moment. A name
            holding a <code>/</code> or a <code>.</code> is a path.</p>
        <Code language="ts" caption="server" code={`
            import { config, database } from '@abide/abide/server'

            export const notes = database(() => config.get().NOTES_DB as string, {
                migrations: ['CREATE TABLE notes (id TEXT PRIMARY KEY, body TEXT)'],
            })
        `} />
    </Section>

    <Section level={3} title="Refresh pages when a script writes the database file">
        <p>A <code>table</code>'s change log hears every commit, from the <code>sqlite3</code>
            shell or a second server too. An <code>rpc</code> over the table refreshes by itself.
            Anything else that reads the table is refreshed from its <code>readable</code>, here by
            the tag <code>getTarget</code> carries.</p>
        <Code language="ts" caption="server" code={`
            import { refresh } from '@abide/abide'
            import { targets } from './lib/targets.server.ts'

            targets.readable.pipeTo(
                new WritableStream({ write: () => refresh({ tags: ['targets'] }) }),
            )
        `} />
    </Section>
</Doc>
