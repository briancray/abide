<script server>
import { GET } from '@abide/abide/server'

const INVOICES: Record<string, { total: string }> = {
    '4021': { total: '$1,240.00' },
}

const getInvoiceTotal = GET(
    async ({ id }: { id: string }) => {
        await Bun.sleep(700) // a slow database, so the wait is on screen
        const row = INVOICES[id]
        if (row === undefined) throw new Error(`no row ${id}`)
        return row
    },
    { description: "An invoice's total, by id." },
)
</script>

<script>
import { reactive, refresh } from '@abide/abide'

// The call hands back a `Reactive`, so probes and triggers are on the RESULT.
const invoice = reactive(() => getInvoiceTotal({ id: '4021' }))
const reloading = reactive(() => invoice.busy() && invoice.ready())
</script>

<ul class="fields stacked">
    <li><span>total</span><strong>{invoice.total}</strong></li>
</ul>

<div class="row">
    <button disabled={!invoice.ready()}>Send a reminder</button>
    <button onclick={() => refresh(invoice)}>Reload</button>
    <span class="status">{reloading ? 'reloading…' : ''}</span>
</div>
