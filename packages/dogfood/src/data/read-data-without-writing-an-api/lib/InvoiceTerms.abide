<script server>
import { GET } from '@abide/abide/server'

const TERMS: Record<string, { due: string; lateFee: string }> = {
    '4021': { due: 'Net 30', lateFee: '1.5% a month' },
}

// No export: this file is its one caller.
const getTerms = GET(
    async ({ id }: { id: string }) => {
        await Bun.sleep(400) // a slow database, so the wait is on screen
        const row = TERMS[id]
        if (row === undefined) throw new Error(`no terms for ${id}`)
        return row
    },
    { description: "An invoice's payment terms, by id." },
)
</script>

<script>
import { reactive } from '@abide/abide'

const terms = reactive(() => getTerms({ id: '4021' }))
</script>

<ul class="fields stacked">
    <li><span>terms</span><strong>{terms.due}</strong></li>
    <li><span>late fee</span><strong>{terms.lateFee}</strong></li>
</ul>
