<script server>
import { GET, POST, reactive } from '@abide/abide/server'

const STAGES = ['lead', 'qualified', 'proposal', 'won']

/** One pipeline for the whole process, so every browser reads the same one. */
const pipeline = reactive(
    [
        { id: 'acme', name: 'Acme Corp', stage: 'lead' },
        { id: 'globex', name: 'Globex', stage: 'proposal' },
    ],
    { global: true },
)

const openDeals = GET(pipeline, {
    description: 'The open deals, and the stage each is at.',
})

const advanceDeal = POST(
    ({ id }: { id: string }) => {
        pipeline.patch((deals) => {
            const deal = deals.find((each) => each.id === id)
            if (deal === undefined) return
            const next = (STAGES.indexOf(deal.stage) + 1) % STAGES.length
            deal.stage = STAGES[next] as string
        })
    },
    { description: 'Moves a deal to its next stage.' },
)
</script>

<script>
const deals = openDeals()
</script>

<ul class="fields">
{#for deal of deals by deal.id}
    <li><span>{deal.stage}</span><strong>{deal.name}</strong></li>
{/for}
</ul>

<div class="row">
    <button onclick={() => advanceDeal({ id: 'acme' })}>Advance Acme</button>
</div>
