<script>
import Code from '#src/lib/Code.abide'
import Doc from '#src/lib/Doc.abide'
import Section from '#src/lib/Section.abide'
</script>

<Doc
    seeAlso={[
        '/helpers/refuse',
        '/helpers/is-failed',
        '/handlers/rpc',
        '/ambients/request',
    ]}
    tests={[
        {
            path: 'packages/abide/tests/fetchAndHandle.test.ts',
            from: ["test('a 503 is asked once, and answered as its FetchFailed"],
        },
        {
            path: 'packages/abide/tests/fetchAndHandle.test.ts',
            from: [
                'test("a pipe asks again after a service\'s 503 and not after its 404',
            ],
        },
        {
            path: 'packages/dogfood/examples/crm/src/companies/lib/Registration.test.ts',
            from: ["test('a registry failing twice is asked a third time'"],
        },
        {
            path: 'packages/abide/tests/fetchAndHandle.test.ts',
            from: [
                "test('a body is read as its content-type says, as handle reads it",
            ],
        },
        {
            path: 'packages/abide/tests/fetchAndHandle.test.ts',
            from: [
                "test('`as` reads the body as JSON, text or a Blob whatever its type says",
            ],
        },
        {
            path: 'packages/abide/tests/fetchAndHandle.test.ts',
            from: [
                "test('a body that is not JSON, or that the schema refuses, is a FetchFailed",
            ],
        },
        {
            path: 'packages/abide/tests/fetchAndHandle.test.ts',
            from: [
                "test('fetchAndHandle.isError narrows a caught failure to its FetchFailed — 54.37'",
            ],
        },
        {
            path: 'packages/abide/tests/fetchAndHandle.test.ts',
            from: [
                "test('a FetchFailed carries what fetch threw as its cause, and the wire carries none of it",
            ],
        },
        {
            path: 'packages/abide/tests/fetchAndHandle.test.ts',
            from: [
                "test('a refused FetchFailed carries what the service said as its cause",
            ],
        },
        {
            path: 'packages/dogfood/examples/crm/src/companies/lib/Registration.test.ts',
            from: [
                "test('a company the registry has never heard of is refused 404'",
            ],
        },
        {
            path: 'packages/dogfood/examples/crm/src/companies/lib/Headcount.test.ts',
            from: [
                "test('a registry slower than half a second leaves the headcount blank",
            ],
        },
        {
            path: 'packages/dogfood/examples/crm/src/companies/lib/Registrations.test.ts',
            from: [
                "test('while the registry is down, every caller is served its last answer'",
            ],
        },
    ]}
>
    <Section level={3} title="Fill in a company from a registry">
        <p>One call is one request. The body is read as its <code>content-type</code> says: JSON
            as its value, text as a string, JSON Lines or an event stream as its chunks, anything
            else as a <code>Blob</code>. A refusal rejects with a <code>FetchFailed</code> at
            502, and a handler that lets it reject refuses with it.</p>
        <Code language="ts" caption="server" code={`
            import { fetchAndHandle } from '@abide/abide'
            import { rpc } from '@abide/abide/server'

            type Registration = { founded: number; employees: number }

            export const getRegistration = rpc(({ id }: { id: string }) =>
                fetchAndHandle<Registration>(
                    \`https://registry.example/companies/\${id}\`,
                ),
            )
        `} />
    </Section>

    <Section level={3} title="Ask a busy registry again">
        <p><code>fetchAndHandle</code> asks once. Asking again is a <code>pipe</code>'s: its
            <code>retries</code>, their <code>backoff</code>, a <code>timeout</code> per attempt
            and how many companies are asked at once. A 408, 425, 429 or 5xx the registry
            answered, or no answer at all, is asked again; a 404 is the answer. A
            <code>Retry-After</code> holds every company waiting, not just the one refused.</p>
        <Code language="ts" caption="server" code={`
            import { fetchAndHandle, pipe } from '@abide/abide'

            export const askRegistry = pipe(
                [
                    (id: string, signal: AbortSignal) =>
                        fetchAndHandle<Registration>(
                            \`https://registry.example/companies/\${id}\`,
                            { signal },
                        ),
                ],
                { concurrency: 4, retries: 2 },
            )
        `} />
    </Section>

    <Section level={3} title="Read a company's filing as text, whatever its type says">
        <p><code>as</code> names the reading in place of the type: <code>'json'</code>,
            <code>'text'</code> or <code>'blob'</code>. A registry that labels its filings
            <code>application/octet-stream</code> is still read as a string.</p>
        <Code language="ts" caption="server" code={`
            import { fetchAndHandle, rpc } from '@abide/abide/server'

            export const getFilings = rpc(({ id }: { id: string }) =>
                fetchAndHandle(\`https://registry.example/filings/\${id}.txt\`, {
                    as: 'text',
                }),
            )
        `} />
    </Section>

    <Section level={3} title="Read a header the registry answers with">
        <p><code>as: 'response'</code> hands back the <code>Response</code> itself once it is
            2xx, its body unread, for what it carries beside the body. A status outside 2xx still
            rejects with its <code>FetchFailed</code>.</p>
        <Code language="ts" caption="server" code={`
            import { fetchAndHandle, rpc } from '@abide/abide/server'

            export const getRegistration = rpc(async ({ id }: { id: string }) => {
                const answer = await fetchAndHandle(
                    \`https://registry.example/companies/\${id}\`,
                    { method: 'HEAD', as: 'response' },
                )
                return answer.headers.get('last-modified')
            })
        `} />
    </Section>

    <Section level={3} title="Hold a registry answer for a minute">
        <p>A fetch keeps nothing. Hold an answer in a <code>memo</code> with a <code>ttl</code>:
            keyed by the company, so two asks at once are one request, and a busy answer is asked
            again on the next call.</p>
        <Code language="ts" caption="server" code={`
            import { fetchAndHandle, memo } from '@abide/abide'

            export const registration = memo(
                ({ id }: { id: string }) =>
                    fetchAndHandle<Registration>(
                        \`https://registry.example/companies/\${id}\`,
                    ),
                { ttl: 60_000, global: true },
            )
        `} />
    </Section>

    <Section level={3} title="Check the body's shape before trusting the body">
        <p>Without a <code>schema</code>, the type you name is a promise nothing checks. With one, a
            body it refuses rejects with a <code>FetchFailed</code> whose reason is
            <code>shape</code>.</p>
        <Code language="ts" caption="server" code={`
            import { fetchAndHandle } from '@abide/abide/server'

            const registry = 'https://registry.example/companies/ada'
            const registration = await fetchAndHandle(registry, {
                schema: (value) => {
                    const { employees } = value as { employees: unknown }
                    if (typeof employees !== 'number') throw new Error('no count')
                    return { employees }
                },
            })
        `} />
    </Section>

    <Section level={3} title="Find out why a fetch was refused">
        <p>A <code>FetchFailed</code> carries the status the service answered, or
            <code>null</code> where nothing answered, and a reason: <code>network</code>,
            <code>status</code> or <code>shape</code>. Where the request threw, its
            <code>cause</code> is what <code>fetch</code> threw, a refused certificate's code
            and all; it never leaves the server.</p>
        <Code language="ts" caption="server" code={`
            import { fetchAndHandle, log } from '@abide/abide/server'

            try {
                await fetchAndHandle('https://registry.example/filings/ada.txt')
            } catch (failed) {
                if (!fetchAndHandle.isError(failed, 'FetchFailed')) throw failed
                log.warning('registry refused', failed.data, failed.cause)
            }
        `} />
    </Section>

    <Section level={3} title="Pass on the registry's own reason for refusing">
        <p>A status outside 2xx keeps what the service answered as the <code>cause</code>, read
            as its type says: a JSON body as its value, text as a string. Like a thrown
            <code>cause</code>, it never leaves the server unless you hand it on.</p>
        <Code language="ts" caption="server" code={`
            import { refuse } from '@abide/abide'
            import { fetchAndHandle, rpc } from '@abide/abide/server'

            export const getRegistration = rpc(async ({ id }: { id: string }) => {
                try {
                    return await fetchAndHandle(\`https://registry.example/companies/\${id}\`)
                } catch (failed) {
                    if (!fetchAndHandle.isError(failed, 'FetchFailed')) throw failed
                    if (failed.data.status !== 422) throw failed
                    return refuse(422, (failed.cause as { error: string }).error)
                }
            })
        `} />
    </Section>

    <Section level={3} title="Answer 404 when the registry has never heard of the company">
        <p>A refused fetch is 502 whatever the service answered. Branch on
            <code>data.status</code>, or <code>data.reason</code>, to answer your caller in its
            own terms.</p>
        <Code language="ts" caption="server" code={`
            import { refuse } from '@abide/abide'
            import { fetchAndHandle, rpc } from '@abide/abide/server'

            export const getRegistration = rpc(async ({ id }: { id: string }) => {
                try {
                    return await fetchAndHandle<Registration>(
                        \`https://registry.example/companies/\${id}\`,
                    )
                } catch (failed) {
                    if (!fetchAndHandle.isError(failed, 'FetchFailed')) throw failed
                    if (failed.data.status === 404) return refuse(404)
                    throw failed
                }
            })
        `} />
    </Section>

    <Section level={3} title="Show a headcount only if the registry answers in time">
        <p>Where an answer is nice to have, give the request a short deadline: the platform's
            <code>AbortSignal.timeout</code> as its <code>signal</code>, with a fallback for
            what it rejects with.</p>
        <Code language="ts" caption="server" code={`
            import { fetchAndHandle, rpc } from '@abide/abide/server'

            export const getHeadcount = rpc(({ id }: { id: string }) =>
                fetchAndHandle<{ employees: number }>(
                    \`https://registry.example/companies/\${id}\`,
                    { signal: AbortSignal.timeout(500) },
                ).then(
                    (registration) => registration.employees,
                    () => null,
                ),
            )
        `} />
    </Section>

    <Section level={3} title="Keep serving the last registry answer while the registry is down">
        <p>Ask from a <code>global</code> <code>memo</code>, one entry per company, whose
            <code>ttl</code> asks again an hour after the last answer while a page reads it. An ask
            that fails leaves the last answer served to every caller, with the failure in
            <code>error</code> beside it.</p>
        <Code language="ts" caption="server" code={`
            import { memo } from '@abide/abide'
            import { askRegistry } from './askRegistry.server.ts'

            export const registrations = memo(
                ({ id }: { id: string }) => askRegistry(id),
                { global: true, ttl: 3_600_000 },
            )
        `} />
    </Section>

    <Section level={3} title="Stop asking once the caller leaves">
        <p>Pass the request's <code>signal</code>, joined with a deadline where one is due. Its
            abort is thrown as its reason, the one thing <code>fetchAndHandle</code> rejects
            with that is not a <code>FetchFailed</code>.</p>
        <Code language="ts" caption="server" code={`
            import { fetchAndHandle, request } from '@abide/abide/server'

            fetchAndHandle('https://registry.example/companies/ada', {
                signal: AbortSignal.any([request().signal, AbortSignal.timeout(5_000)]),
            })
        `} />
    </Section>
</Doc>
