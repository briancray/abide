<script server>
import { GET } from '@abide/abide/server'

// `south` goes quiet past the 2 s timeout after its first row.
const BY_REGION: Record<string, { name: string; total: string }[]> = {
    north: [
        { name: 'week 1', total: '$3,120.00' },
        { name: 'week 2', total: '$2,980.00' },
        { name: 'week 3', total: '$3,400.00' },
    ],
    south: [{ name: 'week 1', total: '$2,140.00' }],
}

const salesByRegion = GET(
    async function* ({ region }: { region: string }) {
        for (const row of BY_REGION[region] ?? []) yield row
        // The stall the per-chunk timeout is against, on one region only.
        if (region === 'south') await Bun.sleep(5_000)
    },
    { timeout: 2_000, description: 'Sales for a region, a row at a time.' },
)
</script>

<script>
import { reactive } from '@abide/abide'

const REGIONS = ['north', 'south']

let region = reactive('north')

const rows = reactive(() => salesByRegion({ region }))

/** The refusal as the status line shows it: its status, then its message. */
function refusal() {
    const failed = rows.error()
    return failed ? `${failed.status} ${failed.message}` : ''
}
</script>

<div class="tabs">
{#for one of REGIONS}
    <button aria-selected={region === one}
        onclick={() => { region = one }}>{one}</button>
{/for}
</div>

<p class="status">{refusal()}</p>

<ul class="fields">
    <li><span>rows</span>
        <strong>
            {rows.error() ? '—' : rows.ready() ? rows.length : 0}
        </strong></li>
</ul>
