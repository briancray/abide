<script server>
import { GET, sse } from '@abide/abide/server'

const LATEST = [
    { page: '/pricing', at: '09:41:02' },
    { page: '/signup', at: '09:41:05' },
    { page: '/docs', at: '09:41:09' },
]

/** A live feed, cut to three visits so the answer closes. */
async function* latestVisits() {
    for (const visit of LATEST) {
        await Bun.sleep(300)
        yield visit
    }
}

const visits = GET(() => sse(latestVisits()), {
    description: 'Live visits, as server-sent events.',
})
</script>

<script>
import { reactive, refresh } from '@abide/abide'

// A plain request, as a wallboard sends it: no `Accept` asks for events.
const feed = reactive(async () => {
    const raw = await visits.raw()
    const type = raw.headers.get('content-type')
    return { type, body: await raw.text() }
})
</script>

<ul class="fields stacked">
    <li><span>content-type</span><strong>{feed.type}</strong></li>
</ul>

<pre class="rounded-md border border-rule bg-raised p-3">{feed.body}</pre>

<div class="row">
    <button onclick={() => refresh(feed)}>Ask again</button>
</div>
