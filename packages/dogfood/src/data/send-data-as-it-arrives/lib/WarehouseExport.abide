<script server>
import { GET, jsonl } from '@abide/abide/server'

type Sale = { region: string; orders: number; total: number }

const BY_DAY: Record<string, Sale[]> = {
    '2026-10-07': [
        { region: 'north', orders: 41, total: 12480 },
        { region: 'south', orders: 29, total: 9140 },
        { region: 'east', orders: 22, total: 7020 },
    ],
}

const salesForWarehouse = GET(
    async ({ day }: { day: string }) => {
        // Read whole: the export is a list before it is a stream.
        await Bun.sleep(400)
        return jsonl(BY_DAY[day] ?? [])
    },
    { description: 'Sales for a day, as JSON lines.' },
)
</script>

<script>
import { reactive, refresh } from '@abide/abide'

const answer = reactive(async () => {
    const raw = await salesForWarehouse.raw({ day: '2026-10-07' })
    const type = raw.headers.get('content-type')
    return { type, body: await raw.text() }
})
</script>

<ul class="fields stacked">
    <li><span>content-type</span><strong>{answer.type}</strong></li>
</ul>

<pre class="rounded-md border border-rule bg-raised p-3">{answer.body}</pre>

<div class="row">
    <button onclick={() => refresh(answer)}>Export again</button>
</div>
