<script server>
import { bytes, GET } from '@abide/abide/server'

const BY_YEAR: Record<string, { name: string; total: string }[]> = {
    '2026': [
        { name: 'north', total: '12480.00' },
        { name: 'south', total: '9140.00' },
        { name: 'east', total: '7020.00' },
    ],
}

const ENCODER = new TextEncoder()

/** A cursor over the rows, so the file is written as they are read. */
async function* csvOf(year: number): AsyncGenerator<Uint8Array> {
    yield ENCODER.encode('region,total\n')
    for (const row of BY_YEAR[String(year)] ?? []) {
        await Bun.sleep(300)
        yield ENCODER.encode(`${row.name},${row.total}\n`)
    }
}

const salesCsv = GET(
    ({ year }: { year: number }) => bytes(csvOf(year)),
    { description: 'Sales by region for a year, as CSV.' },
)
</script>

<script>
import { reactive } from '@abide/abide'

const file = reactive(async () => {
    const raw = await salesCsv.raw({ year: 2026 })
    const type = raw.headers.get('content-type')
    return { type, body: await raw.text() }
})
</script>

<ul class="fields stacked">
    <li><span>content-type</span><strong>{file.type}</strong></li>
</ul>

<pre class="rounded-md border border-rule bg-raised p-3">{file.body}</pre>

<div class="row">
    <a href={salesCsv.url({ year: 2026 })} download="sales-2026.csv">
        Download sales-2026.csv</a>
</div>
