<script server>
import { GET } from '@abide/abide/server'

const BY_YEAR: Record<string, { name: string; total: string }[]> = {
    '2026': [
        { name: 'north', total: '$12,480.00' },
        { name: 'south', total: '$9,140.00' },
        { name: 'east', total: '$7,020.00' },
    ],
}

const salesByRegion = GET(
    async function* ({ year }: { year: number }) {
        for (const row of BY_YEAR[String(year)] ?? []) {
            await Bun.sleep(1200) // a slow database: each row lands alone
            yield row
        }
    },
    { description: 'Sales by region for a year, a row at a time.' },
)
</script>

<script>
import { reactive, refresh } from '@abide/abide'

const rows = reactive(() => salesByRegion({ year: 2026 }))
</script>

<ul class="fields stacked">
{#for region of rows}
    <li><span>{region.name}</span><strong>{region.total}</strong></li>
{/for}
</ul>

<ul class="fields">
    <li><span>regions</span>
        <strong>{rows.busy() ? '…' : rows.length}</strong></li>
</ul>

<div class="row">
    <button onclick={() => refresh(rows)}>Run again</button>
</div>
