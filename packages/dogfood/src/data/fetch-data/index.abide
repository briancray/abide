<script>
import Code from '#src/lib/Code.abide'
import Doc from '#src/lib/Doc.abide'
import Section from '#src/lib/Section.abide'
</script>

<Doc
    seeAlso={[
        '/data/handle',
        '/helpers/refuse',
        '/helpers/is-failed',
        '/handlers/get',
        '/ambients/request',
    ]}
    tests={[
        {
            path: 'packages/abide/tests/fetchData.test.ts',
            from: [
                "test('a 503 is asked again, and the answer after it is the body",
            ],
        },
        {
            path: 'packages/abide/tests/fetchData.test.ts',
            from: [
                "test('a body is read as its content-type says, as handle reads it",
            ],
        },
        {
            path: 'packages/abide/tests/fetchData.test.ts',
            from: [
                "test('`as` reads the body as JSON, text or a Blob whatever its type says",
            ],
        },
        {
            path: 'packages/abide/tests/fetchData.test.ts',
            from: [
                "test('identical asks under a ttl are one request, and a held answer asks nothing",
            ],
        },
        {
            path: 'packages/abide/tests/fetchData.test.ts',
            from: [
                "test('a body that is not JSON, or that the schema refuses, is a FetchFailed",
            ],
        },
        {
            path: 'packages/abide/tests/fetchData.test.ts',
            from: [
                "test('a FetchFailed carries what fetch threw as its cause, and the wire carries none of it",
            ],
        },
        {
            path: 'packages/abide/tests/fetchData.test.ts',
            from: [
                "test('a refused FetchFailed carries what the service said as its cause",
            ],
        },
        {
            path: 'packages/dogfood/examples/crm/src/companies/lib/Registration.test.ts',
            from: [
                "test('a company the registry has never heard of is refused 404'",
            ],
        },
        {
            path: 'packages/dogfood/examples/crm/src/companies/lib/Headcount.test.ts',
            from: [
                "test('a registry slower than half a second leaves the headcount blank",
            ],
        },
        {
            path: 'packages/dogfood/examples/crm/src/companies/lib/Registrations.test.ts',
            from: [
                "test('while the registry is down, every caller is served its last answer'",
            ],
        },
    ]}
>
    <Section level={3} title="Fill in a company from a registry that fails now and then">
        <p>A thrown attempt, a timeout or a 408, 425, 429 or 5xx is asked again, twice by default.
            The body is read as its <code>content-type</code> says, as
            <code>handle</code> reads one: JSON as its value, text as a string, anything else as
            a <code>Blob</code>. A service that gives up is a <code>FetchFailed</code> at 502,
            and returning it from the handler refuses.</p>
        <Code language="ts" caption="server" code={`
            import { fetchData, GET } from '@abide/abide/server'

            type Registration = { founded: number; employees: number }

            export default GET(({ id }: { id: string }) =>
                fetchData<Registration>(\`https://registry.example/companies/\${id}\`),
            )
        `} />
    </Section>

    <Section level={3} title="Read a company's filing as text, whatever its type says">
        <p><code>as</code> names the reading in place of the type: <code>'json'</code>,
            <code>'text'</code> or <code>'blob'</code>. A registry that labels its filings
            <code>application/octet-stream</code> is still read as a string.</p>
        <Code language="ts" caption="server" code={`
            import { fetchData, GET } from '@abide/abide/server'

            export default GET(({ id }: { id: string }) =>
                fetchData(\`https://registry.example/filings/\${id}.txt\`, { as: 'text' }),
            )
        `} />
    </Section>

    <Section level={3} title="Hold a registry answer for a minute">
        <p><code>ttl</code> holds a <code>GET</code>'s answer for that many milliseconds, keyed by
            its URL, its headers and its <code>as</code>. Two asks at once are one request, and a
            failure is never held.</p>
        <Code language="ts" caption="server" code={`
            import { fetchData } from '@abide/abide/server'

            fetchData<Registration>(\`https://registry.example/companies/\${id}\`, {
                ttl: 60_000,
            })
        `} />
    </Section>

    <Section level={3} title="Check the body's shape before trusting the body">
        <p>Without a <code>schema</code>, the type you name is a promise nothing checks. With one, a
            body it refuses is a <code>FetchFailed</code> whose reason is <code>shape</code>.</p>
        <Code language="ts" caption="server" code={`
            import { fetchData } from '@abide/abide/server'

            const registry = 'https://registry.example/companies/ada'
            const registration = await fetchData(registry, {
                schema: (value) => {
                    const { employees } = value as { employees: unknown }
                    if (typeof employees !== 'number') throw new Error('no count')
                    return { employees }
                },
            })
        `} />
    </Section>

    <Section level={3} title="Find out why a fetch gave up">
        <p>A <code>FetchFailed</code> carries the last status, or <code>null</code> where nothing
            answered, and a reason: <code>timeout</code>, <code>network</code>,
            <code>status</code> or <code>shape</code>. Where an attempt threw, its
            <code>cause</code> is what <code>fetch</code> threw, a refused certificate's code
            and all; it never leaves the server.</p>
        <Code language="ts" caption="server" code={`
            import { fetchData, isFailed, log } from '@abide/abide/server'

            const filing = await fetchData('https://registry.example/filings/ada.txt', {
                timeout: 2_000,
            })
            if (isFailed(filing))
                log.warning('registry gave up', filing.data, filing.cause)
        `} />
    </Section>

    <Section level={3} title="Pass on the registry's own reason for refusing">
        <p>A status outside 2xx keeps what the service answered as the <code>cause</code>, read
            as its type says: a JSON body as its value, text as a string. Like a thrown
            <code>cause</code>, it never leaves the server unless you hand it on.</p>
        <Code language="ts" caption="server" code={`
            import { fetchData, GET, isFailed, refuse } from '@abide/abide/server'

            export default GET(async ({ id }: { id: string }) => {
                const entry = await fetchData(\`https://registry.example/companies/\${id}\`)
                if (isFailed(entry) && entry.data.status === 422)
                    return refuse(422, (entry.cause as { error: string }).error)
                return entry
            })
        `} />
    </Section>

    <Section level={3} title="Answer 404 when the registry has never heard of the company">
        <p>A service that gives up is refused 502 whatever it answered. Branch on
            <code>data.status</code>, or <code>data.reason</code>, to answer your caller in its
            own terms.</p>
        <Code language="ts" caption="server" code={`
            import { refuse } from '@abide/abide'
            import { fetchData, GET, isFailed } from '@abide/abide/server'

            export default GET(async ({ id }: { id: string }) => {
                const registration = await fetchData<Registration>(
                    \`https://registry.example/companies/\${id}\`,
                )
                if (isFailed(registration) && registration.data.status === 404)
                    return refuse(404)
                return registration
            })
        `} />
    </Section>

    <Section level={3} title="Show a headcount only if the registry answers in time">
        <p>Where an answer is nice to have, ask once and give up fast: <code>retries: 0</code>
            and a short <code>timeout</code>, with a fallback for the <code>FetchFailed</code>.</p>
        <Code language="ts" caption="server" code={`
            import { fetchData, GET, isFailed } from '@abide/abide/server'

            export default GET(async ({ id }: { id: string }) => {
                const registration = await fetchData<{ employees: number }>(
                    \`https://registry.example/companies/\${id}\`,
                    { retries: 0, timeout: 500 },
                )
                return isFailed(registration) ? null : registration.employees
            })
        `} />
    </Section>

    <Section level={3} title="Keep serving the last registry answer while the registry is down">
        <p>Return the <code>FetchFailed</code> from a <code>global</code> <code>memo</code> that
            polls. An ask that fails leaves the last answer served to every caller, with the
            failure in <code>error</code> beside it.</p>
        <Code language="ts" caption="server" code={`
            import { memo } from '@abide/abide'
            import { fetchData } from '@abide/abide/server'

            export const registrations = memo(
                ({ id }: { id: string }) =>
                    fetchData<Registration>(\`https://registry.example/companies/\${id}\`),
                { global: true, poll: 3_600_000 },
            )
        `} />
    </Section>

    <Section level={3} title="Retry a write that is safe to repeat">
        <p>A <code>POST</code> is asked once, since asking again may write twice. Set
            <code>retries</code> where the service takes the same write twice safely.</p>
        <Code language="ts" caption="server" code={`
            import { fetchData } from '@abide/abide/server'

            await fetchData('https://mail.example/send', {
                method: 'POST',
                body: JSON.stringify(email),
                retries: 2,
            })
        `} />
    </Section>

    <Section level={3} title="Stop asking once the caller leaves">
        <p>Pass the request's <code>signal</code>. Its abort is thrown, the one thing
            <code>fetchData</code> throws, and nothing is asked again.</p>
        <Code language="ts" caption="server" code={`
            import { fetchData, request } from '@abide/abide/server'

            fetchData('https://registry.example/companies/ada', {
                signal: request().signal,
                timeout: 5_000,
            })
        `} />
    </Section>
</Doc>
