<script server>
import { reactive } from '@abide/abide'
import { GET, POST } from '@abide/abide/server'

type Turn = { id: string; speaker: string; text: string }

/** A support room per id; one nobody has posted to for an hour is let go. */
const rooms = reactive(
    (_room: { id: string }): Turn[] => [
        {
            id: 'greeting',
            speaker: 'support',
            text: 'Ask about any invoice here.',
        },
    ],
    { global: true, by: 'id', ttl: 3_600_000 },
)

/** Read, and followed by every tab reading it. */
export const room = GET(rooms, { description: "A support room's turns." })

/** The server writes the turn, so what a tab sends is only its text. */
export const say = POST(
    ({ id, text }: { id: string; text: string }) => {
        rooms({ id }).patch((turns) => {
            turns.push({ id: crypto.randomUUID(), speaker: 'you', text })
            if (turns.length > 20) turns.shift()
        })
    },
    { description: 'Says something in a support room.' },
)
</script>

<script>
import { cookies, reactive } from '@abide/abide'

// This browser's room, by an id in a cookie every tab of it sends.
const id = cookies().get('room') ?? crypto.randomUUID()
cookies().set('room', id)
const turns = reactive(() => room({ id }))
const last = reactive(() => turns.at(-1))
const draft = reactive('Is invoice 4021 paid yet?')
</script>

<ul class="chat">
    <li data-speaker={last?.speaker}>
        <span>{last?.speaker ?? 'connecting'}</span>
        <p>{last?.text ?? '…'}</p>
    </li>
</ul>

<div class="row">
    <label>message
        <input bind:value={draft}>
    </label>
    <button onclick={() => say({ id, text: draft })}>Send</button>
</div>
