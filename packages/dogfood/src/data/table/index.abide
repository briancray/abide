<script>
import Code from '#src/lib/Code.abide'
import Doc from '#src/lib/Doc.abide'
import Section from '#src/lib/Section.abide'
</script>

<Doc
    seeAlso={[
        '/data/database',
        '/reactive/invalidate',
        '/orchestration/pipe',
        '/orchestration/ledger',
    ]}
    tests={[
        {
            path: 'packages/abide/tests/table.test.ts',
            from: [
                "test('a table reads every committed change in order, and none rolled back — 47.23, 47.24, 47.25'",
            ],
        },
        {
            path: 'packages/abide/tests/sql.test.ts',
            from: [
                'test("a table\'s write refreshes its rpc at once — 47.26, 47.31"',
            ],
        },
        {
            path: 'packages/abide/tests/sql.test.ts',
            from: [
                "test('a table called matches a list, comparisons and null as JSON reads them — 47.33'",
            ],
        },
        {
            path: 'packages/abide/tests/sql.test.ts',
            from: [
                "test('a table is upserted, updated and deleted by key — 47.30'",
            ],
        },
        {
            path: 'packages/abide/tests/describedTable.test.ts',
            from: [
                'test("a write upserts by the table\'s own primary key, one column or several — 47.27, 47.30, 47.37"',
            ],
        },
        {
            path: 'packages/abide/tests/describedTable.test.ts',
            from: [
                "test('a BOOLEAN and a JSON column are read and written as what they declare — 47.38, 47.39'",
            ],
        },
        {
            path: 'packages/abide/tests/describedTable.test.ts',
            from: [
                "test('a table given logged records its key and those columns alone — 47.40'",
            ],
        },
        {
            path: 'packages/abide/tests/describedTable.test.ts',
            from: [
                "test('a write inside a transaction refreshes once it commits, and not at all where it rolls back — 47.41'",
            ],
        },
        {
            path: 'packages/abide/tests/table.test.ts',
            from: [
                "test('a value that called the table is not refreshed by its changes — 47.48'",
            ],
        },
        {
            path: 'packages/abide/tests/describedTable.test.ts',
            from: [
                "test('an insert answers its rows as stored, and an undefined column is not written — 47.49, 47.30'",
            ],
        },
        {
            path: 'packages/abide/tests/rpcSources.test.ts',
            from: [
                'test("a table\'s rpc is read by a match and written by key over the wire — 16.117"',
            ],
        },
    ]}
>
    <Section level={3} title="Read the targets by calling the table">
        <p>A table called answers its rows, and that is all it does. A value that read them is
            not loaded again when the table changes, so it carries a tag that the write refreshes,
            as <code>getTarget</code> does.</p>
        <Code language="ts" caption="server" code={`
            import { memo } from '@abide/abide'
            import { targets } from '../pipeline/lib/targets.server.ts'

            export const target = memo(() => targets().at(-1)?.target, {
                global: true,
                tags: ['targets'],
            })
        `} />
    </Section>

    <Section level={3} title="Name the table, and its rows are typed by the migration">
        <p>The opener carries the tables its migrations declare, so the table is named and
            nothing else: its row is typed from the <code>CREATE TABLE</code>, its key is the
            table's primary key, and a name no migration declared is a type error.</p>
        <Code language="ts" caption="server" code={`
            import { type Tables, table } from '@abide/abide/server'
            import { crmDatabase } from './crmDatabase.server.ts'

            export type Target = Tables<typeof crmDatabase>['targets']

            export const targets = table(crmDatabase, 'targets')
        `} />
    </Section>

    <Section level={3} title="Read a BOOLEAN column as true or false, and a JSON column as its value">
        <p>A column's declared type is kept in the file, so <code>BOOLEAN</code> reads back
            <code>true</code> or <code>false</code> and <code>JSON</code> reads back the value it
            was written as — through the table, its changes and <code>sql</code> alike.</p>
        <Code language="ts" caption="server" code={`
            import { database, table } from '@abide/abide/server'

            const crm = database('crm', {
                migrations: [
                    \`CREATE TABLE deals (
                        id INTEGER PRIMARY KEY,
                        won BOOLEAN NOT NULL,
                        notes JSON
                    )\`,
                ],
            })
            const deals = table(crm, 'deals')

            deals.upsert({ id: 1, won: true, notes: { calls: 2 } })
            deals({ won: true })
        `} />
    </Section>

    <Section level={3} title="Match the rows with JSON">
        <p>A value is equality, <code>null</code> is NULL, an array is any of its values, and an
            object of <code>gt</code>, <code>gte</code>, <code>lt</code>, <code>lte</code> and
            <code>ne</code> is every comparison it names.</p>
        <Code language="ts" caption="server" code={`
            import { targets } from '../pipeline/lib/targets.server.ts'

            const ambitious = targets({ target: { gte: 500_000 } })
            const picked = targets({ id: [3, 5, 8] })
        `} />
    </Section>

    <Section level={3} title="Insert a target, and read back the id SQLite assigned">
        <p><code>insert</code> leaves the key to SQLite and answers each row as it was stored,
            its defaults filled in.</p>
        <Code language="ts" caption="server" code={`
            import { targets } from './targets.server.ts'

            const [stored] = targets.insert({ target: 300_000 })
            console.log(stored?.id, stored?.setAt)
        `} />
    </Section>

    <Section level={3} title="Write inside a transaction, and refresh once it commits">
        <p>A write made inside a transaction refreshes the table's <code>rpc</code> once the
            transaction commits, and never where it rolls back.</p>
        <Code language="ts" caption="server" code={`
            import { crmDatabase } from './crmDatabase.server.ts'
            import { targets } from './targets.server.ts'

            crmDatabase().transaction(() => {
                targets.update({ id: 3, target: 450_000 })
                targets.delete({ id: [7, 8] })
            })()
        `} />
    </Section>

    <Section level={3} title="Write the targets by key">
        <p><code>upsert</code> inserts or replaces rows by <code>key</code>, <code>update</code> writes only the
            columns a row names, and <code>delete</code> removes the rows a match names. The
            table's <code>rpc</code> reads it again at once.</p>
        <Code language="ts" caption="server" code={`
            import { targets } from '../pipeline/lib/targets.server.ts'

            targets.update({ id: 3, target: 450_000 })
            targets.delete({ id: [7, 8] })
        `} />
    </Section>

    <Section level={3} title="Give the browser the table by its rpc">
        <p>An <code>rpc</code> over a table answers its rows for a match by <code>GET</code>, and
            its <code>upsert</code>, <code>update</code> and <code>delete</code> by <code>PUT</code>,
            <code>PATCH</code> and <code>DELETE</code> — the same calls on the server and in the
            browser. Any commit to the table, from any connection, sends the new rows to every
            browser reading the <code>GET</code>. <code>columns</code> keeps the rest of the row on
            the server.</p>
        <Code language="ts" caption="server" code={`
            import { rpc } from '@abide/abide/server'
            import { targets } from './lib/targets.server.ts'

            export const listTargets = rpc(targets, { columns: ['id', 'target'] })
        `} />
    </Section>

    <Section level={3} title="Read every change to the targets as it commits">
        <p><code>readable</code> hands on each insert, update and delete committed after it is
            first read, in order, with the row after and before. A write rolled back is none.</p>
        <Code language="ts" caption="server" code={`
            import { targets } from '../pipeline/lib/targets.server.ts'

            for await (const change of targets.readable)
                console.log(change.op, change.row?.target, change.previous?.target)
        `} />
    </Section>

    <Section level={3} title="Carry only the columns a reader needs in each change">
        <p><code>logged</code> names the columns each change records beside the table's key, so a
            wide column is not copied into the change log on every write.</p>
        <Code language="ts" caption="server" code={`
            import { table } from '@abide/abide/server'
            import { crmDatabase } from './crmDatabase.server.ts'

            const targetChanges = table(crmDatabase, 'targets', {
                logged: ['target'],
            })

            for await (const change of targetChanges.readable)
                console.log(change.row?.id, change.row?.target)
        `} />
    </Section>

    <Section level={3} title="Write imported targets a batch at a time">
        <p><code>writable</code> upserts by the table's primary key, or the <code>key</code>
            given, and the rows written in one turn are one transaction.</p>
        <Code language="ts" caption="server" code={`
            import { targets } from '../pipeline/lib/targets.server.ts'

            const imported = ReadableStream.from([
                { id: 7, target: 400_000, setAt: '2026-01-05 09:00:00' },
                { id: 8, target: 450_000, setAt: '2026-02-02 09:00:00' },
            ])
            await imported.pipeTo(targets.writable)
        `} />
    </Section>
</Doc>
