<script>
import Code from '#src/lib/Code.abide'
import Doc from '#src/lib/Doc.abide'
import Section from '#src/lib/Section.abide'
</script>

<Doc
    seeAlso={[
        '/data/database',
        '/reactive/invalidate',
        '/orchestration/pipe',
        '/orchestration/ledger',
    ]}
    tests={[
        {
            path: 'packages/abide/tests/table.test.ts',
            from: [
                "test('a table reads every committed change in order, and none rolled back — 47.26, 47.27, 47.28'",
            ],
        },
        {
            path: 'packages/abide/tests/sql.test.ts',
            from: [
                'test("a table\'s write refreshes what carries its name as a tag at once — 47.29, 47.34"',
            ],
        },
        {
            path: 'packages/abide/tests/sql.test.ts',
            from: [
                "test('a table called matches a list, comparisons and null as JSON reads them — 47.36'",
            ],
        },
        {
            path: 'packages/abide/tests/sql.test.ts',
            from: ["test('a table is set, patched and deleted by key — 47.33'"],
        },
        {
            path: 'packages/abide/tests/rpcSources.test.ts',
            from: [
                'test("a table\'s rpc is read by a match and written by key over the wire — 16.117"',
            ],
        },
    ]}
>
    <Section level={3} title="Read the targets by calling the table">
        <p>A table called answers its rows. A value naming the table among its <code>tags</code>
            loads again after any write to it — whichever code made it, and whatever
            connection.</p>
        <Code language="ts" caption="server" code={`
            import { memo } from '@abide/abide'
            import { targets } from '../pipeline/lib/targets.server.ts'

            export const target = memo(() => targets().at(-1)?.target, {
                global: true,
                tags: ['targets'],
            })
        `} />
    </Section>

    <Section level={3} title="Match the rows with JSON">
        <p>A value is equality, <code>null</code> is NULL, an array is any of its values, and an
            object of <code>gt</code>, <code>gte</code>, <code>lt</code>, <code>lte</code> and
            <code>ne</code> is every comparison it names.</p>
        <Code language="ts" caption="server" code={`
            import { targets } from '../pipeline/lib/targets.server.ts'

            const ambitious = targets({ target: { gte: 500_000 } })
            const picked = targets({ id: [3, 5, 8] })
        `} />
    </Section>

    <Section level={3} title="Write the targets by key">
        <p><code>set</code> upserts rows by <code>key</code>, <code>patch</code> writes only the
            columns a row names, and <code>delete</code> removes the rows a match names. What
            carries the table's name as a tag reads it again at once.</p>
        <Code language="ts" caption="server" code={`
            import { targets } from '../pipeline/lib/targets.server.ts'

            targets.patch({ id: 3, target: 450_000 })
            targets.delete({ id: [7, 8] })
        `} />
    </Section>

    <Section level={3} title="Give the browser the table by its rpc">
        <p>An <code>rpc</code> over a table answers its rows for a match by <code>GET</code>, and
            its <code>set</code>, <code>patch</code> and <code>delete</code> by <code>PUT</code>,
            <code>PATCH</code> and <code>DELETE</code> — the same calls on the server and in the
            browser. <code>columns</code> keeps the rest of the row on the server.</p>
        <Code language="ts" caption="server" code={`
            import { rpc } from '@abide/abide/server'
            import { targets } from './lib/targets.server.ts'

            export default rpc(targets, { columns: ['id', 'target'] })
        `} />
    </Section>

    <Section level={3} title="Read every change to the targets as it commits">
        <p><code>readable</code> hands on each insert, update and delete committed after it is
            first read, in order, with the row after and before. A write rolled back is none.</p>
        <Code language="ts" caption="server" code={`
            import { table } from '@abide/abide/server'
            import { crmDatabase } from '../pipeline/lib/crmDatabase.server.ts'

            for await (const change of table(crmDatabase, 'targets').readable)
                console.log(change.op, change.row?.target, change.previous?.target)
        `} />
    </Section>

    <Section level={3} title="Write imported targets a batch at a time">
        <p><code>writable</code> upserts by <code>key</code>, <code>id</code> where none is given,
            and the rows written in one turn are one transaction.</p>
        <Code language="ts" caption="server" code={`
            import { table } from '@abide/abide/server'
            import { crmDatabase } from '../pipeline/lib/crmDatabase.server.ts'

            await imported.pipeTo(table(crmDatabase, 'targets').writable)
        `} />
    </Section>
</Doc>
