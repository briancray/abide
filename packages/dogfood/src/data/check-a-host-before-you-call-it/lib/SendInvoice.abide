<script server>
import { POST, reachable, refuse } from '@abide/abide/server'

// Billing on its bad day: a host that takes the connection and never answers.
let billingOrigin: string | undefined

function billing(): string {
    if (billingOrigin === undefined) {
        const host = Bun.listen({
            hostname: '127.0.0.1',
            port: 0,
            socket: { data() {} },
        })
        billingOrigin = `http://127.0.0.1:${host.port}`
    }
    return billingOrigin
}

const syncInvoice = POST(
    async ({ id }: { id: string }) => {
        const origin = billing()
        const asked = performance.now()
        if (!(await reachable(origin))) {
            const waited = Math.round(performance.now() - asked)
            return refuse(
                503,
                `Billing is unreachable — refused in ${waited} ms.`,
            )
        }
        return fetch(`${origin}/invoices/${id}`, { method: 'POST' })
    },
    { description: 'Sends an invoice to billing, where billing is reachable.' },
)
</script>

<script>
import { reactive } from '@abide/abide'

let status = reactive('')

async function send() {
    status = 'asking billing…'
    try {
        await syncInvoice({ id: '4310' })
        status = 'sent'
    } catch (refusal) {
        if (!syncInvoice.isError(refusal, 'HttpError')) throw refusal
        status = refusal.message
    }
}
</script>

<div class="row">
    <button onclick={send}>Send to billing</button>
    <span class="status">{status}</span>
</div>
