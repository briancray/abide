<script>
import { reactive, refuse } from '@abide/abide'
import { z } from 'zod'

const notAPhone = refuse.named(
    'NotAPhone',
    422,
    'A phone number is ten digits.',
    { schema: z.object({ typed: z.string() }) },
)

let draft = reactive('415 555 0132')

let phone = reactive('415 555 0132', {
    transform: (typed) => {
        const digits = typed.replaceAll(/\D/g, '')
        if (digits.length !== 10) return notAPhone({ typed })
        const area = digits.slice(0, 3)
        return `(${area}) ${digits.slice(3, 6)}-${digits.slice(6)}`
    },
})

/** What the refusal says, where the last save was refused. */
function refusal() {
    const failed = phone.error()
    return phone.isError(failed, 'NotAPhone')
        ? `“${failed.data.typed}” is not ten digits.`
        : ''
}
</script>

<div class="row">
    <label>phone
        <input bind:value={draft}>
    </label>
    <button onclick={() => { phone = draft }}>Save</button>
</div>

<p class="status">{refusal()}</p>

<ul class="fields">
    <li><span>on the record</span>
        <strong>{phone}</strong></li>
</ul>
