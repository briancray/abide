<script server>
import { DELETE, GET, PATCH, PUT } from '@abide/abide/server'

type ContactRow = { name: string; phone: string; tags: string[] }

const stored: ContactRow = {
    name: 'Ada Lovelace',
    phone: '020 7946 0018',
    tags: ['customer', 'newsletter', 'vip'],
}

/** One contact, written three ways, behind a slow database. */
const contacts = {
    async find(_id: string): Promise<ContactRow> {
        await Bun.sleep(300)
        return { ...stored, tags: [...stored.tags] }
    },
    async update(
        _id: string,
        change: Partial<ContactRow>,
    ): Promise<ContactRow> {
        await Bun.sleep(300)
        Object.assign(stored, change)
        return { ...stored, tags: [...stored.tags] }
    },
}

export const getContact = GET(({ id }: { id: string }) => contacts.find(id), {
    description: 'A contact, by id.',
})

export const updatePhone = PATCH(
    ({ id, phone }: { id: string; phone: string }) =>
        contacts.update(id, { phone }),
    { description: 'Changes the phone of a contact.' },
)

export const replaceTags = PUT(
    ({ id, tags }: { id: string; tags: string[] }) =>
        contacts.update(id, { tags }),
    { description: 'Replaces the tags of a contact.' },
)

export const removeTag = DELETE(
    async ({ id, tag }: { id: string; tag: string }) => {
        const { tags } = await contacts.find(id)
        return contacts.update(id, {
            tags: tags.filter((each) => each !== tag),
        })
    },
    { description: 'Removes one tag from a contact.' },
)
</script>

<script>
import { reactive } from '@abide/abide'

const id = '4021'
let contact = reactive(() => getContact({ id }))
let phone = reactive('020 7946 0019')
</script>

<ul class="fields">
    <li><span>phone</span><strong>{contact.phone}</strong></li>
</ul>

<div class="row">
    <input bind:value={phone} aria-label="phone" />
    <button onclick={() => { contact = updatePhone({ id, phone }) }}>
        Save phone</button>
</div>

<div class="row">
{#for tag of contact.tags}
    <button onclick={() => { contact = removeTag({ id, tag }) }}>
        {tag} ✕</button>
{/for}
</div>

<div class="row">
    <button onclick={() => {
        contact = replaceTags({ id, tags: ['customer', 'newsletter', 'vip'] })
    }}>Reset tags</button>
</div>
