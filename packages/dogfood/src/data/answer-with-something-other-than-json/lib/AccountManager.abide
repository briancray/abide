<script server>
import { GET, json } from '@abide/abide/server'

const MANAGERS: Record<string, { name: string } | undefined> = {
    '4021': { name: 'Charles Babbage' },
    '4022': undefined,
}

const accountManager = GET(
    async ({ id }: { id: string }) => {
        await Bun.sleep(300) // a slow database, so the wait is on screen
        return json(MANAGERS[id])
    },
    { description: 'The account manager of a contact, or null.' },
)
</script>

<script>
import { reactive } from '@abide/abide'

const TABS = [
    { id: '4021', name: 'Ada' },
    { id: '4022', name: 'Grace' },
]

let id = reactive('4021')

// What a sync script does with the answer: read the body as JSON.
const answer = reactive(async () => {
    const raw = await accountManager.raw({ id })
    return { status: raw.status, manager: await raw.json() }
})
</script>

<div class="tabs">
{#for tab of TABS}
    <button aria-selected={id === tab.id}
        onclick={() => { id = tab.id }}>{tab.name}</button>
{/for}
</div>

<ul class="fields">
    <li><span>status</span><strong>{answer.status}</strong></li>
    <li><span>manager</span>
        <strong>{answer.manager ? answer.manager.name : 'null'}</strong></li>
</ul>
