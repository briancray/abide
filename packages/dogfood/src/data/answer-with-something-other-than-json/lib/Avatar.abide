<script server>
import { GET, redirect } from '@abide/abide/server'

/** A contact's record, and the version of the stored photo it names. */
type Contact = { initials: string; color: string; photoVersion: number }

const CONTACTS: Record<string, Contact> = {
    '4021': { initials: 'AL', color: '#2f8f83', photoVersion: 3 },
    '4022': { initials: 'GH', color: '#c4693d', photoVersion: 7 },
}

function contactOf(id: string) {
    const contact = CONTACTS[id]
    if (contact === undefined) throw new Error(`no contact ${id}`)
    return contact
}

const photo = GET(
    ({ id, version }: { id: string; version: number }) => {
        const { initials, color } = contactOf(id)
        const svg = [
            '<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 96 96">',
            `<rect width="96" height="96" fill="${color}"/>`,
            '<text x="48" y="58" font-family="sans-serif"',
            ' font-size="32" font-weight="600" fill="#fff"',
            ` text-anchor="middle">${initials}</text>`,
            '<text x="48" y="84" font-family="monospace"',
            ' font-size="10" fill="#fff" fill-opacity=".7"',
            ` text-anchor="middle">v${version}</text></svg>`,
        ].join('')
        return new Blob([svg], { type: 'image/svg+xml' })
    },
    { description: 'A contact photo, by id and version.' },
)

const avatar = GET(
    ({ id }: { id: string }) =>
        redirect(photo.url({ id, version: contactOf(id).photoVersion })),
    { description: 'Redirects to the current photo of a contact.' },
)
</script>

<script>
import { reactive } from '@abide/abide'

const TABS = [
    { id: '4021', name: 'Ada' },
    { id: '4022', name: 'Grace' },
]

let id = reactive('4021')
</script>

<div class="tabs">
{#for tab of TABS}
    <button aria-selected={id === tab.id}
        onclick={() => { id = tab.id }}>{tab.name}</button>
{/for}
</div>

<ul class="fields stacked">
    <li><span>the page asks for</span><strong>{avatar.url({ id })}</strong></li>
</ul>

<img src={avatar.url({ id })} alt="" class="size-24 rounded-full" />
