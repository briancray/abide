</script>

<Doc
    seeAlso={['/data/fetch-json', '/data/fetch-text', '/reactive/is-failed']}
    tests={[
        {
            path: 'packages/abide/tests/handle.test.ts',
            from: [
                "test('JSON is its value, text is a string, and anything else is a Blob",
            ],
        },
        {
            path: 'packages/abide/tests/handle.test.ts',
            from: [
                "test('a status outside 2xx, and JSON that does not parse, are a FetchFailed",
            ],
        },
        {
            path: 'packages/abide/tests/handle.test.ts',
            from: ["test('a JSON Lines stream is its chunks, each as it arrives"],
        },
        {
            path: 'packages/abide/tests/handle.test.ts',
            from: ["test('what fetch throws reaches the caller untouched'"],
        },
    ]}
>
    <Section level={3} title="Read a company from another service, with its headers">
        <p>The fetch is yours: its options, its headers, its answer. <code>handle</code> reads
            the body as its <code>content-type</code> says, and a status outside 2xx is a
            <code>FetchFailed</code>.</p>
        <Code language="ts" caption="shared" code={`
            import { handle, isFailed } from '@abide/abide'

            const response = await fetch('https://registry.example/companies/hopper')
            const session = response.headers.get('x-session')
            const company = await handle(response)
            if (isFailed(company)) return company
        `} />
    </Section>

    <Section level={3} title="Read a stream of deal moves as they arrive">
        <p>A JSON Lines or event stream is its chunks, each handed over as it arrives.</p>
        <Code language="ts" caption="shared" code={`
            import { handle, log } from '@abide/abide'
            import ticker from './ticker.handler.ts'

            type Move = { account: string; stage: string }
            const moves = await fetch(ticker.url()).then(handle)
            for await (const move of moves as AsyncIterable<Move>)
                log(\`\${move.account} moved to \${move.stage}\`)
        `} />
    </Section>

    <Section level={3} title="Tell a refused certificate from a service that is down">
        <p>What <code>fetch</code> throws reaches you untouched, to show as you choose.</p>
        <Code language="ts" caption="shared" code={`
            import { handle, log } from '@abide/abide'

            try {
                return await fetch(url).then(handle)
            } catch (error) {
                log.warning('the registry refused us', error)
            }
        `} />
    </Section>
</Doc>
