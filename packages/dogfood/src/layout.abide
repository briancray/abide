<script server>
// The docs app's own hooks; each example files its own in its own file.
import { csp, middleware, onConfig } from '@abide/abide/server'

import { serveDownloads } from '#src/lib/serveDownloads.ts'

// The sign-in examples need a secret: one per process, or the deployment's.
const PRINCIPAL_SECRET = crypto.randomUUID()

// 44.85 — the pairing the Ask panel shows asks the visitor's Claude Code for full access.
onConfig(() => ({
    ABIDE_PRINCIPAL_SECRET: PRINCIPAL_SECRET,
    ABIDE_BRIDGE_FULL: true,
    ABIDE_BRIDGE_NOTE:
        'So the assistant can build what you ask for, not just answer from the docs.',
}))

middleware(serveDownloads)

// Every docs page's policy; 'self' so the docs can frame invoice previews.
middleware(csp({ 'frame-ancestors': ["'self'"] }))
</script>

<script>
import { announce, onMenu, prompts, toasts, tooltip, url } from '@abide/abide'

import DocsNav from '#src/lib/DocsNav.abide'
import { MENUS } from '#src/lib/nativeMenus.ts'
import SiteBar from '#src/lib/SiteBar.abide'
import UpdateBanner from '#src/lib/UpdateBanner.abide'
import '#src/lib/app.css'

// The native app's menu bar; in a browser, nothing reads it (38.88).
onMenu(() => MENUS)

// Where every example's announcements, notices, prompts and hints show.
const regions = announce.host()
const shown = toasts.host()
const asked = prompts.host()
const hints = tooltip.host()
</script>

<html lang="en">
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <link
            rel="preload"
            href={url('/fonts/ibm-plex-sans.woff2')}
            as="font"
            type="font/woff2"
            crossorigin
         />
        <link
            rel="preload"
            href={url('/fonts/space-grotesk.woff2')}
            as="font"
            type="font/woff2"
            crossorigin
         />
    </head>
<body
        class="grid grid-cols-[15.5rem_minmax(0,44rem)_1fr]
        max-rail:grid-cols-[15.5rem_minmax(0,1fr)] max-lg:grid-cols-1
        bg-paper font-sans text-prose/6 text-ink antialiased"
    >
        <a
            class="absolute -left-1000 focus:top-2 focus:left-2 focus:z-2
        focus:rounded-md focus:bg-raised focus:px-3 focus:py-2"
            href="#content"
        >Skip to content</a>
<!-- Ahead of the page, so an example's own announce.host, standing after it, is the one that shows (50.36). -->
<div class="sr-only">
            <div {...regions.polite}>
                {#for message of regions.said('polite') key message.count}
                    <span>{message.text}</span>
                {/for}
            </div>
            <div {...regions.assertive}>
                {#for message of regions.said('assertive') key message.count}
                    <span>{message.text}</span>
                {/for}
            </div>
        </div>
<!-- The hosts an example's notices and prompts show in, ahead of the page for the same reason. -->
<div {...shown.region} class="fixed right-5 bottom-5 z-10 flex flex-col gap-2">
            {#for toast of shown.notices key toast.id}
                <div
                    {...shown.notice(toast).notice}
                    class="flex items-center gap-3 rounded-lg border border-rule bg-raised px-4 py-2
            text-chrome shadow-sm data-[tone=error]:border-bad data-[tone=success]:border-good"
                >
                    <span {...shown.notice(toast).text}>{toast.text}</span>
                    {#if toast.action}
                        <button {...shown.notice(toast).action}>{toast.action.label}</button>
                    {/if}
                    <button {...shown.notice(toast).close}>×</button>
                </div>
            {/for}
        </div>
<dialog
            {...asked.dialog}
            class="group m-auto w-96 rounded-xl border border-rule bg-raised p-5 text-ink
    backdrop:bg-ink/30"
        >
            {#if asked.current}
                <form {...asked.form} class="flex flex-col gap-2">
                    {#if asked.current?.title}
                        <h2 {...asked.title}>{asked.current?.title}</h2>
                    {/if}
                    {#if asked.current?.body}
                        <p {...asked.body}>{asked.current?.body}</p>
                    {/if}
                    {#if asked.typing}
                        <label {...asked.field}>
                            {#if asked.current?.mustType !== undefined}
                                Type {asked.current?.mustType} to confirm
                            {/if}
                            <input {...asked.input}>
                        </label>
                    {/if}
                    {#if asked.failed !== undefined}
                        <p {...asked.error} class="text-bad">{asked.failed}</p>
                    {/if}
                    <div {...asked.actions} class="mt-4 flex justify-end gap-2">
                        <button {...asked.confirm} class="group-data-[danger]:bg-bad">{asked.current?.confirm}</button>
                        {#if asked.current?.kind !== 'alert'}
                            <button {...asked.cancel}>{asked.current?.cancel}</button>
                        {/if}
                    </div>
                </form>
            {/if}
        </dialog>
<UpdateBanner />
<SiteBar />
<DocsNav />
<slot />
<div
            {...hints.hint}
            class="m-0 w-max max-w-60 rounded-md border border-rule bg-raised px-3 py-2 text-chrome
    text-ink shadow-sm"
        >{raw(hints.html)}</div>
    </body>
</html>
