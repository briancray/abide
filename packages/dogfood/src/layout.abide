<script server>
// The docs app's own hooks; each example files its own in its own file.
import { csp, middleware, onConfig } from '@abide/abide/server'

import { serveDownloads } from '#src/lib/serveDownloads.ts'

// The sign-in examples need a secret: one per process, or the deployment's.
const PRINCIPAL_SECRET = crypto.randomUUID()

onConfig(() => ({ ABIDE_PRINCIPAL_SECRET: PRINCIPAL_SECRET }))

middleware(serveDownloads)

// Every docs page's policy; 'self' so the docs can frame invoice previews.
middleware(csp({ 'frame-ancestors': ["'self'"] }))
</script>

<script>
import { onMenu, route, url, watch } from '@abide/abide'

import DocsNav from '#src/lib/DocsNav.abide'
import { ASK_ITEM, MENUS } from '#src/lib/nativeMenus.ts'
import SiteBar from '#src/lib/SiteBar.abide'
import UpdateBanner from '#src/lib/UpdateBanner.abide'
import '#src/lib/app.css'

// `?card=<id>` is one example card alone, as the prompt frames it in an answer (`Shown.abide`).
const query = route.query({ card: '' })

// The native app's menu bar; in a browser, nothing reads it (38.88).
onMenu(() => MENUS)
watch(() =>
    ASK_ITEM.on(() =>
        (document.getElementById('ask') as HTMLInputElement | null)?.focus(),
    ),
)
</script>

<html lang="en">
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <link
            rel="preload"
            href={url('/fonts/ibm-plex-sans.woff2')}
            as="font"
            type="font/woff2"
            crossorigin
         />
        <link
            rel="preload"
            href={url('/fonts/space-grotesk.woff2')}
            as="font"
            type="font/woff2"
            crossorigin
         />
    </head>
<body
        class="{query.card ? 'embed' : ''} grid grid-cols-[15.5rem_minmax(0,44rem)_1fr]
        max-rail:grid-cols-[15.5rem_minmax(0,1fr)] max-lg:grid-cols-1
        bg-paper font-sans text-prose/6 text-ink antialiased"
    >
        <a
            class="absolute -left-1000 focus:top-2 focus:left-2 focus:z-2
        focus:rounded-md focus:bg-raised focus:px-3 focus:py-2"
            href="#content"
        >Skip to content</a>
<UpdateBanner />
<SiteBar />
<DocsNav />
<slot />
    </body>
</html>
