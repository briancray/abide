<script server>
// The docs app's own hooks; each example files its own in its own file.
import { csp, middleware, onConfig } from '@abide/abide/server'
import '#src/lib/downloads.ts'

// The sign-in examples need a secret: one per process, or the deployment's.
const PRINCIPAL_SECRET = crypto.randomUUID()

onConfig(() => ({ ABIDE_PRINCIPAL_SECRET: PRINCIPAL_SECRET }))

// Every docs page's policy; 'self' so the docs can frame invoice previews.
middleware(csp({ 'frame-ancestors': ["'self'"] }))
</script>

<script>
import DocsNav from '#src/lib/DocsNav.abide'
import SiteBar from '#src/lib/SiteBar.abide'
import { url } from '@abide/abide'
import '#src/lib/app.css'
</script>

