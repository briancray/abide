<script>
import Code from '#src/lib/Code.abide'
import Doc from '#src/lib/Doc.abide'
import Section from '#src/lib/Section.abide'
</script>

<Doc
    seeAlso={[
        '/reactive/reactive',
        '/abide-files/expressions',
        '/reactive/refresh',
        '/reactive/tracking',
    ]}
    tests={[
        {
            path: 'packages/dogfood/examples/crm/src/contacts/lib/StarButton.test.ts',
            from: ["test('the click writes starred and the button follows'"],
        },
        {
            path: 'packages/abide/tests/lowering.test.ts',
            from: ["test('every assignment operator is a write"],
        },
        {
            path: 'packages/abide/tests/mutatePath.test.ts',
            from: ["test('a lifted mutator wakes its readers once"],
        },
    ]}
>
    <Section level={3} title="Star a contact by reading and assigning its name">
        <p>Name <code>starred</code> to read it and follow it. Assign to it to write it and wake
            every reader.</p>
        <Code language="abide" caption="abide" code={`
            <script>
            import { reactive } from '@abide/abide'
            let starred = reactive(false)
            </script>

            <button onclick={() => (starred = !starred)}>
                {starred ? '★ Starred' : '☆ Star'}
            </button>
        `} />
    </Section>

    <Section level={3} title="Change a city inside a contact's address">
        <p>A write through a path copies <code>contact</code> and its <code>address</code>, then
            writes the copy back. An array's <code>push</code> is the same write, on a copy.</p>
        <Code language="abide" caption="abide" code={`
            <script>
            import { reactive } from '@abide/abide'
            let contact = reactive({
                address: { city: 'London' },
                tags: ['investor'],
            })
            </script>

            <button onclick={() => (contact.address.city = 'Paris')}>Move</button>
            <button onclick={() => contact.tags.push('vip')}>Tag</button>
        `} />
    </Section>

    <Section level={3} title="Pass the reactive value where a Reactive is expected">
        <p>Where the position is typed <code>Reactive</code>, or takes a selection, the name is the
            value itself rather than a read of it.</p>
        <Code language="abide" caption="abide" code={`
            <script>
            import { type Reactive, reactive, refresh } from '@abide/abide'
            import listDeals from './listDeals.handler.ts'

            const deals = reactive(() => listDeals())
            const held: Reactive<Deal[]> = deals
            </script>

            <p>{deals.length} deals</p>
            <button onclick={() => refresh(deals)}>Reload</button>
        `} />
    </Section>

    <Section level={3} title="Write the explicit calls in a .ts file">
        <p>Outside a <code>.abide</code> file there is no sugar: call the value to read it and
            <code>set</code> to write it.</p>
        <Code language="ts" caption="shared" code={`
            import { reactive } from '@abide/abide'

            export const starred = reactive(false)
            export const toggle = () => starred.set(!starred())
        `} />
    </Section>
</Doc>
