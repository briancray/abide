<script server>
import { GET } from '@abide/abide/server'

const NOTES: Record<string, string[]> = {
    d1: ['Wants a two-year term.', 'Legal reviews on Friday.'],
}
const getNotes = GET(({ id }: { id: string }) => NOTES[id] ?? [])
</script>

<script>
import { reactive } from '@abide/abide'

const notes = reactive.derived(() => getNotes({ id: 'd1' }))
</script>

{#for note of notes}<p>{note}</p>{/for}
