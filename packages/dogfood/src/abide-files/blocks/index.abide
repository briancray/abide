<script>
import Code from '#src/lib/Code.abide'
import Doc from '#src/lib/Doc.abide'
import Example from '#src/lib/Example.abide'
import Section from '#src/lib/Section.abide'

import CallRow from './lib/CallRow.abide'
import callRow from './lib/CallRow.abide' with { type: 'text' }
import DealNotes from './lib/DealNotes.abide'
import dealNotes from './lib/DealNotes.abide' with { type: 'text' }
import LeadBadge from './lib/LeadBadge.abide'
import leadBadge from './lib/LeadBadge.abide' with { type: 'text' }
</script>

<Doc
    seeAlso={[
        '/abide-files/props',
        '/abide-files/components',
        '/handlers/get',
        '/pages/files',
    ]}
    tests={[
        {
            path: 'packages/dogfood/examples/crm/src/profile/lib/CallLog.test.ts',
            from: [
                "test('each row keeps its own count, and the module numbers them'",
            ],
        },
        {
            path: 'packages/dogfood/examples/crm/src/profile/lib/StageBadges.test.ts',
            from: ["test('each badge carries its own scope token, not the other'"],
        },
        {
            path: 'packages/abide/tests/componentExports.test.ts',
            from: ["test('a page and a handler file call what a component exports"],
        },
    ]}
>
    <Section level={3} title="Count calls per row and number the rows once">
        <p>A <code>&lt;script&gt;</code> runs for each instance, so each row has its own
            <code>calls</code>. A <code>&lt;script module&gt;</code> runs once for the file, and
            what it exports is a named export of the <code>.abide</code>.</p>
        <Example code={callRow}>
            <ul>
                <CallRow />
                <CallRow />
                <CallRow />
            </ul>
        </Example>
    </Section>

    <Section level={3} title="Keep a deal's notes on the server beside the markup">
        <p>A <code>&lt;script server&gt;</code> never reaches the browser. A handler it declares
            is private to the file, and the browser gets a call in its place.</p>
        <Example code={dealNotes}><DealNotes /></Example>
    </Section>

    <Section level={3} title="Style a badge without the class leaking to other components">
        <p>A <code>&lt;style&gt;</code> block reaches only its own component's markup, so
            another component's <code>.badge</code> keeps its own look.</p>
        <Example code={leadBadge}><LeadBadge /></Example>
    </Section>

    <Section level={3} title="Load the app's stylesheet with the layout">
        <p>Import a stylesheet from a script and it ships with the component that imports it.</p>
        <Code language="abide" caption="abide" code={`
            <script>
            import './lib/app.css'
            </script>
        `} />
    </Section>
</Doc>
