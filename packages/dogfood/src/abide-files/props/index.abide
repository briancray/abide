<script>
import Code from '#src/lib/Code.abide'
import Doc from '#src/lib/Doc.abide'
import Section from '#src/lib/Section.abide'
</script>

<Doc
    seeAlso={[
        '/abide-files/components',
        '/abide-files/by-name',
        '/abide-files/expressions',
        '/reactive/reactive',
    ]}
    tests={[
        {
            path: 'packages/abide/tests/props.test.ts',
            from: [
                "test('a prop re-reads when the caller value moves, and nothing is rebuilt",
            ],
        },
        {
            path: 'packages/abide/tests/props.test.ts',
            from: ["test('a default prop is answered where the caller passed none"],
        },
        {
            path: 'packages/abide/tests/spread.test.ts',
            from: ['test("bind:prop hands the child'],
        },
    ]}
>
    <Section level={3} title="Show an amount in the currency the caller picks">
        <p>Destructure <code>props</code> with a type. Each name is a live read of what the caller
            passed, and a default stands where the caller passed none.</p>
        <Code language="abide" caption="abide" code={`
            <script>
            import { props } from '@abide/abide'

            const { amount, currency = 'USD' } = props<{
                amount: number
                currency?: string
            }>()
            </script>

            <strong>{currency} {amount.toFixed(2)}</strong>
        `} />
    </Section>

    <Section level={3} title="Let a child tidy the email its caller holds">
        <p>Pass a prop with <code>bind:</code> and a write to it in the child reaches the
            caller's value, as in <code>&lt;EmailField bind:value=&#123;email&#125; /&gt;</code>.</p>
        <Code language="abide" caption="abide" code={`
            <script>
            import { props } from '@abide/abide'
            const { value } = props<{ value: string }>()
            </script>

            <p>{value}</p>
            <button onclick={() => (value = value.trim().toLowerCase())}>
                Tidy
            </button>
        `} />
    </Section>

    <Section level={3} title="Edit a draft that starts over when the contact changes">
        <p>A derived value over a prop takes writes, and each write stands until the prop
            changes.</p>
        <Code language="abide" caption="abide" code={`
            <script>
            import { props, reactive } from '@abide/abide'

            const { name } = props<{ name: string }>()
            let draft = reactive(() => name)
            </script>

            <input bind:value={draft}>
        `} />
    </Section>

    <Section level={3} title="Pass a button's own attributes through a wrapper">
        <p><code>Attributes&lt;Tag&gt;</code> types the element's attributes as props, and a rest
            element spreads them on.</p>
        <Code language="abide" caption="abide" code={`
            <script>
            import { type Attributes, props } from '@abide/abide'

            const { label, ...rest } = props<
                { label: string } & Attributes<'button'>
            >()
            </script>

            <button class="action" {...rest}>{label}</button>
        `} />
    </Section>
</Doc>
