<script>
import Doc from '#src/lib/Doc.abide'
import Example from '#src/lib/Example.abide'
import Section from '#src/lib/Section.abide'

import BindFields from './lib/BindFields.abide'
import bindFields from './lib/BindFields.abide' with { type: 'text' }
import ContactName from './lib/ContactName.abide'
import contactName from './lib/ContactName.abide' with { type: 'text' }
import FocusSearch from './lib/FocusSearch.abide'
import focusSearch from './lib/FocusSearch.abide' with { type: 'text' }
import OverdueInvoice from './lib/OverdueInvoice.abide'
import overdueInvoice from './lib/OverdueInvoice.abide' with { type: 'text' }
import SpreadField from './lib/SpreadField.abide'
import spreadField from './lib/SpreadField.abide' with { type: 'text' }
</script>

<Doc
    seeAlso={[
        '/abide-files/by-name',
        '/abide-files/raw',
        '/abide-files/control-flow',
        '/abide-files/props',
        '/pages/sinks',
    ]}
    tests={[
        {
            path: 'packages/abide/tests/bind.test.ts',
            from: [
                "test('bind:value reads the property and writes it back on input",
            ],
        },
        {
            path: 'packages/abide/tests/bind.test.ts',
            from: ["test('bind:group holds the radio chosen, or the boxes checked"],
        },
        {
            path: 'packages/abide/tests/hydrate.test.ts',
            from: [
                "test('a class: directive toggles one class and keeps the others",
            ],
        },
    ]}
>
    <Section level={3} title="Put a contact's name in text and in an attribute">
        <p>An expression in braces fills text, a whole attribute, or part of a quoted one, and
            follows what it reads. Text is escaped.</p>
        <Example code={contactName}><ContactName /></Example>
    </Section>

    <Section level={3} title="Keep a form field and its value in step">
        <p><code>bind:</code> sets the field from the value and writes the value back as the
            reader types, ticks or picks.</p>
        <Example code={bindFields}><BindFields /></Example>
    </Section>

    <Section level={3} title="Flag an overdue invoice with one class and one style">
        <p><code>class:name</code> adds the class while its condition holds and leaves the others
            alone. <code>style:prop</code> sets one property.</p>
        <Example code={overdueInvoice}><OverdueInvoice /></Example>
    </Section>

    <Section level={3} title="Focus the search box from a button">
        <p><code>bind:element</code> hands you the node, in a <code>Reactive</code> or to a
            callback whose returned disposer runs when the node leaves.</p>
        <Example code={focusSearch}><FocusSearch /></Example>
    </Section>

    <Section level={3} title="Pass a set of attributes through at once">
        <p>A spread writes every key as an attribute, or as a prop on a component, and keeps them
            in step with the value.</p>
        <Example code={spreadField}><SpreadField /></Example>
    </Section>
</Doc>
