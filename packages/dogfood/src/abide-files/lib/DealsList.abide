<script>
import { reactive } from '@abide/abide'

const deals = [
    { id: 'd1', name: 'Acme renewal', stage: 'proposal' },
    { id: 'd2', name: 'Hopper onboarding', stage: 'won' },
    { id: 'd3', name: 'Lovelace pilot', stage: 'lead' },
]
let showWon = reactive(false)
</script>

<button onclick={() => (showWon = !showWon)}>
    {showWon ? 'Hide won deals' : 'Show won deals'}
</button>
<ul>
    {#for deal of deals key deal.id}
        {#if showWon || deal.stage !== 'won'}
            <li>{deal.name}</li>
        {/if}
    {/for}
</ul>
