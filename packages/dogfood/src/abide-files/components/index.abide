<script>
import Code from '#src/lib/Code.abide'
import Doc from '#src/lib/Doc.abide'
import Example from '#src/lib/Example.abide'
import Section from '#src/lib/Section.abide'

import Card from './lib/Card.abide'
import card from './lib/Card.abide' with { type: 'text' }
import dealList from './lib/DealList.abide' with { type: 'text' }
import DealNotes from './lib/DealNotes.abide'
import dealNotes from './lib/DealNotes.abide' with { type: 'text' }
import PipelineRows from './lib/PipelineRows.abide'
import pipelineRows from './lib/PipelineRows.abide' with { type: 'text' }
import StageBadges from './lib/StageBadges.abide'
import stageBadges from './lib/StageBadges.abide' with { type: 'text' }
</script>

<Doc
    seeAlso={[
        '/abide-files/props',
        '/abide-files/blocks',
        '/abide-files/control-flow',
    ]}
    tests={[
        {
            path: 'packages/abide/tests/slot.test.ts',
            from: [
                "test('a caller writes markup between the tags and the child places it",
            ],
        },
        {
            path: 'packages/abide/tests/slot.test.ts',
            from: ["test('a slot with no children renders its fallback"],
        },
        {
            path: 'packages/abide/tests/inlineComponent.test.ts',
            from: [
                "test('an inline component written between the tags is passed as a prop",
            ],
        },
    ]}
>
    <Section level={3} title="Wrap a contact's details in a shared card">
        <p>Write <code>&lt;Card title="Ada"&gt;…&lt;/Card&gt;</code> and the markup between the
            tags renders where the card puts <code>&lt;slot/&gt;</code>.</p>
        <Example code={card}>
            <Card title="Ada Lovelace"><p>ada@example.com</p></Card>
        </Example>
    </Section>

    <Section level={3} title="Show a fallback when a caller passes no children">
        <p>The markup inside <code>&lt;slot&gt;</code> renders only where the caller wrote nothing
            between the tags.</p>
        <Example code={dealNotes}><DealNotes /></Example>
    </Section>

    <Section level={3} title="Name a row's markup inside the file that renders the list">
        <p><code>&#123;#component&#125;</code> declares a component inline, closed over the file's
            values, for markup worth naming but not worth a file.</p>
        <Example code={stageBadges}><StageBadges /></Example>
    </Section>

    <Section level={3} title="Hand a list component the markup of each row">
        <p>An inline component written between a component's tags is passed to it as the prop its
            name spells. Here <code>DealList.abide</code> takes a <code>Row</code> and renders it
            for each deal, and the file using it writes what a row holds.</p>
        <Code language="abide" caption="abide" code={dealList} />
        <Example code={pipelineRows}><PipelineRows /></Example>
    </Section>
</Doc>
