<script server>
export const getForecast = async () => {
    await Bun.sleep(1500)
    return 128400
}
</script>

<script>
import { format, reactive } from '@abide/abide'

const forecast = reactive(() => getForecast())
</script>

{#try}
    <strong>{format.money(forecast, { maximumFractionDigits: 0 })}</strong>
{:pending}
    <p>Adding up the pipeline…</p>
{:catch problem}
    <p>{problem.message}</p>
{:finally}
    <small>Weighted by stage.</small>
{/try}
