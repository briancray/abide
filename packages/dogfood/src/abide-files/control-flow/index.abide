<script>
import Doc from '#src/lib/Doc.abide'
import Example from '#src/lib/Example.abide'
import Section from '#src/lib/Section.abide'

import FollowUpDate from './lib/FollowUpDate.abide'
import followUpDate from './lib/FollowUpDate.abide' with { type: 'text' }
import ForecastPending from './lib/ForecastPending.abide'
import forecastPending from './lib/ForecastPending.abide' with { type: 'text' }
import FreshPanel from './lib/FreshPanel.abide'
import freshPanel from './lib/FreshPanel.abide' with { type: 'text' }
import NumberedDeals from './lib/NumberedDeals.abide'
import numberedDeals from './lib/NumberedDeals.abide' with { type: 'text' }
import RemoveDeal from './lib/RemoveDeal.abide'
import removeDeal from './lib/RemoveDeal.abide' with { type: 'text' }
</script>

<Doc
    seeAlso={[
        '/abide-files/expressions',
        '/abide-files/components',
        '/reactive/ready',
        '/reactive/refuse',
        '/pages/sinks',
    ]}
    tests={[
        {
            path: 'packages/dogfood/examples/crm/src/profile/lib/FollowUp.test.ts',
            from: [
                "test('the date field is in the page only while the box is ticked'",
            ],
        },
        {
            path: 'packages/dogfood/examples/crm/src/profile/lib/Tags.test.ts',
            from: ["test('removing a tag removes its row and rewrites no other'"],
        },
        {
            path: 'packages/abide/tests/try.test.ts',
            from: [
                "test('the server renders the body, or the catch where the body throws",
            ],
        },
    ]}
>
    <Section level={3} title="Ask for a follow-up date only when the box is ticked">
        <p><code>&#123;#if&#125;</code> builds the arm it takes and nothing of the others.</p>
        <Example code={followUpDate}><FollowUpDate /></Example>
    </Section>

    <Section level={3} title="Remove one deal from a list and leave the other rows alone">
        <p><code>key</code> says which row is which, so removing a deal removes its row. Without a
            key, rows match by position.</p>
        <Example code={removeDeal}><RemoveDeal /></Example>
    </Section>

    <Section level={3} title="Number the deals, and keep the numbers right after a removal">
        <p>Name a second variable after the item for its position. A row that moves reads its new
            position, so removing the first deal renumbers the rest without rebuilding them.</p>
        <Example code={numberedDeals}><NumberedDeals /></Example>
    </Section>

    <Section level={3} title="Hold a placeholder until the forecast first lands">
        <p><code>&#123;:pending&#125;</code> stands in for the body until its first load, and
            <code>&#123;:catch&#125;</code> replaces the body when rendering it throws.
            <code>&#123;:finally&#125;</code> stands after whichever arm shows, the placeholder
            included.</p>
        <Example code={forecastPending}><ForecastPending /></Example>
    </Section>

    <Section level={3} title="Build a contact panel fresh for each contact">
        <p>A one-item list keyed by the contact makes a new row when the key changes, so a fade-in
            or an uncontrolled field starts over.</p>
        <Example code={freshPanel}><FreshPanel /></Example>
    </Section>
</Doc>
