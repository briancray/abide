<script>
import { reactive } from '@abide/abide'
import { totals } from './totals.ts'

let days = reactive(7)
const shown = reactive(() => totals(days))
</script>

<div class="tabs">
    {#for choice of [7, 30]}
        <button aria-selected={days === choice} onclick={() => (days = choice)}>
            {choice} days
        </button>
    {/for}
</div>
<ul class="tiles">
    <li><span>visitors</span><strong>{shown.visitors}</strong></li>
    <li><span>signups</span><strong>{shown.signups}</strong></li>
    <li><span>revenue</span><strong>${shown.revenue}</strong></li>
</ul>
