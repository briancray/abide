<script>
import { reactive } from '@abide/abide'
import { money } from './money.ts'

let deals = reactive([
    { name: 'Analytical Engines', amount: 8000 },
    { name: 'Hopper & Co', amount: 4400 },
])

function addDeal() {
    deals = [...deals, { name: 'Lovelace Ltd', amount: 12500 }]
}
</script>

<ul class="fields">
    {#for deal of deals by deal.name}
        <li>
            <span>{deal.name}</span><strong>{money.format(deal.amount)}</strong>
        </li>
    {/for}
</ul>
<div class="row">
    <button onclick={addDeal}>Add a deal</button>
</div>
