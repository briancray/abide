<script>
import { props, reactive } from '@abide/abide'
import { type Message, messagesOf } from './messages.ts'

const { opening = messagesOf(4) } = props<{ opening?: Message[] }>()
let messages = reactive(opening)

function nextTurn() {
    messages = messagesOf(messages.length + 2)
}
</script>

<ul class="chat">
    {#for message, at of messages by at}
        <li data-speaker={message.speaker}>
            <span>{message.speaker}</span><p>{message.text}</p>
        </li>
    {/for}
</ul>
<div class="row">
    <button onclick={nextTurn}>Next turn</button>
</div>
