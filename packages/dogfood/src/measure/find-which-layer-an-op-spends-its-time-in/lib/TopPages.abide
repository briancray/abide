<script>
import { reactive } from '@abide/abide'
import { topFive } from './rankPages.ts'

let by = reactive<'views' | 'signups'>('views')
const top = reactive(() => topFive(by))
</script>

<div class="tabs">
    {#for choice of ['views', 'signups'] as const}
        <button aria-selected={by === choice} onclick={() => (by = choice)}>
            By {choice}
        </button>
    {/for}
</div>
<ul class="fields">
    {#for page of top by page.path}
        <li><span>{page.path}</span><strong>{page[by]}</strong></li>
    {/for}
</ul>
