<script>
import Code from '#src/lib/Code.abide'
import Doc from '#src/lib/Doc.abide'
import Section from '#src/lib/Section.abide'
</script>

<Doc
    seeAlso={[
        '/ambients/abort-signal',
        '/orchestration/pipe',
        '/orchestration/worker-files',
        '/operating/log',
        '/data/database',
        '/handlers/rpc',
    ]}
    tests={[
        {
            path: 'packages/abide/tests/job.test.ts',
            from: ["test('a run asked for while one is in flight joins it"],
        },
        {
            path: 'packages/dogfood/examples/crm/src/ops/lib/DealImport.test.ts',
            from: [
                "test('an import asked for while one is running is refused 409'",
            ],
        },
        {
            path: 'packages/dogfood/examples/crm/src/ops/lib/DealImport.test.ts',
            from: [
                "test('an import asked for one stage imports only the deals at it'",
            ],
        },
        {
            path: 'packages/abide/tests/job.test.ts',
            from: [
                "test('Job.run hands the run its input, and a look hands it undefined",
            ],
        },
        {
            path: 'packages/abide/tests/job.test.ts',
            from: [
                "test('a last run within the interval is waited out, and an older one is run at once",
            ],
        },
        {
            path: 'packages/abide/tests/job.test.ts',
            from: [
                "test('a failed run rejects, is logged under job:<name> and kept",
            ],
        },
        {
            path: 'packages/abide/tests/job.test.ts',
            from: [
                "test('a job measured from the start names its next run an interval after the last run started",
            ],
        },
        {
            path: 'packages/abide/tests/job.test.ts',
            from: [
                "test('a paused job starts no run from a look, and Job.run still runs — 54.31'",
            ],
        },
        {
            path: 'packages/abide/tests/workerFiles.test.ts',
            from: [
                "test('a job whose run is a worker export runs it off the main thread, and stopping it ends the thread",
            ],
        },
        {
            path: 'packages/abide/tests/job.test.ts',
            from: [
                "test('a pipe called in a run is told to stop when the job stops",
            ],
        },
        {
            path: 'packages/abide/tests/job.test.ts',
            from: [
                "test('a cron job never run waits for its first time, and missed times run once",
            ],
        },
        {
            path: 'packages/abide/tests/job.test.ts',
            from: ["test('a cron job reads its times in its timeZone"],
        },
        {
            path: 'packages/abide/tests/job.test.ts',
            from: [
                "test('a job given delay makes its first look that long after the app opens",
            ],
        },
    ]}
>
    <Section level={3} title="Mail the team a follow-up digest at eight on weekday mornings">
        <p>Declare the job at the top of a server file. <code>cron</code> names the times a run
            is due, and <code>timeZone</code> the clock they are read on. Nothing runs as the
            file loads: the first run waits for its time, and the app's stop ends the schedule.</p>
        <Code language="ts" caption="server" code={`
            import { log } from '@abide/abide'
            import { job } from '@abide/abide/server'
            import { DEALS } from '../../pipeline/lib/DEALS.server.ts'

            export const digest = job({
                name: 'digest',
                cron: '0 8 * * 1-5',
                timeZone: 'America/New_York',
                run: async () => {
                    const leads = DEALS.filter((deal) => deal.stage === 'lead')
                    await Bun.sleep(300) // the mail going out
                    log.info(\`digest sent: \${leads.length} leads to follow up\`)
                },
            })
        `} />
    </Section>

    <Section level={3} title="Serve the digest's status to every page">
        <p><code>status</code> is one value for every caller, written as each run starts and
            ends, so a handler serves it as it is.</p>
        <Code language="ts" caption="server" code={`
            import { rpc } from '@abide/abide/server'
            import { digest } from './lib/digest.server.ts'

            export default rpc(digest.status)
        `} />
    </Section>

    <Section level={3} title="Send the digest now without sending it twice">
        <p><code>Job.run</code> joins a run in flight rather than start a second, so pressing Send
            twice mails the team once. It rejects with what a failed run threw or refused, so the
            press is refused with it; <code>status</code> keeps it as <code>lastError</code>.</p>
        <Code language="ts" caption="server" code={`
            import { rpc } from '@abide/abide/server'
            import { digest } from './lib/digest.server.ts'

            export default rpc(() => digest.run(), { methods: ['POST'] })
        `} />
    </Section>

    <Section level={3} title="Start an import by hand, and refuse a second press while it runs">
        <p>A job whose <code>every</code> is 0 never runs on its own, so <code>Job.run</code> from a
            handler is the only start. Leave the run in flight and answer with
            <code>status</code>; a press while <code>running</code> reads true is refused 409.</p>
        <Code language="ts" caption="server" code={`
            import { refuse } from '@abide/abide'
            import { job, rpc } from '@abide/abide/server'

            export const dealImport = job({
                name: 'dealImport',
                every: 0,
                run: importDeals,
            })

            const importRunning = refuse.named('ImportRunning', {
                status: 409,
                message: 'An import is already running.',
            })

            export default rpc(
                async () => {
                    if ((await dealImport.status()).running) return importRunning()
                    void dealImport.run()
                    return dealImport.status()
                },
                { methods: ['POST'] },
            )
        `} />
    </Section>

    <Section level={3} title="Import only the deals at one stage">
        <p>What <code>Job.run</code> is given is what <code>run</code> is handed, so a press can say
            what to import. A run the schedule starts is handed <code>undefined</code>, and the input
            of a <code>Job.run</code> that joins a run in flight is never read.</p>
        <Code language="ts" caption="server" code={`
            import { log } from '@abide/abide'
            import { job, rpc } from '@abide/abide/server'
            import { DEALS } from '../../pipeline/lib/DEALS.server.ts'

            export const dealImport = job({
                name: 'dealImport',
                every: 0,
                run: async (options?: { stage?: string }) => {
                    const deals = DEALS.filter(
                        (deal) =>
                            options?.stage === undefined ||
                            deal.stage === options.stage,
                    )
                    await Bun.sleep(300) // the old CRM paging out its deals
                    log.info(\`imported: \${deals.length} deals\`)
                },
            })

            export default rpc((options: { stage?: string } = {}) =>
                dealImport.run(options),
             { methods: ['POST'] },)
        `} />
    </Section>

    <Section level={3} title="Keep a restart from sending the digest again">
        <p>A job that has not run waits for its next time, so a morning missed while the server
            was down is lost. Give it a <code>store</code>, and its status is kept there: a restart
            reads when the last run ended, sends a missed morning once however many it missed,
            waits for the next where it missed none, and keeps the last run's result.</p>
        <Code language="ts" caption="server" code={`
            import { job, store } from '@abide/abide/server'
            import { crmDatabase } from '../../pipeline/lib/crmDatabase.server.ts'

            job({
                name: 'digest',
                cron: '0 8 * * 1-5',
                timeZone: 'America/New_York',
                run: mailDigest,
                store: store.sqlite(crmDatabase, 'digest'),
            })
        `} />
    </Section>

    <Section level={3} title="Score deals every five minutes from the start of each run">
        <p><code>from: 'start'</code> measures <code>every</code> from when the last run
            started. A run due while the last one overran starts at the look after it ends.</p>
        <Code language="ts" caption="server" code={`
            import { job } from '@abide/abide/server'

            job({ name: 'score', every: 300_000, from: 'start', run: scoreAll })
        `} />
    </Section>

    <Section level={3} title="Start scoring a minute after the server opens">
        <p><code>delay</code> holds the first look back that many milliseconds after the app
            opens, so a server that has just started answers its first requests before the work
            begins. The looks after it keep the schedule.</p>
        <Code language="ts" caption="server" code={`
            import { job } from '@abide/abide/server'

            job({ name: 'score', every: 3_600_000, delay: 60_000, run: scoreAll })
        `} />
    </Section>

    <Section level={3} title="Run the scoring in a thread of its own">
        <p>A worker file's export is a function a job's <code>run</code> can be: each run is a
            thread of its own, and the call answers the run's <code>abortSignal()</code>, so
            stopping the job ends the thread.</p>
        <Code language="ts" caption="server" code={`
            import { job } from '@abide/abide/server'

            import { scoreDeals } from './scoreDeals.worker.ts'

            job({ name: 'score', every: 300_000, run: scoreDeals })
        `} />
    </Section>

    <Section level={3} title="Hold the scoring while a migration runs">
        <p><code>paused</code> is read as state: while it reads true no look starts a run, and the
            look its turning false makes runs one that is due. <code>Job.run</code> still runs.</p>
        <Code language="ts" caption="server" code={`
            import { job, reactive } from '@abide/abide/server'

            import { scoreDeals } from './scoreDeals.worker.ts'

            export const migrating = reactive(false)
            job({ name: 'score', every: 300_000, paused: migrating, run: scoreDeals })
        `} />
    </Section>

    <Section level={3} title="Run a pipe of steps on a schedule">
        <p>A <code>pipe</code> called in a run reads the run's <code>abortSignal()</code>, so the
            job's stop ends the steps in flight with no signal handed to it.</p>
        <Code language="ts" caption="server" code={`
            import { job, pipe } from '@abide/abide/server'
            import getDeal from '../deals/getDeal.server.ts'

            const nightly = pipe([() => getDeal({ id: 'd2' }), (deal) => deal.name])
            job({
                name: 'nightly',
                every: 86_400_000,
                run: () => nightly(undefined),
            })
        `} />
    </Section>
</Doc>
