<script>
import { url } from '@abide/abide'

import Code from '#src/lib/Code.abide'
import Doc from '#src/lib/Doc.abide'
import Section from '#src/lib/Section.abide'
</script>

<Doc
    seeAlso={['/reactive/derived', '/ambients/abort-signal', '/orchestration/job']}
    tests={[
        {
            path: 'packages/abide/tests/pipe.test.ts',
            from: [
                "test('a call resolves to its answer and rejects with a refusal, and a computed over it fails with it — 57.5, 15.5'",
            ],
        },
        {
            path: 'packages/abide/tests/pipe.test.ts',
            from: [
                "test('stop aborts every attempt in flight and refuses every later call — 57.18'",
            ],
        },
        {
            path: 'packages/abide/tests/pipe.test.ts',
            from: [
                "test('a pipe used as a step of two pipes is one budget for both — 57.8'",
            ],
        },
        {
            path: 'packages/abide/tests/pipe.test.ts',
            from: [
                "test('a streaming step fans out, each chunk through the rest in order — 57.4, 57.5'",
            ],
        },
        {
            path: 'packages/abide/tests/pipe.test.ts',
            from: [
                "test('the stream face keeps the order written and closes once drained — 57.16, 57.19, 57.20'",
            ],
        },
    ]}
>
    <Section level={3} title="Tidy a deal's name and save the deal">
        <p>Each step is handed what the one before it answered. A pipe is an async function:
            call it with a deal, and it resolves to what the last step answered, and rejects with
            the refusal a step answered, as a handler's call does.</p>
        <Code language="ts" caption="shared" code={`
            import { pipe } from '@abide/abide'
            import getDeal from './getDeal.handler.ts'
            import saveDeal from './saveDeal.handler.ts'

            const rename = pipe([
                (id: string) => getDeal({ id }),
                (deal) => ({ ...deal, name: deal.name.trim() }),
                (deal) => saveDeal(deal),
            ])
            await rename('d2')
        `} />
    </Section>

    <Section level={3} title="Show a save in progress">
        <p>Call the pipe in a <a href={url('/reactive/derived')}><code>reactive.derived</code></a> to
            hold its answer as a value: it is <code>busy()</code> while the item runs, and a refusal
            is its <code>error()</code>. A run the derived value replaces aborts its item.</p>
        <Code language="abide" caption="abide" code={`
            <script>
            import { pipe, reactive } from '@abide/abide'
            import saveDeal from './saveDeal.handler.ts'

            const save = pipe([saveDeal], { retries: 2 })
            const saved = reactive.derived(() =>
                save({ id: 'd2', name: 'Acme', company: 'Acme', amount: 9 }),
            )
            </script>

            {#if saved.busy()}<p>Saving…</p>{/if}
            {#if saved.error()}<p>{saved.error().message}</p>{/if}
        `} />
    </Section>

    <Section level={3} title="Look a deal up three ways at once">
        <p>A list is one step: each member is handed the same input, they run at once, and the next
            step is handed their answers in the list's order.</p>
        <Code language="ts" caption="shared" code={`
            import { pipe } from '@abide/abide'
            import getContact from './getContact.handler.ts'
            import getCompany from './getCompany.handler.ts'
            import getDeal from './getDeal.handler.ts'

            const brief = pipe([
                (id: string) => getDeal({ id }),
                [
                    (deal) => getContact({ id: deal.contactId }),
                    (deal) => getCompany({ id: deal.companyId }),
                ],
                ([contact, company]) => \`\${contact.name} at \${company.name}\`,
            ])
        `} />
    </Section>

    <Section level={3} title="Sync one contact at a time, four contacts at once">
        <p><code>concurrency</code> caps how many items run, one where none is given, and
            <code>group</code> counts it per group: one contact's syncs wait on each other, and another
            contact's do not.</p>
        <Code language="ts" caption="shared" code={`
            import { pipe } from '@abide/abide'
            import syncContact from './syncContact.handler.ts'

            export const syncs = pipe([syncContact], {
                concurrency: 4,
                group: (contact: { id: string }) => contact.id,
            })
        `} />
    </Section>

    <Section level={3} title="Watch one step of a pipe">
        <p>A step can be a pipe, with a <code>status</code> of its own to read. It counts its own
            items, one at a time where it is given no <code>concurrency</code> — whatever the
            pipe around it allows — so give it the same.</p>
        <Code language="ts" caption="shared" code={`
            import { pipe } from '@abide/abide'
            import getDeal from './getDeal.handler.ts'
            import saveDeal from './saveDeal.handler.ts'

            const byId = (id: string) => getDeal({ id })
            export const fetched = pipe([byId], { concurrency: 4 })
            export const sync = pipe([fetched, saveDeal], { concurrency: 4 })
            (await fetched.status()).running // deals being fetched
        `} />
    </Section>

    <Section level={3} title="Ask a rate-limited service again, later">
        <p>A step that throws, or answers a refusal worth asking again, is retried up to
            <code>retries</code>, waiting <code>backoff</code> doubled. A
            <code>Retry-After</code> holds the step for every item until the time it names.</p>
        <Code language="ts" caption="server" code={`
            import { fetchAndHandle, pipe } from '@abide/abide/server'

            const lookup = (domain: string) =>
                fetchAndHandle(\`https://enrich.example/\${domain}\`, { retries: 0 })

            export const enrich = pipe([lookup], {
                concurrency: 4,
                retries: 3,
                backoff: 1_000,
                timeout: 10_000,
            })
        `} />
    </Section>

    <Section level={3} title="Pipe a stream of deals through a pipe">
        <p>A pipe is a stream pair too. Items leave in the order they went in, and one that fails
            leaves as a refusal while the rest run on.</p>
        <Code language="ts" caption="shared" code={`
            import { pipe } from '@abide/abide'

            const scored = pipe([(deal: { value: number }) => deal.value / 1000], {
                concurrency: 8,
            })
            await ReadableStream.from(deals).pipeThrough(scored).pipeTo(report)
        `} />
    </Section>

    <Section level={3} title="Finish what was queued, then close">
        <p>Close the pipe's <code>writable</code> and its <code>readable</code> closes once every
            item written has left: nothing queued is dropped.</p>
        <Code language="ts" caption="shared" code={`
            import { pipe } from '@abide/abide'

            const scored = pipe([(deal: { value: number }) => deal.value / 1000])
            const writer = scored.writable.getWriter()
            for (const deal of deals) await writer.write(deal)
            await writer.close() // scored.readable ends after the last deal
        `} />
    </Section>

    <Section level={3} title="Stop a pipe for good">
        <p><code>stop()</code> aborts every attempt in flight through its signal and refuses
            every call after. It settles once nothing runs.</p>
        <Code language="ts" caption="shared" code={`
            import { pipe } from '@abide/abide'
            import syncContact from './syncContact.handler.ts'

            const syncs = pipe([syncContact], { concurrency: 4 })
            await syncs.stop()
        `} />
    </Section>

    <Section level={3} title="Hold the queue while a call is on">
        <p><code>paused</code> is read as state: while it reads true no attempt starts, and the
            ones running finish.</p>
        <Code language="ts" caption="shared" code={`
            import { pipe, reactive } from '@abide/abide'
            import logToFeed from './logToFeed.handler.ts'

            const onCall = reactive(false)
            const activity = pipe([logToFeed], { paused: onCall })
        `} />
    </Section>
</Doc>
