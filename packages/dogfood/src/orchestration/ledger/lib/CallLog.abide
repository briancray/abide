<script>
import { ledger, reactive } from '@abide/abide'

const calls = ledger<{ contact: string; minutes: number }>()
const logged = reactive(() => calls())
</script>

<button onclick={() => calls.append({ contact: 'Ada', minutes: 12 })}>
    Log a call
</button>
{#if logged.ready()}
    {#for call of logged key call.seq}
        <p>{call.entry.contact}: {call.entry.minutes} min</p>
    {/for}
{/if}
