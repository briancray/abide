<script>
import { reactive } from '@abide/abide'
import { salesCsv } from '#server/rpc/bytesCsvSales'

const file = reactive(async () => {
    const raw = await salesCsv.raw({ year: 2026 })
    const type = raw.headers.get('content-type')
    return { type, body: await raw.text() }
})
</script>

<ul class="fields stacked">
    <li><span>content-type</span><strong>{file.type}</strong></li>
</ul>

<pre class="rounded-md border border-rule bg-raised p-3">{file.body}</pre>

<div class="row">
    <a href={salesCsv.url({ year: 2026 })} download="sales-2026.csv">
        Download sales-2026.csv</a>
</div>
