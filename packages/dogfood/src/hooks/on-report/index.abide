<script>
import Code from '#src/lib/Code.abide'
import Doc from '#src/lib/Doc.abide'
import Section from '#src/lib/Section.abide'
</script>

<Doc
    seeAlso={['/helpers/report', '/hooks/on-error', '/hooks/on-refusal']}
    tests={[
        {
            path: 'packages/abide/tests/report.test.ts',
            from: [
                "test('a sent report reaches every onReport with its secrets taken out",
            ],
        },
        {
            path: 'packages/abide/tests/report.test.ts',
            from: ["test('a report with no onReport filed is refused"],
        },
    ]}
>
    <Section level={3} title="File each problem report in the issue tracker">
        <p>Every report a person sends reaches the hook, its secrets already taken out. Throw
            when the tracker fails, and the sender is refused and can send again.</p>
        <Code language="abide" caption="abide" code={`
            <script server>
            import { onReport } from '@abide/abide/server'

            onReport(async (report) => {
                const answer = await fetch('https://tracker.example/issues', {
                    method: 'POST',
                    body: JSON.stringify({
                        title: report.summary,
                        body: report.markdown,
                    }),
                })
                if (!answer.ok) throw new Error(\`tracker answered \${answer.status}\`)
            })
            </script>
        `} />
    </Section>
</Doc>
