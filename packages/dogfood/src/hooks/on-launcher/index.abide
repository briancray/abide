<script>
import Code from '#src/lib/Code.abide'
import Doc from '#src/lib/Doc.abide'
import Section from '#src/lib/Section.abide'
</script>

<Doc
    seeAlso={[
        '/native-app/native',
        '/native-app/pending-update',
        '/native-app/on-menu',
        '/cli/commands',
    ]}
    tests={[
        {
            path: 'packages/abide/tests/launcher.test.ts',
            from: [
                "test('what onLauncher answers fills its defaults and refuses what it does not take",
            ],
        },
        {
            path: 'packages/abide/tests/launcher.test.ts',
            from: [
                "test('the launch reads what launcher.abide files with onLauncher",
            ],
        },
    ]}
>
    <Section level={3} title="Size the CRM's window and point it at its updates">
        <p>Call the hook in <code>src/native/launcher.abide</code>, the one file it is allowed
            in. <code>update</code> is the address every copy checks for a newer version.</p>
        <Code language="abide" caption="abide" code={`
            <script server>
            import { onLauncher } from '@abide/abide/server'

            onLauncher(() => ({
                width: 1100,
                height: 720,
                minWidth: 720,
                minHeight: 480,
                update: 'https://crm.example.com/updates',
            }))
            </script>
        `} />
    </Section>

    <Section level={3} title="Open straight into the app with no launcher form">
        <p><code>connect: false</code> drops the Connect… form. With nothing for the start
            form to ask, the first launch starts the app at once.</p>
        <Code language="abide" caption="abide" code={`
            <script server>
            import { onLauncher } from '@abide/abide/server'

            onLauncher(() => ({ connect: false, titlebar: 'inset' }))
            </script>
        `} />
    </Section>

    <Section level={3} title="Keep the CRM in the menu bar">
        <p><code>menuBarExtra: true</code> adds an icon to the menu bar. A click opens
            <code>src/native/menubar.abide</code> in a panel of the size given.</p>
        <Code language="abide" caption="abide" code={`
            <script server>
            import { onLauncher } from '@abide/abide/server'

            onLauncher(() => ({
                menuBarExtra: true,
                panelWidth: 360,
                panelHeight: 480,
            }))
            </script>
        `} />
    </Section>
</Doc>
