<script>
import { reactive } from '@abide/abide'
import { getPerson } from '#server/rpc/people'

const person = reactive(() => getPerson({ id: '42' }))

// Bound straight to the field, so typing IS the write.
const draft = reactive(() => person.name)

const status = reactive(() => {
    if (!person.ready()) return 'loading…'
    return person.busy() ? 'refreshing…' : ''
})
</script>

<div class="row">
    <label>your draft
        <input bind:value={draft}>
    </label>
    <button onclick={person.refresh}>reload from the server</button>
    <span class="status">{status}</span>
</div>
