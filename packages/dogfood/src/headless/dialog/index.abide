<script>
import Doc from '#src/lib/Doc.abide'
import Example from '#src/lib/Example.abide'
import Section from '#src/lib/Section.abide'

import ArchiveDeal from './lib/ArchiveDeal.abide'
import archiveDeal from './lib/ArchiveDeal.abide' with { type: 'text' }
import ContractPreview from './lib/ContractPreview.abide'
import contractPreview from './lib/ContractPreview.abide' with { type: 'text' }
import DealDrawer from './lib/DealDrawer.abide'
import dealDrawer from './lib/DealDrawer.abide' with { type: 'text' }
import LookAtDeal from './lib/LookAtDeal.abide'
import lookAtDeal from './lib/LookAtDeal.abide' with { type: 'text' }
import StyledDialog from './lib/StyledDialog.abide'
import styledDialog from './lib/StyledDialog.abide' with { type: 'text' }
</script>

<Doc
    seeAlso={[
        '/headless/prompts',
        '/headless/command-palette',
        '/behaviors/dismissible',
        '/headless/form',
    ]}
    tests={[
        {
            path: 'packages/dogfood/examples/crm/src/contacts/lib/LogCallDialog.test.ts',
            from: ["test('Log call keeps the note, and Cancel drops it'"],
        },
        {
            path: 'packages/dogfood/examples/crm/src/deals/lib/SignContract.test.ts',
            from: ["test('a dialog not dismissible stays open on Escape'"],
        },
        {
            path: 'packages/dogfood/examples/crm/src/contacts/lib/LogCallDialog.test.ts',
            from: [
                "test('a dialog opened again before its close is reported stays open'",
            ],
        },
        {
            path: 'packages/dogfood/examples/crm/src/pipeline/lib/DealQuickLook.test.ts',
            from: [
                "test('every row opens the one dialog, and the same row opens it again after a close'",
            ],
        },
        {
            path: 'packages/dogfood/examples/crm/src/deals/lib/ContractPreview.test.ts',
            from: [
                "test('a click beside the contract closes the preview, and a click on it does not'",
            ],
        },
        {
            path: 'packages/dogfood/examples/crm/src/deals/lib/DealDrawer.test.ts',
            from: [
                'test("a deal\'s details open in a modal drawer, and Close shuts it"',
            ],
        },
    ]}
>
    <Section level={3} title="Ask before archiving, on a dialog">
        <p>Spread <code>dialog</code>'s part onto your own <code>&lt;dialog&gt;</code>. It opens
            modal while <code>ask.open</code> is true, every close writes <code>false</code> back,
            and <code>onclose</code> hands you the <code>value</code> of the button that closed it.
            With <code>dismissible: false</code>, Escape and the backdrop leave it open.</p>
        <Example code={archiveDeal}><ArchiveDeal /></Example>
    </Section>

    <Section level={3} title="Open one dialog from every row of a list">
        <p>Hand <code>open</code> a <code>memo</code> over the value the rows write. A close
            writes <code>false</code> to the memo, and it stands until the memo reruns, so clear
            the value in <code>onclose</code>, or the same row opens nothing the second time.</p>
        <Example code={lookAtDeal}><LookAtDeal /></Example>
    </Section>

    <Section level={3} title="Style the dialog box and the veil behind the dialog">
        <p>The <code>&lt;dialog&gt;</code> is yours, so its classes are too. The
            <code>backdrop:</code> variant reaches the veil, and <code>data-open</code> is present
            while it shows.</p>
        <Example code={styledDialog}><StyledDialog /></Example>
    </Section>

    <Section level={3} title="Close a full-screen dialog by a click beside its content">
        <p>A dialog that fills the screen has no backdrop outside its box to click. Spread
            <code>backdrop</code> on the element that stands for one: a click on that element,
            and not on what it holds, closes the dialog where it is dismissible.</p>
        <Example code={contractPreview}><ContractPreview /></Example>
    </Section>

    <Section level={3} title="Slide a deal's details in from the side">
        <p>A drawer is a dialog laid out at an edge by its own classes: modal the same way, with
            <code>open:</code> and <code>starting:</code> easing it in and out.</p>
        <Example code={dealDrawer}><DealDrawer /></Example>
    </Section>
</Doc>
