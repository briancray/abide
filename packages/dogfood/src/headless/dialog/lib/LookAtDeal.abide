<script>
import { dialog, reactive } from '@abide/abide'

const DEALS = ['Hopper & Co pilot', 'Langley Research audit']

let looking = reactive<string | undefined>(undefined)
const look = dialog({
    open: reactive(() => looking !== undefined),
    onclose: () => (looking = undefined),
})
</script>

{#for deal of DEALS}
    <button onclick={() => (looking = deal)}>{deal}</button>
{/for}
<dialog {...look.dialog} aria-labelledby="look-title">
    <h2 id="look-title">{looking}</h2>
    <form method="dialog"><button>Close</button></form>
</dialog>
