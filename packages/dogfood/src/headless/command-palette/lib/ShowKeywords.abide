<script>
import { commandPalette, reactive } from '@abide/abide'

let open = reactive(false)
let ran = reactive('nothing yet')
const palette = commandPalette({
    commands: [
        {
            label: 'Contacts',
            keywords: ['people'],
            run: () => (ran = 'Contacts'),
        },
        { label: 'Deals', keywords: ['pipeline'], run: () => (ran = 'Deals') },
    ],
    open,
    hotkey: 'mod+shift+y',
})
</script>

<button onclick={() => (open = true)}>Open the palette</button>
<p>Ran: {ran}.</p>
<dialog {...palette.dialog} class="palette">
    <input {...palette.input} placeholder="Go to…">
    <ul {...palette.listbox}>
        {#for command of palette.results key command.label}
            <li {...palette.command(command).option}>
                {command.label}
                <small class="text-muted">{command.keywords?.join(', ')}</small>
            </li>
        {/for}
    </ul>
</dialog>
