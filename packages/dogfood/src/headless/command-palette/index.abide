import Section from '#src/lib/Section.abide'

import JumpAnywhere from './lib/JumpAnywhere.abide'
import jumpAnywhere from './lib/JumpAnywhere.abide' with { type: 'text' }
import MarkWords from './lib/MarkWords.abide'
import markWords from './lib/MarkWords.abide' with { type: 'text' }
import ShowKeywords from './lib/ShowKeywords.abide'
import showKeywords from './lib/ShowKeywords.abide' with { type: 'text' }
</script>

<Doc
    seeAlso={['/headless/dialog', '/behaviors/hotkeys']}
    tests={[
        {
            path: 'packages/dogfood/examples/crm/src/lib/JumpTo.test.ts',
            from: [
                "test('Ctrl+K opens the palette with its input focused, and shuts it again'",
            ],
        },
        {
            path: 'packages/dogfood/examples/crm/src/lib/JumpTo.test.ts',
            from: [
                "test('typing lists the commands whose label or keywords hold every word'",
            ],
        },
        {
            path: 'packages/dogfood/examples/crm/src/lib/JumpTo.test.ts',
            from: [
                "test('an arrow and Enter run the command, and the palette shuts'",
            ],
        },
        {
            path: 'packages/dogfood/examples/crm/src/lib/JumpTo.test.ts',
            from: ["test('Escape is left to the dialog'"],
        },
        {
            path: 'packages/dogfood/examples/crm/src/lib/JumpTo.test.ts',
            from: ["test('each word typed is marked in the labels it is in'"],
        },
        {
            path: 'packages/dogfood/examples/crm/src/deals/lib/DealCommands.test.ts',
            from: [
                "test('the palette opens on its key, lists what is typed and runs it'",
            ],
        },
        {
            path: 'packages/dogfood/e2e/commandPalette.spec.ts',
            from: [
                "test('a key opens the palette, Enter runs a command, Escape shuts it, and focus comes back — 51.65, 51.68, 51.69'",
            ],
        },
    ]}
>
    <Section level={3} title="Show each command beside the keywords typing matches">
        <p>Spread the parts onto a <code>&lt;dialog&gt;</code> of your own, opened modal by the
            <code>open</code> you hand <code>commandPalette</code>: the input, the list, and each command's
            <code>command(command).option</code> in <code>results</code>, which can hold anything. The parts carry the combobox, the keys,
            the filtering and the hotkey, here ⌘⇧Y.</p>
        <Example code={showKeywords}><ShowKeywords /></Example>
    </Section>

    <Section level={3} title="Mark the words typed in each command">
        <p><code>command(command).runs</code> cuts a command's label where each word typed was
            found, by the same match that listed it. Write a matched run in a
            <code>&lt;mark&gt;</code> carrying its <code>match</code> part, and the rest as
            text.</p>
        <Example code={markWords}><MarkWords /></Example>
    </Section>

    <Section level={3} title="Show each command's key beside it, and say so when nothing matches">
        <p>A command's <code>key</code> is the binding the app runs it on elsewhere, which the
            palette shows and does not bind: spread <code>command(command).key</code> onto what
            shows it, written for a person by <code>keyLabel</code>. While <code>results</code> is empty,
            <code>empty</code> is the status saying so. Escape shuts the palette with focus back
            where it was. This page's own ⌘K is the docs' prompt, so the example opens on ⌘J.</p>
        <Example code={jumpAnywhere}><JumpAnywhere /></Example>
    </Section>
</Doc>
