<script>
import { panZoom } from '@abide/abide'

const map = panZoom({ min: 0.5, max: 6, label: 'Sales territories' })
</script>

<div
    class="h-48 overflow-hidden rounded-md border border-rule"
    {...map.surface}
>
    <svg width="400" height="240" {...map.content}>
        <rect x="20" y="20" width="160" height="90" opacity=".15" />
        <rect x="200" y="60" width="170" height="150" opacity=".3" />
        <text x="30" y="70">North</text>
        <text x="210" y="140">South</text>
    </svg>
</div>
<button onclick={() => map.fit({ x: 200, y: 60, width: 170, height: 150 }, 12)}>
    Show the south
</button>
