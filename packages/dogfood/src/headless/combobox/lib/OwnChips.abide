<script>
import { combobox } from '@abide/abide'

const STAGES = ['Lead', 'Qualified', 'Proposal', 'Won', 'Lost']
const box = combobox({ options: () => STAGES, multiple: true })
</script>

<div class="picker">
    <label for={box.id}>Stages</label>
    <div {...box.root} class="flex flex-wrap gap-1">
        {#for stage of box.picks ?? [] by stage}
            <span
                {...box.chip(stage).chip}
                class="rounded-full border px-2 [&_button]:bg-transparent"
            >
                {stage}
                <button {...box.chip(stage).remove}>✕</button>
            </span>
        {/for}
        <input {...box.input} placeholder="Add a stage">
    </div>
    {#if box.open}
        <div {...box.popup}>
            <ul {...box.listbox}>
                {#for stage of box.items by stage}
                    <li {...box.option(stage)}>{stage}</li>
                {/for}
            </ul>
        </div>
    {/if}
</div>
<p>{box.value.length} picked</p>
