<script>
import { combobox, jsonSchema, reactive } from '@abide/abide'

let tags = reactive<readonly string[]>(['investor'], {
    schema: jsonSchema<readonly string[]>({ type: 'array', maxItems: 2 }),
})
const box = combobox({
    options: ['investor', 'speaker', 'mentor'],
    multiple: true,
    value: tags,
})
</script>

<div class="picker">
    <label for={box.id}>Two tags at most</label>
    <div {...box.root} class="flex flex-wrap gap-1">
        {#for tag of tags key tag}
            <span {...box.chip(tag).chip} class="rounded-full border px-2">
                {tag}
                <button {...box.chip(tag).remove}>✕</button>
            </span>
        {/for}
        <input {...box.input} placeholder="Add a tag">
    </div>
    {#if box.open}
        <div {...box.popup}>
            <ul {...box.listbox}>
                {#for tag of box.items key tag}
                    <li {...box.option(tag)}>{tag}</li>
                {/for}
            </ul>
        </div>
    {/if}
</div>
