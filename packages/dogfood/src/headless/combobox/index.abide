<script>
import Doc from '#src/lib/Doc.abide'
import Example from '#src/lib/Example.abide'
import Section from '#src/lib/Section.abide'

import ActiveOption from './lib/ActiveOption.abide'
import activeOption from './lib/ActiveOption.abide' with { type: 'text' }
import ListOverClip from './lib/ListOverClip.abide'
import listOverClip from './lib/ListOverClip.abide' with { type: 'text' }
import MarkTyped from './lib/MarkTyped.abide'
import markTyped from './lib/MarkTyped.abide' with { type: 'text' }
import NothingMatches from './lib/NothingMatches.abide'
import nothingMatches from './lib/NothingMatches.abide' with { type: 'text' }
import OwnChips from './lib/OwnChips.abide'
import ownChips from './lib/OwnChips.abide' with { type: 'text' }
import OwnOptions from './lib/OwnOptions.abide'
import ownOptions from './lib/OwnOptions.abide' with { type: 'text' }
import SearchCompanies from './lib/SearchCompanies.abide'
import searchCompanies from './lib/SearchCompanies.abide' with { type: 'text' }
</script>

<Doc
    seeAlso={['/headless/listbox', '/headless/popover', '/reactive/reactive']}
    tests={[
        {
            path: 'packages/dogfood/examples/crm/src/contacts/lib/ContactPicker.test.ts',
            from: ["test('typing narrows the contacts, ignoring case'"],
        },
        {
            path: 'packages/dogfood/examples/crm/src/companies/lib/CompanyPicker.test.ts',
            from: ["test('typing searches, and Enter picks the active company'"],
        },
        {
            path: 'packages/dogfood/examples/crm/src/companies/lib/CompanyPicker.test.ts',
            from: ["test('a search in flight keeps the last companies listed'"],
        },
        {
            path: 'packages/dogfood/examples/crm/src/contacts/lib/ContactPicker.test.ts',
            from: ["test('Escape shuts, then clears, then is left to the page'"],
        },
        {
            path: 'packages/dogfood/examples/crm/src/contacts/lib/TeamPicker.test.ts',
            from: [
                "test('picking adds a contact, picking it again takes it out, and the list stays open'",
            ],
        },
        {
            path: 'packages/dogfood/examples/crm/src/contacts/lib/TeamPicker.test.ts',
            from: [
                "test('Backspace in an empty input takes out the last contact, and a chip takes out its own'",
            ],
        },
        {
            path: 'packages/dogfood/examples/crm/src/contacts/lib/ContactPicker.test.ts',
            from: [
                "test('a press lists every contact and a second shuts it, and focus opens nothing'",
            ],
        },
        {
            path: 'packages/dogfood/examples/crm/src/companies/lib/CompanyPicker.test.ts',
            from: [
                "test('a press on an empty search field opens nothing, and with text lists what it finds'",
            ],
        },
        {
            path: 'packages/dogfood/examples/crm/src/contacts/lib/ContactPicker.test.ts',
            from: [
                "test('Alt+ArrowDown opens the list without stepping, and Alt+ArrowUp shuts it'",
            ],
        },
        {
            path: 'packages/dogfood/examples/crm/src/contacts/lib/ContactPicker.test.ts',
            from: ["test('what was typed is marked in each contact it lists'"],
        },
        {
            path: 'packages/dogfood/e2e/combobox.spec.ts',
            from: [
                "test('a press on the field opens its list once, and a second press shuts it — 51.92'",
            ],
        },
        {
            path: 'packages/dogfood/e2e/combobox.spec.ts',
            from: [
                "test('a combobox in a box that clips it opens its list past the box — 51.57'",
            ],
        },
    ]}
>
    <Section level={3} title="Show each contact with their initials and company">
        <p>Spread <code>input</code> onto your field, <code>popup</code> and
            <code>listbox</code> onto what holds the list while <code>open</code>, and
            <code>option</code> onto each of <code>items</code>. An option holds whatever you
            write; the parts carry the roles, the keys and the pick, and <code>value</code> holds
            it.</p>
        <Example code={ownOptions}><OwnOptions /></Example>
    </Section>

    <Section level={3} title="Say so when no contact matches what was typed">
        <p>Given <code>options</code>, the list keeps the items whose label holds what was typed,
            ignoring case. <code>nothingFound</code> is true while none does, and
            <code>empty</code> is the status saying so. A press on the field lists every contact,
            and a second shuts the list; Tab reaching the field opens nothing.</p>
        <Example code={nothingMatches}><NothingMatches /></Example>
    </Section>

    <Section level={3} title="Search companies on the server as someone types">
        <p>Pass <code>search</code> in place of <code>options</code>: a handler call, or any async
            function. A search in flight keeps the last results listed, and
            <code>debounce</code> waits for typing to pause.</p>
        <Example code={searchCompanies}><SearchCompanies /></Example>
    </Section>

    <Section level={3} title="Pick several stages, each a chip">
        <p><code>multiple</code> picks many. Strings are their own key and label.
            <code>value</code> is then every item picked, and <code>chip(item)</code> is a chip and the
            button taking it out, as Backspace in the empty field takes the last.</p>
        <Example code={ownChips}><OwnChips /></Example>
    </Section>

    <Section level={3} title="Mark what was typed in each company">
        <p><code>runs(item)</code> cuts an item's label where the list found what was typed, so
            the mark and the narrowing never disagree. Write a matched run in a
            <code>&lt;mark&gt;</code> carrying its <code>match</code> part, and the rest as
            text.</p>
        <Example code={markTyped}><MarkTyped /></Example>
    </Section>

    <Section level={3} title="Highlight the option the arrow keys are on">
        <p>The active option carries <code>data-active</code>, and the picked one
            <code>data-selected</code>, for a <code>data-</code> variant to style.</p>
        <Example code={activeOption}><ActiveOption /></Example>
    </Section>

    <Section level={3} title="Open the list over a box that clips its input">
        <p><code>popup</code> opens in the top layer under its input, as <code>popover</code>
            opens one, so no scroller or <code>overflow</code> cuts it off.
            <code>--anchor-width</code> is its input's width.</p>
        <Example code={listOverClip}><ListOverClip /></Example>
    </Section>
</Doc>
