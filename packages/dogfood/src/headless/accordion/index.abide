        <Example code={oneOpen}><OneOpen /></Example>
    </Section>

    <Section level={3} title="Let several sections stay open">
        <p>Give <code>multiple: true</code>, and <code>open</code> holds every key open.</p>
        <Example code={manyOpen}><ManyOpen /></Example>
    </Section>
