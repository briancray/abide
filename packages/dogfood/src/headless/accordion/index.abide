import ManyOpen from './lib/ManyOpen.abide'
import manyOpen from './lib/ManyOpen.abide' with { type: 'text' }
import OneOpen from './lib/OneOpen.abide'
import oneOpen from './lib/OneOpen.abide' with { type: 'text' }
</script>

<Doc
    seeAlso={['/headless/disclosure', '/headless/tabs']}
    tests={[
        {
            path: 'packages/dogfood/examples/crm/src/deals/lib/DealSections.test.ts',
            from: ["test('opening a section closes the one open'"],
        },
        {
            path: 'packages/abide/tests/disclosure.test.ts',
            from: ["test('an accordion opens one key at a time"],
        },
    ]}
>
    <Section level={3} title="Open one section of a deal at a time">
        <p>Each key's <code>item</code> is a <code>disclosure</code>: spread its
