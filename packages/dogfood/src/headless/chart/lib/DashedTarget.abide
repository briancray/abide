<script>
import { chart } from '@abide/abide'

const plot = chart({
    label: 'Won revenue against target',
    series: [
        { label: 'Won', values: [18_000, 24_500, 31_000, 27_000] },
        { label: 'Target', values: [20_000, 22_000, 24_000, 26_000] },
    ],
})
</script>

<svg
    {...plot.svg}
    class="h-48 w-full [&_[data-series='1']]:[stroke-dasharray:4_4]"
>
    {#for line of plot.lines key line.series}
        <path {...line.path} />
    {/for}
</svg>
