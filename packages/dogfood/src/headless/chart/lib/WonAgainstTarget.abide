<script>
import { chart, format } from '@abide/abide'

const MONTHS = [5, 6, 7, 8].map((month) => Date.UTC(2026, month, 15))

const plot = chart({
    label: 'Won revenue against target',
    series: [
        { label: 'Won', values: [18_000, 24_500, 31_000, 27_000] },
        { label: 'Target', values: [20_000, 22_000, 24_000, 26_000] },
    ],
    x: MONTHS,
    xFormat: (month) => format.date(month, { style: 'month' }),
    yFormat: (amount) => format.money(amount, { notation: 'compact' }),
    zero: true,
})
</script>

<div class="pb-6 pl-12">
    <svg {...plot.svg} class="h-48 w-full overflow-visible">
        {#for tick of plot.yTicks}
            <line {...tick.grid} />
            <text {...tick.text} dx="-6">{tick.label}</text>
        {/for}
        {#for tick of plot.xTicks}
            <text {...tick.text} dy="6">{tick.label}</text>
        {/for}
        {#for line of plot.lines key line.series}
            <path {...line.path} />
        {/for}
        {#if plot.readout}
            <line {...plot.crosshair?.line} />
        {/if}
    </svg>
</div>
{#if plot.readout}
    <span {...plot.tip} class="m-0 grid rounded-md border px-3 py-2">
        <span {...plot.readout?.heading}>{plot.readout?.label}</span>
        {#for point of plot.readout?.values ?? []}
            <span {...point.text}>{point.label}: {point.value}</span>
        {/for}
    </span>
{/if}
