<script>
import { chart } from '@abide/abide'

const plot = chart({
    label: 'Won revenue',
    series: [{ label: 'Won', values: [18_000, 24_500, 31_000, 27_000] }],
})
</script>

<div class="h-48 resize overflow-hidden py-2 pl-12">
    <svg {...plot.root} class="block h-full w-full overflow-visible">
        {#for tick of plot.yTicks}
            <line {...tick.grid} />
            <text {...tick.text} dx="-6">{tick.label}</text>
        {/for}
        {#for line of plot.lines key line.series}
            <path {...line.path} />
        {/for}
    </svg>
</div>
