<script>
import { chart } from '@abide/abide'

const plot = chart({
    label: 'Won revenue against target',
    series: () => [
        { label: 'Won', values: [18_000, 24_500, 31_000, 27_000] },
        { label: 'Target', values: [20_000, 22_000, 24_000, 26_000] },
    ],
})
</script>

<div class="pl-12">
    <svg {...plot.root} class="h-48 w-full overflow-visible">
        {#for tick of plot.yTicks}
            <line {...tick.grid} />
            <text {...tick.text} dx="-6">{tick.label}</text>
        {/for}
        {#for line of plot.lines key line.series}
            <path {...line.path} />
        {/for}
        {#for point of plot.points key point.key}
            <circle {...point.circle} r="4" />
        {/for}
    </svg>
</div>
