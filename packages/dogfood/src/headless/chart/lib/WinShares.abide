<script>
import { chart } from '@abide/abide'

const plot = chart({
    label: 'Win rate by month',
    series: [
        { label: 'Won', values: [4, 6, 5, 8], kind: 'column' },
        { label: 'Lost', values: [3, 2, 4, 3], kind: 'column' },
    ],
    normalize: true,
})
</script>

<svg {...plot.svg} class="h-48 w-full">
    {#for tick of plot.yTicks}
        <text {...tick.text}>{tick.label}</text>
    {/for}
    {#for bar of plot.bars by bar.key}
        <rect {...bar.rect} />
    {/for}
</svg>
