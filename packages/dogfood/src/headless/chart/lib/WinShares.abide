<script>
import { chart } from '@abide/abide'

const plot = chart({
    label: 'Win rate by month',
    series: [
        { label: 'Won', values: [4, 6, 5, 8], kind: 'column' },
        { label: 'Lost', values: [3, 2, 4, 3], kind: 'column' },
    ],
    normalize: true,
})
</script>

<div class="pl-12">
    <svg {...plot.root} class="h-48 w-full overflow-visible">
        {#for tick of plot.yTicks}
            <text {...tick.text} dx="-6">{tick.label}</text>
        {/for}
        {#for bar of plot.bars key bar.key}
            <rect {...bar.rect} />
        {/for}
    </svg>
</div>
