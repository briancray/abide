<script>
import { chart } from '@abide/abide'

const BOUNDS = { y: [0, 150_000] } as const
const east = chart({
    label: 'Open pipeline, east',
    series: [
        {
            label: 'East',
            values: [42_000, 58_000, 51_000, 67_000],
            kind: 'area',
        },
    ],
    bounds: BOUNDS,
})
const west = chart({
    label: 'Open pipeline, west',
    series: [
        {
            label: 'West',
            values: [96_000, 120_000, 104_000, 131_000],
            kind: 'area',
        },
    ],
    bounds: BOUNDS,
})
</script>

<div class="grid grid-cols-2 gap-4">
    {#for plot of [east, west]}
        <div class="pl-10">
            <svg {...plot.svg} class="h-40 w-full overflow-visible">
                {#for tick of plot.yTicks}
                    <text {...tick.text} dx="-6">{tick.label}</text>
                {/for}
                {#for area of plot.areas key area.series}
                    <path {...area.path} />
                {/for}
            </svg>
        </div>
    {/for}
</div>
