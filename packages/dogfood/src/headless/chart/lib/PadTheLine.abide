<script>
import { chart, format } from '@abide/abide'

const plot = chart({
    label: 'Average deal size by month',
    series: [{ label: 'Average', values: [31_000, 34_500, 33_000, 38_000] }],
    yFormat: (amount) => format.money(amount, { notation: 'compact' }),
    pad: 0.15,
})
</script>

<svg {...plot.svg} class="h-48 w-full">
    {#for tick of plot.yTicks}
        <line {...tick.grid} />
        <text {...tick.text}>{tick.label}</text>
    {/for}
    {#for line of plot.lines key line.series}
        <path {...line.path} />
    {/for}
</svg>
