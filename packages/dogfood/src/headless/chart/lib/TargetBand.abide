<script>
import { chart } from '@abide/abide'

const plot = chart({
    label: 'Won revenue against a target band',
    series: () => [{ label: 'Won', values: [18_000, 24_500, 31_000, 27_000] }],
    zero: true,
})
</script>

<div class="pl-12">
    <svg {...plot.root} class="h-48 w-full overflow-visible">
        <rect
            x="0"
            width="100%"
            y={plot.y(30_000)}
            height={plot.y(20_000) - plot.y(30_000)}
            fill="currentColor"
            opacity="0.1"
         />
        {#for tick of plot.yTicks}
            <line {...tick.grid} />
            <text {...tick.text} dx="-6">{tick.label}</text>
        {/for}
        {#for line of plot.lines key line.series}
            <path {...line.path} />
        {/for}
    </svg>
</div>
