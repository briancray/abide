<script>
import { chart, format } from '@abide/abide'

const MONTHS = [5, 6, 7, 8].map((month) => Date.UTC(2026, month, 1))
const LAUNCH = Date.UTC(2026, 6, 20)

const plot = chart({
    label: 'Won revenue by month, with the launch',
    series: [{ label: 'Won', values: [18_000, 24_500, 31_000, 27_000] }],
    x: MONTHS,
    xFormat: (month) => format.date(month, { style: 'month' }),
})
</script>

<svg {...plot.root} class="h-48 w-full">
    {#for line of plot.lines key line.series}
        <path {...line.path} />
    {/for}
    <line
        x1={plot.x(LAUNCH)}
        x2={plot.x(LAUNCH)}
        y1="0"
        y2="100%"
        stroke="currentColor"
        stroke-dasharray="4 4"
     />
</svg>
