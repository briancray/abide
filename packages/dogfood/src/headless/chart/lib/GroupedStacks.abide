<script>
import { chart } from '@abide/abide'

const plot = chart({
    label: 'Deals closed by team',
    series: [
        { label: 'East won', values: [4, 6, 5], kind: 'column', stack: 'east' },
        {
            label: 'East lost',
            values: [3, 2, 4],
            kind: 'column',
            stack: 'east',
        },
        { label: 'West won', values: [5, 3, 7], kind: 'column', stack: 'west' },
        {
            label: 'West lost',
            values: [2, 4, 1],
            kind: 'column',
            stack: 'west',
        },
    ],
})
</script>

<svg {...plot.svg} class="h-48 w-full">
    {#for bar of plot.bars key bar.key}
        <rect {...bar.rect} />
    {/for}
</svg>
