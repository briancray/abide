<script>
import { drawer } from '@abide/abide'

const deals = drawer({
    side: 'bottom',
    modal: false,
    stops: [0.25, 0.5, 0.9],
})
</script>

<button onclick={() => (deals.open = true)}>Show deals</button>
<dialog class="fixed inset-x-0 bottom-0 m-0 mt-auto w-full" {...deals.drawer}
    aria-label="Deals">
    <div
        class="mx-auto my-2 h-1 w-10 rounded-full bg-rule"
        {...deals.handle}
    ></div>
    <p>Engine renewal</p>
</dialog>
