<script>
import { carousel } from '@abide/abide'

const STAGES = ['lead', 'qualified', 'proposal', 'won']
const stages = carousel({ items: STAGES, loop: true, autoplay: 3000 })
</script>

<div class="row">
    <button {...stages.play}>{stages.playing() ? 'Pause' : 'Play'}</button>
    <ul {...stages.host} aria-label="Stages"
        class="flex snap-x snap-mandatory gap-snug overflow-x-auto px-[12.5%]">
        {#for name of STAGES key name}
            <li {...stages.item(name)}
                class="shrink-0 basis-full snap-center p-snug">{name}</li>
        {/for}
    </ul>
</div>
