<script>
import { carousel, reactive } from '@abide/abide'

const STAGES = ['lead', 'qualified', 'proposal', 'won']
let stage = reactive<string | undefined>('proposal')
const stages = carousel({ items: STAGES, selected: stage })
</script>

<ul {...stages.host} aria-label="Stages"
    class="flex snap-x snap-mandatory gap-snug overflow-x-auto px-[12.5%]">
    {#for name of STAGES by name}
        <li {...stages.item(name)} class="shrink-0 basis-3/4 snap-center
            border border-rule p-snug data-current:border-signal">{name}</li>
    {/for}
</ul>
<p class="status">Current: {stages.current}</p>
