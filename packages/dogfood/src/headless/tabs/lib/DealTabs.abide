<script>
import { reactive, tabs } from '@abide/abide'

let tab = reactive<string | undefined>('details')
const view = tabs({ items: ['details', 'stage'], selected: tab })
</script>

<div class="tabs" {...view.list}>
    <button {...view.tab('details').button}>Details</button>
    <button {...view.tab('stage').button}>Stage</button>
</div>
<div {...view.panel}>
    {#if tab === 'details'}<p>Acme renewal, $42K</p>{:else}<p>proposal</p>{/if}
</div>
