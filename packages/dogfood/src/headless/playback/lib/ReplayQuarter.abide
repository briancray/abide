<script>
import { playback } from '@abide/abide'

const WEEKS = 12
const replay = playback({ duration: WEEKS * 1000 })
</script>

<div class="flex flex-col gap-snug" tabindex="0" {...replay.root}>
    <div class="row">
        <button {...replay.play}>{replay.playing() ? '❚❚' : '▶'}</button>
        <input {...replay.scrubber} />
        <div {...replay.speed.group}>
            {#for rate of ['0.5', '1', '2'] by rate}
                <button {...replay.speed.item(rate)}>{rate}×</button>
            {/for}
        </div>
    </div>
    <p>Week {Math.min(WEEKS, Math.floor(replay.at() / 1000) + 1)} of {WEEKS}</p>
</div>
