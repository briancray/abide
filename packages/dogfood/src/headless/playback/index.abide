<Doc
    seeAlso={['/headless/toggle', '/headless/toggle-group', '/behaviors/hotkeys']}
    tests={[
        {
            path: 'packages/dogfood/examples/crm/src/pipeline/lib/QuarterReplay.test.ts',
            from: [
                "test('the keys and the scrubber move the replay, and the speeds pick its rate'",
            ],
        },
        {
            path: 'packages/dogfood/examples/crm/src/pipeline/lib/QuarterPulse.test.ts',
