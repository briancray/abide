<script>
import { dropzone } from '@abide/abide'

const drop = dropzone({ accept: '.pdf' })
const names = (files: readonly File[]) =>
    files.map((file) => file.name).join(', ')
</script>

<div {...drop.host}>Drop the signed contract here, as a PDF.</div>
<p>Attached: {names(drop.files) || 'none'}</p>
