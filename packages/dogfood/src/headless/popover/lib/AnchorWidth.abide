<script>
import { popover, reactive, watch } from '@abide/abide'

let typed = reactive('')
const suggest = popover({ align: 'start', offset: 4 })

watch(() => {
    suggest.open = typed !== ''
})
</script>

<input
    type="text"
    bind:value={typed}
    placeholder="Type to suggest"
    {...suggest.anchor}
 />

<ul
    class="m-0 w-(--anchor-width) list-none rounded-md border border-rule
    bg-raised p-2"
    {...suggest.popover}
>
    <li>{typed} Ltd</li>
    <li>{typed} & Co</li>
</ul>
