<script server>
import { rpc } from '@abide/abide/server'

export const saveDeal = rpc((deal: { name: string }) => deal, {
    methods: ['POST'],
})
</script>

<script>
import { form } from '@abide/abide'

const deal = form(saveDeal)
</script>

<form {...deal.form} class="row">
    <label>
        name <input {...deal.field('name').input} value="Engine renewal">
    </label>
    <button {...deal.reset}>Undo</button>
    <button {...deal.submit}>Save</button>
    <span>{deal.dirty ? 'Unsaved changes' : 'Saved'}</span>
</form>
