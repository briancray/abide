<script server>
import { refuse } from '@abide/abide'
import { rpc } from '@abide/abide/server'

const TAKEN = ['Ledger audit']

export const addDeal = rpc(
    ({ name }: { name: string }) =>
        TAKEN.includes(name)
            ? refuse.validation<{ name: string }>({ name: ['is taken'] })
            : { name },
    { methods: ['POST'] },
)
</script>

<script>
import { form } from '@abide/abide'

const deal = form(addDeal)
</script>

<form {...deal.form} class="flex flex-col items-start gap-2">
    <label>
        name <input {...deal.field('name').input} value="Ledger audit">
    </label>
    <small {...deal.field('name').error} class="text-bad">
        {deal.field('name').message}
    </small>
    <button {...deal.submit}>Add deal</button>
</form>
