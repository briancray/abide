<script server>
import { rpc } from '@abide/abide/server'

export const addDeal = rpc(
    async ({ name }: { name: string }) => {
        await Bun.sleep(1_500)
        return { name }
    },
    { methods: ['POST'] },
)
</script>

<script>
import { form } from '@abide/abide'

const deal = form(addDeal)
</script>

<form {...deal.form} class="row">
    <label>
        name <input {...deal.field('name').input} value="Ledger audit">
    </label>
    <button {...deal.submit}>
        {deal.call.busy() ? 'Adding…' : 'Add deal'}
    </button>
</form>
