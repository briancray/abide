<script>
import { form } from '@abide/abide'

import { saveDeal } from './WhatASaveChanges.server.ts'

const deal = form(saveDeal)
</script>

<form {...deal.form} class="fields stacked">
    <label>
        name <input {...deal.field('name').input} value="Engine renewal">
    </label>
    <label>
        company
        <input {...deal.field('company').input} value="Analytical Engines">
    </label>
    <label>
        amount
        <input type="number" {...deal.field('amount').input} value="12000">
    </label>
    <code>{JSON.stringify(deal.changes)}</code>
</form>
