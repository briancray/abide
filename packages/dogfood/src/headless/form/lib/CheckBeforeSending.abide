<script>
import { form } from '@abide/abide'

import addDeal from './CheckBeforeSending.server.ts'

const deal = form(addDeal)
</script>

<form {...deal.form} class="flex flex-col items-start gap-2">
    <label>name <input {...deal.field('name').input}></label>
    <small {...deal.field('name').error} class="text-bad">
        {deal.field('name').message}
    </small>
    <label>
        amount <input type="number" {...deal.field('amount').input} value="0">
    </label>
    <small {...deal.field('amount').error} class="text-bad">
        {deal.field('amount').message}
    </small>
