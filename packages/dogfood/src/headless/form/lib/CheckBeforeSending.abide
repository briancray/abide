<script server>
import { jsonSchema } from '@abide/abide'
import { POST } from '@abide/abide/server'

type Deal = { name: string; amount: number }

const DEAL = jsonSchema<Deal>({
    type: 'object',
    required: ['name', 'amount'],
    properties: {
        name: { type: 'string', minLength: 2 },
        amount: { type: 'number', minimum: 1 },
    },
})

const addDeal = POST((deal: Deal) => deal, { args: DEAL })
</script>

<script>
import { form } from '@abide/abide'

const deal = form(addDeal)
</script>

<form {...deal.form} class="flex flex-col items-start gap-2">
    <label>name <input {...deal.field('name').input}></label>
    <small {...deal.field('name').error} class="text-bad">
        {deal.field('name').message}
    </small>
    <label>
        amount <input type="number" {...deal.field('amount').input} value="0">
    </label>
    <small {...deal.field('amount').error} class="text-bad">
        {deal.field('amount').message}
    </small>
    <button {...deal.submit}>Add deal</button>
</form>
