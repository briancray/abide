<script>
import { wizard } from '@abide/abide'

const steps = wizard({ steps: ['name', 'stage', 'review'] })
</script>

<ol
    class="row text-muted [&_[aria-current]]:text-ink
    [&_[data-done]]:text-signal"
>
    <li {...steps.step('name')}>Name</li>
    <li {...steps.step('stage')}>Stage</li>
    <li {...steps.step('review')}>Review</li>
</ol>
<button {...steps.previous}>Back</button>
<button {...steps.next}>Next</button>
