<script>
import { wizard } from '@abide/abide'

const STEPS = ['name', 'stage', 'review']
const setup = wizard({ steps: STEPS })
</script>

<ol
    class="row capitalize text-muted [&_[aria-current]]:text-ink
    [&_[data-done]]:text-signal"
>
    {#for step of STEPS key step}<li {...setup.step(step)}>{step}</li>{/for}
</ol>
<button {...setup.previous}>Back</button>
<button {...setup.next}>Next</button>
