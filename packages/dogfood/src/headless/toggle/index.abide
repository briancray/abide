<script>
import Doc from '#src/lib/Doc.abide'
import Example from '#src/lib/Example.abide'
import Section from '#src/lib/Section.abide'

import DealAlerts from './lib/DealAlerts.abide'
import dealAlerts from './lib/DealAlerts.abide' with { type: 'text' }
import FillPressed from './lib/FillPressed.abide'
import fillPressed from './lib/FillPressed.abide' with { type: 'text' }
import PinDeal from './lib/PinDeal.abide'
import pinDeal from './lib/PinDeal.abide' with { type: 'text' }
</script>

<Doc
    seeAlso={['/headless/toggle-group']}
    tests={[
        {
            path: 'packages/abide/tests/toggle.test.ts',
            from: ["test('a toggle flips pressed on a click"],
        },
    ]}
>
    <Section level={3} title="Pin a deal with a button that stays pressed">
        <p>Spread <code>button</code> on a button. A click flips
            <code>pressed</code>, and the button says which it is with
            <code>aria-pressed</code> and <code>data-pressed</code>.</p>
        <Example code={pinDeal}><PinDeal /></Example>
    </Section>

    <Section level={3} title="Turn alerts on with a switch">
        <p>Give <code>role: 'switch'</code> for an on/off setting. The button reads as a switch,
            with <code>aria-checked</code>, and a <code>Reactive</code> handed in as
            <code>pressed</code> is the one it flips.</p>
        <Example code={dealAlerts}><DealAlerts /></Example>
    </Section>

    <Section level={3} title="Fill the pin button while the deal is pinned">
        <p>The button carries <code>data-pressed</code> while it is pressed.</p>
        <Example code={fillPressed}><FillPressed /></Example>
    </Section>
</Doc>
