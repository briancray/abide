<script>
import { spinbutton } from '@abide/abide'

const seats = spinbutton({ min: 1, max: 3, label: 'Seats' })
</script>

<div class="row">
    <button class="disabled:opacity-40" {...seats.decrement}>−</button>
    <input class="w-16 text-center" {...seats.input} />
    <button class="disabled:opacity-40" {...seats.increment}>+</button>
</div>
