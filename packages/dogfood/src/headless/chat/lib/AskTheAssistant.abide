<script>
import { chat } from '@abide/abide'
import askAssistant from 'crm/src/assistant/askAssistant.server.ts'

const talk = chat({ ask: askAssistant })
const parts = talk.message
</script>

<section {...talk.root} class="flex flex-col gap-snug">
    <ol {...talk.transcript} {...talk.autoscroll.host} class="chat">
        {#for message, index of talk.messages key message}
            {#if parts(message, index).shown}
                <li {...parts(message, index).message}>
                    <span {...parts(message, index).speaker}>
                        {parts(message, index).role}
                    </span>
                    {#for block of parts(message, index).blocks key block}
                        {#if block.type === 'text'}
                            <p {...talk.text}>{block.text}</p>
                        {/if}
                    {/for}
                </li>
            {/if}
        {/for}
    </ol>
    <form {...talk.composer} class="row">
        <textarea {...talk.input}
            placeholder="Which company is Ada at?"></textarea>
        <button {...talk.send}>Send</button>
    </form>
</section>
