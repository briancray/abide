            from: [
                "test('chat folds an answer in place, a block keeping its identity from its first delta to its last — 53.32'",
            ],
        },
        {
            path: 'packages/dogfood/examples/crm/src/ops/lib/AssistedReport.test.ts',
            from: [
                "test('the page reads what the assistant wrote off its calls to draftReport'",
            ],
        },
        {
            path: 'packages/abide/tests/assistantBlocks.test.ts',
            from: [
                "test('chat hands back the calls to one handler, live, each value as its event delivered it — 53.109, 44.106'",
            ],
        },
        {
