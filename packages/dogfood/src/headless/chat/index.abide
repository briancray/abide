            from: ["test('a permission prompt is answered through permit'"],
        },
        {
            path: 'packages/dogfood/examples/crm/src/assistant/lib/Chat.test.ts',
            from: [
                "test('a question sent while an answer streams is queued, and asked once the answer ends'",
            ],
        },
        {
            path: 'packages/dogfood/examples/crm/src/assistant/lib/Chat.test.ts',
            from: ["test('a queued question cancelled is never asked'"],
        },
        {
            path: 'packages/dogfood/examples/crm/src/assistant/lib/AssistantThread.test.ts',
            from: [
                "test('Ask again replaces the answer with a fresh one to the same question'",
            ],
        },
        {
            path: 'packages/dogfood/examples/crm/src/assistant/lib/Chat.test.ts',
            from: [
                "test('a conversation handed in as messages is shown, and asked about with what follows'",
            ],
        },
        {
            path: 'packages/dogfood/examples/crm/src/assistant/lib/Chat.test.ts',
            from: [
                "test('the transcript follows its bottom until the reader scrolls up'",
            ],
        },
        {
            path: 'packages/dogfood/examples/crm/src/assistant/lib/Chat.test.ts',
            from: [
                "test('a file picked through the dropzone input goes with the next question'",
            ],
        },
        {
            path: 'packages/dogfood/examples/crm/src/assistant/lib/Chat.test.ts',
            from: [
                "test('a file attached while typing goes after the words, and typing on keeps it there'",
            ],
        },
        {
            path: 'packages/dogfood/examples/crm/src/assistant/lib/Chat.test.ts',
            from: [
                "test('a question whose answer failed is put back to edit, with what was attached'",
            ],
        },
        {
            path: 'packages/dogfood/examples/crm/src/assistant/lib/Chat.test.ts',
            from: [
                "test('a file turned away, or one that cannot be read, is named and never sent'",
            ],
        },
        {
            path: 'packages/dogfood/examples/crm/src/assistant/lib/Chat.test.ts',
            from: [
                "test('a contact card is attached as words, apart from what is typed'",
            ],
        },
        {
            path: 'packages/dogfood/examples/crm/src/assistant/lib/Chat.test.ts',
            from: [
                "test('a question sent while a file is still being taken waits for it'",
            ],
        },
        {
            path: 'packages/dogfood/examples/crm/src/assistant/lib/AssistantThread.test.ts',
            from: ["test('a suggestion is asked as if it were typed and sent'"],
        },
        {
            path: 'packages/dogfood/examples/crm/src/assistant/lib/askAboutThisPage.test.ts',
            from: [
                "test('the model is sent the page asked on, and earlier tool results cut short'",
            ],
        },
        {
            path: 'packages/dogfood/examples/crm/src/assistant/lib/askAboutThisPage.test.ts',
            from: ["test('the conversation keeps every tool result whole'"],
        },
    ]}
>
    <Section level={3} title="Put the CRM's assistant on a page">
        <p>Pass your assistant handler, a <code>POST</code> yielding <code>assistant</code>'s
            events, as <code>ask</code>, and spread the parts onto markup: the conversation's
            messages, each as the Messages API's blocks, and a composer whose input sends on
            Enter and breaks the line on Shift+Enter.</p>
        <Example code={askTheAssistant}><AskTheAssistant /></Example>
    </Section>

    <Section level={3} title="Stop an answer and keep what arrived">
        <p>While an answer streams, <code>streaming</code> is true and <code>stop</code> is the
            button that aborts it. The answer keeps what arrived, and the root carries
            <code>data-stop="stopped"</code>.</p>
        <Code language="abide" caption="abide" code={`
            {#if talk.streaming}
                <button {...talk.stop}>Stop</button>
            {/if}
        `} />
    </Section>

    <Section level={3} title="Render the assistant's answers as markdown">
        <p>A text block is the words as they grow. Render the assistant's with
            <code>markdown.incremental</code> in a component, handed the message's
            <code>streaming</code>, so a chunk renders only the section still growing.</p>
        <Code language="abide" caption="abide" code={`
            <script>
            // The CRM's own, over markdown.incremental.
            import Markdown from '#src/lib/Markdown.abide'
            </script>

            {#if block.type === 'text' && message.role === 'assistant'}
                <Markdown {...talk.text} source={block.text}
                    streaming={talk.message(message, index).streaming} />
            {/if}
        `} />
    </Section>

    <Section level={3} title="Let a person allow or deny a tool Claude Code asks for">
        <p>Pass <code>permit</code> a handler calling <code>provider.claudeCode.permit</code>.
            The answer's <code>permissions</code> are the prompts it asks, and a prompt's
            <code>allow</code> and <code>deny</code> are the buttons answering it; without
            <code>permit</code> they are disabled.</p>
        <Code language="abide" caption="abide" code={`
            <script>
            import { chat } from '@abide/abide'
            import askClaudeCode from '../askClaudeCode.server.ts'
            import permitClaudeCode from '../permitClaudeCode.server.ts'

            const talk = chat({ ask: askClaudeCode, permit: permitClaudeCode })
            </script>

            {#for prompt of talk.permissions key prompt}
                <div {...talk.permission(prompt).permission}>
                    <span {...talk.permission(prompt).name}>{prompt.name}</span>
                    <button {...talk.permission(prompt).allow}>Allow</button>
                    <button {...talk.permission(prompt).deny}>Deny</button>
                </div>
            {/for}
        `} />
    </Section>

    <Section level={3} title="Show a tool call as a line of its own">
        <p>A <code>tool_use</code> block's element carries <code>data-status</code>:
            <code>running</code> until its result arrives, then <code>done</code> or
            <code>failed</code>. What it says is yours.</p>
        <Code language="abide" caption="abide" code={`
            {#if block.type === 'tool_use'}
                <span {...talk.tool(block).tool}>used {block.name}</span>
            {/if}
        `} />
    </Section>

    <Section level={3} title="Fill a report from what the assistant wrote">
        <p><code>calls(handler)</code> is every call the conversation made to one handler, in
            order, typed by it: its <code>input</code>, its <code>value</code> as the answer
            delivered it, and whether it <code>failed</code> or is still
            <code>streaming</code>. Read it in a <code>watch</code>, and each value lands as
            its call answers.</p>
        <Code language="abide" caption="abide" code={`
            <script>
            import { chat, props, type ReportDraft, watch } from '@abide/abide'
            import askReport from '../askReport.server.ts'
            import draftReport from '../draftReport.server.ts'

            const { draft } = props<{ draft: ReportDraft }>()
            const talk = chat({
                ask: (_conversation, options) =>
                    askReport({ draft: draft.markdown }, options),
            })

            watch(() => {
                for (const written of talk.calls(draftReport))
                    if (written.value !== undefined) {
                        draft.summary = written.value.summary
                        draft.description = written.value.description
                    }
            })
            </script>
        `} />
    </Section>

    <Section level={3} title="Offer to ask again under each answer">
        <p>A message's <code>retry</code> asks the question its answer answered again, in the
            answer's place. Show it under the message that <code>ends</code> an answer, once
            the answer has ended.</p>
        <Code language="abide" caption="abide" code={`
            {#if !talk.streaming && talk.message(message, index).ends}
                <div {...talk.message(message, index).actions}>
                    <button onclick={talk.message(message, index).retry}>Ask again</button>
                </div>
            {/if}
        `} />
    </Section>

    <Section level={3} title="Send a follow-up while an answer streams">
        <p>A question sent while an answer streams is <code>pending</code>, and asked as soon as
            the answer ends. <code>cancel</code> is the button dropping it.</p>
        <Code language="abide" caption="abide" code={`
            {#if talk.pending}
                <div {...talk.queued}>
                    <button {...talk.cancel}>Cancel</button>
                </div>
            {/if}
        `} />
    </Section>

    <Section level={3} title="Keep the transcript at its newest message">
        <p><code>autoscroll</code> is an <code>autoscroll</code>'s parts, handed back whole.
            Spread its <code>host</code> with <code>transcript</code> to follow an answer as it
            streams, and its <code>jump</code> is the button taking a reader who scrolled up
            back down.</p>
        <Code language="abide" caption="abide" code={`
            <ol {...talk.transcript} {...talk.autoscroll.host}>…</ol>
            <button {...talk.autoscroll.jump}>↓ Latest</button>
        `} />
    </Section>

    <Section level={3} title="Take files dropped, pasted or picked">
        <p><code>dropzone</code> is a <code>dropzone</code>'s parts, handed back whole. Spread
            its <code>host</code> where files land, the composer or the whole panel, and its
            <code>input</code> on a file picker.</p>
        <Code language="abide" caption="abide" code={`
            <form {...talk.composer} {...talk.dropzone.host}>
                <textarea {...talk.input}></textarea>
                <input {...talk.dropzone.input} aria-label="Attach files">
                <button {...talk.send}>Send</button>
            </form>
        `} />
    </Section>

    <Section level={3} title="Attach a file where the words stop">
        <p><code>draft</code> is the user message being written, its words and files in order.
            The input edits its words, and a file goes after them. <code>attached</code> is
            every block the input does not show, each with a button taking it out.</p>
        <Code language="abide" caption="abide" code={`
            {#for piece of talk.attached key piece}
                <span {...talk.attachment(piece).attachment}>
                    {#if piece.type === 'image'}
                        <img {...talk.attachment(piece).image} alt="an image to send">
                    {/if}
                    <button {...talk.attachment(piece).remove}>×</button>
                </span>
            {/for}
        `} />
    </Section>

    <Section level={3} title="Put a failed question back to edit">
        <p>Write a message to <code>draft</code> and the composer holds it: its words in the
            input, its files attached. The question keeps its files apart from its words, so it
            goes again as it went.</p>
        <Code language="abide" caption="abide" code={`
            <script>
            function putBack() {
                const question = talk.messages.at(-1)
                if (question?.role !== 'user') return
                talk.messages = talk.messages.slice(0, -1)
                talk.draft = question
            }
            </script>

            {#if talk.failed !== undefined}
                <button type="button" onclick={putBack}>Edit the question</button>
            {/if}
        `} />
    </Section>

    <Section level={3} title="Say which files were not attached">
        <p><code>rejected</code> holds the files the last drop, paste or pick turned away, and
            the ones that could not be read. <code>onreject</code> hears them too.</p>
        <Code language="abide" caption="abide" code={`
            {#if talk.rejected.length > 0}
                <p role="status">
                    Not attached: {talk.rejected.map((file) => file.name).join(', ')}
                </p>
            {/if}
        `} />
    </Section>

    <Section level={3} title="Attach a contact card as words">
        <p>Pass <code>attach</code> to decide what a file is sent as. The CRM sends a vCard as
            the contact's fields in words, and every other file as
            <code>assistantMessage</code> makes it. A throw turns the file away, and an empty
            list drops it.</p>
        <Code language="abide" caption="abide" code={`
            <script>
            import { chat } from '@abide/abide'
            import askAssistant from '../askAssistant.server.ts'
            import { attachContactCard } from './attachContactCard.ts'

            const talk = chat({ ask: askAssistant, attach: attachContactCard })
            </script>
        `} />
    </Section>

    <Section level={3} title="Send a question while a photo is still loading">
        <p>A send while <code>attaching</code> waits, and goes once every file has landed.
            The composer carries <code>data-attaching</code> meanwhile.</p>
        <Code language="abide" caption="abide" code={`
            <button {...talk.send}>{talk.attaching ? 'Attaching…' : 'Send'}</button>
        `} />
    </Section>

    <Section level={3} title="Ask a suggested question in one click">
        <p><code>submit</code> sends what <code>draft</code> holds, as the composer does.</p>
        <Code language="abide" caption="abide" code={`
            <script>
            function suggest(question: string) {
                talk.draft = { role: 'user', content: question }
                talk.submit()
            }
            </script>

            <button type="button" onclick={() => suggest('Which company is Ada at?')}>
                Which company is Ada at?</button>
        `} />
    </Section>

    <Section level={3} title="Send the model more, or less, than the conversation holds">
        <p>Every answer is asked through <code>ask</code>: a question sent, one queued, and Ask
            again. Wrap your handler to tell the model which page the question was asked on and
            cut earlier tool results short. The conversation keeps everything. The cost is that
            the model cannot read a cut result again, and calls the tool again where it needs
            it.</p>
        <Code language="ts" caption="browser" code={`
            import type { ChatOptions } from '@abide/abide'
            import askAssistant from '../askAssistant.server.ts'
            import { sentFor } from './askAboutThisPage.ts'

            export const askAboutThisPage: ChatOptions['ask'] = ({ messages }, options) =>
                askAssistant({ messages: sentFor(messages, location.pathname) }, options)
        `} />
    </Section>

    <Section level={3} title="Keep a conversation across visits">
        <p>Hand <code>messages</code> a <code>reactive</code>. The conversation it holds is the
            Messages API's own messages: shown, asked about, and grown by every message the
            chat adds, for you to store as they are.</p>
        <Code language="abide" caption="abide" code={`
            <script>
            import { type AssistantMessage, chat, reactive } from '@abide/abide'
            import askAssistant from '../askAssistant.server.ts'

            // Last visit's conversation, as you stored it.
            let thread = reactive<AssistantMessage[]>([
                { role: 'user', content: 'Which company is Ada at?' },
                { role: 'assistant', content: 'Analytical Engines.' },
            ])
            const talk = chat({ ask: askAssistant, messages: thread })
            </script>
        `} />
    </Section>

    <Section level={3} title="Tell the rep's messages from the assistant's">
        <p>Each message carries <code>data-speaker</code>, <code>you</code> or
            <code>assistant</code>, an answer's last message <code>data-ends</code>, and the root
            <code>data-streaming</code> while an answer arrives.</p>
        <Code language="abide" caption="abide" code={`
            <section {...talk.root} class="data-streaming:opacity-90">
                <ol {...talk.transcript} class="[&_[data-speaker=you]]:text-right">…</ol>
            </section>
        `} />
    </Section>
</Doc>
