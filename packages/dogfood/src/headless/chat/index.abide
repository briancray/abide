<script>
import Code from '#src/lib/Code.abide'
import Doc from '#src/lib/Doc.abide'
import Example from '#src/lib/Example.abide'
import Section from '#src/lib/Section.abide'

import AskTheAssistant from './lib/AskTheAssistant.abide'
import askTheAssistant from './lib/AskTheAssistant.abide' with { type: 'text' }
</script>

<Doc
    seeAlso={[
        '/ai/assistant',
        '/ai/assistant-message',
        '/ai/pairing',
        '/ai/provider',
        '/headless/autoscroll',
        '/headless/dropzone',
        '/helpers/markdown',
    ]}
    tests={[
        {
            path: 'packages/dogfood/examples/crm/src/assistant/lib/AssistantThread.test.ts',
            from: [
                "test('Enter asks, and the answer streams in with its tool call'",
            ],
        },
        {
