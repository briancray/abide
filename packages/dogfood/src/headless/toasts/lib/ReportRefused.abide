<script>
import { onRefusal, report, toasts } from '@abide/abide'

import { sendStatement } from './ReportRefused.server.ts'

onRefusal((refusal, call) => {
    toasts.notify(refusal.message, {
        tone: 'error',
        action: {
            label: 'Report this',
            run: () => report({ trace: call.trace ?? '' }).open(),
        },
    })
})
</script>

<button onclick={() => sendStatement({ id: 'c2' })}>
    Email Grace her statement
</button>
