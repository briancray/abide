<script server>
import { rpc } from '@abide/abide/server'

export const savePhone = rpc(
    ({ phone }: { phone: string }) => {
        if (!/^[\d ]+$/.test(phone)) throw new Error('A phone is digits')
        return phone
    },
    { methods: ['POST'] },
)
</script>

<script>
import { reactive, report, toasts } from '@abide/abide'

let phone = reactive('555 0100')

async function save() {
    try {
        await savePhone({ phone })
        toasts.notify('Phone saved', { tone: 'success' })
    } catch (refused) {
        toasts.notify((refused as Error).message, {
            tone: 'error',
            action: {
                label: 'Report',
                run: () => report({ failure: refused }).open(),
            },
        })
    }
}
</script>

<input bind:value={phone}>
<button onclick={save}>Save</button>
