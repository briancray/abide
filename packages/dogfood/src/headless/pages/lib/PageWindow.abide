<script>
import { memo, pages, reactive } from '@abide/abide'

const COUNT = 8
let page = reactive(1)
const list = pages({ count: COUNT, page })
const nearby = memo(() => {
    const from = Math.max(1, Math.min(page - 2, COUNT - 4))
    return Array.from({ length: 5 }, (_, at) => from + at)
})
</script>

<nav class="row" {...list.nav}>
    <button {...list.previous}>‹</button>
    {#for at of nearby key at}<button {...list.link(at)}>{at}</button>{/for}
    <button {...list.next}>›</button>
</nav>
