<script>
import { menu, reactive } from '@abide/abide'

let choosing = reactive(false)
const move = menu({ open: choosing })
</script>

<button {...move.anchor} onclick={() => (choosing = true)}>
    Choose a stage
</button>
<div {...move.menu}>
    <button {...move.item}>lead</button>
    <button {...move.item}>won</button>
</div>
<p>{choosing ? 'choosing' : 'closed'}</p>
