<div {...actions.menu} class="m-0 flex-col rounded-lg border border-rule
    bg-raised p-tight open:flex">
    <button role="menuitem" {...move.trigger}>Move to</button>
    <div {...move.menu} class="m-0 flex-col rounded-lg border border-rule
        bg-raised p-tight open:flex">
        <button role="menuitem">Proposal</button>
        <button role="menuitem">Won</button>
    </div>
    <button role="menuitem">Archive</button>
</div>
