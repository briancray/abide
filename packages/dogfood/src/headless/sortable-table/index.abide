<script>
import Code from '#src/lib/Code.abide'
import Doc from '#src/lib/Doc.abide'
import Example from '#src/lib/Example.abide'
import Section from '#src/lib/Section.abide'

import ContactUnder from './lib/ContactUnder.abide'
import contactUnder from './lib/ContactUnder.abide' with { type: 'text' }
import OwnCells from './lib/OwnCells.abide'
import ownCells from './lib/OwnCells.abide' with { type: 'text' }
import PickRows from './lib/PickRows.abide'
import pickRows from './lib/PickRows.abide' with { type: 'text' }
import SortArrows from './lib/SortArrows.abide'
import sortArrows from './lib/SortArrows.abide' with { type: 'text' }
import SortedByClose from './lib/SortedByClose.abide'
import sortedByClose from './lib/SortedByClose.abide' with { type: 'text' }
</script>

<Doc
    seeAlso={['/helpers/sort-by', '/helpers/format', '/abide-files/control-flow']}
    tests={[
        {
            path: 'packages/dogfood/examples/crm/src/companies/lib/CompanyTable.test.ts',
            from: ["test('a name links to its company, and sorts with its row'"],
        },
        {
            path: 'packages/dogfood/examples/crm/src/pipeline/lib/ClosingDeals.test.ts',
            from: ["test('a re-sort moves the rows, building and rewriting none'"],
        },
        {
            path: 'packages/dogfood/examples/crm/src/pipeline/lib/ClosingDeals.test.ts',
            from: ["test('stage sorts in pipeline order, ties as they came'"],
        },
        {
            path: 'packages/dogfood/examples/crm/src/pipeline/lib/ClosingDeals.test.ts',
            from: ["test('a first press on Amount sorts the largest deal first'"],
        },
        {
            path: 'packages/dogfood/examples/crm/src/companies/lib/CompanyTable.test.ts',
            from: [
                'test("each company\'s contact sits in a row of its own under it',
            ],
        },
        {
            path: 'packages/dogfood/examples/crm/src/pipeline/lib/StaleDeals.test.ts',
            from: ["test('a checked row is selected, and named by its deal'"],
        },
        {
            path: 'packages/dogfood/examples/crm/src/pipeline/lib/StaleDeals.test.ts',
            from: [
                "test('a Shift-click picks every row from the last one clicked'",
            ],
        },
        {
            path: 'packages/dogfood/examples/crm/src/pipeline/lib/StaleDeals.test.ts',
            from: [
                "test('the header box is mixed for some, and picks every row or none'",
            ],
        },
        {
            path: 'packages/dogfood/examples/crm/src/pipeline/lib/StaleDeals.test.ts',
            from: [
                "test('a header press sorts the rows you wrote, and again turns them round'",
            ],
        },
    ]}
>
    <Section level={3} title="Write each cell yourself, with the headers still sorting">
        <p>Spread a column's <code>header</code> onto its header and its <code>sort</code> onto
            the button, and walk <code>rows</code>: the rows come back in the order the sort names.
            Pressing a header sorts ascending, and pressing it again turns the direction round.
            <code>key</code> lets a re-sort move rows rather than rewrite them. Each cell is yours,
            so a deal's owner can sit under its name.</p>
        <Example code={ownCells}><OwnCells /></Example>
    </Section>

    <Section level={3} title="Sort stages in pipeline order, and show amounts as money">
        <p>A column's <code>value</code> is what it sorts by, and <code>format</code> is what
            <code>text(row, column)</code> writes in its cells.</p>
        <Code language="abide" caption="abide" code={`
            const COLUMNS: Column<Deal>[] = [
                { key: 'name', label: 'Deal', sortable: false },
                {
                    key: 'stage',
                    label: 'Stage',
                    value: (deal) => STAGES.indexOf(deal.stage),
                    format: (_, deal) => deal.stage,
                },
                {
                    key: 'amount',
                    label: 'Amount',
                    format: (amount) => format.money(Number(amount)),
                },
            ]

            {#for column of COLUMNS by column.key}
                <td {...table.column(column).cell}>{table.text(deal, column)}</td>
            {/for}
        `} />
    </Section>

    <Section level={3} title="Open the table sorted by close date">
        <p>Hand <code>sort</code> a <code>reactive</code> to set the sort it opens with and to
            read the one picked since.</p>
        <Example code={sortedByClose}><SortedByClose /></Example>
    </Section>

    <Section level={3} title="Sort amounts largest first on the first press">
        <p>A column's <code>firstDirection</code> is the direction a first press of its header
            sorts in. A second press turns it round.</p>
        <Code language="abide" caption="abide" code={`
            const COLUMNS: Column<Deal>[] = [
                { key: 'amount', label: 'Amount', firstDirection: 'descending' },
            ]
        `} />
    </Section>

    <Section level={3} title="Mark the sorted column's direction with an arrow">
        <p>The sorted header carries <code>data-sort</code>, <code>ascending</code> or
            <code>descending</code>, and a column's <code>align</code> is
            <code>data-align</code> on its header and its cells.</p>
        <Example code={sortArrows}><SortArrows /></Example>
    </Section>

    <Section level={3} title="Show each company's contact in a row under the company">
        <p>Spread <code>row(row).detail</code> onto a row of your own under each row, and it moves
            with its row when the table sorts.</p>
        <Example code={contactUnder}><ContactUnder /></Example>
    </Section>

    <Section level={3} title="Pick rows with a checkbox each, and every row from the header">
        <p><code>row(row).checkbox</code> is a row's checkbox, where a Shift-click picks every row
            from the last one clicked, and <code>selectAll.checkbox</code> is the header's, mixed
            while some rows are picked. <code>selected</code> holds the keys picked.</p>
        <Example code={pickRows}><PickRows /></Example>
    </Section>
</Doc>
