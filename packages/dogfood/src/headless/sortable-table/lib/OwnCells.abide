<script>
import { type Column, format, sortableTable } from '@abide/abide'

type Deal = { id: string; name: string; owner: string; amount: number }

const DEALS: Deal[] = [
    { id: 'hopper', name: 'Hopper renewal', owner: 'Ada', amount: 48_000 },
    { id: 'turing', name: 'Turing seats', owner: 'Grace', amount: 22_000 },
    { id: 'noether', name: 'Noether pilot', owner: 'Ada', amount: 6_500 },
]
const COLUMNS: Column<Deal>[] = [
    { key: 'name', label: 'Deal' },
    { key: 'amount', label: 'Amount', align: 'end' },
]
const table = sortableTable({
    rows: DEALS,
    columns: COLUMNS,
})
</script>

<table {...table.table} class="w-full [&_[data-align=end]]:text-right">
    <thead>
        <tr>
            {#for column of COLUMNS key column.key}
                <th {...table.column(column).header}>
                    <button {...table.column(column).sort}>
                        {column.label}
                    </button>
                </th>
            {/for}
        </tr>
    </thead>
    <tbody>
        {#for deal of table.rows key deal.id}
            <tr>
                <td>
                    <strong>{deal.name}</strong>
                    <small class="block text-muted">{deal.owner}</small>
                </td>
                <td class="text-right">{format.money(deal.amount)}</td>
            </tr>
        {/for}
    </tbody>
</table>
