<script>
import { range, reactive } from '@abide/abide'

let amount = reactive<readonly [number, number]>([10, 40])
const filter = range({ value: amount, label: 'Amount', name: 'amount' })
let sent = reactive('')
</script>

<form
    onsubmit={(event) => {
        event.preventDefault()
        const fields = new FormData(event.currentTarget as HTMLFormElement)
        sent = fields.getAll('amount').join(' to ')
    }}
>
    <div class="range" {...filter.root}>
        <div {...filter.track}>
            <div {...filter.fill} />
            <span {...filter.end(0).thumb} />
            <span {...filter.end(1).thumb} />
        </div>
        <input {...filter.end(0).input}>
        <input {...filter.end(1).input}>
    </div>
    <button>Filter</button>
</form>
<p>{sent === '' ? 'Nothing sent yet.' : `Sent ${sent}.`}</p>
