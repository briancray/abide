<script>
import { lightbox } from '@abide/abide'

const PAGES = ['Terms', 'Pricing', 'Signatures']
const viewer = lightbox({ items: PAGES })
</script>

<button onclick={() => viewer.show('Terms')}>Read the contract</button>
<dialog
    aria-label="Contract"
    {...viewer.dialog}
    class="m-0 h-dvh max-h-none w-dvw max-w-none bg-transparent p-0"
>
    <div {...viewer.backdrop} class="grid h-full place-items-center bg-ink/60">
        <ul
            class="flex w-80 snap-x snap-mandatory overflow-x-auto bg-raised"
            {...viewer.host}
        >
            {#for page of PAGES key page}
                <li
                    class="shrink-0 basis-full snap-center p-8"
                    {...viewer.item(page)}
                >{page}</li>
            {/for}
        </ul>
    </div>
</dialog>
