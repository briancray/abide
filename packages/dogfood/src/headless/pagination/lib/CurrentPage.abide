<script>
import { pagination } from '@abide/abide'

const list = pagination({ count: 5 })
</script>

<nav class="row" {...list.nav}>
    {#for item of list.items}
        {#if item !== 'gap'}
            <button
                class="aria-[current=page]:bg-signal
                aria-[current=page]:text-paper"
                {...list.link(item)}
            >{item}</button>
        {/if}
    {/for}
</nav>
