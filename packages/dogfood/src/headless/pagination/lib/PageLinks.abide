<script>
import { pagination } from '@abide/abide'

const list = pagination({ count: 5, href: (page) => `?page=${page}` })
</script>

<nav class="row" {...list.nav}>
    {#for item of list.items}
        {#if item === 'gap'}<span>…</span>{:else}
            <a {...list.link(item)}>{item}</a>
        {/if}
    {/for}
</nav>
