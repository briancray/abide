<script>
import { calendar, reactive } from '@abide/abide'

let closes = reactive<string | undefined>('2026-12-15')
const dates = calendar({ selected: closes })
</script>

<p>Closes {closes ?? 'on no day yet'}</p>
<div class="calendar">
    <div data-bar>
        <button {...dates.previous}>‹</button>
        <button {...dates.next}>›</button>
    </div>
    <div data-months>
        {#for shown of dates.months key shown.month}
            <section>
                <h3 {...shown.heading}>{shown.label}</h3>
                <div {...shown.grid}>
                    <div {...dates.header}>
                        {#for weekday of dates.weekdays key weekday.day}
                            <div {...weekday.header}>{weekday.short}</div>
                        {/for}
                    </div>
                    {#for week of shown.weeks key week[0]?.date}
                        <div {...dates.week}>
                            {#for day of week key day.date}
                                <div {...day.cell}>{day.day}</div>
                            {/for}
                        </div>
                    {/for}
                </div>
            </section>
        {/for}
    </div>
</div>
