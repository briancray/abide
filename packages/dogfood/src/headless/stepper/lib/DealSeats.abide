<script>
import { stepper } from '@abide/abide'

const seats = stepper({ min: 1, max: 50, label: 'Seats' })
</script>

<div class="row">
    <button {...seats.decrement}>−</button>
    <input class="w-16 text-center" {...seats.input} />
    <button {...seats.increment}>+</button>
</div>
<p>{seats.value} seats</p>
