<script>
import { time } from '@abide/abide'

const DAY = 86_400_000
const due = time({ style: 'short' })
const FOLLOW_UPS = [
    { contact: 'Ada', at: Date.now() + 2 * DAY },
    { contact: 'Grace', at: Date.now() - 3 * DAY },
]
</script>

<ul>
    {#for followUp of FOLLOW_UPS by followUp.contact}
        <li>
            Call {followUp.contact}
            <time {...due.at(followUp.at).time} class="font-medium text-ink">
                {due.at(followUp.at).text}
            </time>
        </li>
    {/for}
</ul>
