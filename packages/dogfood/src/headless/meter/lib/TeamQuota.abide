<script>
import { format, meter } from '@abide/abide'

const WON = 410_000
const TARGET = 500_000
const quota = meter({
    value: WON,
    max: TARGET,
    low: TARGET / 2,
    label: 'Quota',
})
</script>

<div class="h-2 rounded-full bg-rule" {...quota.meter}>
    <div class="h-full rounded-full bg-signal" {...quota.fill}></div>
</div>
<p>
    {format.money(WON, { maximumFractionDigits: 0 })} of
    {format.money(TARGET, { maximumFractionDigits: 0 })}
</p>
