import badgeTestSource from 'crm-07/src/account/lib/Badge.test.ts' with { type: 'text' }
import Density from 'crm-07/src/account/lib/Density.abide'
import densitySource from 'crm-07/src/account/lib/Density.abide' with { type: 'text' }
import densityTestSource from 'crm-07/src/account/lib/Density.test.ts' with { type: 'text' }
import ContactCard from 'crm-07/src/account/lib/ContactCard.abide'
import contactCardSource from 'crm-07/src/account/lib/ContactCard.abide' with { type: 'text' }
import getContactSource from 'crm-07/src/account/getContact.handler.ts' with { type: 'text' }
import contactCardTestSource from 'crm-07/src/account/lib/ContactCard.test.ts' with { type: 'text' }
import ExportContacts from 'crm-07/src/account/lib/ExportContacts.abide'
import exportContactsComponentSource from 'crm-07/src/account/lib/ExportContacts.abide' with { type: 'text' }
import exportContactsSource from 'crm-07/src/account/exportContacts.handler.ts' with { type: 'text' }
import exportContactsTestSource from 'crm-07/src/account/lib/ExportContacts.test.ts' with { type: 'text' }
import PartnerStatement from 'crm-07/src/account/lib/PartnerStatement.abide'
import partnerStatementSource from 'crm-07/src/account/lib/PartnerStatement.abide' with { type: 'text' }
import getStatementSource from 'crm-07/src/account/getStatement.handler.ts' with { type: 'text' }
import partnerStatementTestSource from 'crm-07/src/account/lib/PartnerStatement.test.ts' with { type: 'text' }
import SalesReport from 'crm-07/src/account/lib/SalesReport.abide'
import salesReportComponentSource from 'crm-07/src/account/lib/SalesReport.abide' with { type: 'text' }
import salesReportSource from 'crm-07/src/account/salesReport.handler.ts' with { type: 'text' }
import salesReportTestSource from 'crm-07/src/account/lib/SalesReport.test.ts' with { type: 'text' }
import SyncContact from 'crm-07/src/account/lib/SyncContact.abide'
import syncContactComponentSource from 'crm-07/src/account/lib/SyncContact.abide' with { type: 'text' }
import syncContactSource from 'crm-07/src/account/syncContact.handler.ts' with { type: 'text' }
import syncContactTestSource from 'crm-07/src/account/lib/SyncContact.test.ts' with { type: 'text' }
import AddContact from 'crm-07/src/account/lib/AddContact.abide'
import addContactComponentSource from 'crm-07/src/account/lib/AddContact.abide' with { type: 'text' }
import addContactSource from 'crm-07/src/account/addContact.handler.ts' with { type: 'text' }
import addContactTestSource from 'crm-07/src/account/lib/AddContact.test.ts' with { type: 'text' }
import Widget from 'crm-07/src/account/lib/Widget.abide'
import widgetSource from 'crm-07/src/account/lib/Widget.abide' with { type: 'text' }
