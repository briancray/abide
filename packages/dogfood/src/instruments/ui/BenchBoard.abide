<script>
// THE BENCH, RUN FROM THE PAGE. Every row is abide against the hand-written arm in one engine, and
// nothing here is a result until somebody presses a button — the numbers are the machine's today,
// not a table somebody typed (`harness/scripts/benchRows.ts` is what produces them).
//
// ONE VALUE HOLDS THE ROWS, and a run patches into it as each row lands, so running one bench
// leaves every other row in the catalog standing.
import { reactive } from '@abide/abide'
import { type BenchRow, matchesFilter, type RowItem } from 'harness/rows'
import { benchCatalog, runBench } from '../bench.abide'
import { messageOf } from './messageOf.ts'
import { readRows } from '../readRows.ts'
import { ROW_STATES } from './ROW_STATES.ts'

type Section = { name: string; items: RowItem[] }

let filter = reactive('')
const catalog = reactive(() => benchCatalog())
const landed = reactive(new Map<string, BenchRow>())
let running = reactive(false)
let failure = reactive('')
let stopping: AbortController | undefined

// THE CATALOG'S OWN ITEMS, grouped — and NOT the readings. A keyed list keeps a row whose item is
// the same object and remakes one whose item is new, so a section rebuilt per landed row would
// remake every row in the catalog each time. The readings are looked up by each row's own
// slots, which is what lets one row change alone.
const sections = reactive(() => {
    const grouped: Section[] = []
    for (const item of catalog) {
        if (!matchesFilter(item, filter)) continue
        let section = grouped[grouped.length - 1]
        if (section === undefined || section.name !== item.section) {
            section = { name: item.section, items: [] }
            grouped.push(section)
        }
        section.items.push(item)
    }
    return grouped
})

const shown = reactive(() => {
    let count = 0
    for (const section of sections) count += section.items.length
    return count
})

/**
 * A bench row's cells, as text and tone.
 *
 * Read from `landed` inside the row's own slots — so a reading landing rewrites the slots of the
 * row it belongs to and no other.
 */
function cellsOf(item: RowItem) {
    const row = landed.get(item.id)
    if (row === undefined || row.state !== 'done') {
        const state = ROW_STATES[row?.state ?? 'none']
        return {
            abide: '—',
            vanilla: '—',
            n: '—',
            floor: '—',
            claim: state.label,
            figureTone: 'text-muted',
            claimTone: state.tone,
            note: row?.note ?? '',
        }
    }
    return {
        abide: figure(row.abide, row.unit),
        vanilla: figure(row.vanilla, row.unit),
        n: row.n === null ? '—' : row.n.toLocaleString('en-US'),
        floor: row.floor === null ? '—' : `${(row.floor * 100).toFixed(1)}%`,
        claim: row.claim,
        figureTone: '',
        claimTone: verdictOf(row.claim),
        note: row.note,
    }
}

async function start(scope: string) {
    running = true
    failure = ''
    stopping = new AbortController()
    try {
        await readRows<BenchRow>(
            await runBench.raw({ scope, filter }, { signal: stopping.signal }),
            (row) => landed.patch((map) => map.set(row.id, row)),
        )
    } catch (error) {
        if (!stopping.signal.aborted) failure = messageOf(error)
    }
    // A row a stopped run only queued or started has no reading, so it goes back to having none.
    landed.patch((map) => {
        for (const [id, row] of map)
            if (row.state === 'queued' || row.state === 'running') map.delete(id)
    })
    running = false
}

function stop() {
    stopping?.abort()
}

function figure(value: number | null, unit: string): string {
    if (value === null) return '—'
    if (unit === 'lines') return `${value} lines`
    return `${value < 10 ? value.toFixed(2) : value.toFixed(1)} ${unit}`
}

/**
 * The tone for an abide / vanilla claim: good at or under parity, bad at twice or more.
 *
 * Over 1.00x is abide slower, or larger. Under is the claim; twice is the one worth a look.
 */
function verdictOf(claim: string): string {
    const times = Number.parseFloat(claim)
    if (Number.isNaN(times)) return ''
    return times <= 1 ? 'text-good' : times >= 2 ? 'text-bad' : ''
}
</script>

{#component Figure({ tone, value }: { tone: string; value: string })}
    <td class={`text-right whitespace-nowrap font-mono tabular-nums ${tone}`}>{value}</td>
{/component}

<main id="content" class="col-span-full mx-auto w-full max-w-320 gap-section">
    <header>
        <h1>Bench</h1>
        <p class="max-w-170 text-title/8 text-muted">Every bench with a hand-written arm, abide against vanilla in the same engine. Over 1.00x, abide is slower or larger.</p>
    </header>

    <div class="sticky top-bar z-1 flex flex-wrap items-center gap-snug border-b border-rule bg-paper py-3">
        <input type="search" class="min-w-60 flex-1" placeholder="Filter benches" aria-label="Filter benches" bind:value={filter}>
        {#if running}
            <button onclick={stop}>Stop</button>
        {:else}
            <button onclick={() => start('all')}>{filter.trim() === '' ? 'Run all' : `Run ${shown} shown`}</button>
        {/if}
        <span class={`font-mono text-chrome/4 font-medium ${failure !== '' ? 'text-bad' : 'text-muted'}`}>{failure !== '' ? failure : running ? 'running — one bench at a time, so no two timings share the machine' : `${shown} benches`}</span>
    </div>

    {#if catalog.error()}
        <p class="text-bad">{messageOf(catalog.error())}</p>
    {:else if catalog.ready()}
        {#for section of sections by section.name}
            <section class="gap-snug">
                <div class="flex items-baseline gap-snug">
                    <h2 class="mr-auto">{section.name}</h2>
                    <span class="font-mono text-chrome/4 font-medium text-muted">{section.items.length}</span>
                    <button class="border border-rule bg-transparent px-2 py-1 font-mono text-chrome/4 font-medium text-muted enabled:hover:border-signal enabled:hover:text-signal" onclick={() => start(`section:${section.name}`)} disabled={running}>Run section</button>
                </div>
                <table class="[&_td]:py-2 [&_td]:pr-4 [&_td]:pl-0 [&_td]:align-baseline [&_td]:text-chrome/5 [&_th]:py-2 [&_th]:pr-4 [&_th]:pl-0 [&_th]:align-baseline">
                    <thead>
                        <tr><th>Bench</th><th class="text-right whitespace-nowrap font-mono tabular-nums">abide</th><th class="text-right whitespace-nowrap font-mono tabular-nums">vanilla</th><th class="text-right whitespace-nowrap font-mono tabular-nums">abide / vanilla</th><th class="text-right whitespace-nowrap font-mono tabular-nums">n</th><th class="text-right whitespace-nowrap font-mono tabular-nums">A/A floor</th><th></th></tr>
                    </thead>
                    <tbody>
                        {#for item of section.items by item.id}
                            <tr class="group">
                                <td>{item.name}<span class={`block ${landed.get(item.id)?.state === 'broken' ? 'text-bad' : 'text-muted'}`}>{cellsOf(item).note}</span></td>
                                <Figure tone={cellsOf(item).figureTone} value={cellsOf(item).abide}/>
                                <Figure tone={cellsOf(item).figureTone} value={cellsOf(item).vanilla}/>
                                <Figure tone={cellsOf(item).claimTone} value={cellsOf(item).claim}/>
                                <Figure tone={cellsOf(item).figureTone} value={cellsOf(item).n}/>
                                <Figure tone={cellsOf(item).figureTone} value={cellsOf(item).floor}/>
                                <td class="text-right whitespace-nowrap font-mono tabular-nums"><button class="border border-rule bg-transparent px-2 py-1 font-mono text-chrome/4 font-medium text-muted enabled:hover:border-signal enabled:hover:text-signal opacity-50 transition-opacity duration-120 ease-[ease] group-hover:opacity-100 focus-visible:opacity-100" onclick={() => start(`item:${item.id}`)} disabled={running}>Run</button></td>
                            </tr>
                        {/for}
                    </tbody>
                </table>
            </section>
        {/for}
    {:else}
        <p class="font-mono text-chrome/4 font-medium text-muted">Listing the benches…</p>
    {/if}
</main>
