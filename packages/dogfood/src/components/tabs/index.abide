<script>
import Code from '#src/lib/Code.abide'
import Doc from '#src/lib/Doc.abide'
import Section from '#src/lib/Section.abide'
</script>

<Doc
    seeAlso={[
        '/abide-files/control-flow',
        '/abide-files/components',
        '/components/combobox',
    ]}
    tests={[
        {
            path: 'packages/dogfood/examples/crm/src/deals/lib/DealTabs.test.ts',
            from: [
                "test('the arrow keys move between tabs, and the panel follows'",
            ],
        },
        {
            path: 'packages/dogfood/examples/crm/src/deals/lib/DealTabs.test.ts',
            from: [
                "test('switching tabs rebuilds the panel, and none of the tabs'",
            ],
        },
    ]}
>
    <Section level={3} title="Switch a deal between its details, value and stage">
        <p>Bind <code>selected</code> to the key of the tab showing, and branch on it in the
            children: they are the one panel.</p>
        <Code language="abide" caption="abide" code={`
            <script>
            import { reactive } from '@abide/abide'
            import Tabs from '@abide/abide/Tabs.abide'

            const VIEWS = [
                { key: 'details', label: 'Details' },
                { key: 'stage', label: 'Stage' },
            ]
            let tab = reactive('details')
            </script>

            <Tabs
                id="deal"
                tabs={VIEWS}
                key={(view) => view.key}
                label={(view) => view.label}
                bind:selected={tab}
            >
                {#if tab === 'details'}<DealDetails />{:else}<DealStage />{/if}
            </Tabs>
        `} />
    </Section>

    <Section level={3} title="Put a count beside each tab's name">
        <p>A <code>Tab</code> component renders each tab's content, handed its item.</p>
        <Code language="abide" caption="abide" code={`
            <Tabs
                id="company"
                tabs={VIEWS}
                key={(view) => view.key}
                bind:selected={tab}
            >
                {#component Tab({ item }: { item: View })}
                    {item.label} <span>{item.count}</span>
                {/component}
                <CompanyView tab={tab} />
            </Tabs>
        `} />
    </Section>

    <Section level={3} title="Underline the selected tab">
        <p>The row is <code>data-part="tablist"</code>, each tab <code>data-part="tab"</code>,
            and the selected one carries <code>data-selected</code>.</p>
        <Code language="abide" caption="abide" code={`
            <Tabs
                class="[&_[data-part=tablist]]:flex [&_[data-selected]]:border-b-2"
                …
            />
        `} />
    </Section>
</Doc>
