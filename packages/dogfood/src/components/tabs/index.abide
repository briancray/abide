<Doc
    seeAlso={[
        '/abide-files/control-flow',
        '/abide-files/components',
        '/components/combobox',
    ]}
    tests={[
        {
            path: 'packages/dogfood/examples/crm/src/deals/lib/DealTabs.test.ts',
            from: [
                "test('the arrow keys move between tabs, and the panel follows'",
            ],
        },
        {
            path: 'packages/dogfood/examples/crm/src/deals/lib/DealTabs.test.ts',
            from: [
                "test('switching tabs rebuilds the panel, and none of the tabs'",
            ],
        },
        {
            path: 'packages/abide/tests/tabs.test.ts',
            from: [
                "test('a panel per tab is hidden while another is selected, and kept",
            ],
        },
    ]}
>
    <Section level={3} title="Switch a deal between its details and its stage">
        <p>Spread <code>list</code> on the row, <code>tab(key)</code> on each tab, and
            <code>panel()</code> on the one panel, and branch on the selected key in it.</p>
        <Code language="abide" caption="abide" code={`
            <script>
            import { reactive, tabs } from '@abide/abide'

            let tab = reactive<string | undefined>('details')
            const view = tabs({ keys: ['details', 'stage'], selected: tab })
            </script>

            <div {...view.list}>
                <button {...view.tab('details')}>Details</button>
                <button {...view.tab('stage')}>Stage</button>
            </div>
            <div {...view.panel()}>
                {#if tab === 'details'}<DealDetails />{:else}<DealStage />{/if}
            </div>
        `} />
    </Section>

    <Section level={3} title="Keep a draft in a tab while another shows">
        <p>Spread <code>panel(key)</code> on a panel per tab. A panel is hidden while another
            tab is selected, and keeps what it holds.</p>
        <Code language="abide" caption="abide" code={`
            <div {...view.panel('details')}><DealDetails /></div>
            <div {...view.panel('notes')}><textarea></textarea></div>
        `} />
    </Section>

    <Section level={3} title="Put a count beside each tab's name">
        <p>A tab is your own element, so it holds anything.</p>
        <Code language="abide" caption="abide" code={`
            <button {...view.tab('notes')}>Notes <span>{notes.length}</span></button>
        `} />
    </Section>

    <Section level={3} title="Underline the selected tab">
        <p>The selected tab carries <code>data-selected</code>.</p>
        <Code language="abide" caption="abide" code={`
            <div class="flex [&_[data-selected]]:border-b-2" {...view.list}>
                …
            </div>
        `} />
    </Section>
</Doc>
