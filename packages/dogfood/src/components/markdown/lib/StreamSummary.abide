<script server>
import { GET } from '@abide/abide/server'

const summarizeDeal = GET(async function* () {
    for (const word of '**Acme** wants the annual plan.'.split(' ')) {
        await Bun.sleep(150)
        yield `${word} `
    }
})
</script>

<script>
import { reactive } from '@abide/abide'
import Markdown from '@abide/abide/Markdown.abide'

const summary = reactive(() => summarizeDeal())
</script>

<Markdown source={summary.join('')} />
