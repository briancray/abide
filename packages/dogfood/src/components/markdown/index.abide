<script>
import Doc from '#src/lib/Doc.abide'
import Example from '#src/lib/Example.abide'
import Section from '#src/lib/Section.abide'

import CopyCommands from './lib/CopyCommands.abide'
import copyCommands from './lib/CopyCommands.abide' with { type: 'text' }
import InsideLinks from './lib/InsideLinks.abide'
import insideLinks from './lib/InsideLinks.abide' with { type: 'text' }
import NestedHeadings from './lib/NestedHeadings.abide'
import nestedHeadings from './lib/NestedHeadings.abide' with { type: 'text' }
import OutsideTab from './lib/OutsideTab.abide'
import outsideTab from './lib/OutsideTab.abide' with { type: 'text' }
import PreviewNote from './lib/PreviewNote.abide'
import previewNote from './lib/PreviewNote.abide' with { type: 'text' }
import StreamSummary from './lib/StreamSummary.abide'
import streamSummary from './lib/StreamSummary.abide' with { type: 'text' }
</script>

<Doc
    seeAlso={['/helpers/markdown', '/components/chat', '/abide-files/raw']}
    tests={[
        {
            path: 'packages/dogfood/examples/crm/src/deals/lib/NotePreview.test.ts',
            from: ["test('a note renders its markdown, and its HTML as text'"],
        },
        {
            path: 'packages/dogfood/examples/crm/src/deals/lib/NotePreview.test.ts',
            from: [
                "test('a heading in a note renders at the level the page gives it'",
            ],
        },
        {
            path: 'packages/dogfood/examples/crm/src/pipeline/lib/DealSummary.test.ts',
            from: ["test('a chunk renders only the section still growing'"],
        },
        {
            path: 'packages/dogfood/examples/crm/src/deals/lib/NotePreview.test.ts',
            from: [
                "test('a fenced sh block renders as the code with a Copy beside it, and once closed only'",
            ],
        },
        {
            path: 'packages/dogfood/examples/crm/src/deals/lib/NotePreview.test.ts',
            from: [
                "test('a reference link takes its address from a definition anywhere in the note, which shows nothing'",
            ],
        },
    ]}
>
    <Section level={3} title="Preview a deal note as it is typed">
        <p>HTML in the source renders as text, and a link to a scheme outside
            <code>schemes</code> renders as its words.</p>
        <Example code={previewNote}><PreviewNote /></Example>
    </Section>

    <Section level={3} title="Render a note's headings under the page's own">
        <p>A <code>#</code> heading renders at <code>headingLevel</code>, and each deeper one a level
            under the last.</p>
        <Example code={nestedHeadings}><NestedHeadings /></Example>
    </Section>

    <Section level={3} title="Render a summary as it streams in">
        <p>Hand <code>source</code> the text received until now. A section the stream has moved past keeps
            its nodes, so a chunk renders only the section still growing.</p>
        <Example code={streamSummary}><StreamSummary /></Example>
    </Section>

    <Section level={3} title="Keep a note's links inside the CRM">
        <p><code>href</code> rewrites each link's address. A link it answers
            <code>undefined</code> for renders as its text.</p>
        <Example code={insideLinks}><InsideLinks /></Example>
    </Section>

    <Section level={3} title="Open a note's outside links in a tab of their own">
        <p><code>href</code> may answer the address with the <code>target</code> and
            <code>rel</code> the link opens with.</p>
        <Example code={outsideTab}><OutsideTab /></Example>
    </Section>

    <Section level={3} title="Put a Copy button beside each shell command">
        <p><code>blocks</code> names a component per fence language. A fenced block whose
            language is one of them renders as that component, handed its <code>source</code>
            and the rest of its <code>info</code>, once its fence closes.</p>
        <Example code={copyCommands}><CopyCommands /></Example>
    </Section>

    <Section level={3} title="Name a link once and use it anywhere in a note">
        <p>A reference link — <code>[the quote][q]</code>, <code>[q][]</code> or
            <code>[q]</code> — takes its address from a <code>[q]: address</code> line anywhere
            in the source, which renders nothing.</p>
    </Section>
</Doc>
