<script>
import Code from '#src/lib/Code.abide'
import Doc from '#src/lib/Doc.abide'
import Example from '#src/lib/Example.abide'
import Section from '#src/lib/Section.abide'

import ConfirmDelete from './lib/ConfirmDelete.abide'
import confirmDelete from './lib/ConfirmDelete.abide' with { type: 'text' }
import RenameDeal from './lib/RenameDeal.abide'
import renameDeal from './lib/RenameDeal.abide' with { type: 'text' }
</script>

<Doc
    seeAlso={['/helpers/dialog', '/components/toasts-api']}
    tests={[
        {
            path: 'packages/dogfood/examples/crm/src/deals/lib/DeleteDeal.test.ts',
            from: ["test('a deal is deleted only once the dialog is confirmed'"],
        },
        {
            path: 'packages/dogfood/examples/crm/src/deals/lib/DeleteDeal.test.ts',
            from: ["test('a confirm that is a call stays up, busy, until it lands"],
        },
        {
            path: 'packages/dogfood/examples/crm/src/deals/lib/DeleteDeal.test.ts',
            from: ["test('a withdrawn prompt is declined"],
        },
        {
            path: 'packages/dogfood/examples/crm/src/deals/lib/DeleteDeal.test.ts',
            from: ["test('the question names the deal and is marked danger'"],
        },
        {
            path: 'packages/dogfood/examples/crm/src/deals/lib/DeleteDeal.test.ts',
            from: ["test('Escape declines the question'"],
        },
        {
            path: 'packages/dogfood/examples/crm/src/deals/lib/DeleteDeal.test.ts',
            from: ["test('a question shows in one dialog where two Prompts stand'"],
        },
        {
            path: 'packages/dogfood/examples/crm/src/deals/lib/RenameDeal.test.ts',
            from: [
                "test('Rename takes the text typed, and Cancel keeps the old name'",
            ],
        },
        {
            path: 'packages/abide/tests/overlays.test.ts',
            from: [
                "test('confirm, alert, prompt and notify throw inside a request",
            ],
        },
        {
            path: 'packages/dogfood/examples/crm/src/deals/lib/ArchiveDeal.test.ts',
            from: [
                "test('the question shows in a dialog of its own markup, named and marked danger'",
            ],
        },
        {
            path: 'packages/dogfood/examples/crm/src/deals/lib/ArchiveDeal.test.ts',
            from: [
                "test('Archive stays disabled until the word is typed, and then archives'",
            ],
        },
    ]}
>
    <Section level={3} title="Ask before deleting a deal">
        <p><code>prompts.confirm</code> settles <code>true</code> only when the confirming button
            closed it. Cancel, Escape and the backdrop settle <code>false</code>.</p>
        <Example code={confirmDelete}><ConfirmDelete /></Example>
    </Section>

    <Section level={3} title="Make the company name be typed before a delete">
        <p>With <code>mustType</code>, the confirming button stays disabled until the word is
            typed, matched ignoring case.</p>
        <Code language="ts" caption="browser" code={`
            import { prompts } from '@abide/abide'

            const sure = await prompts.confirm({
                title: 'Delete Analytical Engines?',
                body: 'Its 40 deals go with it.',
                mustType: 'Analytical Engines',
                danger: true,
            })
        `} />
    </Section>

    <Section level={3} title="Ask for a deal's new name">
        <p><code>prompts.prompt</code> settles with the text typed, or <code>undefined</code> when
            declined. The input starts from <code>value</code>.</p>
        <Example code={renameDeal}><RenameDeal /></Example>
    </Section>

    <Section level={3} title="Tell the person something and wait for the close">
        <p>A string in place of the options is the body. <code>prompts.alert</code> settles once
            the person closes it.</p>
        <Code language="ts" caption="browser" code={`
            import { prompts } from '@abide/abide'

            await prompts.alert('The import finished with 3 duplicate contacts.')
        `} />
    </Section>

    <Section level={3} title="Mark a deal lost from the dialog, and say why it could not">
        <p>Hand <code>run</code> the call the confirm makes. The dialog stays up with
            <code>data-busy</code> while it runs, closes once it lands, and shows the refusal in its
            <code>error</code> part: here, that a closed deal does not move.</p>
        <Code language="ts" caption="browser" code={`
            import { prompts } from '@abide/abide'
            import moveDeal from '../moveDeal.handler.ts'

            await prompts.confirm({
                body: 'Mark Engine renewal lost?',
                danger: true,
                run: () => moveDeal({ id, stage: 'lost' }),
            })
        `} />
    </Section>

    <Section level={3} title="Withdraw a question the page no longer needs">
        <p>Pass a <code>signal</code>, and aborting it takes the prompt down, or out of the
            queue, as declined.</p>
        <Code language="ts" caption="browser" code={`
            import { prompts } from '@abide/abide'

            const leaving = new AbortController()
            const keep = prompts.confirm({ body: 'Keep editing?', signal: leaving.signal })
            leaving.abort() // keep settles false
        `} />
    </Section>

    <Section level={3} title="Ask without blocking the page">
        <p><code>modal: false</code> shows the prompt beside the page, which stays usable
            around it.</p>
        <Code language="ts" caption="browser" code={`
            import { prompts } from '@abide/abide'

            await prompts.alert({ body: 'Saved as a draft.', modal: false })
        `} />
    </Section>

    <Section level={3} title="Show every prompt of the app in one dialog">
        <p>Call <code>prompts.host</code> from your root layout's script and spread its parts onto
            a <code>&lt;dialog&gt;</code> there: the form, the field where <code>typing</code>
            holds, the error, and the two buttons. Every prompt on every page shows in it, one at a
            time, in the order asked. The parts carry the queue, the role, the closing and the
            answer; the markup and its classes are yours.</p>
        <Code language="abide" caption="abide" code={`
            <script>
            import { prompts } from '@abide/abide'

            const asked = prompts.host()
            </script>

            <html lang="en">
                <body>
                    <slot />
                    <dialog {...asked.dialog} class="m-auto w-96 rounded-xl p-5">
                        {#if asked.current}
                            <form {...asked.form}>
                                <h2 {...asked.title}>{asked.current?.title}</h2>
                                <p {...asked.body}>{asked.current?.body}</p>
                                {#if asked.typing}<input {...asked.input} />{/if}
                                {#if asked.failed}
                                    <p {...asked.error}>{asked.failed}</p>
                                {/if}
                                <button {...asked.confirm}>
                                    {asked.current?.confirm}
                                </button>
                                {#if asked.current?.kind !== 'alert'}
                                    <button {...asked.cancel}>
                                        {asked.current?.cancel}
                                    </button>
                                {/if}
                            </form>
                        {/if}
                    </dialog>
                </body>
            </html>
        `} />
    </Section>

    <Section level={3} title="Turn the confirm button red on a dangerous question">
        <p>A prompt asked with <code>danger</code> writes <code>data-danger</code> on the dialog.
            Mark the dialog a <code>group</code> and the confirm button reads it.</p>
        <Code language="abide" caption="abide" code={`
            <dialog {...asked.dialog} class="group">
                {#if asked.current}
                    <form {...asked.form}>
                        <button {...asked.confirm} class="group-data-[danger]:bg-bad">
                            {asked.current?.confirm}
                        </button>
                    </form>
                {/if}
            </dialog>
        `} />
    </Section>
</Doc>
