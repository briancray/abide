<script>
import Code from '#src/lib/Code.abide'
import Doc from '#src/lib/Doc.abide'
import Section from '#src/lib/Section.abide'
</script>

<Doc
    seeAlso={[
        '/components/prompts',
        '/components/dialog',
        '/components/toasts-api',
    ]}
    tests={[
        {
            path: 'packages/dogfood/examples/crm/src/deals/lib/DeleteDeal.test.ts',
            from: ["test('a deal is deleted only once the dialog is confirmed'"],
        },
        {
            path: 'packages/dogfood/examples/crm/src/deals/lib/DeleteDeal.test.ts',
            from: ["test('a confirm that is a call stays up, busy, until it lands"],
        },
        {
            path: 'packages/dogfood/examples/crm/src/deals/lib/DeleteDeal.test.ts',
            from: ["test('a withdrawn prompt is declined"],
        },
        {
            path: 'packages/dogfood/examples/crm/src/deals/lib/RenameDeal.test.ts',
            from: [
                "test('Rename takes the text typed, and Cancel keeps the old name'",
            ],
        },
        {
            path: 'packages/abide/tests/overlays.test.ts',
            from: [
                "test('confirm, alert, prompt and notify throw inside a request",
            ],
        },
    ]}
>
    <Section level={3} title="Ask before deleting a deal">
        <p><code>prompts.confirm</code> settles <code>true</code> only when the confirming button
            closed it. Cancel, Escape and the backdrop settle <code>false</code>.</p>
        <Code language="abide" caption="abide" code={`
            <script>
            import { prompts } from '@abide/abide/Prompts.abide'
            import deleteDeal from './deleteDeal.handler.ts'

            async function remove(deal: Deal) {
                const sure = await prompts.confirm({
                    title: \`Delete \${deal.name}?\`,
                    body: 'Its notes and its stage history go with it.',
                    confirm: 'Delete',
                    danger: true,
                })
                if (sure) await deleteDeal({ id: deal.id })
            }
            </script>
        `} />
    </Section>

    <Section level={3} title="Make the company name be typed before a delete">
        <p>With <code>mustType</code>, the confirming button stays disabled until the word is
            typed, matched ignoring case.</p>
        <Code language="ts" caption="browser" code={`
            import { prompts } from '@abide/abide/Prompts.abide'

            const sure = await prompts.confirm({
                title: 'Delete Analytical Engines?',
                body: 'Its 40 deals go with it.',
                mustType: 'Analytical Engines',
                danger: true,
            })
        `} />
    </Section>

    <Section level={3} title="Ask for a deal's new name">
        <p><code>prompts.prompt</code> settles with the text typed, or <code>undefined</code> when
            declined. The input starts from <code>value</code>.</p>
        <Code language="abide" caption="abide" code={`
            <script>
            import { reactive } from '@abide/abide'
            import { prompts } from '@abide/abide/Prompts.abide'

            let deal = reactive('Engine renewal')

            async function rename() {
                const name = await prompts.prompt({ title: 'Rename deal', value: deal })
                if (name?.trim()) deal = name.trim()
            }
            </script>
        `} />
    </Section>

    <Section level={3} title="Tell the person something and wait for the close">
        <p>A string in place of the options is the body. <code>prompts.alert</code> settles once
            the person closes it.</p>
        <Code language="ts" caption="browser" code={`
            import { prompts } from '@abide/abide/Prompts.abide'

            await prompts.alert('The import finished with 3 duplicate contacts.')
        `} />
    </Section>

    <Section level={3} title="Delete a deal from the dialog, and say why it could not">
        <p>Hand <code>run</code> the call the confirm makes. The dialog stays up with
            <code>data-busy</code> while it runs, closes once it lands, and shows the refusal in its
            <code>error</code> part.</p>
        <Code language="ts" caption="browser" code={`
            import { prompts } from '@abide/abide/Prompts.abide'

            await prompts.confirm({
                body: 'Delete Engine renewal?',
                danger: true,
                run: () => deleteDeal({ id }),
            })
        `} />
    </Section>

    <Section level={3} title="Withdraw a question the page no longer needs">
        <p>Pass a <code>signal</code>, and aborting it takes the prompt down, or out of the
            queue, as declined.</p>
        <Code language="ts" caption="browser" code={`
            import { prompts } from '@abide/abide/Prompts.abide'

            const leaving = new AbortController()
            const keep = prompts.confirm({ body: 'Keep editing?', signal: leaving.signal })
            leaving.abort() // keep settles false
        `} />
    </Section>

    <Section level={3} title="Ask without blocking the page">
        <p><code>modal: false</code> shows the prompt beside the page, which stays usable
            around it.</p>
        <Code language="ts" caption="browser" code={`
            import { prompts } from '@abide/abide/Prompts.abide'

            await prompts.alert({ body: 'Saved as a draft.', modal: false })
        `} />
    </Section>
</Doc>
