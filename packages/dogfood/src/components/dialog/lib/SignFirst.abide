<script>
import { reactive } from '@abide/abide'
import Dialog from '@abide/abide/Dialog.abide'

let signing = reactive(false)
</script>

<button onclick={() => (signing = true)}>Review the contract</button>
<Dialog bind:open={signing} dismissible={false}>
    <form method="dialog">
        <button value="sign">Sign the contract</button>
    </form>
</Dialog>
