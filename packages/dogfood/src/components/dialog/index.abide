<script>
import Code from '#src/lib/Code.abide'
import Doc from '#src/lib/Doc.abide'
import Section from '#src/lib/Section.abide'
</script>

<Doc
    seeAlso={[
        '/components/prompts-api',
        '/components/prompts',
        '/helpers/dismissible',
        '/abide-files/props',
    ]}
    tests={[
        {
            path: 'packages/dogfood/examples/crm/src/contacts/lib/LogCallDialog.test.ts',
            from: ["test('Log call keeps the note, and Cancel drops it'"],
        },
        {
            path: 'packages/dogfood/examples/crm/src/contacts/lib/LogCallDialog.test.ts',
            from: ["test('a dialog not dismissible stays open on Escape'"],
        },
        {
            path: 'packages/dogfood/examples/crm/src/contacts/lib/LogCallDialog.test.ts',
            from: [
                "test('a dialog opened again before its close is reported stays open'",
            ],
        },
    ]}
>
    <Section level={3} title="Log a call from a form over the contact page">
        <p>Bind <code>open</code> to a value of yours. A <code>&lt;form method="dialog"&gt;</code>
            closes it, and <code>onclose</code> gets the <code>value</code> of the button that
            submitted it.</p>
        <Code language="abide" caption="abide" code={`
            <script>
            import { reactive } from '@abide/abide'
            import Dialog from '@abide/abide/Dialog.abide'
            import logCall from './logCall.handler.ts'

            let logging = reactive(false)
            let note = reactive('')

            function closed(returnValue: string) {
                if (returnValue === 'log') logCall({ note })
                note = ''
            }
            </script>

            <button onclick={() => (logging = true)}>Log a call</button>
            <Dialog bind:open={logging} onclose={closed}>
                <form method="dialog">
                    <textarea bind:value={note} autofocus></textarea>
                    <button value="log">Log call</button>
                    <button value="cancel">Cancel</button>
                </form>
            </Dialog>
        `} />
    </Section>

    <Section level={3} title="Keep a dialog open until its form submits">
        <p>Set <code>dismissible</code> to <code>false</code> and Escape and a backdrop click
            leave the dialog showing.</p>
        <Code language="abide" caption="abide" code={`
            <script>
            import Dialog from '@abide/abide/Dialog.abide'
            </script>

            <Dialog bind:open={signing} dismissible={false}>
                <form method="dialog">
                    <button value="sign">Sign the contract</button>
                </form>
            </Dialog>
        `} />
    </Section>

    <Section level={3} title="Style the dialog box and the veil behind the dialog">
        <p>Your <code>class</code> lands on the <code>&lt;dialog&gt;</code>. The
            <code>backdrop:</code> variant reaches the veil, and <code>data-open</code> is present
            while it shows.</p>
        <Code language="abide" caption="abide" code={`
            <script>
            import Dialog from '@abide/abide/Dialog.abide'
            </script>

            <Dialog
                bind:open={logging}
                class="m-auto w-96 rounded-xl p-5 backdrop:bg-paper/70"
            >
                …
            </Dialog>
        `} />
    </Section>
</Doc>
