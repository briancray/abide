<script>
import Doc from '#src/lib/Doc.abide'
import Example from '#src/lib/Example.abide'
import Section from '#src/lib/Section.abide'

import ColumnsUnderLine from './lib/ColumnsUnderLine.abide'
import columnsUnderLine from './lib/ColumnsUnderLine.abide' with { type: 'text' }
import CurvedAreas from './lib/CurvedAreas.abide'
import curvedAreas from './lib/CurvedAreas.abide' with { type: 'text' }
import GroupedStacks from './lib/GroupedStacks.abide'
import groupedStacks from './lib/GroupedStacks.abide' with { type: 'text' }
import HideSeries from './lib/HideSeries.abide'
import hideSeries from './lib/HideSeries.abide' with { type: 'text' }
import SideBySide from './lib/SideBySide.abide'
import sideBySide from './lib/SideBySide.abide' with { type: 'text' }
import StackedAreas from './lib/StackedAreas.abide'
import stackedAreas from './lib/StackedAreas.abide' with { type: 'text' }
import TargetOutOfStack from './lib/TargetOutOfStack.abide'
import targetOutOfStack from './lib/TargetOutOfStack.abide' with { type: 'text' }
</script>

<Doc
    seeAlso={['/components/chart', '/helpers/chart']}
    tests={[
        {
            path: 'packages/dogfood/examples/crm/src/reports/lib/DealFlow.test.ts',
            from: ["test('won and lost stand side by side in each month'"],
        },
        {
            path: 'packages/dogfood/examples/crm/src/reports/lib/PipelineTrend.test.ts',
            from: [
                "test('each stage stacks on the one before it, through a month it has no value'",
            ],
        },
        {
            path: 'packages/dogfood/examples/crm/src/reports/lib/PipelineTrend.test.ts',
            from: [
                "test('each stage curves through its months, on the curve of the one under it'",
            ],
        },
        {
            path: 'packages/dogfood/examples/crm/src/reports/lib/PipelineTrend.test.ts',
            from: [
                "test('the target is drawn at its own values, on an axis fixed at $150K'",
            ],
        },
        {
            path: 'packages/dogfood/examples/crm/src/reports/lib/PipelineTrend.test.ts',
            from: [
                "test('leads leave the chart when unchecked, and come back last'",
            ],
        },
    ]}
>
    <Section level={3} title="Draw won revenue as columns under a target line">
        <p>A <code>Line</code>, a <code>Column</code> and an <code>Area</code> each draw
            nothing of their own. The <code>Chart</code> they are children of draws them all on
            one pair of axes, in the order they are written, the first at the back.</p>
        <Example code={columnsUnderLine}><ColumnsUnderLine /></Example>
    </Section>

    <Section level={3} title="Stand two columns side by side in each month">
        <p>Columns in no stack share their month's slot, each up from zero.</p>
        <Example code={sideBySide}><SideBySide /></Example>
    </Section>

    <Section level={3} title="Stack the pipeline's stages as areas">
        <p>Areas sharing a stack fill from the one written before them. A missing value
            counts as zero toward the stack, so the area above it carries on.</p>
        <Example code={stackedAreas}><StackedAreas /></Example>
    </Section>

    <Section level={3} title="Curve the stages through each month">
        <p><code>curve</code> draws a line or an area as a curve through its values. It never
            swings past the two values it joins, so a stage never reads higher than its month did,
            and a stacked area follows the curve of the one under it.</p>
        <Example code={curvedAreas}><CurvedAreas /></Example>
    </Section>

    <Section level={3} title="Keep a target line out of a stacked chart">
        <p><code>stack={'{false}'}</code> draws a series at its own values when the chart
            stacks every other.</p>
        <Example code={targetOutOfStack}><TargetOutOfStack /></Example>
    </Section>

    <Section level={3} title="Group stacked columns, one group per team">
        <p>Series naming the same <code>stack</code> pile together, and each stack takes a band
            of its month's slot beside the others.</p>
        <Example code={groupedStacks}><GroupedStacks /></Example>
    </Section>

    <Section level={3} title="Hide a series with a checkbox">
        <p>A series under an <code>{'{#if}'}</code> leaves the chart when the arm closes, and
            joins it again last when it reopens.</p>
        <Example code={hideSeries}><HideSeries /></Example>
    </Section>
</Doc>
