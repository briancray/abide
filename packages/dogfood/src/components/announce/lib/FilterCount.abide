<script>
import { announce, reactive } from '@abide/abide'

const DEALS = ['Acme renewal', 'Hopper expansion', 'Initech pilot']
let query = reactive('')
const found = reactive(() =>
    DEALS.filter((deal) => deal.toLowerCase().includes(query.toLowerCase())),
)

function filter(text: string) {
    query = text
    announce(`${found.length} of ${DEALS.length} deals match`)
}
</script>

<input
    placeholder="Filter deals"
    value={query}
    oninput={(event) => filter((event.target as HTMLInputElement).value)}
 />
<ul>
    {#for deal of found}
        <li>{deal}</li>
    {/for}
</ul>
