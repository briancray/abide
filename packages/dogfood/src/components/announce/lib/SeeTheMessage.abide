<script>
import { announce } from '@abide/abide'

const regions = announce.host()
</script>

<button onclick={() => announce('Draft saved')}>Save draft</button>
<button
    onclick={() => announce('Connection lost', { politeness: 'assertive' })}
>Drop the connection</button>
<div class="mt-3">
    <div {...regions.polite} class="text-signal">
        {#for message of regions.said('polite') by message.count}
            <span>{message.text}</span>
        {/for}
    </div>
    <div {...regions.assertive} class="text-bad">
        {#for message of regions.said('assertive') by message.count}
            <span>{message.text}</span>
        {/for}
    </div>
</div>
