import Example from '#src/lib/Example.abide'
import Section from '#src/lib/Section.abide'

import FilterCount from './lib/FilterCount.abide'
import filterCount from './lib/FilterCount.abide' with { type: 'text' }
</script>

<Doc
    seeAlso={[
        '/components/announcer',
        '/components/toasts-api',
        '/components/chart',
    ]}
    tests={[
        {
            path: 'packages/dogfood/examples/crm/src/reports/lib/WonRevenue.test.ts',
            from: [
                'test("a move the keys make is read out, and a pointer\'s is not"',
            ],
        },
        {
            path: 'packages/abide/tests/announce.test.ts',
            from: [
                "test('a message replaces the last, and the same words count as a new message'",
            ],
        },
        {
            path: 'packages/abide/tests/announce.test.ts',
            from: ["test('announce throws inside a request — 50.51'"],
        },
    ]}
>
    <Section level={3} title="Say how many deals a filter left">
        <p>A list narrowing as you type changes nothing a screen reader is reading. Announce the
            count, and it is read out once the typing pauses.</p>
        <Example code={filterCount}><FilterCount /></Example>
    </Section>

    <Section level={3} title="Interrupt for what cannot wait">
        <p><code>politeness: 'assertive'</code> cuts in on whatever is being read. Keep it for what
            the reader has to know now. The <code>Announcer</code> page runs it.</p>
        <Code language="abide" caption="abide" code={`
            <script>
            import { announce } from '@abide/abide/Announcer.abide'
            </script>

            <button
                onclick={() =>
                    announce('Connection lost', { politeness: 'assertive' })}
            >Drop the connection</button>
        `} />
    </Section>
</Doc>
