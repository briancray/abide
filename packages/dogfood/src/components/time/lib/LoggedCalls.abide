<script>
import { reactive } from '@abide/abide'
import Time from '@abide/abide/Time.abide'

let calls = reactive<number[]>([Date.now() - 3 * 3_600_000])
</script>

<button onclick={() => (calls = [Date.now(), ...calls])}>Log a call</button>
<ul>
    {#for at of calls by at}
        <li>Called <Time value={at} /></li>
    {/for}
</ul>
