        <Code language="abide" caption="abide" code={`
            <script>
            import Toasts from '@abide/abide/Toasts.abide'
            </script>

            <html lang="en">
                <body>
                    <slot />
                    <Toasts class="fixed right-5 bottom-5 flex flex-col gap-2" />
                </body>
            </html>
        `} />
    </Section>

    <Section level={3} title="Give error notices a red border">
        <p>Each notice is a <code>data-part="toast"</code> child carrying its
            <code>data-tone</code>. Inside it are the <code>text</code>, <code>action</code> and
            <code>close</code> parts.</p>
        <Code language="abide" caption="abide" code={`
            <Toasts
                class="fixed right-5 bottom-5 *:rounded-lg *:border *:px-4
                *:data-[tone=error]:border-bad *:data-[tone=success]:border-good"
            />
        `} />
    </Section>
