<script>
import Code from '#src/lib/Code.abide'
import Doc from '#src/lib/Doc.abide'
import Section from '#src/lib/Section.abide'
</script>

<Doc
    seeAlso={['/components/toasts-api', '/components/prompts', '/helpers/report']}
    tests={[
        {
            path: 'packages/dogfood/examples/crm/src/contacts/lib/SavePhone.test.ts',
            from: ["test('a notice shows once where two Toasts stand'"],
        },
        {
            path: 'packages/dogfood/examples/crm/src/contacts/lib/SavePhone.test.ts',
            from: ["test('closing one notice leaves the others where they are'"],
        },
        {
            path: 'packages/abide/tests/overlays.test.ts',
            from: ["test('the notices and the prompts are one list per request"],
        },
        {
            path: 'packages/dogfood/examples/crm/src/pipeline/lib/WonNotice.test.ts',
            from: [
                "test('a notice renders through Toast, and stays until its fade has finished'",
            ],
        },
    ]}
>
    <Section level={3} title="Show every notice of the app in one corner">
        <p>Render <code>Toasts</code> once, in the root layout, and position it yourself. Every
            <code>toasts.notify</code> on every page lands there, read out by screen readers as it
            arrives.</p>
        <Code language="abide" caption="abide" code={`
            <script>
            import Toasts from '@abide/abide/Toasts.abide'
            </script>

            <html lang="en">
                <body>
                    <slot />
                    <Toasts class="fixed right-5 bottom-5 flex flex-col gap-2" />
                </body>
            </html>
        `} />
    </Section>

    <Section level={3} title="Give error notices a red border">
        <p>Each notice is a <code>data-part="toast"</code> child carrying its
            <code>data-tone</code>. Inside it are the <code>text</code>, <code>action</code> and
            <code>close</code> parts.</p>
        <Code language="abide" caption="abide" code={`
            <script>
            import Toasts from '@abide/abide/Toasts.abide'
            </script>

            <Toasts
                class="fixed right-5 bottom-5 *:rounded-lg *:border *:px-4
                *:data-[tone=error]:border-bad *:data-[tone=success]:border-good"
            />
        `} />
    </Section>
    <Section level={3} title="Fade a notice out as it leaves">
        <p>A <code>Toast</code> component renders each notice's content, handed the
            <code>toast</code>, <code>dismiss</code> and <code>act</code>. An element in it whose
            <code>bind:element</code> hands back <code>element.animate(…).finished</code> keeps the
            notice in the page until the animation ends.</p>
        <Code language="abide" caption="abide" code={`
            <script>
            import Toasts from '@abide/abide/Toasts.abide'

            const fadeOut = (element: Element) => () =>
                element.animate([{ opacity: 1 }, { opacity: 0 }], 200).finished
            </script>

            <Toasts>
                {#component Toast({ toast, dismiss }: ToastProps)}
                    <p bind:element={fadeOut}>
                        <strong>Won.</strong> {toast.text}
                        <button onclick={dismiss}>Close</button>
                    </p>
                {/component}
            </Toasts>
        `} />
    </Section>
</Doc>
