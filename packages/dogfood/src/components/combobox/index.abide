<script>
import Code from '#src/lib/Code.abide'
import Doc from '#src/lib/Doc.abide'
import Example from '#src/lib/Example.abide'
import Section from '#src/lib/Section.abide'

import ListOverClip from './lib/ListOverClip.abide'
import listOverClip from './lib/ListOverClip.abide' with { type: 'text' }
</script>

<Doc
    seeAlso={[
        '/helpers/listbox',
        '/reactive/reactive',
        '/components/menu',
        '/abide-files/components',
    ]}
    tests={[
        {
            path: 'packages/dogfood/examples/crm/src/contacts/lib/ContactPicker.test.ts',
            from: ["test('typing narrows the contacts, ignoring case'"],
        },
        {
            path: 'packages/dogfood/examples/crm/src/companies/lib/CompanyPicker.test.ts',
            from: ["test('typing searches, and Enter picks the active company'"],
        },
        {
            path: 'packages/dogfood/examples/crm/src/companies/lib/CompanyPicker.test.ts',
            from: ["test('a search in flight keeps the last companies listed'"],
        },
        {
            path: 'packages/dogfood/examples/crm/src/contacts/lib/TeamPicker.test.ts',
            from: [
                "test('picking adds a contact, picking it again takes it out, and the list stays open'",
            ],
        },
        {
            path: 'packages/dogfood/examples/crm/src/contacts/lib/TeamPicker.test.ts',
            from: [
                "test('Backspace in an empty input takes out the last contact, and a chip takes out its own'",
            ],
        },
        {
            path: 'packages/dogfood/examples/crm/src/contacts/lib/ContactPicker.test.ts',
            from: ["test('Escape shuts, then clears, then is left to the page'"],
        },
    ]}
>
    <Section level={3} title="Pick a contact from a list narrowed by typing">
        <p>Given <code>options</code>, the list keeps the items whose label holds what was typed,
            ignoring case. The children show when nothing matches.</p>
        <Code language="abide" caption="abide" code={`
            <script>
            import { reactive } from '@abide/abide'
            import Combobox from '@abide/abide/Combobox.abide'
            import listContacts from '../listContacts.handler.ts'

            const contacts = reactive(() => listContacts())
            let contact = reactive<Contact | undefined>(undefined)
            </script>

            <label for="deal-contact">Contact</label>
            <Combobox
                id="deal-contact"
                options={contacts}
                key={(each: Contact) => each.id}
                label={(each: Contact) => each.name}
                bind:value={contact}
            >No contact matches</Combobox>
        `} />
    </Section>

    <Section level={3} title="Put several contacts on a deal">
        <p>Bind <code>value</code> to an array, and each pick adds a contact or takes it out
            again, with the list left open. Each one picked is a <code>chip</code> with a remove
            button, and Backspace in the empty input takes out the last.</p>
        <Code language="abide" caption="abide" code={`
            <script>
            import { reactive } from '@abide/abide'
            import Combobox from '@abide/abide/Combobox.abide'

            let team = reactive<Contact[]>([])
            </script>

            <Combobox
                id="deal-team"
                options={contacts}
                key={(each: Contact) => each.id}
                label={(each: Contact) => each.name}
                bind:value={team}
            />
        `} />
    </Section>

    <Section level={3} title="Search companies on the server as someone types">
        <p>Pass <code>search</code> in place of <code>options</code>. A search in flight keeps
            the last results listed, and <code>debounce</code> waits for typing to pause.</p>
        <Code language="abide" caption="abide" code={`
            <script>
            import Combobox from '@abide/abide/Combobox.abide'
            </script>

            <Combobox
                id="works-at"
                search={(q: string) => searchCompanies({ q })}
                debounce={200}
                key={(found: Company) => found.id}
                label={(found: Company) => found.name}
                bind:value={company}
            />
        `} />
    </Section>

    <Section level={3} title="Show a company's city beside its name in each option">
        <p>An <code>Option</code> component renders each option's content, handed the item.</p>
        <Code language="abide" caption="abide" code={`
            <script>
            import Combobox from '@abide/abide/Combobox.abide'
            </script>

            <Combobox id="works-at" search={find} key={keyOf} label={nameOf}>
                {#component Option({ item }: { item: Company })}
                    {item.name} · {item.city}
                {/component}
                No company matches
            </Combobox>
        `} />
    </Section>

    <Section level={3} title="Highlight the option the arrow keys are on">
        <p>The active option carries <code>data-active</code>, and the picked one
            <code>data-selected</code>. The list is <code>data-part="listbox"</code>.</p>
        <Code language="abide" caption="abide" code={`
            <script>
            import Combobox from '@abide/abide/Combobox.abide'
            </script>

            <Combobox
                class="[&_[data-part=listbox]]:list-none [&_[data-active]]:bg-signal/10"
                …
            />
        `} />
    </Section>
    <Section level={3} title="Open the list over a box that clips its input">
        <p>The list opens in the top layer under its input, as <code>popover</code> opens one, so
            no scroller or <code>overflow</code> cuts it off. It is
            <code>data-part="popup"</code>, holding the list and the children, and
            <code>--anchor-width</code> is its input's width.</p>
        <Example code={listOverClip}><ListOverClip /></Example>
    </Section>
</Doc>
