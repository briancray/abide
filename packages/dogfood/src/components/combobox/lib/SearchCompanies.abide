<script server>
import { GET } from '@abide/abide/server'

type Company = { id: string; name: string }
const COMPANIES: Company[] = [
    { id: 'acme', name: 'Acme' },
    { id: 'engines', name: 'Analytical Engines' },
    { id: 'hopper', name: 'Hopper & Co' },
]

const searchCompanies = GET(({ q }: { q: string }) =>
    COMPANIES.filter((each) =>
        each.name.toLowerCase().includes(q.toLowerCase()),
    ),
)
</script>

<script>
import { reactive } from '@abide/abide'
import Combobox from '@abide/abide/Combobox.abide'

let company = reactive<Company | undefined>(undefined)
</script>

<Combobox
    id="works-at"
    search={(q: string) => searchCompanies({ q })}
    debounce={200}
    key={(found: Company) => found.id}
    label={(found: Company) => found.name}
    bind:value={company}
 />
