<script>
import Code from '#src/lib/Code.abide'
import Doc from '#src/lib/Doc.abide'
import Section from '#src/lib/Section.abide'
</script>

<Doc
    seeAlso={['/components/tooltips', '/components/menu', '/helpers/place']}
    tests={[
        {
            path: 'packages/dogfood/examples/crm/src/pipeline/lib/StageHints.test.ts',
            from: [
                "test('a stage is described by its hint, with nothing written beside it'",
            ],
        },
        {
            path: 'packages/dogfood/examples/crm/src/pipeline/lib/StageHints.test.ts',
            from: ["test('focus opens the hint at once and Escape closes it'"],
        },
        {
            path: 'packages/dogfood/examples/crm/src/pipeline/lib/StageHints.test.ts',
            from: ["test('a pointer resting on a stage opens its hint'"],
        },
    ]}
>
    <Section level={3} title="Explain a pipeline stage on hover and on focus">
        <p>Bind <code>tooltip</code> to the element it explains. Nothing is written beside it, so it
            works in a list, a table row or a flex row alike. Give the element a
            <code>tabindex</code> where it is not focusable, or a keyboard never reaches the
            hint. The hint shows in the page's <code>Tooltips</code>.</p>
        <Code language="abide" caption="abide" code={`
            <script>
            import { tooltip } from '@abide/abide'

            const hint = tooltip('A quote is out, waiting on an answer.')
            </script>

            <span tabindex="0" bind:element={hint}>proposal</span>
        `} />
    </Section>

    <Section level={3} title="Open a hint under its anchor, with no wait">
        <p><code>side</code> is where the hint goes, flipped where there is no room.
            <code>delay</code> is how long a pointer rests before it opens. A click does not
            open it at once; a key that moves focus to the element does.</p>
        <Code language="abide" caption="abide" code={`
            <script>
            import { tooltip } from '@abide/abide'

            const hint = tooltip('Star this contact', {
                side: 'bottom',
                delay: 0,
            })
            </script>

            <button aria-label="Star" bind:element={hint}>★</button>
        `} />
    </Section>

    <Section level={3} title="Show more than text in a hint">
        <p>Hand <code>tooltip</code> a component, and <code>Tooltips</code> renders it. The
            element is described by the hint for as long as it shows.</p>
        <Code language="abide" caption="abide" code={`
            <script>
            import { tooltip } from '@abide/abide'

            import DealSummary from './DealSummary.abide'
            </script>

            <a href="/deals/acme" bind:element={tooltip(DealSummary)}>Acme renewal</a>
        `} />
    </Section>
</Doc>
