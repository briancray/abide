<script>
import { keyLabel, reactive } from '@abide/abide'
import CommandPalette from '@abide/abide/CommandPalette.abide'

let ran = reactive('nothing yet')

const COMMANDS = [
    { label: 'Contacts', run: () => (ran = 'Contacts') },
    { label: 'Deals', run: () => (ran = 'Deals') },
    {
        label: 'Add a deal',
        keywords: ['new', 'create'],
        key: 'n',
        run: () => (ran = 'Add a deal'),
    },
]
</script>

<p>Press {keyLabel('mod+j')}, type "new", then Enter. Ran: {ran}.</p>
<CommandPalette commands={COMMANDS} hotkey="mod+j" class="palette">
    Nothing matches.
</CommandPalette>
