<script>
import { reactive } from '@abide/abide'
import CommandPalette from '@abide/abide/CommandPalette.abide'

let open = reactive(false)
let ran = reactive('nothing yet')

const COMMANDS = [
    { label: 'Export deals', run: () => (ran = 'Export deals') },
    { label: 'Print report', run: () => (ran = 'Print report') },
]
</script>

<button type="button" onclick={() => (open = true)}>Commands</button>
<p>Ran: {ran}.</p>
<CommandPalette
    commands={COMMANDS}
    bind:open={open}
    hotkey="mod+shift+j"
    id="report-commands"
    label="Report commands"
    class="palette"
 />
