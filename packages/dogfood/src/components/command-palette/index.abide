<script>
import Doc from '#src/lib/Doc.abide'
import Example from '#src/lib/Example.abide'
import Section from '#src/lib/Section.abide'

import JumpAnywhere from './lib/JumpAnywhere.abide'
import jumpAnywhere from './lib/JumpAnywhere.abide' with { type: 'text' }
import OpenFromButton from './lib/OpenFromButton.abide'
import openFromButton from './lib/OpenFromButton.abide' with { type: 'text' }
</script>

<Doc
    seeAlso={['/helpers/hotkeys', '/components/combobox', '/components/dialog']}
    tests={[
        {
            path: 'packages/dogfood/examples/crm/src/lib/JumpTo.test.ts',
            from: [
                "test('Ctrl+K opens the palette with its input focused, and shuts it again'",
            ],
        },
        {
            path: 'packages/dogfood/examples/crm/src/lib/JumpTo.test.ts',
            from: [
                "test('typing lists the commands whose label or keywords hold every word'",
            ],
        },
        {
            path: 'packages/dogfood/examples/crm/src/lib/JumpTo.test.ts',
            from: [
                "test('an arrow and Enter run the command, and the palette shuts'",
            ],
        },
        {
            path: 'packages/dogfood/examples/crm/src/lib/JumpTo.test.ts',
            from: ["test('Escape is left to the dialog'"],
        },
    ]}
>
    <Section level={3} title="Jump anywhere in the app from one key">
        <p>The palette opens on <code>hotkey</code>, <code>mod+k</code> unless you name another,
            and lists the commands whose label or keywords hold every word typed. Arrows move,
            Enter runs, and Escape shuts it with focus back where it was. This page's own ⌘K is
            the docs' prompt, so the example opens on ⌘J.</p>
        <Example code={jumpAnywhere}><JumpAnywhere /></Example>
    </Section>

    <Section level={3} title="Open the palette from a button">
        <p>Bind <code>open</code> to open it from a control of your own. Give each palette on a
            page its own <code>id</code> and its own key.</p>
        <Example code={openFromButton}><OpenFromButton /></Example>
    </Section>
</Doc>
