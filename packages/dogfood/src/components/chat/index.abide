<script>
import Code from '#src/lib/Code.abide'
import Doc from '#src/lib/Doc.abide'
import Section from '#src/lib/Section.abide'
</script>

<Doc
    seeAlso={[
        '/ai/assistant',
        '/components/pairing',
        '/ai/provider',
        '/components/markdown',
        '/ai/transcript',
    ]}
    tests={[
        {
            path: 'packages/dogfood/examples/crm/src/assistant/lib/AssistantThread.test.ts',
            from: [
                "test('Enter asks, and the answer streams in with its tool call'",
            ],
        },
        {
            path: 'packages/dogfood/examples/crm/src/assistant/lib/Chat.test.ts',
            from: ["test('Stop ends the answer and keeps what arrived'"],
        },
        {
            path: 'packages/dogfood/examples/crm/src/assistant/lib/Chat.test.ts',
            from: ["test('a permission prompt is answered through permit'"],
        },
        {
            path: 'packages/dogfood/examples/crm/src/assistant/lib/Chat.test.ts',
            from: [
                "test('a question sent while an answer streams is queued, and asked once the answer ends'",
            ],
        },
        {
            path: 'packages/dogfood/examples/crm/src/assistant/lib/Chat.test.ts',
            from: ["test('a queued question cancelled is never asked'"],
        },
        {
            path: 'packages/dogfood/examples/crm/src/assistant/lib/AssistantThread.test.ts',
            from: [
                "test('Ask again replaces the answer with a fresh one to the same question'",
            ],
        },
        {
            path: 'packages/dogfood/examples/crm/src/assistant/lib/Chat.test.ts',
            from: [
                "test('a conversation handed in as turns is shown, and asked about with what follows'",
            ],
        },
    ]}
>
    <Section level={3} title="Put the CRM's assistant on a page">
        <p>Pass your assistant handler, a <code>POST</code> yielding <code>assistant</code>'s
            events, as <code>ask</code>. Enter sends, Shift+Enter breaks the
            line, and Stop aborts an answer while keeping what arrived.</p>
        <Code language="abide" caption="abide" code={`
            <script>
            import Chat from '@abide/abide/Chat.abide'
            import askAssistant from '../askAssistant.handler.ts'
            </script>

            <Chat ask={askAssistant} placeholder="Which company is Ada at?" />
        `} />
    </Section>

    <Section level={3} title="Render the assistant's answers as markdown">
        <p>A <code>Text</code> component renders the assistant's words, handed
            <code>text</code> as it grows. They render as plain text without one.</p>
        <Code language="abide" caption="abide" code={`
            <script>
            import Chat from '@abide/abide/Chat.abide'
            import Markdown from '@abide/abide/Markdown.abide'
            </script>

            <Chat ask={askAssistant}>
                {#component Text({ text }: { text: string })}
                    <Markdown source={text} />
                {/component}
            </Chat>
        `} />
    </Section>

    <Section level={3} title="Let a person allow or deny a tool Claude Code asks for">
        <p>A permission prompt shows in the answer with Allow and Deny. Pass
            <code>permit</code> a handler calling <code>provider.claudeCode.permit</code>; without
            it the buttons stay disabled.</p>
        <Code language="abide" caption="abide" code={`
            <script>
            import Chat from '@abide/abide/Chat.abide'
            </script>

            <Chat ask={askClaudeCode} permit={permitClaudeCode} />
        `} />
    </Section>

    <Section level={3} title="Show a tool call as a line of its own">
        <p>A <code>Tool</code> component renders each tool call, handed the
            <code>part</code> and its <code>turn</code>, in place of its name, input and
            result.</p>
        <Code language="abide" caption="abide" code={`
            <Chat ask={askAssistant}>
                {#component Tool({ part }: { part: { name: string } })}
                    <span>looked up {part.name}</span>
                {/component}
            </Chat>
        `} />
    </Section>

    <Section level={3} title="Offer to ask again under each answer">
        <p>An <code>Actions</code> component renders under each answer that has ended, handed
            the <code>turn</code>, its <code>index</code> and <code>retry</code>, which asks the
            same question again in the answer's place.</p>
        <Code language="abide" caption="abide" code={`
            <Chat ask={askAssistant}>
                {#component Actions({ retry }: { retry: () => void })}
                    <button type="button" onclick={retry}>Ask again</button>
                {/component}
            </Chat>
        `} />
    </Section>

    <Section level={3} title="Send a follow-up while an answer streams">
        <p>A question sent while an answer streams waits in the composer's
            <code>data-part="queued"</code>, with a <code>cancel</code> button, and is asked as
            soon as the answer ends.</p>
    </Section>

    <Section level={3} title="Keep a conversation across visits">
        <p>Bind <code>turns</code>. A conversation it holds is shown and asked about, and every
            turn the chat adds is written to it, for you to store.</p>
        <Code language="abide" caption="abide" code={`
            <script>
            import { reactive } from '@abide/abide'
            import Chat from '@abide/abide/Chat.abide'
            import askAssistant from '../askAssistant.handler.ts'

            // Last visit's conversation, as you stored it.
            let thread = reactive([
                {
                    role: 'user',
                    parts: [{ type: 'text', text: 'Which company is Ada at?' }],
                    stop: undefined,
                    failed: undefined,
                },
            ])
            </script>

            <Chat ask={askAssistant} bind:turns={thread} />
        `} />
    </Section>

    <Section level={3} title="Tell the rep's turns from the assistant's">
        <p>Each turn is <code>data-part="turn"</code> with <code>data-speaker</code>,
            <code>you</code> or <code>assistant</code>. The root carries
            <code>data-streaming</code> while an answer arrives.</p>
        <Code language="abide" caption="abide" code={`
            <script>
            import Chat from '@abide/abide/Chat.abide'
            </script>

            <Chat
                ask={askAssistant}
                class="[&_[data-speaker=you]]:text-right data-streaming:opacity-90"
            />
        `} />
    </Section>
</Doc>
