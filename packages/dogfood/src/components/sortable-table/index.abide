<script>
import Code from '#src/lib/Code.abide'
import Doc from '#src/lib/Doc.abide'
import Section from '#src/lib/Section.abide'
</script>

<Doc
    seeAlso={[
        '/helpers/sort-rows',
        '/helpers/format',
        '/abide-files/components',
        '/abide-files/control-flow',
    ]}
    tests={[
        {
            path: 'packages/dogfood/examples/crm/src/pipeline/lib/ClosingDeals.test.ts',
            from: ["test('stage sorts in pipeline order, ties as they came'"],
        },
        {
            path: 'packages/dogfood/examples/crm/src/pipeline/lib/ClosingDeals.test.ts',
            from: ["test('a re-sort moves the rows, building and rewriting none'"],
        },
        {
            path: 'packages/dogfood/examples/crm/src/companies/lib/CompanyTable.test.ts',
            from: ["test('a name links to its company, and sorts with its row'"],
        },
        {
            path: 'packages/dogfood/examples/crm/src/companies/lib/CompanyTable.test.ts',
            from: [
                'test("each company\'s contact sits in a row of its own under it',
            ],
        },
    ]}
>
    <Section level={3} title="Sort the companies by any column">
        <p>Each header is a button. Pressing it sorts ascending, and pressing it again turns the
            direction round. <code>key</code> lets a re-sort move rows rather than rewrite
            them.</p>
        <Code language="abide" caption="abide" code={`
            <script>
            import { type Column, reactive } from '@abide/abide'
            import SortableTable from '@abide/abide/SortableTable.abide'
            import listCompanies from '../listCompanies.handler.ts'

            const COLUMNS: Column<Company>[] = [
                { key: 'name', label: 'Company' },
                { key: 'city', label: 'City' },
            ]
            const companies = reactive(() => listCompanies())
            </script>

            <SortableTable
                rows={companies}
                columns={COLUMNS}
                key={(company: Company) => company.id}
            />
        `} />
    </Section>

    <Section level={3} title="Sort stages in pipeline order, and show amounts as money">
        <p>A column's <code>value</code> is what it sorts by, and <code>format</code> is what its
            cells show.</p>
        <Code language="ts" caption="shared" code={`
            import { type Column, format } from '@abide/abide'

            const COLUMNS: Column<Deal>[] = [
                { key: 'name', label: 'Deal', sortable: false },
                {
                    key: 'stage',
                    label: 'Stage',
                    value: (deal) => STAGES.indexOf(deal.stage),
                    format: (_, deal) => deal.stage,
                },
                {
                    key: 'amount',
                    label: 'Amount',
                    align: 'end',
                    format: (amount) => format.money(amount),
                },
            ]
        `} />
    </Section>

    <Section level={3} title="Open the table sorted by close date">
        <p>Bind <code>sort</code> to set the sort it opens with and to read the one picked
            since.</p>
        <Code language="abide" caption="abide" code={`
            <script>
            import { reactive, type Sort } from '@abide/abide'
            import SortableTable from '@abide/abide/SortableTable.abide'

            let sort = reactive<Sort | undefined>({
                key: 'closes',
                direction: 'ascending',
            })
            </script>

            <SortableTable rows={deals} columns={COLUMNS} key={keyOf} bind:sort={sort} />
        `} />
    </Section>

    <Section level={3} title="Link each company's name to its page">
        <p>A <code>Cell</code> component renders a cell's content, handed the row, the column and
            the formatted text.</p>
        <Code language="abide" caption="abide" code={`
            <script>
            import SortableTable from '@abide/abide/SortableTable.abide'
            </script>

            <SortableTable rows={companies} columns={COLUMNS} key={keyOf}>
                {#component Cell({ row, column, text }: CellProps)}
                    {#if column.key === 'name'}
                        <a href={\`/companies/\${row.id}\`}>{text}</a>
                    {:else}
                        {text}
                    {/if}
                {/component}
            </SortableTable>
        `} />
    </Section>

    <Section level={3} title="Show each company's contact in a row under the company">
        <p>A <code>Detail</code> component renders a row of its own under each row, one cell
            spanning every column, and it moves with its row when the table sorts.</p>
        <Code language="abide" caption="abide" code={`
            <script>
            import SortableTable from '@abide/abide/SortableTable.abide'
            </script>

            <SortableTable rows={companies} columns={COLUMNS} key={keyOf}>
                {#component Detail({ row }: { row: Company })}
                    <span class="text-muted">Contact: {row.contact}</span>
                {/component}
            </SortableTable>
        `} />
    </Section>

    <Section level={3} title="Mark the sorted column's direction with an arrow">
        <p>The sorted header carries <code>data-sort</code>, <code>ascending</code> or
            <code>descending</code>, and a column's <code>align</code> is
            <code>data-align</code>.</p>
        <Code language="abide" caption="abide" code={`
            <script>
            import SortableTable from '@abide/abide/SortableTable.abide'
            </script>

            <SortableTable
                class="[&_[data-align=end]]:text-right
                [&_[data-sort=ascending]_button]:after:content-['_↑']
                [&_[data-sort=descending]_button]:after:content-['_↓']"
                …
            />
        `} />
    </Section>
</Doc>
