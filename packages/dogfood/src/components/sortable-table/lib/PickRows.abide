<script>
import { reactive } from '@abide/abide'
import SortableTable from '@abide/abide/SortableTable.abide'

const DEALS = [
    { id: 'audit', name: 'Lovelace audit', amount: 9_000 },
    { id: 'seats', name: 'Turing seats', amount: 22_000 },
    { id: 'renewal', name: 'Hopper renewal', amount: 48_000 },
]
let selected = reactive<readonly string[]>([])
</script>

<p>{selected.length} selected: {selected.join(', ')}</p>
<SortableTable
    rows={DEALS}
    columns={[
        { key: 'name', label: 'Deal' },
        { key: 'amount', label: 'Amount' },
    ]}
    key={(deal: (typeof DEALS)[number]) => deal.id}
    bind:selected={selected}
    class="[&_[data-selected]]:bg-signal/10"
 />
