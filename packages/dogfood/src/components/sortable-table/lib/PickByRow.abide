<script>
import { type Column, reactive } from '@abide/abide'
import SortableTable from '@abide/abide/SortableTable.abide'

type Deal = { id: string; name: string; stage: string }
const deals: Deal[] = [
    { id: 'a', name: 'Acme renewal', stage: 'won' },
    { id: 'b', name: 'Engines upgrade', stage: 'proposal' },
]
const COLUMNS: Column<Deal>[] = [
    { key: 'name', label: 'Deal' },
    { key: 'stage', label: 'Stage' },
]
let picked = reactive('')
</script>

<SortableTable
    rows={deals}
    columns={COLUMNS}
    key={(deal: Deal) => deal.id}
    rowAttributes={(deal: Deal) => ({
        'data-stage': deal.stage,
        onclick: () => (picked = deal.name),
    })}
    class="[&_[data-stage=won]]:font-semibold"
 />
<p>{picked || 'Click a row.'}</p>
