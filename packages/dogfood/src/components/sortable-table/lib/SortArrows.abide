<script>
import { type Column } from '@abide/abide'
import SortableTable from '@abide/abide/SortableTable.abide'

type Deal = { id: string; name: string; amount: number }
const deals: Deal[] = [
    { id: 'a', name: 'Acme renewal', amount: 42_000 },
    { id: 'b', name: 'Engines upgrade', amount: 18_000 },
]
const COLUMNS: Column<Deal>[] = [
    { key: 'name', label: 'Deal' },
    { key: 'amount', label: 'Amount', align: 'end' },
]
</script>

<SortableTable
    class="[&_[data-align=end]]:text-right
    [&_[data-sort=ascending]_button]:after:content-['_↑']
    [&_[data-sort=descending]_button]:after:content-['_↓']"
    rows={deals}
    columns={COLUMNS}
    key={(deal: Deal) => deal.id}
 />
