<script>
import { type Column } from '@abide/abide'
import SortableTable from '@abide/abide/SortableTable.abide'

type Company = { id: string; name: string; city: string }
const companies: Company[] = [
    { id: 'acme', name: 'Acme', city: 'Leeds' },
    { id: 'engines', name: 'Analytical Engines', city: 'London' },
]
const COLUMNS: Column<Company>[] = [
    { key: 'name', label: 'Company' },
    { key: 'city', label: 'City' },
]
const keyOf = (company: Company) => company.id
type Cell = { row: Company; column: Column<Company>; text: string }
</script>

<SortableTable rows={companies} columns={COLUMNS} key={keyOf}>
    {#component Cell({ row, column, text }: Cell)}
        {#if column.key === 'name'}
            <a href={`#${row.id}`}>{text}</a>
        {:else}
            {text}
        {/if}
    {/component}
</SortableTable>
