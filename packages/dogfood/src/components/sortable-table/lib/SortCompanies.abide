<script server>
import { GET } from '@abide/abide/server'

type Company = { id: string; name: string; city: string }

const listCompanies = GET((): Company[] => [
    { id: 'acme', name: 'Acme', city: 'Leeds' },
    { id: 'engines', name: 'Analytical Engines', city: 'London' },
    { id: 'hopper', name: 'Hopper & Co', city: 'Arlington' },
])
</script>

<script>
import { type Column, reactive } from '@abide/abide'
import SortableTable from '@abide/abide/SortableTable.abide'

const COLUMNS: Column<Company>[] = [
    { key: 'name', label: 'Company' },
    { key: 'city', label: 'City' },
]
const companies = reactive(() => listCompanies())
</script>

<SortableTable
    rows={companies}
    columns={COLUMNS}
    key={(company: Company) => company.id}
 />
