<script>
import Code from '#src/lib/Code.abide'
import Doc from '#src/lib/Doc.abide'
import Section from '#src/lib/Section.abide'
</script>

<Doc
    seeAlso={[
        '/components/prompts-api',
        '/components/dialog',
        '/components/toasts',
    ]}
    tests={[
        {
            path: 'packages/dogfood/examples/crm/src/deals/lib/DeleteDeal.test.ts',
            from: ["test('a question shows in one dialog where two Prompts stand'"],
        },
        {
            path: 'packages/dogfood/examples/crm/src/deals/lib/DeleteDeal.test.ts',
            from: ["test('the question names the deal and is marked danger'"],
        },
        {
            path: 'packages/dogfood/examples/crm/src/deals/lib/DeleteDeal.test.ts',
            from: ["test('Escape declines the question'"],
        },
    ]}
>
    <Section level={3} title="Show every prompt of the app in one place">
        <p>Render <code>Prompts</code> once, in the root layout. Every prompt on every page shows
            there, one at a time, in the order asked.</p>
        <Code language="abide" caption="abide" code={`
            <script>
            import Prompts from '@abide/abide/Prompts.abide'
            </script>

            <html lang="en">
                <body>
                    <slot />
                    <Prompts class="m-auto w-96 rounded-xl p-5" />
                </body>
            </html>
        `} />
    </Section>

    <Section level={3} title="Lay out the prompt's form and its buttons">
        <p>Each piece inside carries a <code>data-part</code>: <code>form</code>,
            <code>title</code>, <code>body</code>, <code>field</code>, <code>input</code>,
            <code>actions</code>, <code>confirm</code> and <code>cancel</code>.</p>
        <Code language="abide" caption="abide" code={`
            <script>
            import Prompts from '@abide/abide/Prompts.abide'
            </script>

            <Prompts
                class="[&_[data-part=form]]:flex [&_[data-part=form]]:flex-col
                [&_[data-part=actions]]:flex [&_[data-part=actions]]:gap-2"
            />
        `} />
    </Section>

    <Section level={3} title="Turn the confirm button red on a dangerous question">
        <p>A prompt asked with <code>danger</code> writes <code>data-danger</code> on the dialog.
            Combine that state with the <code>confirm</code> part.</p>
        <Code language="abide" caption="abide" code={`
            <script>
            import Prompts from '@abide/abide/Prompts.abide'
            </script>

            <Prompts class="data-[danger]:[&_[data-part=confirm]]:bg-bad" />
        `} />
    </Section>
</Doc>
