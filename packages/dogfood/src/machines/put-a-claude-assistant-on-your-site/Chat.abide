<script server>
import {
    type AssistantMessage,
    assistant,
    GET,
    POST,
    type Provider,
} from '@abide/abide/server'

const PAID = new Set(['INV-4021'])

export const invoiceStatus = GET(
    ({ id }: { id: string }) => ({ id, paid: PAID.has(id) }),
    { description: 'Whether an invoice has been paid, by its number.' },
)

const TOOL = 'get_machines_put-a-claude-assistant-on-your-site_invoiceStatus'

// The model is a recording; the tool call it asks for is made for real.
const recorded: Provider = {
    async *run(_messages, tools) {
        const input = { id: 'INV-4021' }
        yield { type: 'tool', id: 'toolu_1', name: TOOL, input }
        const answered = await tools.call(TOOL, input)
        yield { type: 'result', id: 'toolu_1', ...answered }
        yield { type: 'text', text: 'Yes, INV-4021 is paid.' }
        yield { type: 'done', stop: 'end_turn', usage: { input: 0, output: 0 } }
    },
}

export const askWithTools = POST(
    async function* ({ messages }: { messages: AssistantMessage[] }) {
        yield* assistant(messages, recorded, { mcp: true })
    },
    { clients: { mcp: false } },
)
</script>

<script>
import { reactive } from '@abide/abide'

const QUESTION = 'Is invoice INV-4021 paid?'

let asked = reactive(false)
const events = reactive(() =>
    asked
        ? askWithTools({ messages: [{ role: 'user', content: QUESTION }] })
        : [],
)
</script>

<ul class="chat">
    <li data-speaker="you"><span>you</span><p>{QUESTION}</p></li>
{#for event of events}
    {#if event.type === 'tool'}
        <li><span>tool call</span>
            <p class="font-mono text-chrome">
                {event.name} {JSON.stringify(event.input)}
            </p></li>
    {:else if event.type === 'result'}
        <li><span>your handler answered</span>
            <p class="font-mono text-chrome">{event.text}</p></li>
    {:else if event.type === 'text'}
        <li><span>assistant</span><p>{event.text}</p></li>
    {/if}
{/for}
</ul>

<div class="row">
    <button disabled={asked} onclick={() => { asked = true }}>Ask</button>
    <span class="status">{events.at(-1)?.type === 'done' ? 'done' : ''}</span>
</div>
