<script server>
import {
    type AssistantMessage,
    assistant,
    claudeApi,
    POST,
    request,
} from '@abide/abide/server'
import { messages as standIn } from './v1/messages.abide'

export const askTheApi = POST(
    async function* ({ messages }: { messages: AssistantMessage[] }) {
        // This site's stand-in for https://api.anthropic.com.
        const standInAt = new URL(standIn.url({}), request().url)
        yield* assistant(
            messages,
            claudeApi({
                apiKey: 'the stand-in reads none',
                baseURL: standInAt.href.replace('/v1/messages', ''),
                model: 'claude-opus-5',
                max_tokens: 1024,
                system: 'Answer questions about invoices.',
                thinking: { type: 'adaptive' },
            }),
        )
    },
    { clients: { mcp: false } },
)
</script>

<script>
import { reactive } from '@abide/abide'

const QUESTION = 'Is invoice INV-4021 paid?'

let asked = reactive(false)
const events = reactive(() =>
    asked
        ? askTheApi({ messages: [{ role: 'user', content: QUESTION }] })
        : [],
)
</script>

<div class="row">
    <button disabled={asked} onclick={() => { asked = true }}>Ask</button>
    <span class="status">{QUESTION}</span>
</div>

{#for event of events}
    {#if event.type === 'text'}
        <pre class="rounded-md border border-rule bg-raised p-snug
            text-chrome">{event.text}</pre>
    {/if}
{/for}
