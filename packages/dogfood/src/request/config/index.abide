<script>
import Code from '#src/lib/Code.abide'
import Doc from '#src/lib/Doc.abide'
import Section from '#src/lib/Section.abide'
</script>

<Doc
    seeAlso={[
        '/app/on-config',
        '/app/environment',
        '/pages/files',
        '/operating/health',
    ]}
    tests={[
        {
            path: 'packages/dogfood/examples/crm/src/ops/lib/Retries.test.ts',
            from: [
                "test('RETRIES=5 in .env overrides the default of 3, as a number'",
            ],
        },
        {
            path: 'packages/abide/tests/app.test.ts',
            from: ["test('config layers derived, onConfig and the environment"],
        },
        {
            path: 'packages/dogfood/examples/crm/src/ops/ConfigSchema.test.ts',
            from: [
                "test('a deployment whose RETRIES is out of range does not start'",
            ],
        },
    ]}
>
    <Section level={3} title="Retry a failed call as often as the deployment says">
        <p>Return the default from <code>onConfig</code>, and its type is the setting's type:
            <code>config().RETRIES</code> is a <code>number</code> with no declaration written.</p>
        <Code language="ts" caption="server" code={`
            import { config, GET, onConfig } from '@abide/abide/server'

            onConfig(() => ({ RETRIES: 3 }))

            export default GET(() => ({ retries: config().RETRIES }))
        `} />
    </Section>

    <Section level={3} title="Override a default from the environment">
        <p>The environment wins over the default, coerced to the default's type, so this
            deployment reads <code>5</code>, not <code>'5'</code>. A value that will not coerce, such
            as <code>RETRIES=lots</code>, leaves the default standing.</p>
        <Code code={`
            RETRIES=5 abide start
        `} />
    </Section>

    <Section level={3} title="Read a setting on a page through a handler">
        <p><code>config</code> is a server name. A page asks a handler for the one setting it
            needs, so a key no handler returns never reaches a browser.</p>
        <Code language="abide" caption="abide" code={`
            <script>
            import { reactive } from '@abide/abide'
            import getRetries from './getRetries.handler.ts'

            const policy = reactive(() => getRetries())
            </script>

            <p>{policy.retries + 1} attempts per call</p>
        `} />
    </Section>

    <Section level={3} title="Pick up a rotated key without a restart">
        <p><code>config.invalidate()</code> has the next read take the environment again and rerun
            every <code>onConfig</code>.</p>
        <Code language="ts" caption="server" code={`
            import { config } from '@abide/abide/server'

            const secret = Bun.file('/run/secrets/billing_key')
            Bun.env.BILLING_KEY = (await secret.text()).trim()
            config.invalidate()
        `} />
    </Section>
</Doc>
