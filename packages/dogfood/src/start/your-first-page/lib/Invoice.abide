<script server>
import { GET } from '@abide/abide/server'

// The database, for this example: three invoices on one account.
const INVOICES: Record<string, { total: string; dueOn: string }> = {
    '4310': { total: '$1,240.00', dueOn: 'Oct 14' },
    '4311': { total: '$900.00', dueOn: 'Oct 21' },
    '4312': { total: '$310.00', dueOn: 'Nov 2' },
}

const getInvoice = GET(
    async ({ id }: { id: string }) => {
        // A slow database, so the wait is on screen.
        await Bun.sleep(400)
        return { number: `INV-${id}`, ...INVOICES[id] }
    },
    { description: 'One invoice, by id.' },
)
</script>

<script>
import { reactive } from '@abide/abide'

let id = reactive('4310')
const invoice = reactive(() => getInvoice({ id }))
</script>

<div class="tabs">
    {#for each of ['4310', '4311', '4312']}
        <button aria-selected={id === each}
            onclick={() => (id = each)}>{each}</button>
    {/for}
</div>

<ul class="fields">
    <li><span>invoice</span><strong>{invoice.number}</strong></li>
    <li><span>total</span>
        <strong>{invoice.total} due {invoice.dueOn}</strong></li>
</ul>
