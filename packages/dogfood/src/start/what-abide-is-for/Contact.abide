<script server>
import { GET } from '@abide/abide/server'

const CONTACTS = new Map([
    ['1', { id: '1', name: 'Ada Lovelace', email: 'ada@example.com' }],
])

export const getContact = GET(
    async ({ id }: { id: string }) => {
        await Bun.sleep(900) // a slow database, so the wait is on screen
        const row = CONTACTS.get(id)
        if (row === undefined) throw new Error(`no row ${id}`)
        return row
    },
    { description: 'A contact, by id.' },
)
</script>

<script>
import { reactive } from '@abide/abide'

let draft = reactive('')

const words = reactive(() => (draft ? draft.split(' ').length : 0))
const contact = reactive(() => getContact({ id: '1' }))
let notes = reactive<{ text: string }>()
</script>

<ul class="fields">
    <li><span>owned</span>
        <strong>{draft.ready() ? (draft || '—') : '…'}</strong></li>
    <li><span>derived</span>
        <strong>{words.ready() ? words : '…'}</strong></li>
    <li><span>loaded</span>
        <strong>{contact.ready() ? contact.name : '…'}</strong></li>
    <li><span>pushed</span>
        <strong>{notes.ready() ? notes.text : '…'}</strong></li>
</ul>

<div class="row">
    <label>note
        <input bind:value={draft}>
    </label>
    <button onclick={() => {
        notes = { text: draft }
        draft = ''
    }}>Add</button>
</div>
