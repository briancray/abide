<script server>
import { GET } from '@abide/abide/server'

const getInvoice = GET(
    async () => {
        // A ledger that takes two seconds to answer.
        await Bun.sleep(2000)
        return { number: 'INV-4021', total: '$1,240.00' }
    },
    { description: 'The invoice this page shows.' },
)
</script>

<script>
import { reactive } from '@abide/abide'

const invoice = reactive(() => getInvoice())
</script>

<h1>Invoice {invoice.number}</h1>
<p>{invoice.total} due on receipt</p>
