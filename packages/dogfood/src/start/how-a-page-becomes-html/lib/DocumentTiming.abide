<script>
import { reactive, url } from '@abide/abide'

let closedAfter = reactive('—')
let carriesInvoice = reactive('—')

async function requestPage() {
    const started = performance.now()
    const answer = await fetch(url('/start/how-a-page-becomes-html/frame'))
    const markup = await answer.text()
    closedAfter = `${Math.round(performance.now() - started)} ms`
    carriesInvoice = markup.includes('INV-4021') ? 'yes' : 'no — a hole'
}
</script>

<div class="row">
    <button onclick={requestPage}>Request the invoice page</button>
</div>

<ul class="tiles">
    <li><span>the document closed</span><strong>{closedAfter}</strong></li>
    <li><span>the invoice in it</span><strong>{carriesInvoice}</strong></li>
</ul>
