<script>
import Code from '#src/lib/Code.abide'
import Doc from '#src/lib/Doc.abide'
import Section from '#src/lib/Section.abide'
</script>

<Doc
    seeAlso={[
        '/app/environment',
        '/pages/files',
        '/handlers/clients',
        '/cli/bridge',
    ]}
    tests={[
        {
            path: 'packages/abide/tests/cliCommands.test.ts',
            from: [
                "test('call answers with the value, and exits 7 on a refusal and 8 on a fault",
            ],
        },
        {
            path: 'packages/abide/tests/routes.test.ts',
            from: ["test('abide routes prints the same map as text"],
        },
        {
            path: 'packages/abide/tests/upgrade.test.ts',
            from: [
                "test('abide upgrade --check prints the diff, writes nothing and fails",
            ],
        },
    ]}
>
    <Section level={3} title="Start a new app and serve it while you work">
        <p><code>abide scaffold</code> writes a starter app with a page, a handler, their tests
            and a Dockerfile. <code>abide dev</code> serves it on port 3000, or the next free one,
            and reloads on every save.</p>
        <Code code={`
            bunx @abide/abide scaffold crm
            cd crm
            bun install
            bun run dev
        `} />
    </Section>

    <Section level={3} title="Check, build and serve the CRM in CI">
        <p><code>abide check</code> type-checks the whole package, its <code>.abide</code> files
            and every <code>.ts</code> its <code>tsconfig.json</code> includes, and reports on the
            line you wrote. <code>abide start</code> serves what <code>abide build</code>
            wrote.</p>
        <Code code={`
            abide check && abide format --check && abide build && bun test
            abide start --port 8080
        `} />
    </Section>

    <Section level={3} title="Call a handler from the terminal">
        <p>Give the handler's route without its leading <code>/</code>, and each argument as
            <code>name=value</code>. It exits 0 on an answer, 7 on a refusal, and 8 where the app
            faulted or asks you to call again later.</p>
        <Code code={`
            abide call assistant/searchContacts name=Ada
        `} />
    </Section>

    <Section level={3} title="Follow the activity feed from the terminal">
        <p><code>abide watch</code> prints a followed <code>GET</code>'s value, then the value
            again after each patch.</p>
        <Code code={`abide watch activity/feed account=hopper-co --url http://localhost:3000`} />
    </Section>

    <Section level={3} title="Ship the CRM as one executable">
        <p><code>abide compile</code> writes one file holding the built client, the server and
            the runtime. The file is the <code>abide</code> command for that app.</p>
        <Code code={`
            abide compile
            ./crm start --port 8080
        `} />
    </Section>

    <Section level={3} title="Move your files past what a release changed">
        <p>Name the release you upgraded from. <code>--check</code> prints the diff and writes
            nothing.</p>
        <Code code={`
            bun add @abide/abide@latest
            abide upgrade --check --from 0.139.0
            abide upgrade --from 0.139.0
        `} />
    </Section>
</Doc>
