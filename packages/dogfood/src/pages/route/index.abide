<script>
import Code from '#src/lib/Code.abide'
import Doc from '#src/lib/Doc.abide'
import Section from '#src/lib/Section.abide'
</script>

<Doc
    seeAlso={[
        '/pages/navigate',
        '/pages/url',
        '/pages/pages',
        '/abide-files/by-name',
    ]}
    tests={[
        {
            path: 'packages/dogfood/examples/crm/src/companies/lib/CompanyTabs.test.ts',
            from: ["test('the open tab is read from the address'"],
        },
        {
            path: 'packages/abide/tests/routeQuery.test.ts',
            from: ["test('a write through one member changes that member alone"],
        },
        {
            path: 'packages/abide/tests/app.test.ts',
            from: [
                "test('route.name, params, url, navigating and index are read by name",
            ],
        },
    ]}
>
    <Section level={3} title="Load the company a page's address names">
        <p>In a page file <code>route.params</code> is typed by the file's own segments. Reading
            <code>id</code> follows the address, so the company reloads when it changes.</p>
        <Code language="abide" caption="abide" code={`
            <script>
            import { reactive, route } from '@abide/abide'
            import getCompany from './getCompany.handler.ts'

            const company = reactive.derived(() => getCompany({ id: route.params.id }))
            </script>

            <h2>{company.name}</h2>
        `} />
    </Section>

    <Section level={3} title="Keep the open tab in the address">
        <p><code>route.query</code> reads each member as the type of its default. Assign a member
            to change that member alone, in place of the current history entry.</p>
        <Code language="abide" caption="abide" code={`
            <script>
            import { route } from '@abide/abide'
            import DealFeed from './lib/DealFeed.abide'
            import DealNotes from './lib/DealNotes.abide'

            const query = route.query({ tab: 'deals' })
            </script>

            <button onclick={() => (query.tab = 'notes')}>Notes</button>
            {#if query.tab === 'notes'}<DealNotes />{:else}<DealFeed />{/if}
        `} />
    </Section>

    <Section level={3} title="Show progress while a navigation loads">
        <p><code>route.navigating</code> is true from the click until the next page is on
            screen.</p>
        <Code language="abide" caption="abide" code={`
            <script>
            import { route } from '@abide/abide'
            </script>

            {#if route.navigating}<progress></progress>{/if}
        `} />
    </Section>
</Doc>
