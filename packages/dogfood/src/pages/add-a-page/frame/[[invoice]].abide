<script>
import { route, url } from '@abide/abide'

const PAGE = '/pages/add-a-page/frame/[[invoice]]'
</script>

<nav class="row">
    <a href={url(PAGE)}>All invoices</a>
    {#for invoice of ['4310', '4311']}
        <a href={url(PAGE, { invoice })}>INV-{invoice}</a>
    {/for}
</nav>

<ul class="fields">
    <li><span>address</span><strong>{route.url.pathname}</strong></li>
    <li><span>route.name</span><strong>{route.name()}</strong></li>
    <li><span>invoice</span>
        <strong>{route.params.invoice ?? 'absent'}</strong></li>
</ul>
