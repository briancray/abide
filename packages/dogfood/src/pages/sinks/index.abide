<script>
import Code from '#src/lib/Code.abide'
import Doc from '#src/lib/Doc.abide'
import Section from '#src/lib/Section.abide'
</script>

<Doc
    seeAlso={[
        '/pages/render',
        '/abide-files/control-flow',
        '/abide-files/expressions',
        '/reactive/ready',
    ]}
    tests={[
        {
            path: 'packages/dogfood/examples/crm/src/companies/Streaming.test.ts',
            from: ["test('the page goes out without the company, and asks for it'"],
        },
        {
            path: 'packages/abide/tests/hydrate.test.ts',
            from: ["test('a render continues past a value still in flight"],
        },
        {
            path: 'packages/abide/tests/hydrate.test.ts',
            from: ["test('a render continues past an unlanded attribute and style"],
        },
    ]}
>
    <Section level={3} title="Send the company page before the company lands">
        <p>Nothing holds the document for a value. A value still in flight leaves a hole, and the
            browser's own call fills it, with no loading branch in the file.</p>
        <Code language="abide" caption="abide" code={`
            <script>
            import { reactive, route } from '@abide/abide'
            import getCompany from './getCompany.server.ts'

            const company = reactive.derived(() => getCompany({ id: route.params.id }))
            </script>

            <h2>{company.name}</h2>
            <strong title={company.contact}>{company.pipeline}</strong>
        `} />
    </Section>

    <Section level={3} title="Fill the tab title once the name arrives">
        <p>A hole inside <code>&lt;title&gt;</code> fills the element's <code>textContent</code>,
            so the tab follows.</p>
        <Code language="abide" caption="abide" code={`
            <head><title>{company.name} — CRM</title></head>
        `} />
    </Section>

    <Section level={3} title="Keep what a rep typed while a saved note loads">
        <p>A hole inside <code>&lt;textarea&gt;</code> fills its <code>defaultValue</code>, so
            typing that started first is kept.</p>
        <Code language="abide" caption="abide" code={`
            <textarea name="note">{deal.note}</textarea>
        `} />
    </Section>
</Doc>
