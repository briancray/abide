<script>
import Code from '#src/lib/Code.abide'
import Doc from '#src/lib/Doc.abide'
import Section from '#src/lib/Section.abide'
</script>

<Doc
    seeAlso={[
        '/pages/navigate',
        '/pages/route',
        '/pages/pages',
        '/handlers/mount-paths',
    ]}
    tests={[
        {
            path: 'packages/abide/tests/url.test.ts',
            from: ["test('url fills a required segment, encoded"],
        },
        {
            path: 'packages/abide/tests/url.test.ts',
            from: ["test('the query argument follows the params"],
        },
    ]}
>
    <Section level={3} title="Link each company to its page by route">
        <p>Write the pattern the page is filed under, matcher and all, and pass its segments.
            Leaving out a required one is a compile error, and <code>abide check</code> refuses a
            pattern no page is filed under.</p>
        <Code language="abide" caption="abide" code={`
            <script>
            import { url } from '@abide/abide'
            </script>

            {#for company of companies key company.id}
                <a href={url('/companies/[id=SLUG]', { id: company.id })}>
                    {company.name}</a>
            {/for}
        `} />
    </Section>

    <Section level={3} title="Add a query to an address, leaving out the defaults">
        <p>The query follows the params. A member equal to its default in the fourth argument is
            left out of the address.</p>
        <Code language="ts" caption="shared" code={`
            import { url } from '@abide/abide'

            url('/companies', {}, { city: 'London', page: 1 }, { page: 1 })
            // '/companies?city=London'
        `} />
    </Section>

    <Section level={3} title="Reach the app's own endpoints under any mount path">
        <p>An address <code>url</code> builds carries the path the app is mounted under, so a
            fetch reaches the app wherever it is served.</p>
        <Code language="ts" caption="browser" code={`
            import { url } from '@abide/abide'

            const answer = await fetch(url('/__abide/openapi.json'))
        `} />
    </Section>
</Doc>
