<script>
import Code from '#src/lib/Code.abide'
import Doc from '#src/lib/Doc.abide'
import Exchange from '#src/lib/Exchange.abide'
import Section from '#src/lib/Section.abide'
</script>

<Doc
    seeAlso={[
        '/ambients/response',
        '/handlers/get',
        '/abide-files/props',
        '/pages/pages',
    ]}
    tests={[
        {
            path: 'packages/abide/tests/cliCommands.test.ts',
            from: [
                "test('run imports a .abide, so a script renders a component — 38.211'",
            ],
        },
        {
            path: 'packages/dogfood/examples/crm/src/companies/lib/SheetPreview.test.ts',
            from: ["test('the sheet is a document of its own'"],
        },
        {
            path: 'packages/abide/tests/componentImports.test.ts',
            from: ["test('abide start renders a component a handler imports"],
        },
    ]}
>
    <Section level={3} title="Answer a handler with a company's account sheet">
        <p>Call the component with its props to bind them, then <code>render</code> it to the
            document's bytes and answer with them as HTML.</p>
        <Code language="ts" caption="server" code={`
            import { GET, refuse, render, response } from '@abide/abide/server'
            import { COMPANIES } from './lib/COMPANIES.server.ts'
            import CompanySheet from './lib/CompanySheet.abide'

            export default GET(async ({ id }: { id: string }) => {
                const company = COMPANIES.find((one) => one.id === id)
                if (company === undefined) return refuse.notFound()
                return response.page(await render(CompanySheet({ company })))
            })
        `} />
        <p>The CRM's handler, asked for one company's sheet when this page loaded:</p>
        <Exchange path="/companies/previewCompany?id=hopper-and-co" />
    </Section>

    <Section level={3} title="Write the whole document, styles and all, from the component">
        <p>A component written inside <code>&lt;html&gt;</code> is the document, so the sheet
            carries its own styles and ships no bundle.</p>
        <Code language="abide" caption="abide" code={`
            <script>
            import { props } from '@abide/abide'
            const { company } = props<{ company: { name: string } }>()
            </script>

            <html lang="en">
                <body style="font: 14px/1.5 system-ui">
                    <h1>{company.name}</h1>
                </body>
            </html>
        `} />
    </Section>

    <Section level={3} title="Check a sheet's bytes from a test">
        <p><code>render</code> needs no request and no running app, so a test can render the
            component and read the document it makes.</p>
        <Code language="ts" caption="server" code={`
            import { expect, test } from 'bun:test'
            import { render } from '@abide/abide/server'
            import CompanySheet from './CompanySheet.abide'

            test('the sheet names the company', async () => {
                const company = { name: 'Hopper & Co' }
                const page = await render(CompanySheet({ company }))
                const html = new TextDecoder().decode(page)
                expect(html).toContain('Hopper &amp; Co')
            })
        `} />
    </Section>

    <Section level={3} title="Save each company's sheet from a script">
        <p>Under <code>abide run</code> a script imports a <code>.abide</code> as the app
            compiles it, so <code>render</code> writes the sheets to disk.</p>
        <Code language="ts" caption="server" code={`
            import { render } from '@abide/abide/server'
            import CompanySheet from './src/companies/lib/CompanySheet.abide'

            const company = { name: 'Hopper & Co' }
            await Bun.write('hopper.html', await render(CompanySheet({ company })))
        `} />
        <Code code={`abide run scripts/sheets.ts`} />
    </Section>
</Doc>
