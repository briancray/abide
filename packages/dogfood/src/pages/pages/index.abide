<script>
import Code from '#src/lib/Code.abide'
import Doc from '#src/lib/Doc.abide'
import Section from '#src/lib/Section.abide'
</script>

<Doc
    seeAlso={['/pages/route', '/pages/url', '/pages/files', '/pages/render']}
    tests={[
        {
            path: 'packages/dogfood/examples/crm/src/companies/CompanyPage.test.ts',
            from: ["test('one file answers for every company, reading its id'"],
        },
        {
            path: 'packages/dogfood/examples/crm/src/companies/Head.test.ts',
            from: ['test("a page'],
        },
        {
            path: 'packages/dogfood/examples/crm/src/contacts/lib/QuickFind.test.ts',
            from: ["test('/ focuses the search box until the box leaves'"],
        },
    ]}
>
    <Section level={3} title="Answer every company's address with one file">
        <p>A segment in brackets is a value the page reads from <code>route.params</code>.
            Double brackets make it optional, and <code>...</code> takes every remaining segment.</p>
        <Code code={`
            src/companies/index.abide        /companies
            src/companies/[id].abide         /companies/hopper-and-co
            src/reports/[[year]].abide       /reports  /reports/2026
            src/files/[...path].abide        /files/contracts/2026/acme.pdf
        `} />
    </Section>

    <Section level={3} title="Turn away an address that cannot be a company id">
        <p>Name a matcher after <code>=</code>, as in <code>[id=SLUG].abide</code>, and a segment
            it refuses never reaches the page. The param file holds one regular expression named
            as the file.</p>
        <Code language="ts" caption="shared" code={`
            // A company's id: lowercase words and digits, joined by hyphens.
            export const SLUG = /[a-z0-9-]+/
        `} />
    </Section>

    <Section level={3} title="Title the tab with the company's name">
        <p>A <code>&lt;head&gt;</code> at the top level of a page, a layout or a component adds to
            the document head. The deepest <code>&lt;title&gt;</code> wins over its layout's.</p>
        <Code language="abide" caption="abide" code={`
            <script>
            import { memo, route } from '@abide/abide'
            import getCompany from './getCompany.handler.ts'

            const company = memo(() => getCompany({ id: route.params.id }))
            </script>

            <head><title>{company.name} — CRM</title></head>

            <h2>{company.name}</h2>
        `} />
    </Section>

    <Section level={3} title="Focus the contact search with a key pressed anywhere">
        <p><code>&lt;window&gt;</code> and <code>&lt;document&gt;</code> hold listeners alone. Each
            is added when the component mounts and removed when it leaves.</p>
        <Code language="abide" caption="abide" code={`
            <script>
            import { reactive } from '@abide/abide'
            const search = reactive<HTMLInputElement | undefined>(undefined)

            function shortcut(event: KeyboardEvent) {
                if (event.key !== '/' || event.target === search) return
                event.preventDefault()
                search?.focus()
            }
            </script>

            <window onkeydown={shortcut} />

            <input type="search" bind:element={search}>
        `} />
    </Section>

    <Section level={3} title="Carry a company's name from the list to its page">
        <p>Give an element on each page the same <code>view-transition-name</code> and the
            browser animates one into the other. A rule naming a view transition turns them on.</p>
        <Code language="abide" caption="abide" code={`
            <script>
            import { url } from '@abide/abide'
            </script>

            <a href={url('/companies/[id=SLUG]', { id: company.id })}
                style:view-transition-name="company-{company.id}">
                {company.name}
            </a>

            <style>
            ::view-transition-group(*) { animation-duration: 0.5s; }
            </style>
        `} />
    </Section>
</Doc>
