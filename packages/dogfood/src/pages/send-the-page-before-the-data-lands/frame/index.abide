<script server>
import { GET } from '@abide/abide/server'

const getInvoice = GET(
    async () => {
        // A slow ledger, so the holes are on screen.
        await Bun.sleep(1500)
        return { number: 'INV-4022', customer: 'Hopper & Co', total: '$900.00' }
    },
    { description: 'The invoice this page shows.' },
)
</script>

<script>
import { reactive } from '@abide/abide'

const invoice = reactive(() => getInvoice())
</script>

<ul class="fields">
    <li><span>invoice</span><strong>{invoice.number}</strong></li>
    <li><span>customer</span><strong>{invoice.customer}</strong></li>
    <li><span>total</span><strong>{invoice.total}</strong></li>
</ul>
