<script server>
import { GET, page, render } from '@abide/abide/server'
import Document from './InvoiceDocument.abide'

const INVOICES = {
    '4021': {
        number: 'INV-4021',
        customer: 'Analytical Engines Ltd',
        due: '2026-10-14',
        lines: [
            { item: 'Annual license', amount: '$1,000.00' },
            { item: 'Onboarding', amount: '$240.00' },
        ],
        total: '$1,240.00',
    },
    '4022': {
        number: 'INV-4022',
        customer: 'Hopper & Co',
        due: '2026-10-21',
        lines: [
            { item: 'Seats × 12', amount: '$720.00' },
            { item: 'Priority support', amount: '$180.00' },
        ],
        total: '$900.00',
    },
}

// A slow database, so the wait is on screen.
async function findInvoice(id: string) {
    await Bun.sleep(300)
    const invoice = INVOICES[id as keyof typeof INVOICES]
    if (invoice === undefined) throw new Error(`no invoice ${id}`)
    return invoice
}

export const previewInvoice = GET(
    async ({ id }: { id: string }) => {
        const invoice = await findInvoice(id)
        return page(await render(Document({ invoice })))
    },
    { description: 'An invoice, rendered as a page of its own.' },
)
</script>

<script>
import { reactive } from '@abide/abide'

let id = reactive('4021')
</script>

<div class="tabs">
    <button aria-selected={id === '4021'}
        onclick={() => { id = '4021' }}>INV-4021</button>
    <button aria-selected={id === '4022'}
        onclick={() => { id = '4022' }}>INV-4022</button>
</div>
<iframe src={previewInvoice.url({ id })} title="Invoice preview"
    class="h-56 w-full rounded-md border border-rule"></iframe>
