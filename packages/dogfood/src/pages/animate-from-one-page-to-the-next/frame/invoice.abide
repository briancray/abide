<script>
import { reactive, route, url } from '@abide/abide'

const TOTALS: Record<string, string> = {
    '4021': '$1,240.00',
    '4022': '$900.00',
}

const id = reactive(() => route.url.searchParams.get('id') ?? '4021')
</script>

<a href={url('/pages/animate-from-one-page-to-the-next/frame')}>All invoices</a>
<ul class="tiles">
    <li><span>INV-{id} due</span>
        <strong class="text-heading total-{id}">{TOTALS[id]}</strong></li>
</ul>

<style>
.total-4021 { view-transition-name: total-4021; }
.total-4022 { view-transition-name: total-4022; }
</style>
