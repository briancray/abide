<script>
import Code from '#src/lib/Code.abide'
import Doc from '#src/lib/Doc.abide'
import Exchange from '#src/lib/Exchange.abide'
import Section from '#src/lib/Section.abide'
</script>

<Doc
    seeAlso={[
        '/handlers/rpc',
        '/abide-files/blocks',
        '/pages/pages',
        '/pages/url',
    ]}
    tests={[
        {
            path: 'packages/abide/tests/appAddresses.test.ts',
            from: [
                "test('a handler file answers at its path, and a private handler below /__abide/handlers — 16.2, 16.70, 23.3, 23.14'",
            ],
        },
        {
            path: 'packages/abide/tests/appAddresses.test.ts',
            from: [
                "test('a route parameter reaches the handler, typed, whatever the method — 16.65'",
            ],
        },
        {
            path: 'packages/dogfood/examples/crm/src/deals/lib/DealNotes.test.ts',
            from: ["test('the private handler answers below /__abide/handlers'"],
        },
    ]}
>
    <Section level={3} title="Find a handler's address from its file">
        <p>Export an <code>rpc</code> from a file named <code>&lt;name&gt;.server.ts</code> anywhere
            under <code>src</code>. Its path, less the suffix, is the address its default answers at,
            and a named one answers below it by its name.</p>
        <Code code={`
            src/
              health.server.ts           GET  /health
              deals/
                getDeal.server.ts        GET  /deals/getDeal
                createDeal.server.ts     POST /deals/createDeal
        `} />
    </Section>

    <Section level={3} title="Take a deal's id from the path">
        <p>Put a <code>[param]</code> directory in the path and declare the parameter in the
            handler's <code>Args</code>. A call with <code>&#123; id: 'd2' &#125;</code> goes to
            <code>/deals/d2/close</code>.</p>
        <Code language="ts" caption="server" code={`
            // src/deals/[id]/close.server.ts
            import { rpc } from '@abide/abide/server'
            import { DEALS } from '../../lib/DEALS.server.ts'

            export default rpc(({ id }: { id: string }) => {
                const deal = DEALS.find((each) => each.id === id)
                if (deal) deal.stage = 'won'
                return deal ?? null
            }, { methods: ['POST'] })
        `} />
    </Section>

    <Section level={3} title="Keep the notes handler inside the one card showing notes">
        <p>Export the function from the component's <code>&lt;script server&gt;</code> as it is,
            with no <code>rpc</code> around it. It answers under <code>/__abide/handlers</code> at the
            file's path and its name, and no surface lists it.</p>
        <Code language="abide" caption="abide" code={`
            <script server>
            const NOTES: Record<string, string[]> = { d1: ['Wants a three-year term.'] }
            export const getNotes = ({ id }: { id: string }) => NOTES[id] ?? []
            </script>

            <script>
            import { reactive } from '@abide/abide'
            const notes = reactive(() => getNotes({ id: 'd1' }))
            </script>

            {#for note of notes}<p>{note}</p>{/for}
        `} />
        <p>The CRM's deal notes card declares it. Here is its address, asked when this page
            loaded:</p>
        <Exchange path="/__abide/handlers/deals/lib/DealNotes/getNotes?id=d1" />
    </Section>
</Doc>
