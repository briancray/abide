<script>
import Code from '#src/lib/Code.abide'
import Doc from '#src/lib/Doc.abide'
import Exchange from '#src/lib/Exchange.abide'
import Section from '#src/lib/Section.abide'

// The JSON-RPC body a model's client posts.
const searchHopper = JSON.stringify(
    {
        jsonrpc: '2.0',
        id: 1,
        method: 'tools/call',
        params: {
            name: 'get_assistant_searchContacts',
            arguments: { name: 'Hopper' },
        },
    },
    null,
    2,
)
</script>

<Doc
    seeAlso={[
        '/handlers/clients',
        '/handlers/openapi',
        '/ai/assistant',
        '/middleware/middleware',
        '/cli/commands',
    ]}
    tests={[
        {
            path: 'packages/dogfood/examples/crm/src/assistant/lib/ModelToolCall.test.ts',
            from: ["test('a model lists the handler as a tool, and calls it'"],
        },
        {
            path: 'packages/abide/tests/generated.test.ts',
            from: ["test('a tool is annotated from its handler’s method — 20.14'"],
        },
    ]}
>
    <Section level={3} title="Let a model search the contacts">
        <p>Every handler the app publishes is a tool on <code>/__abide/mcp</code>. A model picks
            one by its <code>description</code>, so write one on every handler.</p>
        <Code language="ts" caption="server" code={`
            // src/assistant/searchContacts.handler.ts
            import { rpc } from '@abide/abide/server'
            import { CONTACTS } from '../contacts/lib/CONTACTS.server.ts'

            export default rpc(
                ({ name }: { name: string }) =>
                    CONTACTS.filter((contact) => contact.name.includes(name)),
                { description: 'The contacts whose name contains \`name\`.' },
            )
        `} />
    </Section>

    <Section level={3} title="Call the contact search as a model's client does">
        <p>Post a JSON-RPC <code>tools/call</code>. The call runs through the app's middleware,
            as the caller, and a declared refusal reaches the model by its name.</p>
        <Code language="ts" caption="shared" code={`
            const answer = await fetch('https://crm.example/__abide/mcp', {
                method: 'POST',
                headers: { 'content-type': 'application/json' },
                body: JSON.stringify({
                    jsonrpc: '2.0',
                    id: 1,
                    method: 'tools/call',
                    params: {
                        name: 'get_assistant_searchContacts',
                        arguments: { name: 'Hopper' },
                    },
                }),
            })
        `} />
        <p>The CRM's search, posted when this page loaded:</p>
        <Exchange method="POST" path="/__abide/mcp" body={searchHopper} />
    </Section>

    <Section level={3} title="Connect a desktop MCP client over stdio">
        <p>Run <code>abide mcp</code> for a client that starts a command rather than calling a
            URL. It serves the same tools.</p>
        <Code code={`abide mcp --url https://crm.example`} />
    </Section>
</Doc>
