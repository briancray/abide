<script>
import Code from '#src/lib/Code.abide'
import Doc from '#src/lib/Doc.abide'
import Section from '#src/lib/Section.abide'
</script>

<Doc
    seeAlso={[
        '/testing/settled',
        '/harness/abide/measure',
        '/harness/abide/preload',
        '/app/create-app',
    ]}
    tests={[
        {
            path: 'packages/dogfood/examples/crm/src/reports/lib/ClosedTiles.test.ts',
            from: ["test('a range switch rewrites two numbers and builds nothing'"],
        },
        {
            path: 'packages/abide/tests/testPreload.test.ts',
            from: [
                "test('the caller reads what the component wrote, and the component what the caller set'",
            ],
        },
        {
            path: 'packages/abide/tests/testPreload.test.ts',
            from: [
                "test('a mounted component reads route at the document address, and navigates",
            ],
        },
        {
            path: 'packages/dogfood/examples/crm/src/lib/JumpTo.test.ts',
            from: [
                "test('an arrow and Enter run the command, and the palette shuts'",
            ],
        },
    ]}
>
    <Section level={3} title="Click a component in a test and read what it rendered">
        <p><code>mount</code> renders the component as the server does and hydrates it with the
            module the browser loads, so the test clicks the listener a person clicks.
            <code>using</code> stops it when the test ends.</p>
        <Code language="ts" caption="browser" code={`
            import { expect, test } from 'bun:test'
            import { flushSync } from '@abide/abide'
            import { mount } from '@abide/abide/test'
            import ClosedTiles from './ClosedTiles.abide'

            test('the 30-day range counts its deals', async () => {
                using _tiles = await mount(ClosedTiles({}))
                document.querySelectorAll('button')[1]?.click()
                flushSync()
                expect(document.querySelector('strong')?.textContent).toBe('75')
            })
        `} />
    </Section>

    <Section level={3} title="Drive a prop from the test as a parent would">
        <p>Hand a prop as a <code>Reactive</code> and the component is bound to it: a write in the
            test reaches the component, and a write in the component reaches the test.</p>
        <Code language="ts" caption="browser" code={`
            import { expect } from 'bun:test'
            import { flushSync, reactive } from '@abide/abide'
            import { mount } from '@abide/abide/test'
            import StageTile from './StageTile.abide'

            const stage = reactive('lead')
            using _tile = await mount(StageTile({ stage }))
            stage.set('won')
            flushSync()
            expect(document.body.textContent).toContain('won')
        `} />
    </Section>

    <Section level={3} title="Read where a component navigated">
        <p>A mounted component stands at the document's address, and its <code>navigate</code>
            writes the history as the router does, so the test reads <code>location</code>
            afterward.</p>
        <Code language="ts" caption="browser" code={`
            import { expect, test } from 'bun:test'
            import { flushSync } from '@abide/abide'
            import { mount } from '@abide/abide/test'
            import JumpTo from './JumpTo.abide'

            test('Companies goes to the companies list', async () => {
                using _jump = await mount(JumpTo({}))
                document.querySelectorAll<HTMLElement>('[role=option]')[1]?.click()
                flushSync()
                expect(location.pathname).toBe('/companies')
            })
        `} />
    </Section>
</Doc>
