<script>
import Code from '#src/lib/Code.abide'
import Doc from '#src/lib/Doc.abide'
import Section from '#src/lib/Section.abide'
</script>

<Doc
    seeAlso={[
        '/ambient/request',
        '/transports/post',
        '/transports/get',
        '/transports/headers',
        '/pages/render',
    ]}
    tests={[
        {
            path: 'packages/dogfood/examples/crm/src/account/lib/AddContact.test.ts',
            from: ["test('adding a contact answers 201, and where it lives'"],
        },
        {
            path: 'packages/abide/tests/transport.test.ts',
            from: [
                "test('response.page answers a document and response.redirect a navigation",
            ],
        },
        {
            path: 'packages/abide/tests/transport.test.ts',
            from: [
                "test('a framing fixed by a helper is kept whatever Accept asks",
            ],
        },
    ]}
>
    <Section level={3} title="Answer 201 with the address of the new contact">
        <p>Write the status and headers through <code>response()</code>, then go on returning the
            value. The body stays the handler's return.</p>
        <Code language="ts" caption="server" code={`
            import { POST, response } from '@abide/abide/server'

            export default POST(async ({ name }: { name: string }) => {
                const contact = await contacts.add({ name })
                response().status = 201
                response().headers.set('location', \`/contacts/\${contact.id}\`)
                return contact
            })
        `} />
    </Section>

    <Section level={3} title="Send a form post on to the deal it created">
        <p><code>response.redirect</code> sets the status and <code>location</code> and returns
            <code>undefined</code>. The status is 302 unless you name another.</p>
        <Code language="ts" caption="server" code={`
            export default POST(async ({ title }: { title: string }) => {
                const deal = await deals.add({ title })
                return response.redirect(\`/deals/\${deal.id}\`, 303)
            })
        `} />
    </Section>

    <Section level={3} title="Stream an export as JSON lines whatever the caller asks">
        <p>An iterable answer streams, framed by the request's <code>Accept</code>. Wrap it in
            <code>response.jsonl</code>, <code>response.sse</code> or <code>response.bytes</code>
            to fix the framing.</p>
        <Code language="ts" caption="server" code={`
            export default GET(() => response.jsonl(deals.all()))
        `} />
    </Section>

    <Section level={3} title="Serve a rendered document from a handler">
        <p><code>response.page</code> marks what <code>render</code> produced as
            <code>text/html</code>. It renders nothing itself.</p>
        <Code language="ts" caption="server" code={`
            import { GET, render, response } from '@abide/abide/server'
            import Statement from './lib/Statement.abide'

            export default GET(async ({ id }: { id: string }) =>
                response.page(await render(Statement({ id }))),
            )
        `} />
    </Section>
</Doc>
