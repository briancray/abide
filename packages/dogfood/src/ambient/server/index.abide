<script>
import Code from '#src/lib/Code.abide'
import Doc from '#src/lib/Doc.abide'
import Section from '#src/lib/Section.abide'
</script>

<Doc
    seeAlso={[
        '/ambient/request',
        '/ambient/health',
        '/app/create-app',
        '/ambient/is-server',
    ]}
    tests={[
        {
            path: 'packages/abide/tests/scope.test.ts',
            from: [
                "test('request and response read the request being served, and throw outside one",
            ],
        },
    ]}
>
    <Section level={3} title="Reach a Bun server API abide does not carry">
        <p><code>server()</code> is the <code>Bun.Server</code> that is listening. Reach for it
            when no abide name covers what you need, such as how many requests are in flight.</p>
        <Code language="ts" caption="server" code={`
            import { GET, server } from '@abide/abide/server'

            export default GET(() => ({
                inFlight: server().pendingRequests,
                sockets: server().pendingWebSockets,
            }))
        `} />
    </Section>

    <Section level={3} title="Read the server only where a socket is bound">
        <p><code>App.listen</code> binds the socket, as <code>abide start</code> and
            <code>abide dev</code> do. A call answered in process, under <code>App.fetch</code> in a
            test, has no server, and <code>server()</code> throws there.</p>
        <Code language="ts" caption="server" code={`
            const app = await createApp()
            await app.run(() => server()) // throws: no socket bound
            await app.listen({ port: 0 })
            await app.run(() => server()) // the Bun.Server
        `} />
    </Section>
</Doc>
