<script>
import Code from '#src/lib/Code.abide'
import Doc from '#src/lib/Doc.abide'
import Section from '#src/lib/Section.abide'
</script>

<Doc
    seeAlso={[
        '/transports/post',
        '/reactive/synced',
        '/reactive/busy',
        '/ambient/online',
    ]}
    tests={[
        {
            path: 'packages/abide/tests/outbox.test.ts',
            from: [
                "test('a mutation with no answer is queued, sent again under its key, and lands its answer",
            ],
        },
        {
            path: 'packages/abide/tests/outbox.test.ts',
            from: [
                "test('a refused call stays with its error and does not hold back the next",
            ],
        },
        {
            path: 'packages/dogfood/examples/crm/src/ops/lib/CallLog.test.ts',
            from: ["test('a call sent twice under one id is logged once'"],
        },
    ]}
>
    <Section level={3} title="Log a call in a tunnel and send it when the network is back">
        <p>Give the call <code>offline</code>. With no answer it settles to what
            <code>offline</code> returns and waits in the outbox, kept through a reload.</p>
        <Code language="abide" caption="abide" code={`
            <script>
            import { outbox } from '@abide/abide'
            import logCall from './logCall.handler.ts'
            import listCalls from './listCalls.handler.ts'

            const calls = listCalls()
            function log(note) {
                const call = { id: crypto.randomUUID(), note }
                logCall(call, {
                    offline: () => calls.patch((held) => held.push(call)),
                })
            }
            </script>

            <p>{outbox(logCall).length} waiting to send</p>
        `} />
    </Section>

    <Section level={3} title="Retry or drop a call the server refused">
        <p>A refused call stays, its refusal on <code>value</code>, and the calls behind it go on.
            Each queued call carries its own <code>retry</code> and <code>discard</code>.</p>
        <Code language="abide" caption="abide" code={`
            {#for call of outbox(logCall) by call.id}
                {#if call.value.error()}
                    <p>{call.args?.note}: {call.value.error().message}</p>
                    <button onclick={call.retry}>Retry</button>
                    <button onclick={call.discard}>Discard</button>
                {/if}
            {/for}
        `} />
    </Section>

    <Section level={3} title="Log a call once however often it is sent">
        <p>Every send of a queued call carries the same <code>idempotency-key</code>. Let the browser
            pick the id, so a resend whose answer was lost writes nothing twice.</p>
        <Code language="ts" caption="server" code={`
            export default POST(({ id, note }: Call) => {
                calls.patch((held) => {
                    if (!held.some((call) => call.id === id)) held.push({ id, note })
                })
            })
        `} />
    </Section>
</Doc>
