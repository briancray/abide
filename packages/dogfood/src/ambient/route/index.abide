<script>
import companyTabsSpecSource from 'crm/e2e/CompanyTabs.test.ts' with { type: 'text' }
import CompanyTabs from 'crm/src/companies/lib/CompanyTabs.abide'
import companyTabsSource from 'crm/src/companies/lib/CompanyTabs.abide' with { type: 'text' }
import companyTabsTestSource from 'crm/src/companies/lib/CompanyTabs.test.ts' with { type: 'text' }

import Doc from '#src/lib/Doc.abide'
