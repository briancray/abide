<script server>
import { POST, response } from '@abide/abide/server'

let nextId = 4031

// A slow database, so the wait is on screen.
async function insertContact(name: string) {
    await Bun.sleep(400)
    const id = String(nextId)
    nextId += 1
    return { id, name }
}

export const addContact = POST(
    async ({ name }: { name: string }) => {
        const contact = await insertContact(name)
        response().status = 201
        response().headers.set('location', `/contacts/${contact.id}`)
        return contact
    },
    { description: 'Adds a contact, and answers 201 with where it lives.' },
)
</script>

<script>
import { reactive } from '@abide/abide'

let name = reactive('Grace Hopper')
let added = reactive<{ status: number; location: string | null }>()

async function add() {
    const raw = await addContact.raw({ name })
    return { status: raw.status, location: raw.headers.get('location') }
}
</script>

<div class="row">
    <input bind:value={name} aria-label="name" />
    <button onclick={() => { added = add() }}>Add contact</button>
</div>

<ul class="fields">
    <li><span>status</span>
        <strong>{added.ready() ? added.status : '—'}</strong></li>
    <li><span>location</span>
        <strong>{added.ready() ? added.location : '—'}</strong></li>
</ul>
