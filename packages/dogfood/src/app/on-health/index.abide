<script>
import Code from '#src/lib/Code.abide'
import Doc from '#src/lib/Doc.abide'
import Exchange from '#src/lib/Exchange.abide'
import Section from '#src/lib/Section.abide'
</script>

<Doc
    seeAlso={['/operating/health', '/app/on-start']}
    tests={[
        {
            path: 'packages/dogfood/examples/crm/src/ops/lib/Health.test.ts',
            from: [
                "test('the health check carries the database beside the baseline'",
            ],
        },
        {
            path: 'packages/abide/tests/health.test.ts',
            from: ["test('a field an app declares on Health is typed"],
        },
    ]}
>
    <Section level={3} title="Report the database connection in the health check">
        <p>What the reporter returns is merged over abide's baseline at
            <code>/__abide/health</code>, and your field wins a collision.</p>
        <Code language="abide" caption="abide" code={`
            <script server>
            import { onHealth } from '@abide/abide/server'
            import { pool } from './lib/pool.server.ts'

            onHealth(() => ({ database: pool.connected ? 'connected' : 'closed' }))
            </script>
        `} />
        <p>The CRM's health check, asked when this page loaded:</p>
        <Exchange path="/__abide/health" />
    </Section>

    <Section level={3} title="Type the field a page reads off the health check">
        <p>Declare the field on <code>Health</code> and <code>health()</code> reads it typed.</p>
        <Code language="ts" caption="server" code={`
            import '@abide/abide'

            declare module '@abide/abide' {
                interface Health {
                    database: string
                }
            }
        `} />
    </Section>
</Doc>
