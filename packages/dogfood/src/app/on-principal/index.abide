<script>
import Code from '#src/lib/Code.abide'
import Doc from '#src/lib/Doc.abide'
import Section from '#src/lib/Section.abide'
</script>

<Doc
    seeAlso={[
        '/ambients/principal',
        '/middleware/signed-in',
        '/middleware/require-role',
        '/app/create-app',
    ]}
    tests={[
        {
            path: 'packages/dogfood/examples/crm/src/account/lib/Badge.test.ts',
            from: ["test('the claims resolve to the member they name'"],
        },
        {
            path: 'packages/abide/tests/principal.test.ts',
            from: [
                "test('set authenticates, the baseline wins, and the caller survives",
            ],
        },
    ]}
>
    <Section level={3} title="Keep only an id in the cookie and look up the member">
        <p>The hook is handed the sealed claims and returns your half of the caller, at most once
            per request. A rename shows on the next request, not at the next sign-in.</p>
        <Code language="abide" caption="abide" code={`
            <script server>
            import { onPrincipal } from '@abide/abide/server'
            import { TEAM } from './lib/TEAM.server.ts'

            onPrincipal((claims) => {
                const { id } = claims as { id: string }
                const member = TEAM.find((one) => one.id === id)
                return member && { name: member.name, role: member.role }
            })
            </script>
        `} />
    </Section>

    <Section level={3} title="Type the member fields every page reads">
        <p>Declare what the hook returns on <code>Principal</code>. abide's own
            <code>authenticated</code>, <code>expiresAt</code> and <code>error</code> win any
            collision, so a resolver cannot sign a caller in.</p>
        <Code language="ts" caption="server" code={`
            import '@abide/abide'

            declare module '@abide/abide' {
                interface Principal {
                    name?: string
                    role?: string
                }
            }
        `} />
    </Section>

    <Section level={3} title="Resolve a member in a test without a cookie">
        <p><code>app.run</code> hands its <code>principal</code> claims to the hook as a sealed
            cookie's are.</p>
        <Code language="ts" caption="server" code={`
            import { expect } from 'bun:test'
            import { principal } from '@abide/abide'
            import { createApp } from '@abide/abide/server'

            await using app = await createApp()
            const member = await app.run(async () => await principal.resolved, {
                principal: { id: 'theo' },
            })
            expect(member.name).toBe('Theo Park')
        `} />
    </Section>
</Doc>
