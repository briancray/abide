<script>
import Code from '#src/lib/Code.abide'
import Doc from '#src/lib/Doc.abide'
import Exchange from '#src/lib/Exchange.abide'
import Section from '#src/lib/Section.abide'
</script>

<Doc
    seeAlso={['/app/on-stop', '/app/on-config', '/app/create-app']}
    tests={[
        {
            path: 'packages/dogfood/examples/crm/src/ops/lib/Pool.test.ts',
            from: [
                "test('the pool is connected before the first request is answered'",
            ],
        },
        {
            path: 'packages/abide/tests/app.test.ts',
            from: ["test('a throwing onStart stops the server starting"],
        },
    ]}
>
    <Section level={3} title="Connect the database pool before the first request">
        <p>Work before <code>await start()</code> runs before the app boots, and work after it
            once the app has booted. The app answers nothing until every hook returns. Call it
            in a handler file or a <code>&lt;script server&gt;</code>.</p>
        <Code language="ts" caption="server" code={`
            import { GET, onStart } from '@abide/abide/server'
            import { pool } from './lib/pool.server.ts'

            onStart(async (start) => {
                await pool.connect()
                await start()
                pool.upAt = new Date().toISOString()
            })

            export default GET(() => ({ upAt: pool.upAt }))
        `} />
        <p>The CRM's pool, asked when this page loaded. It connected before the app came
            up:</p>
        <Exchange path="/ops/getPool" />
    </Section>

    <Section level={3} title="Keep the server down when a migration fails">
        <p>A hook that throws stops the boot, so the app never answers with a schema it
            does not have. Put hooks for the whole app in the root
            <code>src/layout.abide</code>.</p>
        <Code language="abide" caption="abide" code={`
            <script server>
            import { onStart } from '@abide/abide/server'
            import { crmDatabase } from './pipeline/lib/crmDatabase.server.ts'

            onStart(async (start) => {
                crmDatabase() // opens the file, and runs the migrations it has not
                await start()
            })
            </script>
        `} />
    </Section>
</Doc>
