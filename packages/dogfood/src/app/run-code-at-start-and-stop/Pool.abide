<script server>
import { GET, onStart, onStop } from '@abide/abide/server'

// A pool that takes a moment to connect, as a real one does.
const pool = {
    connected: false,
    connectedAt: '',
    upAt: '',
    async connect(): Promise<void> {
        await Bun.sleep(300)
        pool.connected = true
        pool.connectedAt = new Date().toISOString()
    },
    async close(): Promise<void> {
        pool.connected = false
    },
}

onStart(async (start) => {
    await pool.connect()
    await start()
    pool.upAt = new Date().toISOString()
})

onStop(async (stop) => {
    await stop()
    await pool.close()
})

/** When the pool connected, and when the app came up around it. */
export const poolState = GET(
    () => ({ connectedAt: pool.connectedAt, upAt: pool.upAt }),
    { description: 'When the pool connected, and when the app came up.' },
)
</script>

<script>
const state = poolState()
</script>

<ul class="fields stacked">
    <li><span>pool connected</span><strong>{state.connectedAt}</strong></li>
    <li><span>app up</span><strong>{state.upAt}</strong></li>
</ul>
