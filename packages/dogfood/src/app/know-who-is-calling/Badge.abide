<script server>
import { onPrincipal, POST, principal } from '@abide/abide/server'

declare module '@abide/abide' {
    // What `onPrincipal` below resolves to; absent when nobody is signed in.
    interface Principal {
        id?: string
        name?: string
        role?: string
    }
}

const USERS: Record<string, { id: string; name: string; role: string }> = {
    ada: { id: 'ada', name: 'Ada Lovelace', role: 'admin' },
    grace: { id: 'grace', name: 'Grace Hopper', role: 'sales' },
}

// The records a sealed id is resolved against, slow as a real lookup is.
async function findUser(id: string) {
    await Bun.sleep(150)
    return USERS[id]
}

onPrincipal(async (claims) => {
    const { id } = claims as { id: string }
    return findUser(id)
})

/** Seals the id alone, and answers with what `onPrincipal` made of it. */
export const signInAs = POST(
    async ({ id }: { id: string }) => {
        await principal.set({ id })
        const { name = '', role = '' } = principal.resolved()
        return { id, name, role }
    },
    { description: 'Signs in as an id, and answers who that is.' },
)
</script>

<script>
import { reactive } from '@abide/abide'

let id = reactive<string>()

// Built from the call, so it can fail with whatever the call can.
const user = reactive(() => signInAs({ id }))
</script>

<div class="row">
    <button onclick={() => { id = 'ada' }}>Sign in as ada</button>
    <button onclick={() => { id = 'grace' }}>Sign in as grace</button>
</div>

<ul class="fields">
    <li><span>sealed</span>
        <strong>{user.ready() ? user.id : '—'}</strong></li>
    <li><span>name</span>
        <strong>{user.ready() ? user.name : '—'}</strong></li>
    <li><span>role</span>
        <strong>{user.ready() ? user.role : '—'}</strong></li>
</ul>
