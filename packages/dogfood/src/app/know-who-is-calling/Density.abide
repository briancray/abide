<script>
import { cookies, reactive } from '@abide/abide'

const DENSITIES = ['comfortable', 'compact']

const density = reactive(() => cookies().get('density') ?? 'comfortable')
</script>

<div class="tabs">
{#for one of DENSITIES}
    <button aria-selected={density === one}
        onclick={() => cookies().set('density', one)}>{one}</button>
{/for}
</div>

<ul class="fields">
    <li><span>density</span><strong>{density}</strong></li>
</ul>
