<script server>
import { principal, refuse } from '@abide/abide'
import { POST } from '@abide/abide/server'

// null for an unknown email, so the 401 below is a path, not a crash.
const USERS: Record<string, { id: string; name: string }> = {
    'ada@example.com': { id: 'ada', name: 'Ada Lovelace' },
}

// A slow database, so the wait is on screen.
async function userByEmail(email: string) {
    await Bun.sleep(450)
    return USERS[email] ?? null
}

const signIn = POST(
    async ({ email }: { email: string }) => {
        const user = await userByEmail(email)
        if (user === null) return refuse(401, 'No such account.')
        await principal.set({ id: user.id, name: user.name })
    },
    { description: 'Signs in by email.' },
)

const signOut = POST(() => principal.clear(), {
    description: 'Signs out.',
})
</script>

<script>
import { principal, reactive } from '@abide/abide'
import Header from './Header.abide'

let email = reactive('ada@example.com')
</script>

<Header/>
<div class="row">
    <label>email
        <input bind:value={email}>
    </label>
    <button onclick={() => {
        if (principal.authenticated()) signOut()
        else signIn({ email })
    }}>{principal.authenticated() ? 'Sign out' : 'Sign in'}</button>
</div>
