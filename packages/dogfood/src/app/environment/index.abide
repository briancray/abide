<script>
import Code from '#src/lib/Code.abide'
import Doc from '#src/lib/Doc.abide'
import Section from '#src/lib/Section.abide'
</script>

<Doc
    seeAlso={[
        '/request/config',
        '/app/on-config',
        '/operating/log',
        '/cli/commands',
    ]}
    tests={[
        {
            path: 'packages/abide/tests/environment.test.ts',
            from: [
                "test('abide start names the environment production where none was given",
            ],
        },
        {
            path: 'packages/abide/tests/log.test.ts',
            from: ["test('log.enabled answers DEBUG in debug-npm grammar"],
        },
        {
            path: 'packages/abide/tests/otlpExport.test.ts',
            from: ["test('with no endpoint named nothing is exported"],
        },
    ]}
>
    <Section level={3} title="Serve the CRM under a sub-path">
        <p>Every page, handler and asset answers below the path, with nothing rebuilt. Addresses
            built with <code>url</code> follow it.</p>
        <Code code={`APP_URL=https://example.com/crm abide start`} />
    </Section>

    <Section level={3} title="Rotate the secret that seals the principal cookie">
        <p>List the new secret first and keep the old one after it, so a cookie sealed before the
            change still opens.</p>
        <Code code={`ABIDE_PRINCIPAL_SECRET=$NEW_SECRET,$OLD_SECRET abide start`} />
    </Section>

    <Section level={3} title="Turn on debug lines for one part of the app">
        <p><code>DEBUG</code> takes namespaces in the grammar of the <code>debug</code> package,
            under the app's name.</p>
        <Code code={`DEBUG='crm:*,-crm:db' abide dev`} />
    </Section>

    <Section level={3} title="Keep the CRM readable when the network drops">
        <p>Each page a browser opens is kept on the device with its handlers' answers and the
            bundle, and opens from there offline.</p>
        <Code code={`ABIDE_OFFLINE=1 abide start`} />
    </Section>

    <Section level={3} title="Send lines and spans to an OpenTelemetry backend">
        <p>Name an OTLP endpoint and every line the app logs and every span it opens is sent as
            OTLP over HTTP. Unset, nothing is sent.</p>
        <Code code={`
            OTEL_EXPORTER_OTLP_ENDPOINT=https://api.honeycomb.io \\
            OTEL_EXPORTER_OTLP_HEADERS=x-honeycomb-team=$KEY abide start
        `} />
    </Section>
</Doc>
