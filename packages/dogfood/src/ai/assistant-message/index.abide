<script>
import { url } from '@abide/abide'

import Code from '#src/lib/Code.abide'
import Doc from '#src/lib/Doc.abide'
import Section from '#src/lib/Section.abide'
</script>

<Doc
    seeAlso={['/ai/assistant', '/headless/dropzone', '/headless/chat']}
    tests={[
        {
            path: 'packages/abide/tests/assistantMessage.test.ts',
            from: [
                "test('a PDF is a document, and a file of text a text document, each titled with its name — 44.55'",
            ],
        },
        {
            path: 'packages/abide/tests/assistantMessage.test.ts',
            from: ["test('words and files are blocks in the order given — 44.55'"],
        },
        {
            path: 'packages/abide/tests/assistantMessage.test.ts',
            from: [
                "test('a URL is the block the API fetches it into, and a block built by hand goes as written, in order — 44.55'",
            ],
        },
        {
            path: 'packages/abide/tests/assistantMessage.test.ts',
            from: [
                "test('an image is drawn down to 1568 on its long side, a photo as a JPEG — 44.52, 44.53'",
            ],
        },
        {
            path: 'packages/abide/tests/assistantMessage.test.ts',
            from: [
                "test('an image nothing can draw goes as it is, or throws where a model is not shown its type — 44.54'",
            ],
        },
        {
