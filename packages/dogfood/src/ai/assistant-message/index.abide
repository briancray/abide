>
    <Section level={3} title="Ask about a statement dropped on the question">
        <p>Keep the files a <a href={url('/headless/dropzone')}><code>dropzone</code></a> takes,
            and hand them to <code>assistantMessage</code> with the question when it is sent. A PDF
            goes as a document, titled with its file's name.</p>
        <Code language="abide" caption="abide" code={`
            <script>
            import { assistantMessage, dropzone, reactive } from '@abide/abide'
            import { askAssistant } from './askAssistant.server.ts'

            let question = reactive('')
            let files = reactive<File[]>([])
            const drop = dropzone({
                accept: 'application/pdf,image/*',
                onfiles: (taken) => files.patch((all) => all.push(...taken)),
            })

            async function send() {
                const message = await assistantMessage('user', [...files, question])
                askAssistant({ messages: [message] })
                files = []
            }
            </script>

            <form {...drop.host} onsubmit={send}>
                <textarea bind:value={question}></textarea>
                <button>Ask</button>
            </form>
        `} />
    </Section>

    <Section level={3} title="Ask the assistant about a photo of a business card">
        <p>A photo is drawn down to 1568 pixels on its long side, with where it was taken left
            behind.</p>
        <Code language="abide" caption="abide" code={`
            <script>
            import { assistantMessage } from '@abide/abide'
            import { askAssistant } from './askAssistant.server.ts'

            async function ask(event: Event) {
                const [card] = (event.target as HTMLInputElement).files ?? []
                if (card === undefined) return
                const message = await assistantMessage('user', [card, 'Add this contact.'])
                askAssistant({ messages: [message] })
            }
            </script>

            <input type="file" accept="image/*" onchange={ask}>
        `} />
    </Section>

    <Section level={3} title="Ask whether an invoice paid a receipt">
        <p>Words and files are blocks in the order given, so the question can point at each file
            where it mentions it.</p>
        <Code language="ts" caption="browser" code={`
            import { assistantMessage } from '@abide/abide'
            import { askAssistant } from './askAssistant.server.ts'

            const message = await assistantMessage('user', [
                'Was this receipt',
                receipt,
                'paid by this invoice?',
                invoice,
            ])
            askAssistant({ messages: [message] })
        `} />
    </Section>

    <Section level={3} title="Ask about a statement the bank serves at a URL">
        <p>A URL whose path ends <code>.pdf</code> goes as a document, and one ending in an
            image's extension as an image. The API fetches it, so nothing is downloaded
            first.</p>
        <Code language="ts" caption="browser" code={`
            import { assistantMessage } from '@abide/abide'
            import { askAssistant } from './askAssistant.server.ts'

            const statement = new URL('https://bank.example/statements/q3.pdf')
            const message = await assistantMessage('user', [statement, 'What did I hold?'])
            askAssistant({ messages: [message] })
        `} />
    </Section>

    <Section level={3} title="Hand the assistant a search result to cite">
        <p>A block written by hand goes as it is, in its place: any content block the Messages
            API takes in a user turn. A search result rides in the turn and the transcript with
            no part of its own in <a href={url('/headless/chat')}><code>chat</code></a>.</p>
        <Code language="ts" caption="browser" code={`
            import { assistantMessage } from '@abide/abide'
            import { askAssistant } from './askAssistant.server.ts'

            const message = await assistantMessage('user', [
                {
                    type: 'search_result',
                    source: 'https://bank.example/fees',
                    title: 'Fees',
                    content: [{ type: 'text', text: 'The Q3 fee was $731.' }],
                },
                'What was I charged in Q3?',
            ])
            askAssistant({ messages: [message] })
        `} />
    </Section>

    <Section level={3} title="Tell the person which file the assistant cannot read">
        <p>A file no model reads, or a phone's HEIC this browser cannot redraw, throws, naming
            the file.</p>
        <Code language="ts" caption="browser" code={`
            import { assistantMessage } from '@abide/abide'
            import { askAssistant } from './askAssistant.server.ts'

            try {
                const message = await assistantMessage('user', [...files, question])
                askAssistant({ messages: [message] })
            } catch (error) {
                failure = (error as Error).message
            }
        `} />
    </Section>

    <Section level={3} title="Seed a conversation with an earlier answer">
        <p>Pass <code>'assistant'</code> and the words it said. A file goes only in the
            person's message, so one handed to an assistant message throws.</p>
        <Code language="ts" caption="browser" code={`
            import { assistantMessage } from '@abide/abide'

            const history = [
                await assistantMessage('user', ['What did I spend on fees?']),
                await assistantMessage('assistant', ['About $412, mostly wire fees.']),
            ]
        `} />
    </Section>

    <Section level={3} title="Keep an answer as the messages it amounts to">
        <p>Hand <code>assistantMessage</code> the events an answer streamed. It joins each run's
            words, writes each tool call's input, and puts each call's result in the person's
            message after it, as the Messages API holds them. A call that never answered is left
            out, so the conversation goes back to the API as it is.</p>
        <Code language="ts" caption="browser" code={`
            import { assistantMessage, type AssistantMessage } from '@abide/abide'
            import { askAssistant } from './askAssistant.server.ts'

            const history: AssistantMessage[] = [
                await assistantMessage('user', ['Which company is Ada at?']),
            ]
            const events = await askAssistant({ messages: history })
            history.push(...assistantMessage('assistant', events))
        `} />
    </Section>

    <Section level={3} title="Show the page of the statement an answer cites">
        <p>Words the model cited keep the Messages API's <code>citations</code>, and go back to
            it with them.</p>
        <Code language="abide" caption="abide" code={`
            {#for block of message.content}
                {#if block.type === 'text'}
                    <p>{block.text}
                        {#for citation of block.citations ?? []}
                            <cite>{String(citation.document_title)}</cite>
                        {/for}
                    </p>
                {/if}
            {/for}
        `} />
    </Section>
</Doc>
