<script>
import Code from '#src/lib/Code.abide'
import Doc from '#src/lib/Doc.abide'
import Section from '#src/lib/Section.abide'
</script>

<Doc
    seeAlso={['/ai/provider', '/ai/results-of', '/headless/chat', '/handlers/mcp']}
    tests={[
        {
            path: 'packages/dogfood/examples/crm/src/assistant/lib/AssistantChat.test.ts',
            from: ["test('the model calls the CRM search, through the app'"],
        },
        {
            path: 'packages/abide/tests/assistant.test.ts',
            from: [
                "test('a tool call is seen before its input is written — 44.28'",
            ],
        },
        {
            path: 'packages/abide/tests/assistantBlocks.test.ts',
            from: [
                "test('provider.claudeApi yields every event the API streams, unchanged — 44.2, 44.11'",
            ],
        },
        {
            path: 'packages/abide/tests/assistant.test.ts',
            from: [
                "test('both providers play one conversation as one event sequence, tools called as the asker — 44.2, 44.7, 44.17'",
            ],
        },
    ]}
>
    <Section level={3} title="Answer a rep's question with the CRM's own handlers">
        <p>Yield <code>assistant</code> from a streaming handler you write, so its address and its
            middleware are yours. <code>tools: true</code> hands the model the app's tools, each
            called as the person asking.</p>
        <Code language="ts" caption="server" code={`
            import {
                assistant,
                type AssistantMessage,
                provider,
                rpc,
} from '@abide/abide/server'

            const claude = provider.claudeApi({
                apiKey: Bun.env.ANTHROPIC_API_KEY ?? '',
                model: 'claude-opus-5',
                max_tokens: 1024,
            })

            type Asked = { messages: AssistantMessage[] }

            export default rpc(
                async function* ({ messages }: Asked) {
                    yield* assistant(messages, claude, { tools: true })
                },
                { methods: ['POST'], clients: { mcp: false } },
            )
        `} />
    </Section>

    <Section level={3} title="Show the answer as its words arrive">
        <p>Call the handler like any stream. Each run streams as the Messages API streams it, so
            a <code>text_delta</code> is a piece of the reply: join them in a derived value.</p>
        <Code language="abide" caption="abide" code={`
            <script>
            import { reactive } from '@abide/abide'
            import askAssistant from './askAssistant.server.ts'

            const events = reactive(() => askAssistant({
                messages: [{ role: 'user', content: 'Where does Ada work?' }],
            }))
            const answer = reactive(() => {
                let text = ''
                for (const event of events)
                    if (
                        event.type === 'content_block_delta' &&
                        event.delta.type === 'text_delta'
                    )
                        text += event.delta.text
                return text
            })
            </script>

            <p>{answer}</p>
        `} />
    </Section>

    <Section level={3} title="Log what an answer read from the cache">
        <p>Each run's <code>message_start</code> and <code>message_delta</code> carry the
            Messages API's <code>usage</code> as it counts it, cache counts included, and the
            <code>message_delta</code> its <code>stop_reason</code>.</p>
        <Code language="ts" caption="server" code={`
            import { type AssistantEvent, log } from '@abide/abide/server'

            export function logUsage(event: AssistantEvent) {
                if (event.type !== 'message_start') return
                const { cache_read_input_tokens } = event.message.usage
                log.info('read from the cache', cache_read_input_tokens)
            }
        `} />
    </Section>

    <Section level={3} title="Test the assistant against a recorded model">
        <p>A <code>Provider</code> is one method, <code>run</code>, yielding each run as the
            Messages API streams it, and what each tool call answered between runs. Write one with
            fixed lines, and the tool call it makes still runs the real handler.</p>
        <Code language="ts" caption="server" code={`
            import type { Provider } from '@abide/abide/server'
            import { recordedRun } from '#src/lib/recordedRun.ts'

            const recorded: Provider = {
                async *run(_messages, tools) {
                    const name = 'get_assistant_searchContacts'
                    const input = { name: 'Ada' }
                    yield* recordedRun(
                        [{ type: 'tool_use', id: 't1', name, input }],
                        'tool_use',
                    )
                    const { isError } = await tools.call(name, input)
                    yield {
                        type: 'tool_result',
                        tool_use_id: 't1',
                        content: [],
                        is_error: isError,
                    }
                    yield* recordedRun(
                        [{ type: 'text', text: 'Ada is at Analytical Engines.' }],
                        'end_turn',
                    )
                },
            }
        `} />
    </Section>
</Doc>
