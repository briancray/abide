<script>
import Code from '#src/lib/Code.abide'
import Doc from '#src/lib/Doc.abide'
import Section from '#src/lib/Section.abide'
</script>

<Doc
    seeAlso={[
        '/ai/provider',
        '/ai/results-of',
        '/ai/transcript',
        '/headless/chat',
        '/handlers/mcp',
    ]}
    tests={[
        {
            path: 'packages/dogfood/examples/crm/src/assistant/lib/AssistantChat.test.ts',
            from: ["test('the model calls the CRM search, through the app'"],
        },
        {
            path: 'packages/abide/tests/assistant.test.ts',
            from: [
                "test('a tool call is announced before its input is written — 44.28'",
            ],
        },
    ]}
>
    <Section level={3} title="Answer a rep's question with the CRM's own handlers">
        <p>Yield <code>assistant</code> from a streaming handler you write, so its address and its
            middleware are yours. <code>mcp: true</code> hands the model the app's tools, each
            called as the person asking.</p>
        <Code language="ts" caption="server" code={`
            import {
                assistant,
                type AssistantMessage,
                POST,
                provider,
            } from '@abide/abide/server'

            const claude = provider.claudeApi({
                apiKey: Bun.env.ANTHROPIC_API_KEY ?? '',
                model: 'claude-opus-5',
                max_tokens: 1024,
            })

            export default POST(
                async function* ({ messages }: { messages: AssistantMessage[] }) {
                    yield* assistant(messages, claude, { mcp: true })
                },
                { clients: { mcp: false } },
            )
        `} />
    </Section>

    <Section level={3} title="Show the answer as its words arrive">
        <p>Call the handler like any stream. Each <code>text</code> event is a piece of the
            reply, so join them in a derived value.</p>
        <Code language="abide" caption="abide" code={`
            <script>
            import { reactive } from '@abide/abide'
            import askAssistant from './askAssistant.handler.ts'

            const events = askAssistant({
                messages: [{ role: 'user', content: 'Where does Ada work?' }],
            })
            const answer = reactive(() => {
                let text = ''
                for (const event of events)
                    if (event.type === 'text') text += event.text
                return text
            })
            </script>

            <p>{answer}</p>
        `} />
    </Section>

    <Section level={3} title="Test the assistant against a recorded model">
        <p>A <code>Provider</code> is one method, <code>run</code>, yielding events. Write one
            with fixed lines, and the tool call it makes still runs the real handler.</p>
        <Code language="ts" caption="server" code={`
            import type { Provider } from '@abide/abide/server'

            const recorded: Provider = {
                async *run(_messages, tools) {
                    const name = 'get_assistant_searchContacts'
                    const input = { name: 'Ada' }
                    yield { type: 'tool', id: 't1', name }
                    yield { type: 'input', id: 't1', input }
                    const { failed } = await tools.call(name, input)
                    yield { type: 'result', id: 't1', text: '', failed }
                    yield { type: 'text', text: 'Ada is at Analytical Engines.' }
                    yield { type: 'done', stop: 'end_turn', usage: { input: 0, output: 0 } }
                },
            }
        `} />
    </Section>
</Doc>
