<script>
import Code from '#src/lib/Code.abide'
import Doc from '#src/lib/Doc.abide'
import Section from '#src/lib/Section.abide'
</script>

<Doc
    seeAlso={[
        '/headless/chat',
        '/ai/assistant',
        '/ai/results-of',
        '/reactive/reactive',
    ]}
    tests={[
        {
            path: 'packages/abide/tests/transcript.test.ts',
            from: [
                "test('an answer folds into one turn: words joined, each call paired with its input and result — 53.24-53.27'",
            ],
        },
        {
            path: 'packages/abide/tests/transcript.test.ts',
            from: ["test('a turn sets every field it declares — 53.30'"],
        },
        {
            path: 'packages/abide/tests/assistantBlocks.test.ts',
            from: [
                "test('a conversation folded from its events goes back to the API as the blocks it was — 53.28, 44.38'",
            ],
        },
        {
            path: 'packages/abide/tests/assistantBlocks.test.ts',
            from: [
                "test('a call that never answered goes back as neither its call nor its result — 53.28'",
            ],
        },
    ]}
>
    <Section level={3} title="Fold a streamed answer into the assistant's turn">
        <p>Open the question and the answer with <code>transcript.turn</code>, then fold each
            event into the answer as it arrives. Fold inside <code>patch</code>, once per event, so
            a long answer is walked once rather than again for every piece.</p>
        <Code language="ts" caption="browser" code={`
            import { type AssistantTurn, reactive, transcript } from '@abide/abide'
            import askAssistant from './askAssistant.handler.ts'

            const turns = reactive<AssistantTurn[]>([])
            async function ask(text: string) {
                turns.patch((all) => {
                    all.push(transcript.turn('user', [{ type: 'text', text }]))
                    all.push(transcript.turn('assistant'))
                })
                const messages = transcript.messages(turns())
                for await (const event of askAssistant({ messages }))
                    turns.patch((all) => {
                        const answering = all[all.length - 1]
                        if (answering) transcript.fold(answering, event)
                    })
            }
        `} />
    </Section>

    <Section level={3} title="Show each tool call among the assistant's words">
        <p>A folded turn's <code>parts</code> keep the order they arrived in. A tool part holds
            its input and, once answered, its result.</p>
        <Code language="abide" caption="abide" code={`
            <script>
            import { type AssistantTurn, props } from '@abide/abide'
            const { turn } = props<{ turn: AssistantTurn }>()
            </script>

            {#for part of turn.parts}
                {#if part.type === 'text'}
                    <p>{part.text}</p>
                {:else if part.type === 'tool'}
                    <p>{part.name}: {part.content === undefined ? 'running' : 'done'}</p>
                {/if}
            {/for}
        `} />
    </Section>

    <Section level={3} title="Show the page of the statement an answer cites">
        <p>A run of words the model cited is a text part of its own, holding the Messages
            API's <code>citations</code>. <code>transcript.messages</code> sends it back with
            them, and each tool call as the <code>tool_use</code> and <code>tool_result</code>
            the model saw.</p>
        <Code language="abide" caption="abide" code={`
            {#for part of turn.parts}
                {#if part.type === 'text'}
                    <p>{part.text}
                        {#for citation of part.citations ?? []}
                            <cite>{String(citation.document_title)}</cite>
                        {/for}
                    </p>
                {/if}
            {/for}
        `} />
    </Section>
</Doc>
