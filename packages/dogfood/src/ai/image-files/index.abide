<script>
import Code from '#src/lib/Code.abide'
import Doc from '#src/lib/Doc.abide'
import Section from '#src/lib/Section.abide'
</script>

<Doc
    seeAlso={[
        '/ai/image-piece',
        '/helpers/dropzone',
        '/ai/assistant',
        '/components/chat',
    ]}
    tests={[
        {
            path: 'packages/abide/tests/imagePiece.test.ts',
            from: [
                "test('a paste or a drop hands on the images a model is shown or a HEIC, from its items where its files hold none — 44.55'",
            ],
        },
    ]}
>
    <Section level={3} title="Take the screenshots a rep pastes into the composer">
        <p>Hand <code>imageFiles</code> the paste's <code>clipboardData</code>. It answers the
            images a model is shown, and leaves out a pasted PDF or text.</p>
        <Code language="abide" caption="abide" code={`
            <script>
            import { imageFiles, imagePiece, reactive } from '@abide/abide'

            let attached = reactive<{ data: string; mimeType: string }[]>([])
            async function paste(event: ClipboardEvent) {
                for (const file of imageFiles(event.clipboardData))
                    attached.push(await imagePiece(file))
            }
            </script>

            <textarea onpaste={paste}></textarea>
        `} />
    </Section>

    <Section level={3} title="Accept only images dropped on the composer">
        <p>Pass <code>imageFiles</code> as a <code>dropzone</code>'s <code>accept</code>, and the
            drop and the paste hand on the same images.</p>
        <Code language="abide" caption="abide" code={`
            <script>
            import { dropzone, imageFiles, imagePiece, reactive } from '@abide/abide'

            let attached = reactive<{ data: string; mimeType: string }[]>([])
            async function attach(files: File[]) {
                for (const file of files) attached.push(await imagePiece(file))
            }
            </script>

            <form bind:element={dropzone(attach, { accept: imageFiles, paste: true })}>
                <textarea></textarea>
            </form>
        `} />
    </Section>
</Doc>
