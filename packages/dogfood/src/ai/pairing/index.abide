<script>
import Code from '#src/lib/Code.abide'
import Doc from '#src/lib/Doc.abide'
import Section from '#src/lib/Section.abide'
</script>

<Doc
    seeAlso={['/headless/chat', '/ai/provider', '/app/on-pairing', '/cli/bridge']}
    tests={[
        {
            path: 'packages/dogfood/examples/crm/src/assistant/lib/ClaudeCodeChat.test.ts',
            from: ["test('unpaired: the command and the click, and no chat yet'"],
        },
        {
            path: 'packages/dogfood/examples/crm/src/assistant/lib/ClaudeCodeChat.test.ts',
            from: ["test('paired: the chat, and the tools it cannot use'"],
        },
        {
            path: 'packages/dogfood/examples/crm/src/assistant/lib/Pairing.test.ts',
            from: [
                "test('a connection that takes too long offers to try again, and trying again asks again'",
            ],
        },
        {
            path: 'packages/dogfood/examples/crm/src/assistant/lib/Pairing.test.ts',
            from: [
                "test('a visitor offline is told so, and the step returns once they are back'",
            ],
        },
        {
            path: 'packages/abide/tests/pairing.test.ts',
            from: [
                "test('a click that blurs the page offers the click again; one that does not offers the install — 44.70, 44.71, 53.42'",
            ],
        },
        {
            path: 'packages/abide/tests/pairing.test.ts',
            from: [
                "test('copyInstall copies the install command and holds copied — 44.72'",
            ],
        },
        {
            path: 'packages/abide/tests/pairing.test.ts',
            from: [
                "test('a pairing built outside a setup stops reading and following once stopped — 44.73'",
            ],
        },
    ]}
>
    <Section level={3} title="Pair the visitor's Claude Code with a click">
        <p><code>start</code> opens the pairing link, and <code>status</code> follows the pairing
            as it changes. <code>step</code> is where it stands, one arm of the page per step:
            <code>connecting</code>, <code>slow</code>, <code>offline</code>,
            <code>unavailable</code>, <code>click</code>, <code>waiting</code>,
            <code>install</code> or <code>paired</code>. The page writes no handler for any of
            it.</p>
        <Code language="abide" caption="abide" code={`
            <script>
            import { pairing } from '@abide/abide'
            const { status, step, start } = pairing()
            </script>

            {#if step === 'paired'}
                <p>Your Claude Code is paired.</p>
            {:else if step === 'click' || step === 'waiting'}
                <pre>{status?.command}</pre>
                <button disabled={step === 'waiting'} onclick={start}>Pair</button>
            {:else}
                <p>{step}</p>
            {/if}
        `} />
    </Section>

    <Section level={3} title="Offer the install command when the click opens nothing">
        <p>A click that opens no app sets <code>step</code> to <code>install</code>. Show the
            command that installs what opens the link, and a copy button.</p>
        <Code language="abide" caption="abide" code={`
            <script>
            import { pairing } from '@abide/abide'
            const { status, step, copied, copyInstall } = pairing()
            </script>

            {#if step === 'install'}
                <pre>{status?.install}</pre>
                <button onclick={copyInstall}>{copied ? 'Copied' : 'Copy'}</button>
            {/if}
        `} />
    </Section>

    <Section level={3} title="Show the chat once the visitor's Claude Code is paired">
        <p>Render the conversation in the <code>paired</code> arm, and a Reconnect calling
            <code>start</code> beside it. <code>status.missing</code> names the tools the visitor's
            Claude Code cannot use here.</p>
        <Code language="abide" caption="abide" code={`
            <script>
            import { pairing } from '@abide/abide'
            import Chat from './Chat.abide'
            import askClaudeCode from '../askClaudeCode.server.ts'

            const { status, step, start } = pairing()
            </script>

            {#if step === 'paired'}
                {#if status?.missing.length}
                    <p>Claude Code here cannot use {status.missing.join(', ')}.</p>
                {/if}
                <Chat ask={askClaudeCode} />
                <button onclick={start}>Reconnect</button>
            {/if}
        `} />
    </Section>

    <Section level={3} title="Offer a retry when connecting takes too long">
        <p>After <code>slowAfter</code> milliseconds of connecting, the step is
            <code>slow</code>, and <code>retry</code> reads the pairing again. A visitor with no
            network is at <code>offline</code> until they are back, before any other step.</p>
        <Code language="abide" caption="abide" code={`
            <script>
            import { pairing } from '@abide/abide'
            const { step, retry } = pairing({ slowAfter: 5000 })
            </script>

            {#if step === 'slow'}
                <p>Still connecting to Claude Code.</p>
                <button onclick={retry}>Try again</button>
            {:else if step === 'offline'}
                <p>You are offline. Pairing resumes once you are back.</p>
            {/if}
        `} />
    </Section>

    <Section level={3} title="Stop a pairing a click handler started">
        <p>A pairing in a component stops with the component. One built anywhere else runs until
            its <code>stop</code>, which <code>using</code> calls too.</p>
        <Code language="ts" caption="browser" code={`
            import { pairing } from '@abide/abide'

            using connection = pairing()
            await connection.status
            console.log(connection.status()?.paired)
        `} />
    </Section>
</Doc>
