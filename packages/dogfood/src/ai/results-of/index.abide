<script>
import Code from '#src/lib/Code.abide'
import Doc from '#src/lib/Doc.abide'
import Section from '#src/lib/Section.abide'
</script>

<Doc
    seeAlso={['/ai/assistant', '/ai/assistant-message', '/handlers/get']}
    tests={[
        {
            path: 'packages/abide/tests/assistant.test.ts',
            from: [
                "test('a handler that takes args is one resultsOf reads — 44.51'",
            ],
        },
        {
            path: 'packages/abide/tests/assistant.test.ts',
            from: [
                "test('an answer carries its value, and resultsOf finds a handler’s calls by its tool, whoever ran it — 44.49, 44.50, 44.51'",
            ],
        },
        {
            path: 'packages/abide/tests/assistantBlocks.test.ts',
            from: [
                "test('resultsOf reads what a handler’s calls answered off the messages — 44.51'",
            ],
        },
    ]}
>
    <Section level={3} title="Fill a report from what the assistant drafted">
        <p>Await the assistant handler for every event, keep them as the messages they amount
            to, then hand those to <code>resultsOf</code> with the handler whose answers you
            want. Each value is typed as that handler's.</p>
        <Code language="ts" caption="browser" code={`
            import { assistantMessage, type ReportDraft, resultsOf } from '@abide/abide'
            import askReport from './askReport.handler.ts'
            import draftReport from './draftReport.handler.ts'

            async function fill(draft: ReportDraft) {
                const events = await askReport({ draft: draft.markdown() })
                const messages = assistantMessage('assistant', events)
                for (const written of resultsOf(messages, draftReport)) {
                    draft.summary.set(written.summary)
                    draft.description.set(written.description)
                }
            }
        `} />
    </Section>

    <Section level={3} title="List every contact the assistant looked up">
        <p>A failed call is left out, so each value is one the handler answered.</p>
        <Code language="abide" caption="abide" code={`
            <script>
            import { type AssistantMessage, props, resultsOf } from '@abide/abide'
            import searchContacts from './searchContacts.handler.ts'

            const { messages } = props<{ messages: AssistantMessage[] }>()
            const found = resultsOf(messages, searchContacts).flat()
            </script>

            {#for contact of found}<p>{contact.name}</p>{/for}
        `} />
    </Section>
</Doc>
