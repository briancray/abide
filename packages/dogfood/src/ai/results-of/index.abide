<script>
import Code from '#src/lib/Code.abide'
import Doc from '#src/lib/Doc.abide'
import Section from '#src/lib/Section.abide'
</script>

<Doc
    seeAlso={[
        '/headless/chat',
        '/ai/assistant',
        '/ai/assistant-message',
        '/handlers/rpc',
    ]}
    tests={[
        {
            path: 'packages/abide/tests/assistant.test.ts',
            from: [
                "test('a handler that takes args is one resultsOf reads — 44.51'",
            ],
        },
        {
            path: 'packages/abide/tests/assistant.test.ts',
            from: [
                "test('an answer carries its value, and resultsOf finds a handler’s calls by its tool, whoever ran it — 44.49, 44.50, 44.51'",
            ],
        },
        {
            path: 'packages/abide/tests/assistantBlocks.test.ts',
            from: [
                "test('resultsOf reads what a handler’s calls answered off the messages — 44.51'",
            ],
        },
    ]}
>
    <Section level={3} title="Count the contacts a stored conversation found">
        <p>Hand <code>resultsOf</code> a conversation as you stored it and the handler whose
            answers you want. Each value is typed as that handler's, in the order its calls
            were made. In a page, read a <code>chat</code>'s own <code>calls</code>
            instead.</p>
        <Code language="ts" caption="server" code={`
            import type { AssistantMessage } from '@abide/abide/server'
            import { resultsOf } from '@abide/abide'
            import searchContacts from '../searchContacts.server.ts'

            export function contactsFound(stored: AssistantMessage[]) {
                return resultsOf(stored, searchContacts).flat().length
            }
        `} />
    </Section>

    <Section level={3} title="Read only the reports the assistant managed to write">
        <p>A failed call is left out, so each value is one the handler answered.</p>
        <Code language="ts" caption="server" code={`
            import type { AssistantMessage } from '@abide/abide/server'
            import { resultsOf } from '@abide/abide'
            import draftReport from '../draftReport.server.ts'

            export function summaries(stored: AssistantMessage[]) {
                return resultsOf(stored, draftReport).map((written) => written.summary)
            }
        `} />
    </Section>
</Doc>
