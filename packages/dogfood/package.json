{
    "name": "dogfood",
    "version": "0.0.0",
    "private": true,
    "type": "module",
    "description": "The abide documentation, as an abide app — and the app abide is dogfooded on",
    "imports": {
        "#shared": "./src/shared/index.ts",
        "#shared/*": [
            "./src/shared/*",
            "./src/shared/*.ts"
        ],
        "#ui": "./src/ui/index.ts",
        "#ui/*": [
            "./src/ui/*",
            "./src/ui/*.ts"
        ],
        "#server": "./src/server/index.ts",
        "#server/*": [
            "./src/server/*",
            "./src/server/*.ts"
        ]
    },
    "scripts": {
        "pages": "bun run scripts/buildPages.ts",
        "build": "bun run pages && abide build",
        "start": "abide start --port 3131",
        "dev": "bun run scripts/dev.ts",
        "typecheck": "tsc -p tsconfig.json"
    },
    "dependencies": {
        "abide": "workspace:*",
        "zod": "^4.6.5"
    },
    "devDependencies": {
        "harness": "workspace:*",
        "tailwindcss": "^4.3.3"
    }
}
