{
    "name": "dogfood",
    "version": "0.0.0",
    "private": true,
    "type": "module",
    "description": "The abide documentation app, and the app abide is dogfooded on",
    "imports": {
        "#shared": "./src/shared/index.ts",
        "#shared/*": "./src/shared/*",
        "#ui": "./src/ui/index.ts",
        "#ui/*": "./src/ui/*",
        "#server": "./src/server/index.ts",
        "#server/*": "./src/server/*"
    },
    "scripts": {
        "build": "abide build --root ./src",
        "start": "abide start --root ./src",
        "dev": "abide dev --root ./src",
        "typecheck": "tsc -p tsconfig.json",
        "docs": "bun run scripts/buildDocs.ts",
        "docs:serve": "bun run scripts/buildDocs.ts --serve"
    },
    "dependencies": {
        "abide": "workspace:*"
    },
    "devDependencies": {
        "tailwindcss": "^4.3.3"
    }
}
