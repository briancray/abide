{
    "name": "dogfood",
    "version": "0.0.0",
    "type": "module",
    "private": true,
    "imports": {
        "#server/*": [
            "./src/server/*",
            "./.abide/types/src/server/*"
        ],
        "#ui/*": [
            "./src/ui/*",
            "./.abide/types/src/ui/*"
        ],
        "#shared/*": [
            "./src/shared/*",
            "./.abide/types/src/shared/*"
        ],
        "#tests/*": [
            "./src/tests/*",
            "./.abide/types/src/tests/*"
        ]
    },
    "scripts": {
        "dev": "bun ../abide/cli/index.ts dev",
        "start": "bun ../abide/cli/index.ts start",
        "build": "bun ../abide/cli/index.ts build",
        "compile": "bun ../abide/cli/index.ts compile --out .abide/dogfood",
        "console": "bun ../abide/cli/index.ts console",
        "typecheck": "tsc --noEmit"
    },
    "dependencies": {
        "abide": "workspace:*",
        "harness": "workspace:*",
        "marked": "^18.0.10"
    },
    "devDependencies": {
        "bun-plugin-tailwind": "^0.1.2",
        "tailwindcss": "^4.3.3"
    }
}
