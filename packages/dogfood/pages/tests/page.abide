<!-- Every case in the repo, in one table.

     This page DOES load every suite, and that is the one page it is correct on: the whole point of it is
     to be the list of everything, so the chunk it costs is the thing it is for. Every other page reaches
     one suite through `LOADERS` for exactly that reason. -->
<script module>
import { memo, state } from 'abide'
import type { Suite } from 'harness'
import { allSuites } from '../../demos/index.ts'
import Cases from '../../site/cases.abide'
import { CHIP } from '../../site/table.ts'

const BLURB =
    'Every claim in the repo, run in this browser — the same bodies `bun test` runs, one at a time, ' +
    'because the DOM counters they measure with are global. Scan the status column; open a row for its ' +
    'lines and the code that made them.'
</script>

<script>
/**
 * Every suite, and the failure if the load is what failed.
 *
 * A page whose whole content is one load has to say when the load did not happen: a silent empty table
 * reads as "there are no tests", which is the one thing it never means.
 */
const failure = state('')
const loaded = memo(async (): Promise<Suite[]> => {
    try {
        return await allSuites()
    } catch (error: unknown) {
        failure = `the suites did not load — ${String(error)}`
        return []
    }
})
</script>

<!-- `loaded.pending()`, not `loaded().pending()`: with no args the memo IS its own handle, where a keyed
     one is selected by the call first. -->
{#if loaded.pending()}
    <p class="note">loading every suite…</p>
{:else}
    {#if failure}
        <p class="error">{failure}</p>
    {:else}
        <Cases suites={loaded()} title="tests" blurb={BLURB}>
            <p class="note">Measurements are on <a href="/bench" class="link">/bench</a>; what each name looks like written is under <a href="/docs" class="link">/docs</a>.</p>
        </Cases>
    {/if}
{/if}
