<!-- One SPELLING as a reference page: the ladder of examples that use it.

     The mirror of `/docs/[callable]`, and deliberately the same page rather than a second design of
     one: `Reference` takes what both vocabularies have — a name, a line, and the rungs — so the only
     thing that differs here is that there is no import line, because `{#for}` imports nothing.

     `/docs/syntax/<x>` and `/docs/<x>` cannot collide: this pattern is two segments and that one is
     one, and the literal `syntax` beats the parameter at the segment they share, which is what makes
     the index above this one reachable at all. -->
<script module>
import { memo, route } from 'abide'
import type { Example } from 'harness'
import { rungsSpelling, type SpellingMeta, type SpellingName, SPELLINGS } from '../../../../demos/SPELLINGS.ts'
import Reference from '../../../../site/reference.abide'
import type { NavItem } from '../../../../site/sidebar.ts'

/** Where a reader came from, which for this vocabulary is the syntax index rather than `/docs`. */
const CRUMB: NavItem = { href: '/docs/syntax', label: 'docs · syntax' }

interface Found {
    spelling: SpellingMeta
    rungs: Example[]
}

/**
 * One spelling and its rungs, by slug. The args are the cache key, so navigating back reads what is loaded.
 *
 * THE ONLY READER, for the reason the callable page states: the page's whole content is one deferred
 * region, so the ask and the wait are one thing the server and a browser agree on. A second reader
 * outside it — the sidebar in the layout, which renders first — is what broke that. See `site/sidebar.ts`.
 */
const ladderOf = memo(async ({ slug }: { slug: string }): Promise<Found | null> => {
    if (!Object.hasOwn(SPELLINGS, slug)) return null
    const spelling = SPELLINGS[slug as SpellingName]
    return { spelling, rungs: await rungsSpelling(spelling) }
})
</script>

<!-- The same two-level shape as the callable page and for both of its reasons: the probe is what sends
     the shell out with a placeholder in it, and the settled arm is where the answer can be bound to a
     const the `{#if}` under it narrows. -->
{#if ladderOf({ slug: route().params.spelling ?? '' }).pending()}
    <p class="note">loading…</p>
{:else}
    <script>
    const found = ladderOf({ slug: route().params.spelling ?? '' })
    </script>
    {#if found}
        <Reference head={found.spelling} crumb={CRUMB} rungs={found.rungs}/>
    {:else}
        <div class="page-head">
            <h1 class="page-title">nothing here</h1>
            <p class="page-blurb">a <code>.abide</code> file has no spelling called “{route().params.spelling}”.</p>
            <p class="note"><a href="/docs/syntax" class="link">Every spelling it does have →</a></p>
        </div>
    {/if}
{/if}
