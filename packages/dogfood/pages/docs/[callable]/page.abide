<!-- Every public name's reference, as one page.

     `[callable]` is the segment that names it, and `CALLABLES` is how one page serves every one of
     those routes. The ladders behind it are `import()`s for the same reason the suite loaders are: reaching
     them through one static list put every rung's source, and every compiled preview, on every page.

     Keyed by CALLABLE rather than by capability because a callable is what a reader arrives with —
     somebody who met `cookies()` in a codebase is looking up `cookies`, and a suite page made them read
     five neighbouring rungs to find it. -->
<script>
import { memo, route } from 'abide'
import type { Example } from 'harness'
import { CALLABLES, type CallableMeta, type CallableName, rungsOf } from '../../../demos/CALLABLES.ts'
import Reference from '../../../site/reference.abide'
import type { NavItem } from '../../../site/sidebar.ts'

/** Where a reader came from, which for this vocabulary is the index of names. */
const CRUMB: NavItem = { href: '/docs', label: 'docs' }

interface Found {
    callable: CallableMeta
    rungs: Example[]
}

/**
 * One callable and its rungs, by name. The args are the cache key, so navigating back reads what is loaded.
 *
 * THE ONLY READER, and that is worth keeping: this page's whole content sits behind the `.pending()`
 * below, so the ask and the deferral are one thing the server and a browser agree on. A second reader
 * OUTSIDE that guard — the sidebar in the layout, which renders first — broke exactly that agreement.
 * See `site/sidebar.ts`.
 */
const ladderOf = memo(async ({ name }: { name: string }): Promise<Found | null> => {
    if (!Object.hasOwn(CALLABLES, name)) return null
    const callable = CALLABLES[name as CallableName]
    return { callable, rungs: await rungsOf(callable) }
})
const found = memo(() => ladderOf({ name: route().params.callable ?? '' }))
</script>

<!-- Asking about `.pending()` is what sends the shell out now with the placeholder in it. The call
     stays in the markup rather than being hoisted into setup: it reads `route()`, so it belongs in the
     slot's own thunk, where a navigation re-runs it.

     It is also what gives the answer a CONST to be narrowed by. A read in a template is a call, and
     TypeScript narrows a const and never a call, so the settled arm binds one in a nested setup block,
     which is legal as the first node of a block body. -->
    {#if found}
        <Reference head={found.callable} crumb={CRUMB} rungs={found.rungs}/>
    {:else}
        <div class="page-head">
            <h1 class="page-title">nothing here</h1>
            <p class="page-blurb">abide exports nothing called “{route().params.callable}”.</p>
            <p class="note"><a href="/docs" class="link">Every name it does export →</a></p>
        </div>
    {/if}
