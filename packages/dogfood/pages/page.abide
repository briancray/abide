<!-- The hub: four ways in, and an index of the capabilities under them.

     Four, because there are four questions somebody arrives with — what is this, does it work, what does
     it cost, and what does one of these look like at scale — and each has a section that answers only
     that one. This used to be the `overview` suite's cards with an index beneath them, which answered the
     first question and buried the other three.

     `overview`'s own blurb is the prose here: it is the one place that text lives, so the hub cannot
     describe this repo differently from the suite that used to. -->
<script module>
import { CAPABILITIES, META } from '../demos/SUITES.ts'

const CARD = 'card'
const TAG = 'card-tag'

const WAYS_IN: { href: string; title: string; tag: string; blurb: string }[] = [
    {
        href: '/docs',
        title: 'docs',
        tag: 'what it looks like written',
        blurb:
            'One page per NAME abide exports: a ladder of examples, each rung adding exactly one thing, ' +
            'and every rung is a real file this app compiles and runs.',
    },
    {
        href: '/tests',
        title: 'tests',
        tag: 'whether it works',
        blurb:
            'Every claim in the repo as a row, run in this browser — the same bodies `bun test` runs. ' +
            'Scan the status column; open a row for its lines and the code that made them.',
    },
    {
        href: '/bench',
        title: 'bench',
        tag: 'what it costs',
        blurb:
            'Every case that carries a bench, against a hand-written equivalent: time as a ratio, work as ' +
            'DOM calls, reactivity as wake-ups, and emitted code as its budget.',
    },
    {
        href: '/users/42',
        title: 'the app itself',
        tag: 'not a demo',
        blurb:
            'The pages this app serves for its own sake — a user page through two layouts, a file tree, a ' +
            'stream. The furniture the sections above are built out of.',
    },
]
</script>

<div class="page-head">
    <h1 class="page-title">abide</h1>
    <p class="page-blurb">{META.overview.blurb}</p>
</div>

<div class="cards">
    {#for way of WAYS_IN}
        <a href={way.href} class={CARD}>
            <h2 class="card-title">{way.title}</h2>
            <p class={TAG}>{way.tag}</p>
            <p class="card-blurb">{way.blurb}</p>
        </a>
    {/for}
</div>

<section>
    <h2 class="head">the capabilities · {CAPABILITIES.length}</h2>
    <div class="cards">
        {#for entry of CAPABILITIES}
            <a href="/tests/{entry.name}" class={CARD}>
                <h3 class="card-title">{entry.title}</h3>
                <p class={TAG}>{entry.tag}</p>
                <p class="card-blurb">{entry.blurb}</p>
            </a>
        {/for}
    </div>
</section>
