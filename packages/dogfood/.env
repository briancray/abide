# What this deployment overrides. The CRM defaults RETRIES to 3 in
# examples/crm/src/ops/getRetries.handler.ts, which /guide/run-it's card reads.
RETRIES=5

# The log namespaces whose gated lines write: /guide/run-it's logging card.
DEBUG=dogfood:billing

# The docs app keeps its pages offline — /guide/test-measure-and-ship's `ABIDE_OFFLINE`, dogfooded.
ABIDE_OFFLINE=1
