<script>
import { props } from '@abide/abide'

const { name } = props<{ name: string }>()

const initials = name
    .split(' ')
    .map((part) => part[0] ?? '')
    .join('')
</script>

<span class="initials">{initials}</span>

<style>
.initials {
    display: inline-grid;
    place-items: center;
    width: 2rem;
    height: 2rem;
    border-radius: 9999px;
    background: #1e3a5f;
    color: #fff;
    font-size: 0.75rem;
    font-weight: 600;
}
</style>
